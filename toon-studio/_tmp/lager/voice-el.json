 "tempo": 1.0,
 "lines": [
  {
   "src": "N1a.mp3",
   "t0": 0,
   "t1": 1.63,
   "say": "Август восемьдесят шестого.",
   "gap": 0.48,
   "who": "narrator",
   "chapter": "N1"
  },
  {
   "src": "N1a.mp3",
   "t0": 2.01,
   "t1": 3.66,
   "say": "Летний лагерь «Ласточка».",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 4.07,
   "t1": 5.89,
   "say": "Ты вожатый первого отряда.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 6.28,
   "t1": 7.55,
   "say": "Вечерняя перекличка.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 7.93,
   "t1": 9.76,
   "say": "В списке двенадцать детей.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 10.24,
   "t1": 11.01,
   "say": "Ты считаешь.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 11.33,
   "t1": 12.04,
   "say": "Тринадцать.",
   "gap": 1.0,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 12.41,
   "t1": 13.28,
   "say": "Пересчитываешь.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 13.57,
   "t1": 14.33,
   "say": "Тринадцать.",
   "gap": 1.1,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 14.85,
   "t1": 16.41,
   "say": "Ты читаешь список вслух.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 16.76,
   "t1": 19.5,
   "say": "Двенадцать имён — двенадцать «я».",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 19.85,
   "t1": 21.76,
   "say": "Ни одного лишнего голоса.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 22.13,
   "t1": 24.7,
   "say": "А тринадцатый просто стоит среди них.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 25.07,
   "t1": 26.98,
   "say": "И ты не можешь понять, кто это.",
   "gap": 1.2,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 27.75,
   "t1": 30.43,
   "say": "Ночью к тебе приходит сторож, дядя Гриша.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 30.73,
   "t1": 32.61,
   "say": "Он работает здесь сорок лет.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "G1a.mp3",
   "t0": 0.08,
   "t1": 1.4,
   "say": "Тоже насчитал лишнего?",
   "gap": 0.52,
   "who": "old",
   "chapter": "G1"
  },
  {
   "src": "G1a.mp3",
   "t0": 1.82,
   "t1": 2.49,
   "say": "Тогда слушай.",
   "gap": 0.8,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 2.98,
   "t1": 3.4,
   "say": "Первое.",
   "gap": 0.59,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 3.89,
   "t1": 5.47,
   "say": "Не показывай, что считаешь.",
   "gap": 0.25,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 5.62,
   "t1": 6.15,
   "say": "Он поймёт.",
   "gap": 0.9,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 6.76,
   "t1": 7.29,
   "say": "Второе.",
   "gap": 0.38,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 7.57,
   "t1": 8.98,
   "say": "Не называй его по имени.",
   "gap": 0.33,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 9.21,
   "t1": 10.51,
   "say": "Имя он заберёт себе.",
   "gap": 0.9,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 10.99,
   "t1": 11.5,
   "say": "Третье.",
   "gap": 0.41,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 11.81,
   "t1": 12.93,
   "say": "Найди до рассвета.",
   "gap": 0.38,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 13.21,
   "t1": 15.24,
   "say": "Иначе утром их снова будет двенадцать.",
   "gap": 0.45,
   "who": "old"
  },
  {
   "src": "G1a.mp3",
   "t0": 15.59,
   "t1": 16.85,
   "say": "Только без одного из твоих.",
   "gap": 1.2,
   "who": "old"
  },
  {
   "src": "N2a.mp3",
   "t0": 0.03,
   "t1": 1.94,
   "say": "Ты смотришь на отряд по-новому.",
   "gap": 0.73,
   "who": "narrator",
   "chapter": "N2"
  },
  {
   "src": "N2a.mp3",
   "t0": 2.57,
   "t1": 3.39,
   "say": "Номер один.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 3.75,
   "t1": 4.26,
   "say": "Вова.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 4.63,
   "t1": 6.5,
   "say": "Он ни разу не ел в столовой.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 6.65,
   "t1": 7.64,
   "say": "Ни крошки.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 8.21,
   "t1": 8.97,
   "say": "Номер два.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 9.21,
   "t1": 9.73,
   "say": "Лена.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 10.01,
   "t1": 11.64,
   "say": "Знает всех по именам.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 11.81,
   "t1": 13.84,
   "say": "Но никто не помнит, как она приехала.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 14.46,
   "t1": 15.19,
   "say": "Номер три.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 15.43,
   "t1": 15.97,
   "say": "Миша.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 16.3,
   "t1": 18.48,
   "say": "В полночь он возвращается с озера.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 18.72,
   "t1": 19.83,
   "say": "Волосы мокрые.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 19.99,
   "t1": 21.42,
   "say": "А купаться запрещено.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 22.01,
   "t1": 22.92,
   "say": "Номер четыре.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 23.21,
   "t1": 23.62,
   "say": "Оля.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 23.97,
   "t1": 24.55,
   "say": "Тихая.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 24.75,
   "t1": 25.42,
   "say": "Обычная.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 25.74,
   "t1": 26.9,
   "say": "Всегда рядом с тобой.",
   "gap": 1.2,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 27.5,
   "t1": 28.52,
   "say": "Последний вечер.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 28.82,
   "t1": 29.42,
   "say": "Костёр.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 29.75,
   "t1": 30.4,
   "say": "Все поют.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "G2a.mp3",
   "t0": 0.25,
   "t1": 1.41,
   "say": "Смотри на тени.",
   "gap": 1.0,
   "who": "old",
   "chapter": "G2",
   "fx": "volume=1.6"
  },
  {
   "src": "N3a.mp3",
   "t0": 0,
   "t1": 1.09,
   "say": "Огонь прыгает.",
   "gap": 0.66,
   "who": "narrator",
   "chapter": "N3"
  },
  {
   "src": "N3a.mp3",
   "t0": 1.65,
   "t1": 3.15,
   "say": "Тени дрожат на песке.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 3.55,
   "t1": 4.92,
   "say": "Ты всматриваешься…",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 5.33,
   "t1": 6.45,
   "say": "И костёр гаснет.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 7.07,
   "t1": 9.33,
   "say": "В темноте кто-то берёт тебя за руку.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 9.75,
   "t1": 11.62,
   "say": "Маленькая холодная ладонь.",
   "gap": 1.0,
   "who": "narrator"
  },
  {
   "src": "KIDa.mp3",
   "t0": 0.09,
   "t1": 0.78,
   "say": "Вожатый…",
   "gap": 0.9,
   "who": "kid",
   "chapter": "KID",
   "fx": "aecho=0.8:0.6:70|140:0.3|0.15,volume=1.5"
  },
  {
   "src": "KIDa.mp3",
   "t0": 1.26,
   "t1": 2.62,
   "say": "а ты нас посчитал?",
   "gap": 1.3,
   "who": "kid",
   "fx": "aecho=0.8:0.6:70|140:0.3|0.15,volume=1.5"
  },
  {
   "src": "N4a.mp3",
   "t0": 0,
   "t1": 1.28,
   "say": "До рассвета час.",
   "gap": 0.36,
   "who": "narrator",
   "chapter": "N4"
  },
  {
   "src": "N4a.mp3",
   "t0": 1.54,
   "t1": 2.67,
   "say": "Ошибиться нельзя.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 2.96,
   "t1": 5.86,
   "say": "Выгонишь не того — и ребёнок уйдёт в лес один.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 6.35,
   "t1": 9.12,
   "say": "Номер один, два, три или четыре?",
   "gap": 1.0,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 9.5,
   "t1": 10.55,
   "say": "Пересмотри костёр.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 10.78,
   "t1": 11.68,
   "say": "Подсказка там.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 12.02,
   "t1": 13.4,
   "say": "Пиши номер в комментариях.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 13.67,
   "t1": 15.68,
   "say": "Что будет дальше — решите вы.",
   "gap": 0.6,
   "who": "narrator"
  }
 ]
}