     "t": 25.075
    },
    {
     "w": "ты",
     "t": 25.275
    },
    {
     "w": "молчишь.",
     "t": 25.495
    }
   ]
  },
  {
   "i": 13,
   "text": "Ты смотришь в глазок.",
   "start": 26.308,
   "end": 27.361,
   "who": "narrator",
   "words": [
    {
     "w": "Ты",
     "t": 26.308
    },
