   "who": "eva",
   "fx": "volume=5.498,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "D_TRICKa.mp3",
   "t0": 0,
   "t1": 1.99,
   "say": "Тогда ты придумываешь хитрость.",
