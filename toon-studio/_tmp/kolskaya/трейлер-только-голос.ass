Dialogue: 0,0:00:00.00,0:00:02.48,N,,0,0,0,,1
Dialogue: 0,0:00:00.00,0:00:02.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:00.00,0:00:02.48,T,,0,0,0,,К ржавой крышке в тундре.
Dialogue: 0,0:00:02.50,0:00:08.26,N,,0,0,0,,2
Dialogue: 0,0:00:02.50,0:00:08.26,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:02.50,0:00:08.26,T,,0,0,0,,Под этой крышкой — самая глубокая дыра, которую человек когда-либо сделал в Земле.
Dialogue: 0,0:00:08.28,0:00:10.78,N,,0,0,0,,3
Dialogue: 0,0:00:08.28,0:00:10.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:08.28,0:00:10.78,T,,0,0,0,,Двенадцать километров вниз.
Dialogue: 0,0:00:10.80,0:00:13.76,N,,0,0,0,,4
Dialogue: 0,0:00:10.80,0:00:13.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:10.80,0:00:13.76,T,,0,0,0,,Это глубже, чем Эверест высокий.
Dialogue: 0,0:00:13.78,0:00:16.69,N,,0,0,0,,5
Dialogue: 0,0:00:13.78,0:00:16.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:13.78,0:00:16.69,T,,0,0,0,,Будто учёные опустили туда микрофон.
Dialogue: 0,0:00:16.71,0:00:18.44,N,,0,0,0,,6
Dialogue: 0,0:00:16.71,0:00:18.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:16.71,0:00:18.44,T,,0,0,0,,И услышали крики.
Dialogue: 0,0:00:18.46,0:00:20.00,N,,0,0,0,,7
Dialogue: 0,0:00:18.46,0:00:20.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:18.46,0:00:20.00,T,,0,0,0,,Тысячи голосов.
Dialogue: 0,0:00:20.02,0:00:22.29,N,,0,0,0,,8
Dialogue: 0,0:00:20.02,0:00:22.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:20.02,0:00:22.29,T,,0,0,0,,Из самой глубины.
Dialogue: 0,0:00:22.31,0:00:23.67,N,,0,0,0,,9
Dialogue: 0,0:00:22.31,0:00:23.67,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:22.31,0:00:23.67,T,,0,0,0,,Её заварили.
Dialogue: 0,0:00:23.69,0:00:25.06,N,,0,0,0,,10
Dialogue: 0,0:00:23.69,0:00:25.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:23.69,0:00:25.06,T,,0,0,0,,Наглухо.
Dialogue: 0,0:00:25.08,0:00:26.80,N,,0,0,0,,11
Dialogue: 0,0:00:25.08,0:00:26.80,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:25.08,0:00:26.80,T,,0,0,0,,Звучит как сказка.
Dialogue: 0,0:00:26.82,0:00:29.34,N,,0,0,0,,12
Dialogue: 0,0:00:26.82,0:00:29.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:26.82,0:00:29.34,T,,0,0,0,,Но скважина настоящая.
Dialogue: 0,0:00:29.36,0:00:33.21,N,,0,0,0,,13
Dialogue: 0,0:00:29.36,0:00:33.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:29.36,0:00:33.21,T,,0,0,0,,Почему самую глубокую дыру на планете бросили?
Dialogue: 0,0:00:33.23,0:00:34.73,N,,0,0,0,,14
Dialogue: 0,0:00:33.23,0:00:34.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:33.23,0:00:34.73,T,,0,0,0,,Приложи ухо…
