   "who": "narrator"
  },
  {
   "src": "D_TRICKa.mp3",
   "t0": 5.75,
   "t1": 6.37,
   "say": "Тишина.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "D_TRICKa.mp3",
   "t0": 6.82,
   "t1": 7.54,
   "say": "Пять секунд.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "D_TRICKa.mp3",
