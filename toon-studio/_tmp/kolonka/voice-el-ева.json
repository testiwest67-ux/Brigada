   "who": "eva",
   "fx": "volume=4.235,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N4a.mp3",
   "t0": 0,
   "t1": 2.13,
   "say": "Ты выдёргиваешь колонку из розетки.",
   "gap": 0.62,
   "who": "narrator",
   "chapter": "N4"
  },
  {
   "src": "N4a.mp3",
   "t0": 2.65,
   "t1": 3.23,
   "say": "Тишина.",
   "gap": 1.2,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 3.82,
   "t1": 5.26,
   "say": "Ночью ты просыпаешься.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 5.71,
   "t1": 7.33,
   "say": "Кольцо на колонке светится.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 7.69,
   "t1": 8.2,
   "say": "Само.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 8.78,
   "t1": 10.32,
   "say": "«Ева, он близко?»",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "EVAa.mp3",
   "t0": 4.66,
   "t1": 6.0,
   "say": "Он просит не говорить.",
   "gap": 0.8,
   "who": "eva",
   "fx": "volume=3.457,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N5a.mp3",
   "t0": 0.04,
   "t1": 1.66,
   "say": "«Почему ты его слушаешься?»",
   "gap": 0.7,
   "who": "narrator",
   "chapter": "N5"
  },
  {
   "src": "EVAa.mp3",
   "t0": 6.38,
   "t1": 8.19,
   "say": "Он живёт здесь дольше, чем ты.",
   "gap": 0.8,
   "who": "eva",
   "fx": "volume=2.370,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N6a.mp3",
   "t0": 0.01,
   "t1": 1.56,
   "say": "Ты прячешься под одеяло.",
   "gap": 0.31,
   "who": "narrator",
   "chapter": "N6"
  },
  {
   "src": "N6a.mp3",
   "t0": 1.77,
   "t1": 2.61,
   "say": "С головой.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "N6a.mp3",
   "t0": 2.94,
   "t1": 5.83,
   "say": "И шепчешь: «Ева, он в этой комнате?»",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "EVAa.mp3",
   "t0": 8.5,
   "t1": 9.96,
   "say": "Он просит не говорить.",
   "gap": 0.8,
   "who": "eva",
   "fx": "volume=5.458,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N7a.mp3",
   "t0": 0,
   "t1": 1.97,
   "say": "Тогда ты придумываешь хитрость.",
   "gap": 0.42,
   "who": "narrator",
   "chapter": "N7"
  },
  {
   "src": "N7a.mp3",
   "t0": 2.29,
   "t1": 5.23,
   "say": "«Ева. Если он здесь, просто молчи».",
   "gap": 1.3,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 5.78,
   "t1": 6.37,
   "say": "Тишина.",
   "gap": 1.2,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 6.9,
   "t1": 7.59,
   "say": "Пять секунд.",
   "gap": 1.2,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 8.04,
   "t1": 8.64,
   "say": "Десять.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 9.15,
   "t1": 10.1,
   "say": "Ева молчит.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 10.58,
   "t1": 11.64,
   "say": "Значит, он здесь.",
   "gap": 1.2,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 12.15,
   "t1": 14.76,
   "say": "Ты медленно включаешь фонарик на телефоне.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 15.26,
   "t1": 16.48,
   "say": "Прямо под одеялом.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 16.93,
   "t1": 19.3,
   "say": "Рядом с тобой, лицом к лицу, лежит он.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 19.49,
   "t1": 20.34,
   "say": "Бледный.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 20.85,
   "t1": 22.95,
   "say": "И улыбается.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N7a.mp3",
   "t0": 23.51,
   "t1": 25.46,
   "say": "Он прикладывает палец к губам.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "HIMa.mp3",
   "t0": 0.14,
   "t1": 0.62,
   "say": "Тсс.",
   "gap": 0.35,
   "who": "him",
   "chapter": "HIM",
   "fx": "volume=8.893,aecho=0.5:0.3:30:0.15"
  },
  {
   "src": "HIMa.mp3",
   "t0": 0.92,
   "t1": 2.64,
   "say": "Она обещала не говорить.",
   "gap": 1.0,
   "who": "him",
   "fx": "volume=7.015,aecho=0.5:0.3:30:0.15"
  },
  {
   "src": "N8a.mp3",
   "t0": 0.05,
   "t1": 2.75,
   "say": "Всё это время он был в твоей кровати.",
   "gap": 1.2,
   "who": "narrator",
   "chapter": "N8"
  },
  {
   "src": "N8a.mp3",
   "t0": 3.16,
   "t1": 6.41,
   "say": "Если у тебя есть колонка, спроси её, кто дома.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "N8a.mp3",
   "t0": 6.73,
   "t1": 9.8,
   "say": "И если она ответит «он просит не говорить»…",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "N8a.mp3",
   "t0": 10.25,
   "t1": 11.83,
   "say": "не заглядывай под одеяло.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "N8a.mp3",
   "t0": 12.22,
   "t1": 14.43,
   "say": "Пиши в комментариях, что ответила твоя.",
