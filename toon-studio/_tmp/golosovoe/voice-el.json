   "src": "N2a.mp3",
   "t0": 22.03,
   "t1": 23.12,
   "say": "его больше нет.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 23.57,
   "t1": 24.45,
   "say": "Ты не встаёшь.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 24.77,
   "t1": 26.21,
   "say": "Ты делаешь, как сказал…",
