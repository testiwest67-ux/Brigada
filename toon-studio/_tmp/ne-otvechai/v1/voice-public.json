     "t": 26.768
    },
    {
     "w": "глазок.",
     "t": 26.928
    }
   ]
  },
  {
   "i": 14,
   "text": "Она там. Бледная. Дрожит.",
   "start": 27.611,
   "end": 30.178,
   "who": "narrator",
   "words": [
