     "t": 5.88
    },
    {
     "w": "дверь…",
     "t": 6.06
    },
    {
     "w": "стучат.",
     "t": 6.7
    }
   ]
  },
  {
   "i": 4,
   "text": "Бабушка учила тебя одному правилу.",
   "start": 7.684,
   "end": 9.558,
   "who": "narrator",
   "words": [
    {
     "w": "Бабушка",
     "t": 7.684
    },
    {
     "w": "учила",
     "t": 8.064
    },
    {
     "w": "тебя",
     "t": 8.464
    },
    {
     "w": "одному",
     "t": 8.724
    },
    {
     "w": "правилу.",
     "t": 9.124
    }
   ]
  },
  {
   "i": 5,
   "text": "Если ночью кто-то постучал в твою дверь",
   "start": 9.808,
   "end": 12.678,
   "who": "narrator",
   "words": [
    {
     "w": "Если",
     "t": 9.828
    },
    {
     "w": "ночью",
     "t": 10.248
    },
    {
     "w": "кто-то",
     "t": 10.668
    },
    {
     "w": "постучал",
     "t": 11.108
    },
    {
     "w": "в",
     "t": 11.748
    },
    {
     "w": "твою",
     "t": 11.948
    },
    {
     "w": "дверь",
     "t": 12.388
    }
   ]
  },
  {
   "i": 6,
   "text": "и назвал тебя по имени…",
   "start": 12.798,
   "end": 14.131,
   "who": "narrator",
   "words": [
    {
     "w": "и",
     "t": 12.818
    },
    {
