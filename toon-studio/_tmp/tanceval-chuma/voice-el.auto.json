{
 "dir": "public/tanceval-chuma/el",
 "lead": 5.0,
 "tail": 14.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0,
   "t1": 2.5,
   "say": "Лето тысяча пятьсот восемнадцатого года.",
   "gap": 0.4,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 2.8,
   "t1": 4.12,
   "say": "Город Страсбург.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.63,
   "t1": 7.24,
   "say": "На рыночной площади стоит деревянный помост.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 7.63,
   "t1": 8.78,
   "say": "Вокруг толпа.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 9.21,
   "t1": 10.34,
   "say": "Играют барабаны.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 10.52,
   "t1": 12.25,
   "say": "Играют дудки и скрипки.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.61,
   "t1": 14.56,
   "say": "А на помосте танцуют люди.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.89,
   "t1": 16.15,
   "say": "Десятки людей.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 16.59,
   "t1": 18.62,
   "say": "Они танцуют уже не первый день.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 19.0,
   "t1": 20.15,
   "say": "Их лица серые.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 20.41,
   "t1": 21.73,
   "say": "Глаза пустые.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.15,
   "t1": 23.27,
   "say": "Ноги распухли.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.64,
   "t1": 27.43,
   "say": "Кровь просачивается в кожаные сапоги и деревянные башмаки.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 27.95,
   "t1": 29.4,
   "say": "Кто-то падает без сил.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 29.71,
   "t1": 30.61,
   "say": "Его поднимают.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 30.83,
   "t1": 32.13,
   "say": "И он снова танцует.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 32.7,
   "t1": 34.86,
   "say": "Никто из них не хочет танцевать.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.08,
   "t1": 37.22,
   "say": "Но никто не может остановиться.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.73,
   "t1": 41.3,
   "say": "А самое странное — музыкантов позвал сам город.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 41.83,
   "t1": 44.91,
   "say": "Власти решили, что так людей можно вылечить.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 45.52,
   "t1": 47.42,
   "say": "Это не сказка и не легенда.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 47.84,
   "t1": 53.51,
   "say": "О тех днях остались записи врачей, проповеди, хроники и решения городского совета.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 54.02,
   "t1": 56.87,
   "say": "Историки называют это танцевальной чумой.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 57.51,
   "t1": 61.31,
   "say": "Что заставило сотни людей плясать, пока не откажут ноги?",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 61.74,
   "t1": 63.09,
   "say": "Сколько из них погибло?",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 63.47,
   "t1": 70.0,
   "say": "И почему это случалось снова и снова, веками, почти всегда у одной и той же реки?",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 70.64,
   "t1": 72.12,
   "say": "Давай разберёмся по порядку.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 72.44,
   "t1": 73.08,
   "say": "По фактам.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 73.43,
   "t1": 75.69,
   "say": "А в конце — три главные версии.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 75.94,
   "t1": 78.74,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0.01,
   "t1": 4.35,
   "say": "Страсбург в начале шестнадцатого века — богатый вольный город.",
   "gap": 0.49,
   "who": "narrator",
   "chapter": "1. Город на краю"
  },
  {
   "src": "ch1.mp3",
   "t0": 4.74,
   "t1": 9.57,
   "say": "Каменный собор, узкие улицы, дома с тёмными деревянными балками.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 9.94,
   "t1": 12.44,
   "say": "Купцы, ремесленники, гильдии.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 12.89,
   "t1": 15.48,
   "say": "Через город течёт торговля по реке Рейн.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.99,
   "t1": 19.47,
   "say": "Но за стенами собора жизнь совсем не богатая.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 19.81,
   "t1": 22.71,
   "say": "Три года подряд перед этим летом — неурожай.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 23.1,
   "t1": 24.09,
   "say": "Хлеб дорожает.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 24.47,
   "t1": 26.03,
   "say": "Потом его просто нет.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 26.4,
   "t1": 29.16,
   "say": "Люди едят то, что раньше отдали бы скоту.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 29.57,
   "t1": 32.0,
   "say": "В деревнях вокруг умирают от голода.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 32.33,
   "t1": 33.67,
   "say": "Крестьяне бунтуют.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 34.05,
   "t1": 36.35,
   "say": "Приходит новая болезнь — сифилис.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 36.65,
   "t1": 38.02,
   "say": "От неё нет лекарства.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 38.42,
   "t1": 40.34,
   "say": "Ещё живы рассказы о чуме.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 40.58,
   "t1": 41.51,
   "say": "О наводнениях.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 41.72,
   "t1": 43.54,
   "say": "О страшной комете в небе.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 43.94,
   "t1": 48.74,
   "say": "А лето тысяча пятьсот восемнадцатого года выдаётся необычайно жарким.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 49.28,
   "t1": 51.76,
   "say": "Представь, как живёт обычный горожанин.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.21,
   "t1": 53.03,
   "say": "Ты голоден.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 53.25,
   "t1": 54.41,
   "say": "Ты боишься болезни.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 54.68,
   "t1": 59.56,
   "say": "Ты не знаешь, переживёт ли твоя семья зиму.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 59.97,
   "t1": 64.08,
   "say": "И ты твёрдо веришь в одно: всё это — наказание за грехи.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 64.3,
   "t1": 65.72,
   "say": "Небо гневается.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 66.11,
   "t1": 67.78,
   "say": "Святые гневаются.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 68.14,
   "t1": 69.37,
   "say": "Особенно один святой.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 69.83,
   "t1": 70.53,
   "say": "Святой Вит.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 70.89,
   "t1": 75.53,
   "say": "Люди верят: если святой Вит разгневается, он может наслать на человека проклятие.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 75.89,
   "t1": 77.34,
   "say": "Проклятие танца.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 77.77,
   "t1": 80.93,
   "say": "Человек начинает плясать — и не может остановиться.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 81.31,
   "t1": 84.85,
   "say": "Снять такое проклятие может только сам святой Вит.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 85.24,
   "t1": 86.33,
   "say": "Запомни эту веру.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 86.57,
   "t1": 88.41,
   "say": "Она ещё сыграет главную роль.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0,
   "t1": 3.46,
   "say": "Четырнадцатое июля тысяча пятьсот восемнадцатого года.",
   "gap": 0.5,
   "who": "narrator",
   "chapter": "2. Первая"
  },
  {
   "src": "ch2.mp3",
   "t0": 3.86,
   "t1": 5.67,
   "say": "Узкая мощёная улочка.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 5.96,
   "t1": 7.57,
   "say": "Дом с деревянными балками.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 8.03,
   "t1": 9.64,
   "say": "Из дома выходит женщина.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 9.99,
   "t1": 12.69,
   "say": "В хрониках её называют фрау Троффеа.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 13.01,
   "t1": 15.82,
   "say": "Правда, в письме совета, написанном в тот самый год, имени нет.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 15.97,
   "t1": 16.69,
   "say": "Просто женщина.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 17.02,
   "t1": 18.32,
   "say": "Она выходит на улицу.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 18.91,
   "t1": 20.25,
   "say": "И начинает танцевать.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 20.69,
   "t1": 22.23,
   "say": "Музыки нет.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 22.63,
   "t1": 23.48,
   "say": "Праздника нет.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 23.82,
   "t1": 24.91,
   "say": "Никто не просил.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 25.13,
   "t1": 26.31,
   "say": "Она просто танцует.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 26.58,
   "t1": 26.89,
   "say": "Час.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 27.01,
   "t1": 28.06,
   "say": "Другой.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 28.49,
   "t1": 29.02,
   "say": "До вечера.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 29.27,
   "t1": 30.99,
   "say": "Соседи выглядывают из окон.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 31.29,
   "t1": 32.97,
   "say": "Кто-то смеётся.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 33.15,
   "t1": 35.35,
   "say": "Кто-то крестится.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 35.61,
   "t1": 37.96,
   "say": "Её муж умоляет её остановиться.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 38.07,
   "t1": 39.02,
   "say": "Зовёт домой.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 39.09,
   "t1": 40.22,
   "say": "Держит за руки.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 40.54,
   "t1": 41.45,
   "say": "Она не слышит.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.87,
   "t1": 43.81,
   "say": "К ночи она падает без сил.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 44.04,
   "t1": 45.41,
   "say": "Засыпает прямо там.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 45.78,
   "t1": 48.6,
   "say": "А утром встаёт — и снова танцует.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 48.9,
   "t1": 50.1,
   "say": "И на следующий день.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 50.24,
   "t1": 51.51,
   "say": "И ещё через день.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 51.78,
   "t1": 57.73,
   "say": "Хроники расходятся: кто-то пишет о четырёх днях, кто-то о шести, кто-то о целой неделе.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 58.09,
   "t1": 59.6,
   "say": "Ноги у неё опухают.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 59.86,
   "t1": 60.94,
   "say": "Обувь в крови.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 61.16,
   "t1": 62.31,
   "say": "Она почти не ест.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 62.65,
   "t1": 64.08,
   "say": "Сам муж не заразился.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 64.25,
   "t1": 66.99,
   "say": "Он видел всё вблизи — и не пустился в пляс.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 67.39,
   "t1": 71.45,
   "say": "Через несколько лет этот случай опишет знаменитый врач Парацельс.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 71.65,
   "t1": 75.13,
   "say": "У него будет своё, очень неприятное объяснение.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 75.45,
   "t1": 76.88,
   "say": "Мы вернёмся к нему в конце.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 77.25,
   "t1": 79.71,
   "say": "А пока город не знает, что делать.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 79.95,
   "t1": 82.34,
   "say": "И фрау Троффеа сажают на телегу.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 82.65,
   "t1": 86.4,
   "say": "Везут почти за пятьдесят километров, в городок Саверн.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 86.75,
   "t1": 89.64,
   "say": "Там, в горах, есть святыня святого Вита.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 89.96,
   "t1": 93.3,
   "say": "Если это его проклятие — пусть он его и снимает.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 93.8,
   "t1": 95.07,
   "say": "Телега уезжает.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 95.47,
   "t1": 96.79,
   "say": "Город выдыхает.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 97.36,
   "t1": 98.6,
   "say": "Но уже поздно.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0.05,
   "t1": 3.73,
   "say": "Пока фрау Троффеа танцевала на улице, на неё смотрели.",
   "gap": 0.56,
   "who": "narrator",
   "chapter": "3. Зараза"
  },
  {
   "src": "ch3.mp3",
   "t0": 4.19,
   "t1": 5.06,
   "say": "Каждый день.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 5.37,
   "t1": 7.79,
   "say": "Соседи, прохожие, дети.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 8.25,
   "t1": 10.5,
   "say": "И кто-то из них начал танцевать рядом.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 10.97,
   "t1": 15.39,
   "say": "Через несколько дней в Страсбурге танцуют уже больше тридцати человек.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 15.69,
   "t1": 17.17,
   "say": "Мужчины и женщины.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 17.3,
   "t1": 18.73,
   "say": "Молодые и старые.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 19.06,
   "t1": 20.42,
   "say": "Они не знают друг друга.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 20.65,
   "t1": 21.84,
   "say": "Они не сговаривались.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 22.1,
   "t1": 25.15,
   "say": "Они просто начинают — и не могут перестать.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 25.75,
   "t1": 31.28,
   "say": "Одна семейная хроника тех лет пишет: через месяц танцевали четыреста человек.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 31.75,
   "t1": 35.95,
   "say": "Другие историки осторожнее: от пятидесяти до четырёхсот.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 36.32,
   "t1": 37.7,
   "say": "Точно не знает никто.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 38.1,
   "t1": 40.25,
   "say": "Но даже пятьдесят — это много.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 40.66,
   "t1": 46.39,
   "say": "Представь: в городе посреди жары и голода по улицам кружатся десятки людей.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 46.64,
   "t1": 47.96,
   "say": "Днём и ночью.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 48.15,
   "t1": 49.43,
   "say": "С пустыми глазами.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 49.87,
   "t1": 52.65,
   "say": "Они падают, встают и танцуют снова.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 53.06,
   "t1": 56.04,
   "say": "И каждый, кто на это смотрит, думает одно и то же.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 56.59,
   "t1": 58.14,
   "say": "А вдруг я следующий?",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 58.57,
   "t1": 61.03,
   "say": "А вдруг святой Вит гневается и на меня?",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 61.59,
   "t1": 62.85,
   "say": "Город в панике.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 63.14,
   "t1": 65.15,
   "say": "И власти решают действовать.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0,
   "t1": 2.04,
   "say": "Городской совет собирает врачей.",
   "gap": 0.57,
   "who": "narrator",
   "chapter": "4. Лекарство хуже болезни"
  },
  {
   "src": "ch4.mp3",
   "t0": 2.51,
   "t1": 7.83,
   "say": "В те времена считали, что в теле человека четыре жидкости.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 8.05,
   "t1": 10.35,
   "say": "Кровь, слизь, жёлтая желчь и чёрная желчь.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 10.86,
   "t1": 14.04,
   "say": "Если их равновесие нарушено, человек болеет.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 14.52,
   "t1": 18.76,
   "say": "Врачи выносят решение: это не колдовство и не порча.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 18.97,
   "t1": 20.83,
   "say": "Это естественная болезнь.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 20.99,
   "t1": 22.18,
   "say": "От перегретой крови.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 22.7,
   "t1": 25.73,
   "say": "Обычно перегретую кровь лечили кровопусканием.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 26.01,
   "t1": 28.34,
   "say": "Но здесь врачи советуют другое.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 28.8,
   "t1": 33.52,
   "say": "Раз кровь перегрета танцем — пусть люди вытанцуют болезнь до конца.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.8,
   "t1": 36.57,
   "say": "Пусть танцуют, пока жар не выйдет сам.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 37.05,
   "t1": 38.66,
   "say": "И совет соглашается.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 39.0,
   "t1": 42.99,
   "say": "Гильдии плотников и кожевников отдают свои залы под танцы.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 43.38,
   "t1": 47.6,
   "say": "На конном рынке и на зерновом рынке строят деревянные помосты.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 47.7,
   "t1": 49.83,
   "say": "Чтобы танцующие не падали на камни.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 50.01,
   "t1": 51.02,
   "say": "Чтобы было где.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 51.54,
   "t1": 54.51,
   "say": "По некоторым записям, совет идёт ещё дальше.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 54.76,
   "t1": 56.11,
   "say": "Нанимает музыкантов.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 56.46,
   "t1": 59.28,
   "say": "Барабаны, скрипки, дудки, рожки.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 59.6,
   "t1": 65.95,
   "say": "Зовёт здоровых, сильных людей — танцевать рядом с больными и поддерживать их, чтобы те не падали.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 66.44,
   "t1": 68.91,
   "say": "Историки спорят, насколько это точно.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 69.14,
   "t1": 72.6,
   "say": "Но если так и было — это была ужасная ошибка.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 72.97,
   "t1": 75.96,
   "say": "Потому что на площади теперь целое представление.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 76.25,
   "t1": 78.33,
   "say": "Музыка гремит на весь город.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 78.61,
   "t1": 81.24,
   "say": "Толпа стоит и смотрит на танцующих.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 81.72,
   "t1": 84.32,
   "say": "И многие видят в этом не болезнь крови.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 84.6,
   "t1": 86.33,
   "say": "А гнев святого Вита.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 86.81,
   "t1": 89.01,
   "say": "А раз святой гневается на грешников…",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 89.47,
   "t1": 90.6,
   "say": "а безгрешных нет…",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 91.12,
   "t1": 94.11,
   "say": "Значит, проклятие может настичь любого.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 94.6,
   "t1": 98.63,
   "say": "И люди из толпы один за другим начинают танцевать сами.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 99.14,
   "t1": 100.4,
   "say": "Лекарство не лечит.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 100.82,
   "t1": 102.47,
   "say": "Оно разносит болезнь.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0,
   "t1": 4.06,
   "say": "Где-то в конце лета совет понимает: это не работает.",
   "gap": 0.59,
   "who": "narrator",
   "chapter": "5. Святой Вит"
  },
  {
   "src": "ch5.mp3",
   "t0": 4.55,
   "t1": 7.33,
   "say": "И разворачивается на сто восемьдесят градусов.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 7.76,
   "t1": 8.88,
   "say": "Помосты сносят.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 9.14,
   "t1": 13.1,
   "say": "В городе запрещают почти все танцы и почти всю музыку.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 13.54,
   "t1": 15.69,
   "say": "Сохранилась даже запись этого запрета.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 16.16,
   "t1": 21.61,
   "say": "Честным людям можно танцевать только на свадьбах и на первой службе нового священника.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 21.87,
   "t1": 24.08,
   "say": "И только под струнные инструменты.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 24.32,
   "t1": 25.45,
   "say": "Никаких бубнов.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 25.59,
   "t1": 26.99,
   "say": "Никаких барабанов.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 27.52,
   "t1": 31.36,
   "say": "А тех, кто танцует, отправляют туда же, куда и фрау Троффеа.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 31.6,
   "t1": 32.68,
   "say": "К святому Виту.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 33.18,
   "t1": 35.07,
   "say": "Их везут в горы, к часовне.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 35.44,
   "t1": 38.69,
   "say": "Самых тяжёлых — на телегах, несколько дней пути.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 39.16,
   "t1": 41.29,
   "say": "Там с ними проводят странный обряд.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.72,
   "t1": 43.72,
   "say": "Каждому дают красные башмаки.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 44.12,
   "t1": 46.26,
   "say": "Башмаки окропляют святой водой.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 46.65,
   "t1": 48.53,
   "say": "Святым маслом рисуют кресты.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 48.81,
   "t1": 49.39,
   "say": "Сверху.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 49.62,
   "t1": 50.45,
   "say": "И на подошвах.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 50.88,
   "t1": 52.74,
   "say": "В руки дают маленькие кресты.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 53.19,
   "t1": 54.12,
   "say": "Курится ладан.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 54.44,
   "t1": 56.71,
   "say": "Священник читает молитвы на латыни.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 57.2,
   "t1": 60.57,
   "say": "Танцующих водят вокруг деревянной фигуры святого Вита.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 61.14,
   "t1": 63.04,
   "say": "И знаешь, что происходит дальше?",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 63.62,
   "t1": 64.6,
   "say": "Это помогает.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 65.15,
   "t1": 69.06,
   "say": "Через неделю поток танцующих превращается в тонкий ручеёк.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 69.48,
   "t1": 70.67,
   "say": "Потом иссякает.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 71.28,
   "t1": 74.57,
   "say": "По городу идёт слух: их простил святой Вит.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 75.16,
   "t1": 78.42,
   "say": "К сентябрю танцевальная чума в Страсбурге заканчивается.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 78.73,
   "t1": 80.57,
   "say": "Так же внезапно, как началась.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 81.06,
   "t1": 83.03,
   "say": "Но это не конец истории.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 83.36,
   "t1": 85.71,
   "say": "Потому что Страсбург был не первым.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0.01,
   "t1": 2.91,
   "say": "Танцевальная чума появлялась в Европе и раньше.",
   "gap": 0.35,
   "who": "narrator",
   "chapter": "6. Это уже было"
  },
  {
   "src": "ch6.mp3",
   "t0": 3.16,
   "t1": 3.97,
   "say": "Много раз.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 4.4,
   "t1": 5.41,
   "say": "Одиннадцатый век.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 5.55,
   "t1": 6.33,
   "say": "Саксония.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 6.48,
   "t1": 7.76,
   "say": "Деревня Кёльбиг.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 8.11,
   "t1": 13.43,
   "say": "В ночь перед Рождеством восемнадцать крестьян пляшут возле церкви и мешают службе.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 13.97,
   "t1": 15.85,
   "say": "Тысяча двести тридцать седьмой год.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 16.06,
   "t1": 16.78,
   "say": "Германия.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 17.12,
   "t1": 20.55,
   "say": "Толпа детей идёт из города Эрфурт в соседний Арнштадт.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 20.79,
   "t1": 21.85,
   "say": "Двадцать километров.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 22.26,
   "t1": 24.85,
   "say": "Они прыгают и танцуют всю дорогу.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 25.23,
   "t1": 33.32,
   "say": "Некоторые историки думают, что отсюда выросла легенда о Гамельнском крысолове — дудочнике, который увёл детей из города.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 33.83,
   "t1": 35.87,
   "say": "Тысяча двести семьдесят восьмой год.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 36.27,
   "t1": 39.81,
   "say": "Около двухсот человек танцуют на мосту через реку Маас.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 40.13,
   "t1": 41.58,
   "say": "Мост не выдерживает.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 41.81,
   "t1": 42.54,
   "say": "И рушится.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 42.94,
   "t1": 46.01,
   "say": "Тех, кто выжил, отвозят к часовне святого Вита.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 46.52,
   "t1": 48.77,
   "say": "Тысяча триста семьдесят четвёртый год.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 49.05,
   "t1": 50.68,
   "say": "Двадцать четвёртое июня.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 50.84,
   "t1": 51.86,
   "say": "Город Ахен.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 52.18,
   "t1": 55.48,
   "say": "Отсюда начинается огромная волна.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 55.6,
   "t1": 57.53,
   "say": "Кёльн, Фландрия, Мец, Утрехт.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 57.73,
   "t1": 58.61,
   "say": "И Страсбург.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 58.93,
   "t1": 61.34,
   "say": "Люди танцуют на улицах и в церквях.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 61.5,
   "t1": 62.26,
   "say": "Сотнями.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 62.78,
   "t1": 65.79,
   "say": "Тысяча четыреста восемнадцатый — снова Страсбург.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 66.21,
   "t1": 67.99,
   "say": "Тысяча четыреста двадцать восьмой.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 68.18,
   "t1": 68.96,
   "say": "Швейцария.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 69.17,
   "t1": 71.17,
   "say": "Монах танцует до смерти.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 71.69,
   "t1": 77.59,
   "say": "В одной немецкой деревне была женщина, которая каждый год приходила танцевать к часовне святого Вита.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 77.85,
   "t1": 79.22,
   "say": "Двадцать лет подряд.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 79.53,
   "t1": 81.54,
   "say": "А другая — тридцать два года.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 82.11,
   "t1": 83.54,
   "say": "А теперь возьми карту.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 83.84,
   "t1": 85.8,
   "say": "Отметь на ней все эти вспышки.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 86.1,
   "t1": 88.68,
   "say": "Почти все они окажутся вдоль двух рек.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 88.89,
   "t1": 90.21,
   "say": "Рейна и Мозеля.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 90.54,
   "t1": 94.43,
   "say": "Именно там, где сильнее всего верили в проклятие святого Вита.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 94.84,
   "t1": 100.35,
   "say": "Историки насчитали больше десяти таких эпидемий после тысяча триста семьдесят четвёртого года.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 100.64,
   "t1": 103.5,
   "say": "И страсбургская — самая известная из них.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 103.77,
   "t1": 105.4,
   "say": "И лучше всех описанная.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0,
   "t1": 4.81,
   "say": "Если ты читал про танцевальную чуму, ты, скорее всего, видел страшную цифру.",
   "gap": 0.52,
   "who": "narrator",
   "chapter": "7. Сколько умерло?"
  },
  {
   "src": "ch7.mp3",
   "t0": 5.23,
   "t1": 8.68,
   "say": "На пике умирало до пятнадцати человек в день.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 9.12,
   "t1": 10.38,
   "say": "От разрыва сердца.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 10.51,
   "t1": 11.46,
   "say": "От инсульта.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 11.63,
   "t1": 12.64,
   "say": "От истощения.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 13.07,
   "t1": 15.73,
   "say": "А всего — может быть, сотни погибших.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 16.35,
   "t1": 19.51,
   "say": "Эту цифру повторяют почти все статьи и ролики.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 19.74,
   "t1": 22.6,
   "say": "Она идёт в основном от историка Джона Уоллера.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 22.9,
   "t1": 25.59,
   "say": "Он написал о танцевальной чуме целую книгу.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 25.9,
   "t1": 27.79,
   "say": "Но здесь есть проблема.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 28.14,
   "t1": 31.94,
   "say": "Все источники о смертях, на которые он опирается, — поздние.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 32.27,
   "t1": 36.52,
   "say": "Например, хроника, написанная через сто восемнадцать лет после событий.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 36.93,
   "t1": 40.01,
   "say": "А документы самого тысяча пятьсот восемнадцатого года?",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 40.29,
   "t1": 43.42,
   "say": "Записи совета, письма, хроники очевидцев?",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 43.87,
   "t1": 45.53,
   "say": "О смертях они молчат.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 46.07,
   "t1": 49.82,
   "say": "Французский историк Элизабет Клеменц сверила эти записи.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 50.09,
   "t1": 54.87,
   "say": "И не нашла ни одного подтверждённого человека, который умер от танца.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 55.37,
   "t1": 61.15,
   "say": "В одном старом стихотворении о тех днях сказано просто: многие ничего не ели.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 61.47,
   "t1": 63.54,
   "say": "А потом болезнь их отпустила.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 64.11,
   "t1": 66.08,
   "say": "Значит ли это, что никто не умер?",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 66.51,
   "t1": 67.47,
   "say": "Не обязательно.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 67.8,
   "t1": 72.51,
   "say": "Люди неделями танцевали в жару, без еды, на распухших ногах.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 72.87,
   "t1": 77.05,
   "say": "Для голодного, ослабленного человека это могло кончиться плохо.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 77.47,
   "t1": 80.02,
   "say": "Но правда в том, что мы не знаем.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 80.36,
   "t1": 82.0,
   "say": "Может быть, погибли сотни.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 82.23,
   "t1": 83.88,
   "say": "А может быть, ни одного.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 84.28,
   "t1": 88.42,
   "say": "Самая известная деталь этой истории — и та под вопросом.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.05,
   "t1": 1.39,
   "say": "Так что же это было?",
   "gap": 0.67,
   "who": "narrator",
   "chapter": "8. Версии"
  },
  {
   "src": "ch8.mp3",
   "t0": 1.96,
   "t1": 3.05,
   "say": "Версия первая.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 3.33,
   "t1": 4.15,
   "say": "Отравление.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 4.44,
   "t1": 7.84,
   "say": "Во влажные годы на колосьях ржи вырастает грибок.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 8.01,
   "t1": 8.75,
   "say": "Спорынья.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 8.99,
   "t1": 11.85,
   "say": "В ней есть вещество, похожее на ЛСД.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 12.1,
   "t1": 17.45,
   "say": "Человек, съевший заражённый хлеб, может видеть видения, биться в судорогах, бредить.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 17.7,
   "t1": 20.03,
   "say": "В голодные годы ели всё, что было.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 20.37,
   "t1": 21.47,
   "say": "Звучит логично.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.72,
   "t1": 24.01,
   "say": "Но у этой версии большая дыра.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 24.26,
   "t1": 26.13,
   "say": "Спорынья сжимает сосуды.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 26.34,
   "t1": 28.55,
   "say": "Руки и ноги немеют, холодеют.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 28.73,
   "t1": 30.17,
   "say": "Может начаться гангрена.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 30.41,
   "t1": 33.42,
   "say": "С таким отравлением не потанцуешь несколько дней подряд.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 33.65,
   "t1": 36.96,
   "say": "И никто не описывал у танцующих почерневших пальцев.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 37.3,
   "t1": 40.1,
   "say": "А главное — рожь ели по всей Европе.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 40.28,
   "t1": 42.87,
   "say": "Почему же танцевали почти только вдоль Рейна?",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 43.68,
   "t1": 44.73,
   "say": "Версия вторая.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 44.92,
   "t1": 46.25,
   "say": "Массовый психоз.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 46.5,
   "t1": 48.92,
   "say": "Её защищает тот самый Джон Уоллер.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 49.06,
   "t1": 50.59,
   "say": "И сегодня она главная.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 50.89,
   "t1": 52.08,
   "say": "Смотри, как это работает.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 52.44,
   "t1": 55.78,
   "say": "Люди годами живут в голоде, страхе и болезнях.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 56.09,
   "t1": 57.24,
   "say": "Нервы на пределе.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 57.46,
   "t1": 62.44,
   "say": "И все вокруг твёрдо верят: святой Вит может наслать проклятие танца.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 62.73,
   "t1": 64.38,
   "say": "Женщина начинает танцевать.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 64.6,
   "t1": 66.65,
   "say": "Все видят: проклятие пришло.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 66.91,
   "t1": 70.47,
   "say": "И следующий, кто сильнее всех боится, впадает в транс.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 70.66,
   "t1": 73.56,
   "say": "Тело делает то, чего он боится больше всего.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 73.81,
   "t1": 74.54,
   "say": "Танцевать.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 74.81,
   "t1": 77.63,
   "say": "Так вера и страх запускают друг друга.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 77.8,
   "t1": 80.57,
   "say": "А помосты и барабаны подливают масла в огонь.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 80.81,
   "t1": 84.41,
   "say": "Поэтому танцевали именно там, где верили в святого Вита.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 84.61,
   "t1": 87.62,
   "say": "И поэтому помогли красные башмаки и часовня.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 87.86,
   "t1": 91.36,
   "say": "Если веришь, что святой простил, — проклятие снято.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 91.65,
   "t1": 93.63,
   "say": "Ты можешь сказать: так не бывает.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 93.92,
   "t1": 95.87,
   "say": "Но так бывает и сегодня.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 96.21,
   "t1": 104.6,
   "say": "В тысяча девятьсот шестьдесят третьем году в Африке, в Танганьике, в школе для девочек несколько учениц начали смеяться и не могли остановиться.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 104.81,
   "t1": 106.49,
   "say": "Смех перекинулся на других.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 106.74,
   "t1": 108.44,
   "say": "Потом на соседние деревни.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 108.65,
   "t1": 109.78,
   "say": "Школы закрыли.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 109.92,
   "t1": 111.45,
   "say": "Заболели сотни людей.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 111.69,
   "t1": 113.51,
   "say": "Никакого вируса не нашли.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 114.33,
   "t1": 115.41,
   "say": "Версия третья.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 115.69,
   "t1": 117.32,
   "say": "Это вообще была не болезнь.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 117.6,
   "t1": 121.59,
   "say": "Некоторые учёные думают, что часть танцующих — это религиозный обряд.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 121.87,
   "t1": 122.72,
   "say": "Паломничество.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 122.91,
   "t1": 124.21,
   "say": "Может быть, даже секта.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 124.48,
   "t1": 129.05,
   "say": "Люди танцевали не потому, что не могли остановиться, а потому, что так молились.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 129.23,
   "t1": 132.28,
   "say": "А испуганные писцы записали это как эпидемию.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 132.86,
   "t1": 135.62,
   "say": "И есть ещё мнение того самого Парацельса.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 135.87,
   "t1": 141.19,
   "say": "Он приехал в Страсбург через восемь лет и решил: фрау Троффеа просто притворялась.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 141.37,
   "t1": 144.09,
   "say": "Танцевала назло мужу, чтобы опозорить его.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 144.29,
   "t1": 147.74,
   "say": "А остальные жёны начали танцевать — назло своим мужьям.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 148.03,
   "t1": 151.0,
   "say": "Сегодня это объяснение не принимает почти никто.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 151.21,
   "t1": 156.0,
   "say": "Но оно хорошо показывает, как мало люди того времени понимали, что происходит.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 0.05,
   "t1": 2.05,
   "say": "Пятьсот лет прошло с того лета.",
   "gap": 0.47,
   "who": "narrator",
   "chapter": "9. Финал"
  },
  {
   "src": "ch9.mp3",
   "t0": 2.42,
   "t1": 3.53,
   "say": "Мы знаем дату.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 3.67,
   "t1": 4.66,
   "say": "Знаем город.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 4.89,
   "t1": 7.08,
   "say": "Знаем даже, что запретили барабаны.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 7.54,
   "t1": 9.51,
   "say": "Но так и не знаем главного.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 10.1,
   "t1": 11.55,
   "say": "Итак, три версии.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 12.0,
   "t1": 14.01,
   "say": "А — отравление спорыньёй.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 14.29,
   "t1": 17.71,
   "say": "Люди сходили с ума от грибка в хлебе.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 18.01,
   "t1": 19.32,
   "say": "Б — массовый психоз.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 19.51,
   "t1": 22.9,
   "say": "Голод, страх и вера в проклятие святого Вита.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 23.53,
   "t1": 25.07,
   "say": "В — не болезнь, а ритуал.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 25.21,
   "t1": 29.65,
   "say": "Люди танцевали нарочно, а хроники всё приукрасили.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 30.27,
   "t1": 31.23,
   "say": "А ты как думаешь?",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 31.47,
   "t1": 32.94,
   "say": "Напиши букву в комментариях.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 33.3,
   "t1": 36.04,
   "say": "И напиши, какую загадку разобрать следующей.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 36.35,
   "t1": 38.43,
   "say": "А если тебе понравилось — подпишись.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 38.79,
   "t1": 40.95,
   "say": "Впереди ещё много неразгаданного.",
   "gap": 8.0,
   "who": "narrator"
  }
 ]
}