 "lines": [
  {
   "i": 0,
   "text": "Летом тысяча пятьсот восемнадцатого года.",
   "start": 0.0,
   "end": 2.903,
   "who": "narrator",
   "words": [
    {
     "w": "Летом",
     "t": 0.18
    },
    {
     "w": "тысяча",
     "t": 0.52
    },
    {
     "w": "пятьсот",
     "t": 1.04
    },
    {
     "w": "восемнадцатого",
     "t": 1.38
    },
    {
     "w": "года.",
     "t": 2.42
    }
   ]
  },
  {
   "i": 1,
   "text": "Город Страсбург.",
   "start": 3.403,
   "end": 4.748,
   "who": "narrator",
   "words": [
    {
     "w": "Город",
     "t": 3.443
    },
    {
     "w": "Страсбург.",
     "t": 3.983
    }
   ]
  },
  {
   "i": 2,
   "text": "А на помосте танцуют люди.",
   "start": 5.198,
   "end": 7.164,
   "who": "narrator",
   "words": [
    {
     "w": "А",
     "t": 5.218
    },
    {
     "w": "на",
     "t": 5.358
    },
    {
     "w": "помосте",
     "t": 5.538
    },
    {
     "w": "танцуют",
     "t": 6.258
    },
    {
     "w": "люди.",
     "t": 6.738
    }
   ]
  },
  {
   "i": 3,
   "text": "Их лица серые.",
   "start": 7.614,
   "end": 8.822,
   "who": "narrator",
   "words": [
    {
     "w": "Их",
     "t": 7.634
    },
    {
