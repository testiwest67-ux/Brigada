   "who": "narrator"
  },
  {
   "src": "N4a.mp3",
   "t0": 7.69,
   "t1": 8.2,
   "say": "Само.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "D_ASKa.mp3",
   "t0": 3.75,
   "t1": 5.07,
   "say": "«Диана, он близко?»",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "EVAa.mp3",
   "t0": 4.66,
   "t1": 6.0,
   "say": "Он просит не говорить.",
   "gap": 0.8,
   "who": "eva",
   "fx": "volume=3.514,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N5a.mp3",
   "t0": 0.04,
   "t1": 1.66,
   "say": "«Почему ты его слушаешься?»",
   "gap": 0.7,
   "who": "narrator",
   "chapter": "N5"
  },
  {
   "src": "EVAa.mp3",
   "t0": 6.38,
   "t1": 8.19,
   "say": "Он живёт здесь дольше, чем ты.",
