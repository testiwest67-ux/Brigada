   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 3.26,
   "t1": 4.94,
   "say": "Твоя манера тянуть слова.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 5.44,
   "t1": 6.01,
   "say": "Шутка?",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 6.33,
   "t1": 7.52,
   "say": "Кто-то взломал телефон?",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 7.89,
   "t1": 9.62,
   "say": "И тут из-под кровати…",
