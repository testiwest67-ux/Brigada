     "w": "может",
     "t": 16.222
    },
    {
     "w": "остановиться.",
     "t": 16.602
    }
   ]
  },
  {
   "i": 8,
   "text": "А самое странное — музыкантов позвал сам город.",
   "start": 18.117,
   "end": 21.953,
   "who": "narrator",
   "words": [
    {
