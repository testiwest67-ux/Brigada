    {
     "w": "и",
     "t": 19.158
    },
    {
     "w": "один.",
     "t": 19.258
    }
   ]
  },
  {
   "i": 10,
   "text": "«Тёма, открой. Я ключи забыла».",
   "start": 19.917,
   "end": 23.495,
   "who": "mom",
   "words": [
    {
     "w": "«Тёма,",
     "t": 20.197
    },
    {
     "w": "открой.",
     "t": 20.257
    },
    {
     "w": "Я",
     "t": 21.137
    },
    {
     "w": "ключи",
     "t": 22.437
    },
    {
     "w": "забыла».",
     "t": 22.657
    }
   ]
  },
  {
   "i": 11,
   "text": "Это голос мамы.",
   "start": 23.845,
   "end": 24.875,
   "who": "narrator",
   "words": [
    {
     "w": "Это",
     "t": 23.925
    },
    {
     "w": "голос",
     "t": 24.205
    },
    {
     "w": "мамы.",
     "t": 24.505
    }
   ]
  },
  {
   "i": 12,
   "text": "Но ты молчишь.",
   "start": 25.055,
   "end": 25.957,
   "who": "narrator",
   "words": [
