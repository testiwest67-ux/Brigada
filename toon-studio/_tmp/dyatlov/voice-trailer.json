{
 "dir": "public/dyatlov/el",
 "lead": 0.15,
 "tail": 0.15,
 "tempo": 1,
 "lines": [
  {
   "src": "trailer-loop.mp3",
   "t0": 5.78,
   "t1": 9.51,
   "say": "Почему девять человек разрезали свою палатку изнутри?",
   "gap": 0.35,
   "who": "narrator",
   "chapter": "Трейлер"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 9.78,
   "t1": 11.95,
   "say": "И ушли в мороз почти раздетыми.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 7.03,
   "t1": 9.5,
   "say": "Февраль тысяча девятьсот пятьдесят девятого.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 9.68,
   "t1": 10.73,
   "say": "Северный Урал.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 11.1,
   "t1": 12.23,
   "say": "Опытные туристы.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 15.62,
   "t1": 17.06,
   "say": "Их вёл Игорь Дятлов.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 25.35,
   "t1": 28.91,
   "say": "К горе, которую местные манси называют Холатчахль.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 29.27,
   "t1": 32.55,
   "say": "Это название часто переводят как «Мёртвая вершина».",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 33.01,
   "t1": 36.75,
   "say": "Первого февраля они ставят палатку прямо на открытом склоне.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 37.07,
   "t1": 39.65,
   "say": "А через три недели её находят спасатели.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 40.06,
   "t1": 42.89,
   "say": "Палатка наполовину в снегу.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 43.06,
   "t1": 45.06,
   "say": "Внутри — одежда, обувь, еда.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 45.34,
   "t1": 46.23,
   "say": "Всё на месте.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 46.6,
   "t1": 47.71,
   "say": "Нет только людей.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 48.16,
   "t1": 51.15,
   "say": "Вниз по склону уходят следы девяти человек.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 51.45,
   "t1": 53.2,
   "say": "Многие — в одних носках.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 53.53,
   "t1": 56.27,
   "say": "А ночью там было около минус тридцати.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 56.54,
   "t1": 59.38,
   "say": "И ветер, от которого трудно устоять на ногах.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 59.89,
   "t1": 61.75,
   "say": "Первых нашли у старого кедра.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 63.41,
   "t1": 65.06,
   "say": "Рядом — остатки костра.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 65.49,
   "t1": 68.53,
   "say": "Последних — только в мае, когда растаял снег.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 68.88,
   "t1": 71.54,
   "say": "На некоторых вещах нашли следы радиации.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 71.99,
   "t1": 74.13,
   "say": "Дело закрыли через четыре месяца.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 74.43,
   "t1": 81.85,
   "say": "Причину назвали одной странной фразой: «Стихийная сила, преодолеть которую люди были не в состоянии».",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 0.25,
   "t1": 1.28,
   "say": "Что это за сила?",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 1.69,
   "t1": 5.47,
   "say": "Может быть, в полном видео на канале ты найдёшь ответ на вопрос…",
   "gap": 0,
   "who": "narrator"
  }
 ]
}