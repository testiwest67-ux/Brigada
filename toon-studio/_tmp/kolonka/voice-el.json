   "t0": 1.77,
   "t1": 2.61,
   "say": "С головой.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "D_ASKa.mp3",
   "t0": 5.49,
   "t1": 8.26,
   "say": "И шепчешь: «Диана, он в этой комнате?»",
