{
 "dir": "public/kolskaya/el",
 "lead": 5.0,
 "tail": 14.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0.01,
   "t1": 1.18,
   "say": "Север России.",
   "gap": 0.45,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 1.495,
   "t1": 2.67,
   "say": "Кольский полуостров.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 3.2,
   "t1": 4.57,
   "say": "Тундра, ветер и снег.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.63,
   "t1": 8.065,
   "say": "Среди камней стоят пустые здания.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 8.375,
   "t1": 9.325,
   "say": "Окна выбиты.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 9.585,
   "t1": 10.785,
   "say": "Крыша провалилась.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 10.905,
   "t1": 14.225,
   "say": "А посреди бетона — ржавая железная крышка.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.425,
   "t1": 15.655,
   "say": "Чуть больше тарелки.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 15.785,
   "t1": 16.775,
   "say": "Её заварили.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 17.08,
   "t1": 17.78,
   "say": "Наглухо.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.25,
   "t1": 23.63,
   "say": "Под этой крышкой — самая глубокая дыра, которую человек когда-либо сделал в Земле.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.98,
   "t1": 26.055,
   "say": "Двенадцать километров вниз.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 26.175,
   "t1": 28.565,
   "say": "Это глубже, чем Эверест высокий.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 28.565,
   "t1": 32.555,
   "say": "Про эту дыру по всему миру рассказывают страшную историю.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 32.825,
   "t1": 35.36,
   "say": "Будто учёные опустили туда микрофон.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.75,
   "t1": 37.105,
   "say": "И услышали крики.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.385,
   "t1": 38.555,
   "say": "Тысячи голосов.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 38.555,
   "t1": 40.145,
   "say": "Из самой глубины.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 40.385,
   "t1": 42.725,
   "say": "Будто после этого скважину закрыли.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 42.725,
   "t1": 43.705,
   "say": "И заварили.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 43.825,
   "t1": 45.945,
   "say": "Чтобы никто больше не слушал.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 46.185,
   "t1": 47.535,
   "say": "Звучит как сказка.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 47.775,
   "t1": 49.725,
   "say": "Но скважина настоящая.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.015,
   "t1": 52.075,
   "say": "Её бурили больше двадцати лет.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 52.295,
   "t1": 54.065,
   "say": "Там работали сотни людей.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 54.105,
   "t1": 58.445,
   "say": "И на глубине они действительно нашли то, чего не ждал никто.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 58.825,
   "t1": 60.545,
   "say": "Так что же там, под крышкой?",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 60.865,
   "t1": 63.94,
   "say": "Почему самую глубокую дыру на планете бросили?",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 64.24,
   "t1": 65.925,
   "say": "И откуда взялись крики?",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 66.265,
   "t1": 67.905,
   "say": "Давай разберёмся по порядку.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 68.055,
   "t1": 68.835,
   "say": "По фактам.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 68.985,
   "t1": 70.785,
   "say": "А в конце — три версии.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 70.905,
   "t1": 73.695,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0.04,
   "t1": 2.5,
   "say": "Пятидесятые и шестидесятые годы.",
   "gap": 0.37,
   "who": "narrator",
   "chapter": "1. Гонка в недра"
  },
  {
   "src": "ch1.mp3",
   "t0": 2.73,
   "t1": 4.135,
   "say": "Холодная война.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 4.495,
   "t1": 7.85,
   "say": "СССР и Америка соревнуются во всём.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 8.21,
   "t1": 9.985,
   "say": "Кто первым запустит спутник.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 10.225,
   "t1": 12.615,
   "say": "Кто первым отправит человека в космос.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 12.625,
   "t1": 14.715,
   "say": "Кто первым долетит до Луны.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.135,
   "t1": 18.085,
   "say": "Но есть место, куда не заглянул никто.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 18.415,
   "t1": 20.105,
   "say": "Оно у нас под ногами.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 20.385,
   "t1": 23.095,
   "say": "Мы видим звёзды за миллиарды километров.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 23.145,
   "t1": 26.965,
   "say": "А что под землёй глубже нескольких километров — не знаем.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 27.175,
   "t1": 28.405,
   "say": "Только догадываемся.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 28.405,
   "t1": 32.565,
   "say": "Учёные слушают, как по Земле бегут волны от землетрясений.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 32.565,
   "t1": 35.725,
   "say": "И рисуют картину: сверху гранит.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 35.825,
   "t1": 37.275,
   "say": "Под ним базальт.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 37.505,
   "t1": 39.425,
   "say": "Ещё глубже — мантия.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 39.865,
   "t1": 43.105,
   "say": "Проверить эту картину можно только одним способом.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 43.145,
   "t1": 44.175,
   "say": "Пробурить.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 44.535,
   "t1": 46.505,
   "say": "Американцы пробуют первыми.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 46.665,
   "t1": 48.885,
   "say": "Их проект бурит дно океана.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 49.095,
   "t1": 50.445,
   "say": "Но денег не хватает.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 50.505,
   "t1": 51.955,
   "say": "Проект закрывают.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.175,
   "t1": 56.145,
   "say": "А Советский Союз решает: мы пройдём глубже всех.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 56.145,
   "t1": 59.225,
   "say": "Место выбирают на Кольском полуострове.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 59.345,
   "t1": 62.525,
   "say": "Здесь древние камни выходят прямо к поверхности.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 62.815,
   "t1": 66.095,
   "say": "Возраст некоторых из них — почти три миллиарда лет.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 66.73,
   "t1": 72.31,
   "say": "Двадцать четвёртого мая тысяча девятьсот семидесятого года бур впервые входит в землю.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 72.64,
   "t1": 74.745,
   "say": "Сначала цель — семь километров.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 75.055,
   "t1": 77.035,
   "say": "Но очень скоро её поднимут.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 77.28,
   "t1": 78.29,
   "say": "До пятнадцати.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0.01,
   "t1": 1.95,
   "say": "Ближайший город — Заполярный.",
   "gap": 0.42,
   "who": "narrator",
   "chapter": "2. Город на краю"
  },
  {
   "src": "ch2.mp3",
   "t0": 2.105,
   "t1": 4.385,
   "say": "Двенадцать километров по тундре.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 4.545,
   "t1": 6.545,
   "say": "Зимой здесь полярная ночь.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 6.585,
   "t1": 8.545,
   "say": "Солнце не встаёт неделями.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 8.705,
   "t1": 10.365,
   "say": "Летом оно не садится.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 10.735,
   "t1": 12.885,
   "say": "На буровой работают круглые сутки.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 12.905,
   "t1": 14.215,
   "say": "Смена за сменой.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 14.465,
   "t1": 17.575,
   "say": "В лучшие годы здесь трудятся около пятисот человек.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 17.795,
   "t1": 20.935,
   "say": "Буровики, геологи, химики, инженеры.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 21.255,
   "t1": 24.385,
   "say": "Руководит экспедицией геолог Давид Губерман.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 24.385,
   "t1": 27.675,
   "say": "Над скважиной вырастает высокая буровая башня.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 27.675,
   "t1": 32.785,
   "say": "В тысяча девятьсот семьдесят четвёртом сюда привозят новую буровую установку.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 32.945,
   "t1": 35.885,
   "say": "Её называют «Уралмаш-пятнадцать тысяч».",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 36.015,
   "t1": 39.175,
   "say": "По новой цели — пятнадцать тысяч метров.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 39.505,
   "t1": 41.215,
   "say": "Представь, как это работает.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.565,
   "t1": 43.715,
   "say": "Вниз уходит колонна из труб.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 44.025,
   "t1": 46.125,
   "say": "Трубы свинчивают одну за другой.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 46.425,
   "t1": 48.655,
   "say": "А на самом дне крутится долото.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 48.935,
   "t1": 50.535,
   "say": "Оно грызёт камень.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 50.545,
   "t1": 53.695,
   "say": "Ширина ствола — около двадцати трёх сантиметров.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 53.945,
   "t1": 56.53,
   "say": "Чуть шире твоей ладони с растопыренными пальцами.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 56.93,
   "t1": 60.795,
   "say": "И вот такой узкий ход уходит на километры вниз.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 61.185,
   "t1": 64.935,
   "say": "Каждый раз, когда долото стирается, всю колонну поднимают.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 65.105,
   "t1": 67.095,
   "say": "Разбирают трубу за трубой.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 67.105,
   "t1": 68.24,
   "say": "Меняют долото.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 68.54,
   "t1": 69.745,
   "say": "И опускают снова.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 70.095,
   "t1": 74.995,
   "say": "На глубине в десять километров один такой подъём занимает многие часы.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 75.375,
   "t1": 78.245,
   "say": "А вместе с породой наверх достают керн.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 78.415,
   "t1": 80.545,
   "say": "Это столбик камня из глубины.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 80.675,
   "t1": 83.39,
   "say": "Его режут, изучают, подписывают.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 83.87,
   "t1": 88.205,
   "say": "Каждый метр — как страница книги, которую раньше не читал никто.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0.0,
   "t1": 3.41,
   "say": "Шестого июня тысяча девятьсот семьдесят девятого года.",
   "gap": 0.55,
   "who": "narrator",
   "chapter": "3. Рекорд"
  },
  {
   "src": "ch3.mp3",
   "t0": 3.825,
   "t1": 8.055,
   "say": "Кольская скважина проходит девять тысяч пятьсот восемьдесят три метра.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 8.41,
   "t1": 13.46,
   "say": "До этого дня самой глубокой в мире была скважина в Америке, в штате Оклахома.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 13.785,
   "t1": 16.285,
   "say": "Теперь рекорд у Советского Союза.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 16.465,
   "t1": 18.045,
   "say": "Но бур идёт дальше.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 18.09,
   "t1": 24.63,
   "say": "В тысяча девятьсот восемьдесят третьем году скважина проходит двенадцать километров.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 24.68,
   "t1": 26.385,
   "say": "Двенадцать тысяч метров вниз.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 26.655,
   "t1": 29.175,
   "say": "Это больше, чем глубина Марианской впадины.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 29.175,
   "t1": 32.025,
   "say": "Бурение останавливают почти на год.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 32.105,
   "t1": 37.985,
   "say": "В тысяча девятьсот восемьдесят четвёртом в Москве собирается Международный геологический конгресс.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 38.1,
   "t1": 39.785,
   "say": "Учёные со всего мира.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 40.095,
   "t1": 42.905,
   "say": "И Советский Союз показывает им Кольскую.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 42.995,
   "t1": 45.065,
   "say": "Керны, цифры, графики.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 45.335,
   "t1": 47.775,
   "say": "Иностранцы приезжают прямо на буровую.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 48.025,
   "t1": 50.415,
   "say": "Для геологов это как первый спутник.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 50.585,
   "t1": 54.835,
   "say": "Кажется, ещё немного — и пятнадцать километров будут взяты.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 54.865,
   "t1": 58.055,
   "say": "Но после конгресса бурение начинают снова.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 58.055,
   "t1": 61.495,
   "say": "И случается то, чего боится каждый буровик.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0.0,
   "t1": 4.14,
   "say": "Двадцать седьмое сентября тысяча девятьсот восемьдесят четвёртого года.",
   "gap": 0.39,
   "who": "narrator",
   "chapter": "4. Обрыв"
  },
  {
   "src": "ch4.mp3",
   "t0": 4.405,
   "t1": 7.685,
   "say": "Глубина — двенадцать тысяч шестьдесят шесть метров.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 8.25,
   "t1": 10.145,
   "say": "Колонну поднимают наверх.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 10.375,
   "t1": 12.555,
   "say": "И вдруг она становится лёгкой.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 12.865,
   "t1": 14.225,
   "say": "Слишком лёгкой.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 14.465,
   "t1": 15.945,
   "say": "Труба оборвалась.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 15.945,
   "t1": 18.725,
   "say": "Где-то в глубине осталась часть колонны.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 19.05,
   "t1": 21.07,
   "say": "Около пяти километров труб.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 21.49,
   "t1": 23.305,
   "say": "Пять километров железа.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 23.345,
   "t1": 25.21,
   "say": "В дыре шириной с тарелку.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 25.52,
   "t1": 27.285,
   "say": "Достать их невозможно.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 27.535,
   "t1": 29.38,
   "say": "Годы работы — на дне.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 29.85,
   "t1": 31.645,
   "say": "Есть только один выход.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 31.905,
   "t1": 33.035,
   "say": "Бурить заново.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.145,
   "t1": 33.905,
   "say": "В обход.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 34.215,
   "t1": 38.525,
   "say": "Буровики уходят в сторону от старого ствола и снова идут вниз.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 38.745,
   "t1": 40.025,
   "say": "Метр за метром.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 40.065,
   "t1": 41.545,
   "say": "Месяц за месяцем.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 41.735,
   "t1": 43.355,
   "say": "Проходит почти пять лет.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 43.76,
   "t1": 51.61,
   "say": "И в тысяча девятьсот восемьдесят девятом году новый ствол достигает глубины двенадцать тысяч двести шестьдесят два метра.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 51.89,
   "t1": 53.105,
   "say": "Это рекорд.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 53.305,
   "t1": 54.805,
   "say": "Он не побит до сих пор.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 55.015,
   "t1": 56.465,
   "say": "Уже почти сорок лет.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 56.465,
   "t1": 60.305,
   "say": "Ни одна скважина на Земле не ушла вглубь дальше.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 60.505,
   "t1": 63.785,
   "say": "Позже Кольскую внесут в Книгу рекордов Гиннесса.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 63.815,
   "t1": 67.295,
   "say": "Как самую глубокую точку, до которой добрался человек.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 67.665,
   "t1": 70.365,
   "say": "Но сами буровики гордились не рекордом.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 70.495,
   "t1": 73.355,
   "say": "Они гордились тем, что подняли наверх.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 73.505,
   "t1": 75.985,
   "say": "Но что же нашли там, внизу?",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0.07,
   "t1": 1.61,
   "say": "Помнишь картину из учебников?",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "5. Что нашли"
  },
  {
   "src": "ch5.mp3",
   "t0": 1.985,
   "t1": 2.975,
   "say": "Сверху гранит.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 3.155,
   "t1": 4.625,
   "say": "Под ним базальт.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 5.015,
   "t1": 9.485,
   "say": "Учёные были уверены: примерно на семи километрах гранит закончится.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 9.53,
   "t1": 11.23,
   "say": "Начнётся базальт.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 11.65,
   "t1": 13.355,
   "say": "Бур проходит семь километров.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 13.73,
   "t1": 14.46,
   "say": "Восемь.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 14.59,
   "t1": 15.3,
   "say": "Десять.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 15.515,
   "t1": 16.425,
   "say": "Двенадцать.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 16.83,
   "t1": 17.975,
   "say": "Базальта нет.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 18.135,
   "t1": 19.565,
   "say": "Ни на какой глубине.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 19.665,
   "t1": 23.305,
   "say": "Внизу всё тот же гранит и другие древние породы.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 23.535,
   "t1": 28.775,
   "say": "А волны от землетрясений, которые приняли за границу базальта, оказались чем-то другим.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 28.915,
   "t1": 32.875,
   "say": "Камнем, который давление и жар изменили изнутри.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 33.035,
   "t1": 35.575,
   "say": "Картину Земли пришлось перерисовывать.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 35.745,
   "t1": 37.015,
   "say": "Но это не всё.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 37.255,
   "t1": 40.775,
   "say": "На глубине от трёх до шести километров нашли воду.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.065,
   "t1": 42.775,
   "say": "Её там не должно было быть.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 42.985,
   "t1": 45.865,
   "say": "Давление выжимает воду прямо из камня.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 45.985,
   "t1": 48.675,
   "say": "А плотный слой сверху не даёт ей уйти.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 48.915,
   "t1": 52.545,
   "say": "Буровой раствор, который выходил из скважины, словно кипел.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 52.695,
   "t1": 55.8,
   "say": "В нём было столько водорода, сколько не ждал никто.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 56.14,
   "t1": 57.715,
   "say": "А ещё трещины.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 58.055,
   "t1": 61.395,
   "say": "Думали, что глубже порода станет плотной и цельной.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 61.535,
   "t1": 63.965,
   "say": "А трещин с глубиной становилось больше.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 64.265,
   "t1": 67.195,
   "say": "И самое удивительное — окаменелости.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 67.425,
   "t1": 72.355,
   "say": "На глубине около шести километров в керне нашли следы древнего планктона.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 72.495,
   "t1": 74.335,
   "say": "Крошечные морские существа.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 74.495,
   "t1": 75.565,
   "say": "Окаменевшие.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 75.785,
   "t1": 77.275,
   "say": "Они лежали в камне.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 77.455,
   "t1": 79.37,
   "say": "На глубине в шесть километров.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 79.88,
   "t1": 86.225,
   "say": "А на самом дне бур дошёл до пород, которым около двух целых семи десятых миллиарда лет.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 86.305,
   "t1": 91.355,
   "say": "Когда они застывали, на Земле ещё не было ни растений, ни животных на суше.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 91.575,
   "t1": 94.115,
   "say": "Только океан, камень и небо.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 94.535,
   "t1": 97.115,
   "say": "Каждая находка — новая загадка.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 97.335,
   "t1": 100.535,
   "say": "Но чем глубже, тем страшнее становилось внизу.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0,
   "t1": 2.1,
   "say": "Чем глубже, тем горячее.",
   "gap": 0.45,
   "who": "narrator",
   "chapter": "6. Жар"
  },
  {
   "src": "ch6.mp3",
   "t0": 2.425,
   "t1": 3.655,
   "say": "Это знали все.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 3.825,
   "t1": 8.315,
   "say": "Учёные считали: на двенадцати километрах будет около ста градусов.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 8.345,
   "t1": 9.585,
   "say": "Как кипяток.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 9.625,
   "t1": 12.515,
   "say": "Термометр показал около ста восьмидесяти.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 12.635,
   "t1": 14.645,
   "say": "Почти вдвое горячее.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 14.745,
   "t1": 17.485,
   "say": "В такой жаре камень ведёт себя странно.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 17.625,
   "t1": 19.025,
   "say": "Он становится мягким.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 19.255,
   "t1": 23.845,
   "say": "Учёные говорили, что порода на дне похожа скорее на пластик, чем на камень.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 23.995,
   "t1": 26.165,
   "say": "Она медленно сжимает ствол.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 26.305,
   "t1": 28.235,
   "say": "Затягивает его, как рану.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 28.235,
   "t1": 29.365,
   "say": "Ломает долото.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 29.655,
   "t1": 31.185,
   "say": "Скручивает трубы.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 31.275,
   "t1": 36.385,
   "say": "Чтобы колонна выдержала, внизу ставят трубы из лёгкого алюминиевого сплава.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 36.545,
   "t1": 37.825,
   "say": "Но и они не вечны.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 38.105,
   "t1": 40.725,
   "say": "Каждый новый метр даётся всё тяжелее.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 41.25,
   "t1": 47.89,
   "say": "В тысяча девятьсот девяностом году на глубине двенадцать тысяч двести шестьдесят два метра снова авария.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 48.23,
   "t1": 50.095,
   "say": "Буровики пробуют ещё раз.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 50.185,
   "t1": 50.905,
   "say": "Новый ствол.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 50.95,
   "t1": 57.88,
   "say": "В тысяча девятьсот девяносто втором его останавливают на одиннадцати тысячах восьмистах восьмидесяти двух метрах.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 58.29,
   "t1": 59.625,
   "say": "Причина — жара.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 59.97,
   "t1": 61.74,
   "say": "Сто восемьдесят градусов.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 62.21,
   "t1": 65.175,
   "say": "Пятнадцать километров так и остались мечтой.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 65.325,
   "t1": 67.415,
   "say": "И это случилось не только с нами.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 67.585,
   "t1": 71.395,
   "say": "В те же годы свою сверхглубокую скважину бурила Германия.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 71.625,
   "t1": 74.265,
   "say": "Немцы прошли чуть больше девяти километров.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 74.265,
   "t1": 76.405,
   "say": "И упёрлись в ту же стену.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 76.545,
   "t1": 79.575,
   "say": "Жара больше двухсот шестидесяти градусов.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 79.825,
   "t1": 82.185,
   "say": "Трубы и приборы просто не выдерживали.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 82.315,
   "t1": 86.06,
   "say": "Похоже, на этой глубине Земля ставит свой предел.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 86.41,
   "t1": 88.775,
   "say": "Земля просто не пустила дальше.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 89.105,
   "t1": 93.495,
   "say": "А в это время по миру уже вовсю гуляла совсем другая история.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 93.595,
   "t1": 97.235,
   "say": "Про то, почему на самом деле остановили бурение.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0.0,
   "t1": 2.33,
   "say": "Тысяча девятьсот восемьдесят девятый год.",
   "gap": 0.5,
   "who": "narrator",
   "chapter": "7. Колодец в ад"
  },
  {
   "src": "ch7.mp3",
   "t0": 2.67,
   "t1": 5.815,
   "say": "Новость появляется в маленьком журнале в Финляндии.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 5.825,
   "t1": 9.655,
   "say": "Потом её подхватывает американский христианский телеканал.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 10.095,
   "t1": 11.585,
   "say": "История звучит так.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 11.785,
   "t1": 16.615,
   "say": "В Сибири советские учёные пробурили скважину на четырнадцать километров.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 16.985,
   "t1": 19.705,
   "say": "И бур вдруг провалился в пустоту.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 19.865,
   "t1": 22.555,
   "say": "Внизу оказалась огромная полость.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 22.785,
   "t1": 25.315,
   "say": "Температура — больше тысячи градусов.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 25.315,
   "t1": 30.815,
   "say": "Руководитель работ, некий доктор Азаков, приказал опустить туда микрофон.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 30.945,
   "t1": 33.345,
   "say": "И микрофон записал звук.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 33.625,
   "t1": 34.345,
   "say": "Крики.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 34.465,
   "t1": 35.785,
   "say": "Тысячи голосов.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 35.945,
   "t1": 37.945,
   "say": "Люди кричали от боли.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 38.225,
   "t1": 41.065,
   "say": "Через семнадцать секунд микрофон расплавился.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 41.225,
   "t1": 45.175,
   "say": "А потом из скважины вырвалось облако светящегося газа.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 45.415,
   "t1": 48.695,
   "say": "И в нём, будто бы, видели крылатую фигуру.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 48.855,
   "t1": 50.905,
   "say": "Рабочие в ужасе разбежались.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 51.025,
   "t1": 53.96,
   "say": "Позже в интернете появилась и сама «запись».",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 54.35,
   "t1": 57.065,
   "say": "Жуткий вой, от которого бегут мурашки.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 57.385,
   "t1": 59.745,
   "say": "Её переслушивали снова и снова.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 60.035,
   "t1": 62.305,
   "say": "Многие верят в неё до сих пор.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 62.505,
   "t1": 64.025,
   "say": "Но давай сравним.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 64.155,
   "t1": 67.505,
   "say": "Скважина не в Сибири, а на Кольском полуострове.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 67.795,
   "t1": 70.72,
   "say": "Глубина не четырнадцать километров, а двенадцать.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 71.09,
   "t1": 74.19,
   "say": "Температура не тысяча градусов, а сто восемьдесят.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 74.58,
   "t1": 76.685,
   "say": "Никакой пустоты внизу не было.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 76.785,
   "t1": 78.945,
   "say": "Внизу был горячий камень.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 79.225,
   "t1": 81.165,
   "say": "Так откуда взялась эта история?",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.01,
   "t1": 3.33,
   "say": "Путь легенды можно проследить почти шаг за шагом.",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "8. Кто это придумал"
  },
  {
   "src": "ch8.mp3",
   "t0": 3.665,
   "t1": 7.775,
   "say": "Сначала её напечатал маленький религиозный журнал в Финляндии.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 8.065,
   "t1": 11.615,
   "say": "Автор пересказал по памяти письмо читателя из газеты.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 11.665,
   "t1": 14.975,
   "say": "Потом историю перепечатал другой финский листок.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 15.18,
   "t1": 17.78,
   "say": "Летом тысяча девятьсот восемьдесят девятого.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 18.11,
   "t1": 20.065,
   "say": "И она попала в Америку.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 20.065,
   "t1": 21.705,
   "say": "На религиозный телеканал.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.895,
   "t1": 23.465,
   "say": "Её показали в эфире.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 23.465,
   "t1": 25.105,
   "say": "Без всякой проверки.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 25.265,
   "t1": 28.655,
   "say": "И тут в истории появляется норвежский учитель.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 29.04,
   "t1": 30.85,
   "say": "Его зовут Оге Рендален.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 31.13,
   "t1": 33.835,
   "say": "Он видит этот выпуск, когда бывает в Америке.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 33.905,
   "t1": 37.475,
   "say": "И решает проверить, насколько легко люди верят.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 37.67,
   "t1": 43.645,
   "say": "Рендален пишет на телеканал: да, я знаю эту историю, у нас в Норвегии о ней писали.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 43.735,
   "t1": 46.79,
   "say": "И присылает вырезку из норвежской газеты.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 46.94,
   "t1": 48.705,
   "say": "С «переводом» на английский.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 48.755,
   "t1": 52.165,
   "say": "Только в настоящей статье говорилось совсем о другом.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 52.345,
   "t1": 53.995,
   "say": "О строительном инспекторе.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 54.025,
   "t1": 56.945,
   "say": "А Рендален добавил в «перевод» всё, что хотел.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 56.945,
   "t1": 60.305,
   "say": "Даже летучую мышь, которая вылетела из скважины.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 60.545,
   "t1": 61.965,
   "say": "Телеканал поверил.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 61.965,
   "t1": 63.485,
   "say": "И показал и это.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 63.525,
   "t1": 67.205,
   "say": "Позже Рендален сам рассказал, что это был розыгрыш.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 67.385,
   "t1": 72.515,
   "say": "Он хотел показать, как легко люди принимают на веру то, что им хочется услышать.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 72.775,
   "t1": 73.885,
   "say": "И ведь показал.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 74.145,
   "t1": 77.245,
   "say": "Подумай, почему эта история так цепляет.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 77.375,
   "t1": 79.535,
   "say": "Секретный советский объект.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 79.775,
   "t1": 82.375,
   "say": "Учёные, которые зашли слишком далеко.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 82.665,
   "t1": 84.34,
   "say": "Крышка, которую заварили.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 84.68,
   "t1": 87.555,
   "say": "Всё это звучит как начало фильма ужасов.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 87.775,
   "t1": 89.955,
   "say": "А правду рассказать сложнее.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 89.955,
   "t1": 93.955,
   "say": "Про гранит, водород и трубы, которые ломает жара.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 94.225,
   "t1": 97.235,
   "say": "Но правда здесь не менее удивительная.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 97.505,
   "t1": 98.265,
   "say": "А «крики»?",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 98.545,
   "t1": 101.865,
   "say": "Это зацикленные звуки, наложенные друг на друга.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 102.155,
   "t1": 105.315,
   "say": "Часто говорят, что их взяли из старого фильма ужасов.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 105.625,
   "t1": 108.475,
   "say": "И с тех пор легенда только переезжала.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 108.625,
   "t1": 110.015,
   "say": "Сначала на Аляску.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 110.095,
   "t1": 111.605,
   "say": "Потом на нефтяную вышку.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 111.605,
   "t1": 115.715,
   "say": "А в две тысячи двадцатом году в России сняли фильм ужасов.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 115.905,
   "t1": 119.315,
   "say": "Он так и называется — «Кольская сверхглубокая».",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 0.05,
   "t1": 1.98,
   "say": "А что же настоящая скважина?",
   "gap": 0.68,
   "who": "narrator",
   "chapter": "9. Финал"
  },
  {
   "src": "ch9.mp3",
   "t0": 2.56,
   "t1": 4.77,
   "say": "Тысяча девятьсот девяносто первый год.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 5.02,
   "t1": 7.105,
   "say": "Советского Союза больше нет.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 7.305,
   "t1": 9.175,
   "say": "Денег на науку почти нет.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 9.73,
   "t1": 13.77,
   "say": "В тысяча девятьсот девяносто четвёртом году бурят последний раз.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 14.085,
   "t1": 16.675,
   "say": "Глубина всего восемь с половиной километров.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 17.03,
   "t1": 19.145,
   "say": "Потом бурение останавливают.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 19.145,
   "t1": 20.175,
   "say": "Навсегда.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 20.175,
   "t1": 23.005,
   "say": "Когда-то здесь работали пятьсот человек.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 23.49,
   "t1": 26.67,
   "say": "К две тысячи восьмому году осталось около двадцати.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 27.08,
   "t1": 28.62,
   "say": "Предприятие закрывают.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 28.93,
   "t1": 31.165,
   "say": "Оборудование увозят и разбирают.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 31.305,
   "t1": 32.985,
   "say": "Здания пустеют.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 32.995,
   "t1": 35.815,
   "say": "А скважину заваривают железной крышкой.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 36.45,
   "t1": 38.03,
   "say": "Двенадцать километров.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 38.31,
   "t1": 41.055,
   "say": "Это рекорд, который не побит до сих пор.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 41.495,
   "t1": 44.145,
   "say": "Да, сегодня есть скважины и длиннее.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 44.235,
   "t1": 49.705,
   "say": "В Катаре, на Сахалине нефтяники бурят на двенадцать, даже на пятнадцать километров.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 49.835,
   "t1": 53.945,
   "say": "Но эти скважины идут почти горизонтально, под небольшим углом.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 53.945,
   "t1": 56.73,
   "say": "Настоящая глубина у них гораздо меньше.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 57.09,
   "t1": 59.465,
   "say": "А Кольская шла прямо вниз.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 59.785,
   "t1": 64.265,
   "say": "И всё равно это меньше половины процента пути до центра Земли.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 64.585,
   "t1": 66.385,
   "say": "Мы долетели до Луны.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 66.535,
   "t1": 69.385,
   "say": "Отправили зонды за пределы Солнечной системы.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 69.395,
   "t1": 73.715,
   "say": "А вглубь собственной планеты прошли всего на двенадцать километров.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 73.865,
   "t1": 75.225,
   "say": "И остановились.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 75.515,
   "t1": 76.165,
   "say": "Почему?",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 76.705,
   "t1": 78.385,
   "say": "Итак, три версии.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 78.805,
   "t1": 80.585,
   "say": "А — Земля не пустила.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 80.735,
   "t1": 86.66,
   "say": "Жара и мягкий, как пластик, камень сделали дальнейшее бурение невозможным.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 87.01,
   "t1": 87.995,
   "say": "Б — кончились деньги.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 88.015,
   "t1": 91.065,
   "say": "Скважина умерла вместе с Советским Союзом.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 91.425,
   "t1": 95.065,
   "say": "В — там нашли что-то, о чём решили молчать.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 95.155,
   "t1": 97.515,
   "say": "И крышку заварили не просто так.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 97.795,
   "t1": 99.065,
   "say": "А ты как думаешь?",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 99.215,
   "t1": 100.905,
   "say": "Напиши букву в комментариях.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 101.065,
   "t1": 103.855,
   "say": "И напиши, какую загадку разобрать следующей.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 104.035,
   "t1": 106.305,
   "say": "А если тебе понравилось — подпишись.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 106.415,
   "t1": 108.715,
   "say": "Впереди ещё много неразгаданного.",
   "gap": 8.0,
   "who": "narrator"
  }
 ]
}