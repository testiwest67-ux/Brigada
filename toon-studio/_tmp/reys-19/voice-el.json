{
 "dir": "public/reys-19/el",
 "lead": 0.4,
 "tail": 2.6,
 "tempo": 1.06,
 "lines": [
  {
   "src": "N1a.mp3",
   "t0": 0,
   "t1": 1.68,
   "say": "Бермудский треугольник.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 2.11,
   "t1": 6.82,
   "say": "За один вечер здесь исчезли шесть самолётов. И двадцать семь человек.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 7.21,
   "t1": 8.89,
   "say": "И не нашли ни одного обломка.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "Ta.mp3",
   "t0": 0,
   "t1": 1.83,
   "say": "Оба моих компаса отказали.",
   "gap": 0.6,
   "who": "taylor",
   "fx": "highpass=f=350,lowpass=f=2800,volume=2.0,alimiter=limit=0.7:level=0",
   "tempo": 1.0
  },
  {
   "src": "N1a.mp3",
   "t0": 9.26,
   "t1": 13.23,
   "say": "Это последний вечер «Рейса девятнадцать». И ты его слышишь.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 13.67,
   "t1": 17.07,
   "say": "Пятое декабря тысяча девятьсот сорок пятого. Флорида.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 17.39,
   "t1": 19.35,
   "say": "Ты радист на военной авиабазе.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 19.7,
   "t1": 23.85,
   "say": "В два часа дня взлетают пять торпедоносцев. Четырнадцать человек.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 24.14,
   "t1": 27.58,
   "say": "Обычный учебный полёт. Солнце. Спокойный океан.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 27.95,
   "t1": 31.24,
   "say": "Ведёт их лейтенант Чарльз Тейлор. Опытный пилот.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 0,
   "t1": 1.89,
   "say": "А потом в наушниках треск.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "Ta.mp3",
   "t0": 1.95,
   "t1": 5.5,
   "say": "Оба компаса отказали. Пытаюсь найти Форт-Лодердейл.",
   "gap": 0.45,
   "who": "taylor",
   "fx": "highpass=f=350,lowpass=f=2800,volume=2.0,alimiter=limit=0.7:level=0",
   "tempo": 1.0
  },
  {
   "src": "N2a.mp3",
   "t0": 2.11,
   "t1": 5.4,
   "say": "Тейлор уверен, что под ним острова у берега Флориды.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 5.59,
   "t1": 8.89,
   "say": "Ты жмёшь кнопку микрофона. Летите на запад! К берегу!",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 9.19,
   "t1": 13.16,
   "say": "Но пять самолётов уходят на северо-восток. В открытый океан.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 13.58,
   "t1": 15.27,
   "say": "Прямо в сердце треугольника.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 15.55,
   "t1": 17.68,
   "say": "Темнеет. Начинается шторм.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 17.8,
   "t1": 19.79,
   "say": "Топлива остаётся минут на двадцать.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "Ta.mp3",
   "t0": 5.7,
   "t1": 10.48,
   "say": "Как только у первого кончится топливо… садимся на воду. Все вместе.",
   "gap": 0.6,
   "who": "taylor",
   "fx": "highpass=f=350,lowpass=f=2800,volume=2.0,alimiter=limit=0.7:level=0",
   "tempo": 1.0
  },
  {
   "src": "N2a.mp3",
   "t0": 20.13,
   "t1": 21.46,
   "say": "И эфир замолкает.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 21.99,
   "t1": 25.45,
   "say": "За ними вылетает самолёт-спасатель. Тринадцать человек.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 25.84,
   "t1": 28.05,
   "say": "Через несколько минут пропадает и он.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 28.56,
   "t1": 31.85,
   "say": "Моряки с корабля видят в ночном небе огненную вспышку.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 32.15,
   "t1": 36.91,
   "say": "Шесть самолётов. Двадцать семь человек. За один вечер.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 0,
   "t1": 3.55,
   "say": "Утром океан прочёсывают сотни кораблей и самолётов.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 3.86,
   "t1": 6.8,
   "say": "Ни одного обломка. Ни одного человека.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 7.32,
   "t1": 9.56,
   "say": "Комиссия пишет: виноват пилот.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 9.93,
   "t1": 13.33,
   "say": "Но мать Тейлора не верит. И причину переписывают.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 13.72,
   "t1": 15.62,
   "say": "«Причины неизвестны».",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 16.09,
   "t1": 20.59,
   "say": "Через двадцать лет журналист назовёт это место «Бермудский треугольник».",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 20.88,
   "t1": 24.53,
   "say": "И главной его историей станет «Рейс девятнадцать».",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 24.92,
   "t1": 26.47,
   "say": "Так что же случилось?",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 27.05,
   "t1": 31.73,
   "say": "А. Пилот ошибся, кончилось топливо, и ночной океан всё скрыл.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 32.24,
   "t1": 36.22,
   "say": "Б. Компасы правда сошли с ума. Магнитная аномалия.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 36.79,
   "t1": 41.49,
   "say": "В. В треугольнике есть что-то, чего мы до сих пор не понимаем.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 41.91,
   "t1": 44.43,
   "say": "А ты как думаешь? Пиши букву в комментариях.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 44.62,
   "t1": 46.84,
   "say": "И какую загадку разобрать дальше?",
   "gap": 0.3,
   "who": "narrator"
  }
 ]
}