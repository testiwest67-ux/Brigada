{
 "dir": "public/roopkund/el",
 "lead": 0.0,
 "tail": 0.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "trailer-loop.mp3",
   "t0": 6.12,
   "t1": 8.1,
   "say": "Высоко в Гималаях.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 1.23,
   "t1": 4.175,
   "say": "Высота — больше пяти тысяч метров.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 8.785,
   "t1": 11.435,
   "say": "Среди скал лежит маленькое озеро.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 11.615,
   "t1": 12.945,
   "say": "Круглое, как чаша.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 16.095,
   "t1": 17.625,
   "say": "Но летом лёд тает.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 17.825,
   "t1": 20.785,
   "say": "И тогда становится видно, что лежит на дне.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 20.905,
   "t1": 22.195,
   "say": "И по берегам.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.495,
   "t1": 23.115,
   "say": "Кости.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.275,
   "t1": 25.645,
   "say": "Сотни человеческих скелетов.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 32.795,
   "t1": 35.115,
   "say": "Здесь погибли сотни людей.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.375,
   "t1": 37.675,
   "say": "Высоко в горах, где никто не живёт.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.955,
   "t1": 38.795,
   "say": "Кто они?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 38.955,
   "t1": 40.485,
   "say": "Как они сюда попали?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 40.665,
   "t1": 42.015,
   "say": "И что их убило?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 51.375,
   "t1": 53.565,
   "say": "Это озеро Роопкунд.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 53.865,
   "t1": 56.315,
   "say": "Его называют озером скелетов.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 26.825,
   "t1": 29.015,
   "say": "На некоторых костях осталась плоть.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 30.055,
   "t1": 33.125,
   "say": "По некоторым данным, на черепах есть раны.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 33.305,
   "t1": 35.745,
   "say": "Как будто удары пришлись сверху.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 35.865,
   "t1": 38.095,
   "say": "Круглыми, тяжёлыми предметами.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.465,
   "t1": 42.255,
   "say": "Как град.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 85.585,
   "t1": 88.045,
   "say": "Загадка почти разгадана.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 88.305,
   "t1": 88.945,
   "say": "Почти.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 45.215,
   "t1": 48.535,
   "say": "А потом учёные прочитали их ДНК.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 56.725,
   "t1": 59.505,
   "say": "Люди в озере — не одна группа.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 59.545,
   "t1": 60.375,
   "say": "Их три.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 79.385,
   "t1": 81.845,
   "say": "Ближе всего по ДНК они к жителям…",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 81.845,
   "t1": 84.225,
   "say": "восточного Средиземноморья.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 84.225,
   "t1": 87.325,
   "say": "К людям, которые сегодня живут на острове Крит.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 87.325,
   "t1": 88.505,
   "say": "И в Греции.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 88.505,
   "t1": 90.945,
   "say": "За тысячи километров отсюда.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 10.175,
   "t1": 13.095,
   "say": "Эти люди погибли не в один день.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 69.265,
   "t1": 71.665,
   "say": "Между ними — тысяча лет.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 71.985,
   "t1": 74.775,
   "say": "Значит, здесь не было одной катастрофы.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 75.015,
   "t1": 78.725,
   "say": "Значит, люди приходили к этому озеру снова и снова.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 78.975,
   "t1": 81.43,
   "say": "И снова и снова здесь умирали.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 97.975,
   "t1": 103.495,
   "say": "Как люди с другого конца света оказались в одном маленьком озере в Гималаях?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 0.33,
   "t1": 1.55,
   "say": "Так кто эти люди?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 1.7,
   "t1": 4.2,
   "say": "Ответ — в полном видео на канале.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 4.35,
   "t1": 6.12,
   "say": "Потому что всё началось…",
   "gap": 0.0,
   "who": "narrator"
  }
 ]
}