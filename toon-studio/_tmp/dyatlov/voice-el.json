{
 "dir": "public/dyatlov/el",
 "lead": 1.0,
 "tail": 3.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0.05,
   "t1": 2.63,
   "say": "Февраль тысяча девятьсот пятьдесят девятого.",
   "gap": 0.34,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 2.87,
   "t1": 3.91,
   "say": "Северный Урал.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.47,
   "t1": 6.44,
   "say": "На склоне горы стоит палатка.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 6.76,
   "t1": 9.62,
   "say": "Её наполовину занесло снегом.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 9.84,
   "t1": 11.72,
   "say": "Внутри — одежда, обувь, еда.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.08,
   "t1": 12.82,
   "say": "Всё на месте.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 13.22,
   "t1": 14.25,
   "say": "Нет только людей.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.85,
   "t1": 16.44,
   "say": "Стенка палатки разрезана.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 16.74,
   "t1": 17.37,
   "say": "Изнутри.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 17.86,
   "t1": 22.2,
   "say": "А вниз по склону, в темноту, уходят следы девяти человек.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.6,
   "t1": 23.97,
   "say": "Многие — без обуви.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 24.2,
   "t1": 25.15,
   "say": "В одних носках.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 25.62,
   "t1": 28.14,
   "say": "А ночью здесь было около минус тридцати.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 28.46,
   "t1": 31.14,
   "say": "И ветер, от которого трудно устоять на ногах.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 31.75,
   "t1": 33.08,
   "say": "Это были не новички.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 33.4,
   "t1": 37.81,
   "say": "Опытные туристы, которые знали: без палатки в такую ночь не выжить.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 38.26,
   "t1": 39.72,
   "say": "И всё-таки они ушли.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 40.31,
   "t1": 47.75,
   "say": "Что могло заставить девятерых взрослых людей разрезать единственное укрытие и шагнуть в мороз почти раздетыми?",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 48.39,
   "t1": 51.1,
   "say": "Следствие закрыло дело через четыре месяца.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 51.49,
   "t1": 54.04,
   "say": "Причину назвали одной странной фразой.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 54.56,
   "t1": 59.31,
   "say": "Учёные, прокуроры и тысячи исследователей спорят о ней до сих пор.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 59.85,
   "t1": 61.17,
   "say": "Давай пройдём их путь.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 61.37,
   "t1": 62.36,
   "say": "День за днём.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 62.63,
   "t1": 65.05,
   "say": "По следам, дневникам и документам.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 65.46,
   "t1": 67.87,
   "say": "А в конце — три главные версии.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 68.21,
   "t1": 71.22,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0.01,
   "t1": 3.53,
   "say": "Свердловск, январь тысяча девятьсот пятьдесят девятого.",
   "gap": 0.38,
   "who": "narrator",
   "chapter": "1. Десять"
  },
  {
   "src": "ch1.mp3",
   "t0": 3.81,
   "t1": 5.86,
   "say": "Уральский политехнический институт.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 6.46,
   "t1": 8.83,
   "say": "При институте есть туристический клуб.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 9.28,
   "t1": 13.72,
   "say": "Зимой его самые опытные участники уходят в дальние походы.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 14.25,
   "t1": 16.97,
   "say": "Одну из таких групп собирает Игорь Дятлов.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 17.21,
   "t1": 18.68,
   "say": "Студент пятого курса.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 19.01,
   "t1": 22.92,
   "say": "Ему двадцать три — исполнилось всего за пару недель до похода.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 23.39,
   "t1": 24.63,
   "say": "Он опытный турист.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 24.99,
   "t1": 27.34,
   "say": "Друзья ему доверяют и идут за ним.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 27.86,
   "t1": 29.31,
   "say": "Давай познакомимся с ними.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 29.63,
   "t1": 33.53,
   "say": "Они заслуживают того, чтобы их помнили не только по одной ночи.",
   "gap": 0.87,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 34.3,
   "t1": 35.71,
   "say": "Зина Колмогорова.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 35.92,
   "t1": 38.2,
   "say": "Студентка радиотехнического факультета.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 38.51,
   "t1": 41.5,
   "say": "Весёлая, общительная, её любят в клубе.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 42.11,
   "t1": 43.32,
   "say": "Люда Дубинина.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 43.6,
   "t1": 45.43,
   "say": "Учится на строительном факультете.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 45.65,
   "t1": 48.35,
   "say": "Ей двадцать, она самая младшая в группе.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 48.96,
   "t1": 50.45,
   "say": "Юрий Кривонищенко.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 50.74,
   "t1": 55.77,
   "say": "Уже окончил институт, работает строителем в закрытом городе Челябинск-сорок.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 56.24,
   "t1": 59.18,
   "say": "Про такие места тогда не принято было говорить вслух.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 59.86,
   "t1": 61.54,
   "say": "Николай Тибо-Бриньоль.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 61.9,
   "t1": 64.09,
   "say": "Тоже выпускник, инженер-строитель.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 64.45,
   "t1": 66.34,
   "say": "У его рода французские корни.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 66.64,
   "t1": 69.69,
   "say": "Его отец, горный инженер, строил Магнитку.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 70.16,
   "t1": 75.86,
   "say": "В тридцать первом году его арестовали по ложному обвинению и отправили в лагерь на десять лет.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 76.34,
   "t1": 79.86,
   "say": "Оправдают его только в тысяча девятьсот девяносто первом.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 80.68,
   "t1": 81.97,
   "say": "Александр Колеватов.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 82.4,
   "t1": 83.62,
   "say": "Рустем Слободин.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 83.8,
   "t1": 85.02,
   "say": "Юрий Дорошенко.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 85.31,
   "t1": 87.14,
   "say": "Каждому чуть больше двадцати.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 87.73,
   "t1": 88.84,
   "say": "Юрий Юдин.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 89.03,
   "t1": 89.61,
   "say": "Студент.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 89.94,
   "t1": 91.44,
   "say": "Он тоже идёт в этот поход.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 92.08,
   "t1": 93.55,
   "say": "И Семён Золотарёв.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 94.02,
   "t1": 94.98,
   "say": "Он здесь чужой.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 95.2,
   "t1": 96.92,
   "say": "В группе он никого не знает.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 97.32,
   "t1": 98.65,
   "say": "Ему за тридцать пять.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 99.1,
   "t1": 102.64,
   "say": "Он прошёл войну и вернулся с четырьмя боевыми наградами.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 102.96,
   "t1": 104.83,
   "say": "Работал инструктором на турбазе.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 105.31,
   "t1": 109.56,
   "say": "Перед самым походом в группе освобождается место, и Золотарёва берут.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 110.11,
   "t1": 114.19,
   "say": "Представляясь ребятам, он просит называть его не Семёном, а Сашей.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 115.07,
   "t1": 118.21,
   "say": "Пять студентов, три выпускника и инструктор.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 118.59,
   "t1": 119.57,
   "say": "И ещё Юдин.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 120.05,
   "t1": 121.84,
   "say": "Это не прогулка выходного дня.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 122.24,
   "t1": 125.62,
   "say": "Маршрут — почти триста пятьдесят километров на лыжах.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 125.85,
   "t1": 126.55,
   "say": "Зимой.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 126.8,
   "t1": 128.34,
   "say": "Через тайгу и горы.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 128.8,
   "t1": 131.86,
   "say": "Цель — гора Отортен на севере Урала.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 132.39,
   "t1": 138.06,
   "say": "План простой: двенадцатого февраля выйти в посёлок Вижай и дать телеграмму в спортклуб.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 138.49,
   "t1": 140.32,
   "say": "Пятнадцатого — вернуться домой.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 140.89,
   "t1": 141.93,
   "say": "Их десять.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 142.28,
   "t1": 146.66,
   "say": "И пока они ещё не знают, что домой вернётся только один.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0.01,
   "t1": 1.04,
   "say": "Конец января.",
   "gap": 0.58,
   "who": "narrator",
   "chapter": "2. Дорога на север"
  },
  {
   "src": "ch2.mp3",
   "t0": 1.52,
   "t1": 3.07,
   "say": "Поезд везёт их на север.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 3.37,
   "t1": 4.64,
   "say": "Потом — Ивдель.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 4.87,
   "t1": 6.18,
   "say": "Потом — Вижай.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 6.54,
   "t1": 9.65,
   "say": "Потом — посёлок лесорубов, сорок первый квартал.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 10.07,
   "t1": 11.75,
   "say": "Дальше жилья уже нет.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 12.05,
   "t1": 13.59,
   "say": "Только снег, лес и горы.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 13.77,
   "t1": 16.23,
   "say": "Они много фотографируют.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 16.5,
   "t1": 17.53,
   "say": "Пишут дневники.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 17.77,
   "t1": 19.37,
   "say": "Шутят и поют песни.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 19.82,
   "t1": 22.48,
   "say": "Эти плёнки и тетради потом найдут в палатке.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 22.81,
   "t1": 25.46,
   "say": "По ним мы и знаем почти каждый их день.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 25.96,
   "t1": 26.9,
   "say": "Обычный поход.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 27.15,
   "t1": 28.61,
   "say": "Обычные молодые люди.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 28.89,
   "t1": 30.64,
   "say": "Ничего не предвещает беды.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 31.16,
   "t1": 34.09,
   "say": "А потом у одного из них начинает болеть нога.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 34.58,
   "t1": 37.63,
   "say": "Юрий Юдин понимает: дальше он не дойдёт.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 38.13,
   "t1": 41.36,
   "say": "В таком походе больной человек — опасность для всех.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.88,
   "t1": 46.15,
   "say": "Двадцать восьмого января он прощается с друзьями и поворачивает назад.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 46.71,
   "t1": 49.67,
   "say": "Это последний день, когда их видели живыми.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 50.19,
   "t1": 52.69,
   "say": "Юдин проживёт ещё больше полувека.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 53.08,
   "t1": 55.62,
   "say": "Всю жизнь он будет думать о той ночи.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 55.93,
   "t1": 59.19,
   "say": "И не поверит, что их погубила обычная стихия.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 59.7,
   "t1": 60.66,
   "say": "Но об этом позже.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 60.99,
   "t1": 63.16,
   "say": "А пока группа уходит дальше.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 63.46,
   "t1": 64.68,
   "say": "Теперь их девять.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 65.04,
   "t1": 67.64,
   "say": "До той ночи остаётся четыре дня.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0,
   "t1": 1.63,
   "say": "Вечер первого февраля.",
   "gap": 0.49,
   "who": "narrator",
   "chapter": "4. Ночь"
  },
  {
   "src": "ch4.mp3",
   "t0": 2.02,
   "t1": 3.87,
   "say": "Девять человек в одной палатке.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 4.4,
   "t1": 4.93,
   "say": "Тесно.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 5.34,
   "t1": 6.02,
   "say": "Холодно.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 6.62,
   "t1": 12.11,
   "say": "По разным данным, в эту ночь в горах было от минус двадцати пяти до минус тридцати пяти.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 12.67,
   "t1": 17.28,
   "say": "Метеостанция в Ивделе отметила ветер до тридцати пяти метров в секунду.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 17.62,
   "t1": 18.88,
   "say": "Это почти ураган.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 19.38,
   "t1": 21.81,
   "say": "Что случилось дальше, не видел никто.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 22.25,
   "t1": 24.89,
   "say": "Мы знаем только то, что осталось на снегу.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 25.47,
   "t1": 28.16,
   "say": "Кто-то разрезал стенку палатки изнутри.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 28.62,
   "t1": 30.39,
   "say": "Все девять вышли наружу.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 30.69,
   "t1": 31.71,
   "say": "Почти раздетые.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 32.1,
   "t1": 33.57,
   "say": "Многие — без обуви.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 34.03,
   "t1": 36.98,
   "say": "Они не взяли ни курток, ни валенок, ни еды.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 37.45,
   "t1": 39.03,
   "say": "И пошли вниз по склону.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 39.32,
   "t1": 39.88,
   "say": "К лесу.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 40.37,
   "t1": 43.28,
   "say": "Полтора километра в темноте и метели.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 43.78,
   "t1": 44.97,
   "say": "Следы шли рядом.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 45.22,
   "t1": 45.85,
   "say": "Цепочкой.",
   "gap": 0.77,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 46.52,
   "t1": 51.1,
   "say": "Подумай, что значит полтора километра босиком в такую ночь.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 51.59,
   "t1": 53.64,
   "say": "Пальцы немеют через несколько минут.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 53.95,
   "t1": 56.14,
   "say": "Ветер пробивает свитер насквозь.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 56.57,
   "t1": 61.47,
   "say": "Без палатки, без огня, без тёплой одежды у человека остаются часы.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 61.77,
   "t1": 62.76,
   "say": "Может быть, меньше.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 63.27,
   "t1": 64.2,
   "say": "Они это знали.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 64.5,
   "t1": 65.36,
   "say": "Лучше нас.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 65.83,
   "t1": 70.16,
   "say": "Значит, то, что выгнало их из палатки, казалось им страшнее мороза.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 70.66,
   "t1": 72.92,
   "say": "Или они верили, что скоро вернутся.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 73.52,
   "t1": 79.36,
   "say": "Но прежде чем гадать, давай посмотрим, что нашли те, кто пришёл сюда через три недели.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0,
   "t1": 1.75,
   "say": "Двенадцатое февраля проходит.",
   "gap": 0.62,
   "who": "narrator",
   "chapter": "5. Поиски"
  },
  {
   "src": "ch5.mp3",
   "t0": 2.27,
   "t1": 3.86,
   "say": "Телеграммы из Вижая нет.",
   "gap": 0.81,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 4.57,
   "t1": 6.16,
   "say": "Сначала никто не волнуется.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 6.45,
   "t1": 9.83,
   "say": "В таких походах группы часто задерживаются на день-два.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 10.37,
   "t1": 11.56,
   "say": "Но дни идут.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 12.11,
   "t1": 13.78,
   "say": "Начинают беспокоиться родные.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 14.4,
   "t1": 17.84,
   "say": "Во второй половине февраля на поиски отправляются отряды.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 18.18,
   "t1": 21.37,
   "say": "Среди них студенты и сотрудники того же института.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 22.0,
   "t1": 25.53,
   "say": "Двадцать шестого февраля поисковики находят палатку.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 25.92,
   "t1": 27.4,
   "say": "Полузанесённую снегом.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 27.62,
   "t1": 28.95,
   "say": "С разрезами на стенке.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 29.47,
   "t1": 34.12,
   "say": "Внутри — вещи, обувь, еда, дневники, фотоаппараты.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 34.47,
   "t1": 35.55,
   "say": "Всё аккуратно.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 36.15,
   "t1": 38.2,
   "say": "От палатки вниз уходят следы.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 38.66,
   "t1": 40.15,
   "say": "Поисковики идут по ним.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 40.57,
   "t1": 42.12,
   "say": "Полтора километра вниз.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 42.34,
   "t1": 43.37,
   "say": "К границе леса.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 43.96,
   "t1": 46.93,
   "say": "Там, под высоким кедром, — остатки костра.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 47.41,
   "t1": 48.57,
   "say": "И первые двое.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 48.98,
   "t1": 51.57,
   "say": "Юрий Дорошенко и Юрий Кривонищенко.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 52.0,
   "t1": 54.11,
   "say": "Почти раздетые, в одном белье.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 54.79,
   "t1": 58.57,
   "say": "Чуть выше по склону, между кедром и палаткой, — Игорь Дятлов.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 59.04,
   "t1": 60.76,
   "say": "Потом Зина Колмогорова.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 61.44,
   "t1": 64.81,
   "say": "Пятого марта под снегом находят Рустема Слободина.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 65.37,
   "t1": 68.98,
   "say": "Все трое лежали на одной линии — от кедра к палатке.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 69.39,
   "t1": 71.29,
   "say": "Как будто пытались вернуться назад.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 71.59,
   "t1": 72.26,
   "say": "К вещам.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 72.5,
   "t1": 73.08,
   "say": "К теплу.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 73.6,
   "t1": 74.75,
   "say": "Но не дошли.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 75.26,
   "t1": 77.45,
   "say": "Причиной их гибели стал холод.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 78.09,
   "t1": 80.47,
   "say": "А где ещё четверо — никто не знает.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 80.79,
   "t1": 82.32,
   "say": "Снег слишком глубокий.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 82.88,
   "t1": 84.13,
   "say": "Поиски продолжаются.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 84.64,
   "t1": 85.67,
   "say": "Пятеро найдены.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 85.92,
   "t1": 86.99,
   "say": "Четверо — нет.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 87.49,
   "t1": 89.87,
   "say": "И вопросов становится только больше.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0.06,
   "t1": 1.66,
   "say": "Поиски идут до весны.",
   "gap": 0.46,
   "who": "narrator",
   "chapter": "6. Май"
  },
  {
   "src": "ch6.mp3",
   "t0": 2.02,
   "t1": 4.11,
   "say": "В мае снег начинает таять.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 4.58,
   "t1": 12.0,
   "say": "В русле ручья, в семидесяти пяти метрах от костра, под четырёхметровым слоем снега находят последних четверых.",
   "gap": 0.76,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 12.66,
   "t1": 13.82,
   "say": "Людмила Дубинина.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 14.07,
   "t1": 15.19,
   "say": "Семён Золотарёв.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 15.47,
   "t1": 16.91,
   "say": "Николай Тибо-Бриньоль.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 17.12,
   "t1": 18.35,
   "say": "Александр Колеватов.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 18.97,
   "t1": 22.16,
   "say": "На них больше одежды, чем на тех, кто погиб у костра.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 22.53,
   "t1": 24.39,
   "say": "У троих — тяжёлые травмы.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 24.77,
   "t1": 27.0,
   "say": "Переломы, как после сильного удара.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 27.4,
   "t1": 30.15,
   "say": "Такие травмы сравнивают с травмами при аварии.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 30.59,
   "t1": 33.33,
   "say": "На части вещей находят следы радиации.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 33.88,
   "t1": 38.82,
   "say": "Двадцать восьмого мая тысяча девятьсот пятьдесят девятого года дело закрывают.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 39.15,
   "t1": 46.11,
   "say": "Причина гибели в документе звучит так: «стихийная сила, преодолеть которую люди были не в состоянии».",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 46.57,
   "t1": 49.31,
   "say": "Какая именно сила — в деле не сказано.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 49.7,
   "t1": 54.98,
   "say": "Именно эта фраза и стала началом загадки, которой больше шестидесяти лет.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0,
   "t1": 3.27,
   "say": "За эти годы появилось больше семидесяти версий.",
   "gap": 0.45,
   "who": "narrator",
   "chapter": "7. Версии"
  },
  {
   "src": "ch7.mp3",
   "t0": 3.62,
   "t1": 6.96,
   "say": "В две тысячи девятнадцатом прокуратура вернулась к делу.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 7.37,
   "t1": 10.83,
   "say": "Из семидесяти пяти версий выбрали три главные.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 11.08,
   "t1": 13.56,
   "say": "И все три были связаны с погодой.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 14.17,
   "t1": 17.04,
   "say": "Давай разберём три самые известные версии.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 17.21,
   "t1": 19.42,
   "say": "И что говорит за и против каждой.",
   "gap": 0.83,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 20.15,
   "t1": 21.25,
   "say": "Версия первая.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 21.48,
   "t1": 22.15,
   "say": "Лавина.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 22.76,
   "t1": 26.2,
   "say": "В июле две тысячи двадцатого прокуратура объявила вывод.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 26.55,
   "t1": 30.51,
   "say": "Ночью на палатку сошла небольшая лавина — «снежная доска».",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 30.97,
   "t1": 38.38,
   "say": "Туристы разрезали палатку и отошли вниз, примерно на пятьдесят метров, к каменной гряде, где лавина их бы не достала.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 38.81,
   "t1": 42.57,
   "say": "А потом в темноте и метели не смогли найти палатку.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 42.93,
   "t1": 43.68,
   "say": "И замёрзли.",
   "gap": 0.76,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 44.34,
   "t1": 51.33,
   "say": "В две тысячи двадцать первом учёные из Швейцарии, Йохан Гом и Александр Пузрин, построили компьютерную модель.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 51.89,
   "t1": 55.23,
   "say": "Помнишь площадку, которую туристы вырезали в снегу под палатку?",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 55.78,
   "t1": 59.25,
   "say": "По их расчёту, этот вырез подрезал снежный пласт.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 59.53,
   "t1": 62.8,
   "say": "А ветер всю ночь наносил на склон новый снег.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 63.26,
   "t1": 69.36,
   "say": "Спустя от девяти до тринадцати часов кусок плотного наста мог съехать прямо на палатку.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 69.95,
   "t1": 75.13,
   "say": "Чтобы проверить травмы, учёные взяли данные краш-тестов автомобилей семидесятых годов.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 75.56,
   "t1": 77.46,
   "say": "И травмы в модели совпали.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 77.98,
   "t1": 83.21,
   "say": "Один из авторов сказал: если бы они не подрезали склон, ничего бы не случилось.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 83.84,
   "t1": 85.95,
   "say": "Но против тоже есть доводы.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 86.48,
   "t1": 89.43,
   "say": "Склон там пологий — меньше тридцати градусов.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 89.91,
   "t1": 93.17,
   "say": "Обычно считается, что лавины сходят на склонах круче.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 93.78,
   "t1": 96.64,
   "say": "Поисковики не увидели явных следов лавины.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 97.17,
   "t1": 101.46,
   "say": "Учёные отвечают: рядом с палаткой склон круче, чем в среднем.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 101.68,
   "t1": 104.63,
   "say": "А за три недели ветер мог замести все следы.",
   "gap": 0.77,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 105.3,
   "t1": 112.17,
   "say": "В две тысячи двадцать втором они ездили на перевал сами — и увидели, что снежные пласты там действительно сходят.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 112.68,
   "t1": 117.1,
   "say": "Но даже они честно пишут: мы не утверждаем, что раскрыли тайну.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 117.38,
   "t1": 119.27,
   "say": "Никто не выжил, чтобы рассказать.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 119.87,
   "t1": 124.04,
   "say": "А фонд памяти группы Дятлова с выводом прокуратуры не согласился.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 124.87,
   "t1": 126.02,
   "say": "Версия вторая.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 126.27,
   "t1": 127.85,
   "say": "Военные испытания.",
   "gap": 0.77,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 128.52,
   "t1": 134.62,
   "say": "В январе и феврале пятьдесят девятого в небе над этими местами не раз видели светящиеся шары.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 135.17,
   "t1": 138.84,
   "say": "Семнадцатого февраля такой шар видели сами поисковики.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 139.35,
   "t1": 143.47,
   "say": "Газета «Тагильский рабочий» написала о шаре размером с Луну.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 144.02,
   "t1": 151.36,
   "say": "Один из поисковиков позже говорил: когда по телевизору стали показывать запуски ракет, он узнал то, что видел в небе.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 152.0,
   "t1": 156.4,
   "say": "Добавь к этому радиацию на одежде и травмы, как после сильного удара.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 156.93,
   "t1": 162.91,
   "say": "Юдин до конца жизни считал, что его друзья случайно стали свидетелями секретных испытаний.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 163.39,
   "t1": 167.54,
   "say": "Но документов об испытаниях в эти дни в этом районе так и не нашли.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 168.08,
   "t1": 170.08,
   "say": "Прокуратура тоже не нашла улик.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 170.49,
   "t1": 171.71,
   "say": "Это гипотеза.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 172.52,
   "t1": 173.66,
   "say": "Версия третья.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 173.95,
   "t1": 176.38,
   "say": "Что-то, чего мы пока не понимаем.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 177.0,
   "t1": 182.74,
   "say": "В две тысячи тринадцатом американский писатель Донни Айкар выпустил книгу «Мёртвая гора».",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 182.9,
   "t1": 189.89,
   "say": "Вместе с учёными-метеорологами он предположил: ветер, обтекая гору, мог рождать инфразвук.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 190.21,
   "t1": 192.51,
   "say": "Это звук, которого не слышно ухом.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 192.92,
   "t1": 197.32,
   "say": "Но от него у человека может появиться необъяснимая тревога и страх.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 197.83,
   "t1": 202.77,
   "say": "Девять человек в темноте вдруг чувствуют ужас и не понимают почему.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 203.25,
   "t1": 205.25,
   "say": "Проверить это сегодня невозможно.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 205.57,
   "t1": 212.87,
   "say": "И ведь именно об этом говорят слова из дела: стихийная сила, преодолеть которую люди были не в состоянии.",
   "gap": 1.6,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.04,
   "t1": 1.7,
   "say": "Так что же мы знаем точно?",
   "gap": 0.63,
   "who": "narrator",
   "chapter": "8. Финал"
  },
  {
   "src": "ch8.mp3",
   "t0": 2.23,
   "t1": 6.01,
   "say": "Девять опытных туристов ночью разрезали палатку изнутри.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 6.42,
   "t1": 8.45,
   "say": "Ушли в мороз почти без одежды.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 8.8,
   "t1": 10.2,
   "say": "Развели костёр у кедра.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 10.59,
   "t1": 11.73,
   "say": "Пытались вернуться.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 12.1,
   "t1": 13.0,
   "say": "И не вернулись.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 13.57,
   "t1": 14.77,
   "say": "Чего мы не знаем?",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 15.15,
   "t1": 16.84,
   "say": "Что заставило их уйти.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 17.37,
   "t1": 22.07,
   "say": "Перевал рядом с тем склоном сегодня называется их именем — перевал Дятлова.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 22.48,
   "t1": 24.39,
   "say": "Туда до сих пор приходят туристы.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 24.58,
   "t1": 25.62,
   "say": "Ставят палатки.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 25.92,
   "t1": 27.91,
   "say": "И долго смотрят на этот склон.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 28.51,
   "t1": 28.95,
   "say": "Игорь.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 29.13,
   "t1": 29.74,
   "say": "Зина.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 29.87,
   "t1": 30.46,
   "say": "Люда.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 30.63,
   "t1": 31.39,
   "say": "Александр.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 31.52,
   "t1": 32.23,
   "say": "Рустем.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 32.3,
   "t1": 32.89,
   "say": "Юрий.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 32.98,
   "t1": 33.58,
   "say": "Юрий.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 33.68,
   "t1": 34.4,
   "say": "Николай.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 34.51,
   "t1": 35.07,
   "say": "Семён.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 35.67,
   "t1": 38.13,
   "say": "А ты как думаешь, что случилось той ночью?",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 38.59,
   "t1": 40.9,
   "say": "А — лавина, снежная доска.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 41.27,
   "t1": 43.29,
   "say": "Б — военные испытания.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 43.63,
   "t1": 46.8,
   "say": "В — что-то, чего мы до сих пор не понимаем.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 47.23,
   "t1": 48.76,
   "say": "Напиши букву в комментариях.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 48.91,
   "t1": 50.21,
   "say": "Мы прочитаем каждый.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 50.54,
   "t1": 53.53,
   "say": "И подпишись, чтобы не пропустить следующую загадку.",
   "gap": 1.6,
   "who": "narrator"
  }
 ]
}