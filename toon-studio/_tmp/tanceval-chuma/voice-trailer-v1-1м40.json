{
 "dir": "public/tanceval-chuma/el",
 "lead": 0.0,
 "tail": 0.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "trailer-loop.mp3",
   "t0": 6.29,
   "t1": 9.2,
   "say": "Летом тысяча пятьсот восемнадцатого года.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 2.79,
   "t1": 4.14,
   "say": "Город Страсбург.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.615,
   "t1": 14.585,
   "say": "А на помосте танцуют люди.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 16.565,
   "t1": 18.645,
   "say": "Они танцуют уже не первый день.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 19.015,
   "t1": 20.225,
   "say": "Их лица серые.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 20.385,
   "t1": 21.775,
   "say": "Глаза пустые.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.145,
   "t1": 23.395,
   "say": "Ноги распухли.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 32.655,
   "t1": 34.905,
   "say": "Никто из них не хочет танцевать.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.095,
   "t1": 37.265,
   "say": "Но никто не может остановиться.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.665,
   "t1": 41.505,
   "say": "А самое странное — музыкантов позвал сам город.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 41.775,
   "t1": 45.105,
   "say": "Власти решили, что так людей можно вылечить.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 7.785,
   "t1": 9.745,
   "say": "Из дома выходит женщина.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 20.285,
   "t1": 22.425,
   "say": "И начинает танцевать.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 22.585,
   "t1": 23.555,
   "say": "Музыки нет.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 26.585,
   "t1": 28.165,
   "say": "Она просто танцует.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 45.735,
   "t1": 48.735,
   "say": "А утром встаёт — и снова танцует.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 10.745,
   "t1": 15.295,
   "say": "Через несколько дней в Страсбурге танцуют уже больше тридцати человек.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 22.105,
   "t1": 25.155,
   "say": "Они просто начинают — и не могут перестать.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 25.695,
   "t1": 31.425,
   "say": "Одна семейная хроника тех лет пишет: через месяц танцевали четыреста человек.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 56.075,
   "t1": 58.305,
   "say": "А вдруг я следующий?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 28.365,
   "t1": 33.605,
   "say": "Раз кровь перегрета танцем — пусть люди вытанцуют болезнь до конца.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.815,
   "t1": 36.665,
   "say": "Пусть танцуют, пока жар не выйдет сам.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 36.825,
   "t1": 38.725,
   "say": "И совет соглашается.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 76.115,
   "t1": 78.395,
   "say": "Музыка гремит на весь город.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 94.575,
   "t1": 98.755,
   "say": "И люди из толпы один за другим начинают танцевать сами.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 99.105,
   "t1": 100.625,
   "say": "Лекарство не лечит.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 100.815,
   "t1": 102.515,
   "say": "Оно разносит болезнь.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 5.065,
   "t1": 8.825,
   "say": "На пике умирало до пятнадцати человек в день.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 25.9,
   "t1": 27.775,
   "say": "Но здесь есть проблема.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 43.855,
   "t1": 45.645,
   "say": "О смертях они молчат.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 80.335,
   "t1": 82.035,
   "say": "Может быть, погибли сотни.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 82.23,
   "t1": 83.865,
   "say": "А может быть, ни одного.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 0.0,
   "t1": 1.7,
   "say": "Так что же это было?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 1.8,
   "t1": 4.45,
   "say": "Ответ — в полном видео на канале.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 4.5,
   "t1": 6.29,
   "say": "Потому что всё началось…",
   "gap": 0.0,
   "who": "narrator"
  }
 ]
}