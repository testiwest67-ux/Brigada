   "who": "eva",
   "fx": "volume=3.255,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N3a.mp3",
   "t0": 0.05,
   "t1": 1.65,
   "say": "По спине бегут мурашки.",
   "gap": 0.74,
   "who": "narrator",
   "chapter": "N3"
  },
  {
   "src": "N3a.mp3",
   "t0": 2.29,
   "t1": 3.52,
   "say": "Ты обходишь квартиру.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 3.9,
   "t1": 4.49,
   "say": "Кухня.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 4.69,
   "t1": 5.45,
   "say": "Ванная.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 5.61,
   "t1": 6.12,
   "say": "Шкаф.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 6.58,
   "t1": 7.16,
   "say": "Никого.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 7.61,
   "t1": 8.98,
   "say": "«Ева, где он?»",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "EVAa.mp3",
   "t0": 2.97,
   "t1": 4.31,
   "say": "Он просит не говорить.",
