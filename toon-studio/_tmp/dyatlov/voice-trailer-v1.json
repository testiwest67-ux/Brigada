{
 "dir": "public/dyatlov/el",
 "lead": 0.3,
 "tail": 2,
 "tempo": 1,
 "lines": [
  {
   "src": "trailer.mp3",
   "t0": 0,
   "t1": 2.62,
   "say": "Девять человек разрезали свою палатку.",
   "gap": 0.42,
   "who": "narrator",
   "chapter": "Трейлер"
  },
  {
   "src": "trailer.mp3",
   "t0": 2.94,
   "t1": 3.61,
   "say": "Изнутри.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 3.99,
   "t1": 5.08,
   "say": "И ушли в мороз.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 5.38,
   "t1": 6.47,
   "say": "Почти раздетыми.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 7.03,
   "t1": 9.5,
   "say": "Февраль тысяча девятьсот пятьдесят девятого.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 9.68,
   "t1": 10.73,
   "say": "Северный Урал.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 11.1,
   "t1": 12.23,
   "say": "Опытные туристы.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 12.5,
   "t1": 15.29,
   "say": "Студенты и выпускники Уральского политеха.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 15.62,
   "t1": 17.06,
   "say": "Их вёл Игорь Дятлов.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 17.5,
   "t1": 19.11,
   "say": "Сначала их было десять.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 19.39,
   "t1": 21.4,
   "say": "Один заболел и повернул назад.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 21.71,
   "t1": 23.24,
   "say": "Только поэтому он выжил.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 23.61,
   "t1": 25.14,
   "say": "Девять пошли дальше.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 25.35,
   "t1": 28.91,
   "say": "К горе, которую местные манси называют Холатчахль.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 29.27,
   "t1": 32.55,
   "say": "Это название часто переводят как «Мёртвая вершина».",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 33.01,
   "t1": 36.75,
   "say": "Первого февраля они ставят палатку прямо на открытом склоне.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 37.07,
   "t1": 39.65,
   "say": "А через три недели её находят спасатели.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 40.06,
   "t1": 42.89,
   "say": "Палатка наполовину в снегу.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 43.06,
   "t1": 45.06,
   "say": "Внутри — одежда, обувь, еда.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 45.34,
   "t1": 46.23,
   "say": "Всё на месте.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 46.6,
   "t1": 47.71,
   "say": "Нет только людей.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 48.16,
   "t1": 51.15,
   "say": "Вниз по склону уходят следы девяти человек.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 51.45,
   "t1": 53.2,
   "say": "Многие — в одних носках.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 53.53,
   "t1": 56.27,
   "say": "А ночью там было около минус тридцати.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 56.54,
   "t1": 59.38,
   "say": "И ветер, от которого трудно устоять на ногах.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 59.89,
   "t1": 61.75,
   "say": "Первых нашли у старого кедра.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 61.93,
   "t1": 63.07,
   "say": "Почти без одежды.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 63.41,
   "t1": 65.06,
   "say": "Рядом — остатки костра.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 65.49,
   "t1": 68.53,
   "say": "Последних — только в мае, когда растаял снег.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 68.88,
   "t1": 71.54,
   "say": "На некоторых вещах нашли следы радиации.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 71.99,
   "t1": 74.13,
   "say": "Дело закрыли через четыре месяца.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 74.43,
   "t1": 81.85,
   "say": "Причину назвали одной странной фразой: «Стихийная сила, преодолеть которую люди были не в состоянии».",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 82.33,
   "t1": 83.62,
   "say": "Что это за сила?",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 84.07,
   "t1": 87.25,
   "say": "Шестьдесят лет спустя прокуратура снова открыла дело.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 87.57,
   "t1": 89.71,
   "say": "Учёные построили модель склона.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 89.95,
   "t1": 91.32,
   "say": "Но спорят до сих пор.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 91.6,
   "t1": 94.11,
   "say": "Что выгнало их из палатки в ту ночь?",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 94.54,
   "t1": 98.32,
   "say": "Три главные версии — и ты решишь, какая ближе к правде.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 98.69,
   "t1": 100.58,
   "say": "Полное расследование — на канале.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 100.71,
   "t1": 101.87,
   "say": "Ссылка в профиле.",
   "gap": 0.6,
   "who": "narrator"
  }
 ]
}