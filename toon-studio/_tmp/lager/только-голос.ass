Dialogue: 0,0:00:01.00,0:00:03.08,N,,0,0,0,,1
Dialogue: 0,0:00:01.00,0:00:03.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:01.00,0:00:03.08,T,,0,0,0,,Август восемьдесят шестого.
Dialogue: 0,0:00:03.10,0:00:05.24,N,,0,0,0,,2
Dialogue: 0,0:00:03.10,0:00:05.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:03.10,0:00:05.24,T,,0,0,0,,Летний лагерь «Ласточка».
Dialogue: 0,0:00:05.26,0:00:07.54,N,,0,0,0,,3
Dialogue: 0,0:00:05.26,0:00:07.54,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:05.26,0:00:07.54,T,,0,0,0,,Ты вожатый первого отряда.
Dialogue: 0,0:00:07.56,0:00:09.28,N,,0,0,0,,4
Dialogue: 0,0:00:07.56,0:00:09.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:07.56,0:00:09.28,T,,0,0,0,,Вечерняя перекличка.
Dialogue: 0,0:00:09.30,0:00:11.81,N,,0,0,0,,5
Dialogue: 0,0:00:09.30,0:00:11.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:09.30,0:00:11.81,T,,0,0,0,,В списке двенадцать детей.
Dialogue: 0,0:00:11.83,0:00:13.27,N,,0,0,0,,6
Dialogue: 0,0:00:11.83,0:00:13.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:11.83,0:00:13.27,T,,0,0,0,,Ты считаешь.
Dialogue: 0,0:00:13.29,0:00:14.97,N,,0,0,0,,7
Dialogue: 0,0:00:13.29,0:00:14.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:13.29,0:00:14.97,T,,0,0,0,,Тринадцать.
Dialogue: 0,0:00:14.99,0:00:16.54,N,,0,0,0,,8
Dialogue: 0,0:00:14.99,0:00:16.54,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:14.99,0:00:16.54,T,,0,0,0,,Пересчитываешь.
Dialogue: 0,0:00:16.56,0:00:18.39,N,,0,0,0,,9
Dialogue: 0,0:00:16.56,0:00:18.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:16.56,0:00:18.39,T,,0,0,0,,Тринадцать.
Dialogue: 0,0:00:18.41,0:00:20.40,N,,0,0,0,,10
Dialogue: 0,0:00:18.41,0:00:20.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:18.41,0:00:20.40,T,,0,0,0,,Ты читаешь список вслух.
Dialogue: 0,0:00:20.42,0:00:23.58,N,,0,0,0,,11
Dialogue: 0,0:00:20.42,0:00:23.58,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:20.42,0:00:23.58,T,,0,0,0,,Двенадцать имён — двенадцать «я».
Dialogue: 0,0:00:23.60,0:00:25.96,N,,0,0,0,,12
Dialogue: 0,0:00:23.60,0:00:25.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:23.60,0:00:25.96,T,,0,0,0,,Ни одного лишнего голоса.
Dialogue: 0,0:00:25.98,0:00:28.99,N,,0,0,0,,13
Dialogue: 0,0:00:25.98,0:00:28.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:25.98,0:00:28.99,T,,0,0,0,,А тринадцатый просто стоит среди них.
Dialogue: 0,0:00:29.01,0:00:32.10,N,,0,0,0,,14
Dialogue: 0,0:00:29.01,0:00:32.10,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:29.01,0:00:32.10,T,,0,0,0,,И ты не можешь понять, кто это.
Dialogue: 0,0:00:32.12,0:00:35.17,N,,0,0,0,,15
Dialogue: 0,0:00:32.12,0:00:35.17,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:32.12,0:00:35.17,T,,0,0,0,,Ночью к тебе приходит сторож, дядя Гриша.
Dialogue: 0,0:00:35.19,0:00:37.95,N,,0,0,0,,16
Dialogue: 0,0:00:35.19,0:00:37.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:35.19,0:00:37.95,T,,0,0,0,,Он работает здесь сорок лет.
Dialogue: 0,0:00:37.97,0:00:39.78,N,,0,0,0,,17
Dialogue: 0,0:00:37.97,0:00:39.78,W,,0,0,0,,сторож
Dialogue: 0,0:00:37.97,0:00:39.78,T,,0,0,0,,Тоже насчитал лишнего?
Dialogue: 0,0:00:39.80,0:00:41.25,N,,0,0,0,,18
Dialogue: 0,0:00:39.80,0:00:41.25,W,,0,0,0,,сторож
Dialogue: 0,0:00:39.80,0:00:41.25,T,,0,0,0,,Тогда слушай.
Dialogue: 0,0:00:41.27,0:00:42.25,N,,0,0,0,,19
Dialogue: 0,0:00:41.27,0:00:42.25,W,,0,0,0,,сторож
Dialogue: 0,0:00:41.27,0:00:42.25,T,,0,0,0,,Первое.
Dialogue: 0,0:00:42.27,0:00:44.08,N,,0,0,0,,20
Dialogue: 0,0:00:42.27,0:00:44.08,W,,0,0,0,,сторож
Dialogue: 0,0:00:42.27,0:00:44.08,T,,0,0,0,,Не показывай, что считаешь.
Dialogue: 0,0:00:44.10,0:00:45.50,N,,0,0,0,,21
Dialogue: 0,0:00:44.10,0:00:45.50,W,,0,0,0,,сторож
Dialogue: 0,0:00:44.10,0:00:45.50,T,,0,0,0,,Он поймёт.
Dialogue: 0,0:00:45.52,0:00:46.41,N,,0,0,0,,22
Dialogue: 0,0:00:45.52,0:00:46.41,W,,0,0,0,,сторож
Dialogue: 0,0:00:45.52,0:00:46.41,T,,0,0,0,,Второе.
Dialogue: 0,0:00:46.43,0:00:48.15,N,,0,0,0,,23
Dialogue: 0,0:00:46.43,0:00:48.15,W,,0,0,0,,сторож
Dialogue: 0,0:00:46.43,0:00:48.15,T,,0,0,0,,Не называй его по имени.
Dialogue: 0,0:00:48.17,0:00:50.35,N,,0,0,0,,24
Dialogue: 0,0:00:48.17,0:00:50.35,W,,0,0,0,,сторож
Dialogue: 0,0:00:48.17,0:00:50.35,T,,0,0,0,,Имя он заберёт себе.
Dialogue: 0,0:00:50.37,0:00:51.27,N,,0,0,0,,25
Dialogue: 0,0:00:50.37,0:00:51.27,W,,0,0,0,,сторож
Dialogue: 0,0:00:50.37,0:00:51.27,T,,0,0,0,,Третье.
Dialogue: 0,0:00:51.29,0:00:52.76,N,,0,0,0,,26
Dialogue: 0,0:00:51.29,0:00:52.76,W,,0,0,0,,сторож
Dialogue: 0,0:00:51.29,0:00:52.76,T,,0,0,0,,Найди до рассвета.
Dialogue: 0,0:00:52.78,0:00:55.24,N,,0,0,0,,27
Dialogue: 0,0:00:52.78,0:00:55.24,W,,0,0,0,,сторож
Dialogue: 0,0:00:52.78,0:00:55.24,T,,0,0,0,,Иначе утром их снова будет двенадцать.
Dialogue: 0,0:00:55.26,0:00:57.70,N,,0,0,0,,28
Dialogue: 0,0:00:55.26,0:00:57.70,W,,0,0,0,,сторож
Dialogue: 0,0:00:55.26,0:00:57.70,T,,0,0,0,,Только без одного из твоих.
Dialogue: 0,0:00:57.72,0:01:00.34,N,,0,0,0,,29
Dialogue: 0,0:00:57.72,0:01:00.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:57.72,0:01:00.34,T,,0,0,0,,Ты смотришь на отряд по-новому.
Dialogue: 0,0:01:00.36,0:01:01.61,N,,0,0,0,,30
Dialogue: 0,0:01:00.36,0:01:01.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:00.36,0:01:01.61,T,,0,0,0,,Номер один.
Dialogue: 0,0:01:01.63,0:01:02.59,N,,0,0,0,,31
Dialogue: 0,0:01:01.63,0:01:02.59,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:01.63,0:01:02.59,T,,0,0,0,,Вова.
Dialogue: 0,0:01:02.61,0:01:04.71,N,,0,0,0,,32
Dialogue: 0,0:01:02.61,0:01:04.71,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:02.61,0:01:04.71,T,,0,0,0,,Он ни разу не ел в столовой.
Dialogue: 0,0:01:04.73,0:01:06.60,N,,0,0,0,,33
Dialogue: 0,0:01:04.73,0:01:06.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:04.73,0:01:06.60,T,,0,0,0,,Ни крошки.
Dialogue: 0,0:01:06.62,0:01:07.69,N,,0,0,0,,34
Dialogue: 0,0:01:06.62,0:01:07.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:06.62,0:01:07.69,T,,0,0,0,,Номер два.
Dialogue: 0,0:01:07.71,0:01:08.58,N,,0,0,0,,35
Dialogue: 0,0:01:07.71,0:01:08.58,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:07.71,0:01:08.58,T,,0,0,0,,Лена.
Dialogue: 0,0:01:08.60,0:01:10.48,N,,0,0,0,,36
Dialogue: 0,0:01:08.60,0:01:10.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:08.60,0:01:10.48,T,,0,0,0,,Знает всех по именам.
Dialogue: 0,0:01:10.50,0:01:13.41,N,,0,0,0,,37
Dialogue: 0,0:01:10.50,0:01:13.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:10.50,0:01:13.41,T,,0,0,0,,Но никто не помнит, как она приехала.
Dialogue: 0,0:01:13.43,0:01:14.47,N,,0,0,0,,38
Dialogue: 0,0:01:13.43,0:01:14.47,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:13.43,0:01:14.47,T,,0,0,0,,Номер три.
Dialogue: 0,0:01:14.49,0:01:15.44,N,,0,0,0,,39
Dialogue: 0,0:01:14.49,0:01:15.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:14.49,0:01:15.44,T,,0,0,0,,Миша.
Dialogue: 0,0:01:15.46,0:01:17.95,N,,0,0,0,,40
Dialogue: 0,0:01:15.46,0:01:17.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:15.46,0:01:17.95,T,,0,0,0,,В полночь он возвращается с озера.
Dialogue: 0,0:01:17.97,0:01:19.31,N,,0,0,0,,41
Dialogue: 0,0:01:17.97,0:01:19.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:17.97,0:01:19.31,T,,0,0,0,,Волосы мокрые.
Dialogue: 0,0:01:19.33,0:01:21.64,N,,0,0,0,,42
Dialogue: 0,0:01:19.33,0:01:21.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:19.33,0:01:21.64,T,,0,0,0,,А купаться запрещено.
Dialogue: 0,0:01:21.66,0:01:22.92,N,,0,0,0,,43
Dialogue: 0,0:01:21.66,0:01:22.92,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:21.66,0:01:22.92,T,,0,0,0,,Номер четыре.
Dialogue: 0,0:01:22.94,0:01:24.03,N,,0,0,0,,44
Dialogue: 0,0:01:22.94,0:01:24.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:22.94,0:01:24.03,T,,0,0,0,,Оля.
Dialogue: 0,0:01:24.05,0:01:24.90,N,,0,0,0,,45
Dialogue: 0,0:01:24.05,0:01:24.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:24.05,0:01:24.90,T,,0,0,0,,Тихая.
Dialogue: 0,0:01:24.92,0:01:25.98,N,,0,0,0,,46
Dialogue: 0,0:01:24.92,0:01:25.98,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:24.92,0:01:25.98,T,,0,0,0,,Обычная.
Dialogue: 0,0:01:26.00,0:01:28.34,N,,0,0,0,,47
Dialogue: 0,0:01:26.00,0:01:28.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:26.00,0:01:28.34,T,,0,0,0,,Всегда рядом с тобой.
Dialogue: 0,0:01:28.36,0:01:29.76,N,,0,0,0,,48
Dialogue: 0,0:01:28.36,0:01:29.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:28.36,0:01:29.76,T,,0,0,0,,Последний вечер.
Dialogue: 0,0:01:29.78,0:01:30.78,N,,0,0,0,,49
Dialogue: 0,0:01:29.78,0:01:30.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:29.78,0:01:30.78,T,,0,0,0,,Костёр.
Dialogue: 0,0:01:30.80,0:01:32.31,N,,0,0,0,,50
Dialogue: 0,0:01:30.80,0:01:32.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:30.80,0:01:32.31,T,,0,0,0,,Все поют.
Dialogue: 0,0:01:32.33,0:01:34.47,N,,0,0,0,,51
Dialogue: 0,0:01:32.33,0:01:34.47,W,,0,0,0,,сторож
Dialogue: 0,0:01:32.33,0:01:34.47,T,,0,0,0,,Смотри на тени.
Dialogue: 0,0:01:34.49,0:01:36.21,N,,0,0,0,,52
Dialogue: 0,0:01:34.49,0:01:36.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:34.49,0:01:36.21,T,,0,0,0,,Огонь прыгает.
Dialogue: 0,0:01:36.23,0:01:38.20,N,,0,0,0,,53
Dialogue: 0,0:01:36.23,0:01:38.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:36.23,0:01:38.20,T,,0,0,0,,Тени дрожат на песке.
Dialogue: 0,0:01:38.22,0:01:40.46,N,,0,0,0,,54
Dialogue: 0,0:01:38.22,0:01:40.46,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:38.22,0:01:40.46,T,,0,0,0,,Ты всматриваешься…
Dialogue: 0,0:01:40.48,0:01:43.18,N,,0,0,0,,55
Dialogue: 0,0:01:40.48,0:01:43.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:40.48,0:01:43.18,T,,0,0,0,,И костёр гаснет.
Dialogue: 0,0:01:43.20,0:01:45.95,N,,0,0,0,,56
Dialogue: 0,0:01:43.20,0:01:45.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:43.20,0:01:45.95,T,,0,0,0,,В темноте кто-то берёт тебя за руку.
Dialogue: 0,0:01:45.97,0:01:48.81,N,,0,0,0,,57
Dialogue: 0,0:01:45.97,0:01:48.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:45.97,0:01:48.81,T,,0,0,0,,Маленькая холодная ладонь.
Dialogue: 0,0:01:48.83,0:01:50.54,N,,0,0,0,,58
Dialogue: 0,0:01:48.83,0:01:50.54,W,,0,0,0,,ребёнок
Dialogue: 0,0:01:48.83,0:01:50.54,T,,0,0,0,,Вожатый…
Dialogue: 0,0:01:50.56,0:01:53.33,N,,0,0,0,,59
Dialogue: 0,0:01:50.56,0:01:53.33,W,,0,0,0,,ребёнок
Dialogue: 0,0:01:50.56,0:01:53.33,T,,0,0,0,,а ты нас посчитал?
Dialogue: 0,0:01:53.35,0:01:54.96,N,,0,0,0,,60
Dialogue: 0,0:01:53.35,0:01:54.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:53.35,0:01:54.96,T,,0,0,0,,До рассвета час.
Dialogue: 0,0:01:54.98,0:01:56.48,N,,0,0,0,,61
Dialogue: 0,0:01:54.98,0:01:56.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:54.98,0:01:56.48,T,,0,0,0,,Ошибиться нельзя.
Dialogue: 0,0:01:56.50,0:02:00.28,N,,0,0,0,,62
Dialogue: 0,0:01:56.50,0:02:00.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:56.50,0:02:00.28,T,,0,0,0,,Выгонишь не того — и ребёнок уйдёт в лес один.
Dialogue: 0,0:02:00.30,0:02:04.04,N,,0,0,0,,63
Dialogue: 0,0:02:00.30,0:02:04.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:00.30,0:02:04.04,T,,0,0,0,,Номер один, два, три или четыре?
Dialogue: 0,0:02:04.06,0:02:05.42,N,,0,0,0,,64
Dialogue: 0,0:02:04.06,0:02:05.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:04.06,0:02:05.42,T,,0,0,0,,Пересмотри костёр.
Dialogue: 0,0:02:05.44,0:02:07.02,N,,0,0,0,,65
Dialogue: 0,0:02:05.44,0:02:07.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:05.44,0:02:07.02,T,,0,0,0,,Подсказка там.
Dialogue: 0,0:02:07.03,0:02:08.76,N,,0,0,0,,66
Dialogue: 0,0:02:07.03,0:02:08.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:07.03,0:02:08.76,T,,0,0,0,,Пиши номер в комментариях.
Dialogue: 0,0:02:08.78,0:02:13.88,N,,0,0,0,,67
Dialogue: 0,0:02:08.78,0:02:13.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:08.78,0:02:13.88,T,,0,0,0,,Что будет дальше — решите вы.
