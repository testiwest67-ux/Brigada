    {
     "w": "стук.",
     "t": 17.533
    }
   ]
  },
  {
   "i": 9,
   "text": "Два… и один.",
   "start": 18.038,
   "end": 19.517,
   "who": "narrator",
   "words": [
    {
     "w": "Два…",
     "t": 18.058
