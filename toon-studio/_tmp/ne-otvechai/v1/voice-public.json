     "w": "тебя",
     "t": 13.238
    },
    {
     "w": "по",
     "t": 13.538
    },
    {
     "w": "имени…",
     "t": 13.678
    }
   ]
  },
  {
   "i": 7,
   "text": "НИКОГДА не отвечай.",
   "start": 14.431,
   "end": 16.173,
   "who": "narrator",
   "words": [
