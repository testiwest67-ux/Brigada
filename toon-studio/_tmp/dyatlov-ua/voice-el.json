{
 "dir": "public/dyatlov-ua/el",
 "lead": 0.5,
 "tail": 2.0,
 "tempo": 1.06,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0,
   "t1": 2.75,
   "say": "Лютий тисяча дев'ятсот п'ятдесят дев'ятого.",
   "gap": 0.31,
   "who": "narrator",
   "chapter": "Трейлер"
  },
  {
   "src": "ch0.mp3",
   "t0": 2.96,
   "t1": 4.07,
   "say": "Північний Урал.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.52,
   "t1": 6.41,
   "say": "На схилі гори стоїть намет.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 6.67,
   "t1": 9.85,
   "say": "Його наполовину замело снігом.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 9.97,
   "t1": 12.07,
   "say": "Усередині — одяг, взуття, їжа.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.3,
   "t1": 13.35,
   "say": "Усе на місці.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 13.61,
   "t1": 14.98,
   "say": "Немає лише людей.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 15.37,
   "t1": 17.11,
   "say": "Стінку намету розрізано.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 17.29,
   "t1": 18.14,
   "say": "Зсередини.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.47,
   "t1": 22.71,
   "say": "А вниз по схилу, у темряву, ведуть сліди дев'ятьох людей.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.03,
   "t1": 25.0,
   "say": "Багато хто — без взуття.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 25.22,
   "t1": 26.54,
   "say": "В одних шкарпетках.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 26.91,
   "t1": 29.49,
   "say": "Тієї ночі було близько мінус тридцяти.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 29.84,
   "t1": 32.94,
   "say": "І вітер, від якого важко встояти на ногах.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 33.24,
   "t1": 35.14,
   "say": "Це були досвідчені туристи.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.44,
   "t1": 38.98,
   "say": "Вони знали: без намету в таку ніч не вижити.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 39.31,
   "t1": 41.05,
   "say": "І все ж вони пішли.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 41.53,
   "t1": 44.49,
   "say": "Слідство закрило справу через чотири місяці.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 44.83,
   "t1": 49.8,
   "say": "Причину назвало так: «стихійна сила, подолати яку люди не могли».",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.25,
   "t1": 50.94,
   "say": "Лавина?",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 51.2,
   "t1": 52.72,
   "say": "Військові випробування?",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 52.93,
   "t1": 55.39,
   "say": "Чи щось, чого ми досі не розуміємо?",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 55.73,
   "t1": 63.33,
   "say": "Повну історію — день за днем, за щоденниками й документами — дивись у нашому новому відео.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 63.5,
   "t1": 64.61,
   "say": "А ти як думаєш?",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 64.8,
   "t1": 66.42,
   "say": "Пиши в коментарях: А, Б чи В.",
   "gap": 0.3,
   "who": "narrator"
  }
 ]
}