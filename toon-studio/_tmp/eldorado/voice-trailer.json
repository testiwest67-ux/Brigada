{
 "dir": "public/eldorado/el",
 "lead": 0.3,
 "tail": 2.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "trailer.mp3",
   "t0": 0.06,
   "t1": 2.93,
   "say": "Всё, что ты знаешь об Эльдорадо, — ошибка.",
   "gap": 0.54,
   "who": "narrator",
   "chapter": "Трейлер"
  },
  {
   "src": "trailer.mp3",
   "t0": 3.37,
   "t1": 4.28,
   "say": "Это не город.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 4.51,
   "t1": 5.88,
   "say": "Не золотые улицы.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 6.02,
   "t1": 7.45,
   "say": "Не крыши из золота.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 7.86,
   "t1": 9.46,
   "say": "Это был человек.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 10.01,
   "t1": 15.52,
   "say": "Высоко в горах Колумбии нового правителя мазали смолой и осыпали золотой пылью.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 15.67,
   "t1": 17.0,
   "say": "С головы до ног.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 17.38,
   "t1": 19.82,
   "say": "Он выплывал на плоту на середину озера.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 19.92,
   "t1": 22.33,
   "say": "Бросал в воду золото и изумруды.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 22.58,
   "t1": 24.19,
   "say": "А потом нырял сам.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 24.67,
   "t1": 28.44,
   "say": "Испанцы услышали эту историю — и не смогли её забыть.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 28.85,
   "t1": 29.92,
   "say": "Пятьсот лет.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 30.26,
   "t1": 32.65,
   "say": "Они шли за золотым городом в джунгли.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 32.8,
   "t1": 34.16,
   "say": "Целыми армиями.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 34.48,
   "t1": 38.21,
   "say": "Четыре тысячи человек погибли в одной только экспедиции.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 38.51,
   "t1": 42.35,
   "say": "Они ели лошадей, собак, а потом ремни и подошвы.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 42.74,
   "t1": 48.82,
   "say": "Один испанец случайно проплыл всю Амазонку — и рассказал о многолюдных городах на берегах.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 49.2,
   "t1": 52.71,
   "say": "Но когда туда пришли другие, там были только джунгли.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 53.09,
   "t1": 54.86,
   "say": "Его назвали лжецом.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 55.31,
   "t1": 60.84,
   "say": "Один солдат сошёл с ума, назвал себя «Гнев Божий» и убил собственную дочь.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 61.19,
   "t1": 66.52,
   "say": "Знаменитому английскому мореплавателю отрубили голову, потому что он не привёз золото.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 66.98,
   "t1": 68.66,
   "say": "Озеро пытались осушить.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 68.8,
   "t1": 69.61,
   "say": "Дважды.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 69.81,
   "t1": 71.71,
   "say": "И дно превратилось в камень.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 72.0,
   "t1": 73.8,
   "say": "Теперь его трогать запрещено.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 74.18,
   "t1": 76.04,
   "say": "А золото всё ещё там.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 76.55,
   "t1": 81.56,
   "say": "В тысяча девятьсот двадцать пятом году полковник ушёл в джунгли искать затерянный город.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 81.93,
   "t1": 84.51,
   "say": "Его больше никто никогда не видел.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 84.86,
   "t1": 87.38,
   "say": "Все решили: Эльдорадо — сказка.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 87.87,
   "t1": 93.17,
   "say": "А в две тысячи двадцать четвёртом году учёные посветили лазером сквозь джунгли Амазонии.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 93.41,
   "t1": 96.4,
   "say": "И увидели то, чего там быть не могло.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 96.88,
   "t1": 97.87,
   "say": "Что они нашли?",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 98.13,
   "t1": 100.32,
   "say": "И где на самом деле Эльдорадо?",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 100.77,
   "t1": 102.61,
   "say": "Полное расследование — на канале.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "trailer.mp3",
   "t0": 102.8,
   "t1": 103.94,
   "say": "Ссылка в профиле.",
   "gap": 0.6,
   "who": "narrator"
  }
 ]
}