{
 "dir": "public/flannan/el",
 "lead": 3.0,
 "tail": 10.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0,
   "t1": 3.17,
   "say": "Двадцать шестое декабря тысяча девятисотого года.",
   "gap": 0.4,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 3.47,
   "t1": 4.25,
   "say": "Шотландия.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.53,
   "t1": 6.16,
   "say": "Холодное северное море.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 6.84,
   "t1": 10.22,
   "say": "К маленькому скалистому острову подходит судно снабжения.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 10.66,
   "t1": 11.87,
   "say": "Его здесь ждут.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.32,
   "t1": 13.27,
   "say": "Должны ждать.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 13.88,
   "t1": 18.13,
   "say": "Судно везёт продукты, письма и смену — четвёртого смотрителя.",
   "gap": 0.77,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.8,
   "t1": 20.07,
   "say": "Капитан даёт гудок.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 20.49,
   "t1": 21.24,
   "say": "Ещё раз.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 21.7,
   "t1": 23.24,
   "say": "Пускает сигнальную ракету.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.86,
   "t1": 24.76,
   "say": "Ответа нет.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 25.22,
   "t1": 26.83,
   "say": "На флагштоке нет флага.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 27.14,
   "t1": 29.29,
   "say": "На причале никто не машет рукой.",
   "gap": 0.89,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 30.08,
   "t1": 32.83,
   "say": "На берег высаживается смотритель Джозеф Мур.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 33.31,
   "t1": 35.66,
   "say": "Он поднимается по крутой лестнице к маяку.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 36.17,
   "t1": 37.19,
   "say": "Ворота закрыты.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.6,
   "t1": 38.6,
   "say": "Дверь закрыта.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 39.08,
   "t1": 40.28,
   "say": "Внутри тихо.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 40.81,
   "t1": 42.82,
   "say": "Лампы почищены и заправлены.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 43.15,
   "t1": 44.24,
   "say": "На кухне порядок.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 44.63,
   "t1": 46.09,
   "say": "Часы на стене стоят.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 46.5,
   "t1": 49.09,
   "say": "А на крючке висит непромокаемый плащ.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 49.71,
   "t1": 50.28,
   "say": "Один.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.86,
   "t1": 53.2,
   "say": "Трое смотрителей маяка исчезли.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 53.52,
   "t1": 56.88,
   "say": "С крошечного острова, с которого некуда уйти.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 57.49,
   "t1": 60.36,
   "say": "Их больше никто никогда не видел.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 61.2,
   "t1": 63.32,
   "say": "Прошло больше ста двадцати лет.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 63.82,
   "t1": 68.89,
   "say": "Об этом острове написали стихи, сняли фильм, сочинили десятки легенд.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 69.54,
   "t1": 71.08,
   "say": "Давай разберёмся по порядку.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 71.29,
   "t1": 74.59,
   "say": "По отчёту, который написали через три дня после находки.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 74.88,
   "t1": 75.52,
   "say": "По фактам.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 75.98,
   "t1": 79.68,
   "say": "И отделим их от легенд — здесь их особенно много.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 80.18,
   "t1": 82.52,
   "say": "А в конце — три главные версии.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 82.75,
   "t1": 85.63,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0,
   "t1": 5.59,
   "say": "К западу от Шотландии, за островом Льюис, в открытом море лежат несколько скал.",
   "gap": 0.53,
   "who": "narrator",
   "chapter": "1. Остров"
  },
  {
   "src": "ch1.mp3",
   "t0": 6.02,
   "t1": 7.41,
   "say": "Острова Фланнан.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 7.87,
   "t1": 10.22,
   "say": "Моряки называют их Семь охотников.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 10.77,
   "t1": 13.85,
   "say": "До ближайшего берега — тридцать два километра воды.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 14.34,
   "t1": 15.62,
   "say": "Здесь нет деревьев.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.93,
   "t1": 16.64,
   "say": "Нет домов.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 17.1,
   "t1": 23.81,
   "say": "Только трава, морские птицы и отвесные обрывы, о которые круглый год бьются волны Атлантики.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 24.31,
   "t1": 26.96,
   "say": "Зимой здесь неделями не стихает ветер.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 27.31,
   "t1": 31.81,
   "say": "А море бывает таким, что к острову не может подойти ни одно судно.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 32.42,
   "t1": 35.78,
   "say": "Самый большой из островов называется Эйлен-Мор.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 36.16,
   "t1": 38.55,
   "say": "С него видны все проходящие корабли.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 38.91,
   "t1": 43.02,
   "say": "И все проходящие корабли видят его — если знают, где он.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 43.63,
   "t1": 47.19,
   "say": "В конце девятнадцатого века здесь решают построить маяк.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 47.71,
   "t1": 52.19,
   "say": "Четыре года строители возят по морю камень, железо и стекло.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.55,
   "t1": 54.48,
   "say": "Поднимают их по отвесной скале.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 54.95,
   "t1": 57.84,
   "say": "Башня получается высотой двадцать три метра.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 58.09,
   "t1": 61.49,
   "say": "А огонь горит на высоте сто один метр над водой.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 62.17,
   "t1": 67.72,
   "say": "Седьмого декабря тысяча восемьсот девяносто девятого года маяк впервые загорается.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 68.2,
   "t1": 70.97,
   "say": "С тех пор каждую ночь он должен светить.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 71.24,
   "t1": 72.2,
   "say": "Без перерывов.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 72.44,
   "t1": 73.53,
   "say": "Без исключений.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 74.03,
   "t1": 77.36,
   "say": "Для этого на острове всегда живут трое смотрителей.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 77.69,
   "t1": 83.07,
   "say": "И у них есть главное правило: огонь никогда не оставляют без присмотра.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 83.45,
   "t1": 87.08,
   "say": "Хотя бы один человек всегда должен быть рядом с ним.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0,
   "t1": 2.2,
   "say": "Декабрь тысяча девятисотого года.",
   "gap": 0.41,
   "who": "narrator",
   "chapter": "2. Трое"
  },
  {
   "src": "ch2.mp3",
   "t0": 2.51,
   "t1": 4.22,
   "say": "Маяку чуть больше года.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 4.66,
   "t1": 5.94,
   "say": "На острове трое.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 6.39,
   "t1": 8.65,
   "say": "Главный смотритель — Джеймс Дукат.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 8.98,
   "t1": 11.63,
   "say": "Опытный, серьёзный, давно на службе.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 12.04,
   "t1": 14.69,
   "say": "Дома, на большой земле, его ждёт семья.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 15.3,
   "t1": 17.39,
   "say": "Его помощник — Томас Маршалл.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 17.67,
   "t1": 18.61,
   "say": "Тоже не новичок.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 18.88,
   "t1": 24.0,
   "say": "Говорят, однажды Маршалла оштрафовали за то, что во время шторма пропало снаряжение.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 24.39,
   "t1": 25.49,
   "say": "Запомни эту деталь.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 26.05,
   "t1": 27.91,
   "say": "Третий — Дональд Макартур.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 28.24,
   "t1": 30.93,
   "say": "Он здесь не постоянный смотритель, а подменный.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 31.22,
   "t1": 32.87,
   "say": "Местный, с острова Льюис.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 33.14,
   "t1": 36.82,
   "say": "Он заменяет Уильяма Росса, который заболел и остался на берегу.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 37.38,
   "t1": 41.47,
   "say": "Четвёртый смотритель, Джозеф Мур, в эти недели живёт на Льюисе.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.72,
   "t1": 44.66,
   "say": "Его очередь ехать на маяк — со следующим судном.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 45.2,
   "t1": 48.11,
   "say": "Работа на маяке тяжёлая и однообразная.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 48.44,
   "t1": 54.08,
   "say": "Днём — почистить линзы, заправить лампы керосином, подкрутить механизм, записать погоду.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 54.48,
   "t1": 56.81,
   "say": "Ночью — следить, чтобы огонь горел.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 57.28,
   "t1": 59.64,
   "say": "Время от времени приходит судно снабжения.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 59.83,
   "t1": 62.09,
   "say": "Привозит еду, письма, смену.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 62.44,
   "t1": 66.72,
   "say": "А всё остальное время — только трое людей, ветер и море.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0,
   "t1": 1.18,
   "say": "Середина декабря.",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "3. Тишина"
  },
  {
   "src": "ch3.mp3",
   "t0": 1.59,
   "t1": 3.07,
   "say": "Над островами штормы.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 3.51,
   "t1": 4.99,
   "say": "На маяке ведут журнал.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 5.44,
   "t1": 8.62,
   "say": "Последние записи в нём сделаны тринадцатого декабря.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 9.11,
   "t1": 14.76,
   "say": "Дальше смотрители записывают погоду мелом на грифельной доске, чтобы потом перенести в журнал.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 15.26,
   "t1": 19.76,
   "say": "Последняя запись на доске — утро пятнадцатого декабря, девять часов.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 20.26,
   "t1": 21.44,
   "say": "Лампа почищена.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 21.62,
   "t1": 22.81,
   "say": "Резервуар полон.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 23.03,
   "t1": 24.13,
   "say": "Шторы на окнах.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 24.43,
   "t1": 25.8,
   "say": "Обычный рабочий день.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 26.38,
   "t1": 30.85,
   "say": "В ту же ночь, около полуночи, мимо острова проходит пароход «Арктор».",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 31.3,
   "t1": 33.65,
   "say": "Моряки замечают: маяк не горит.",
   "gap": 0.76,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 34.31,
   "t1": 39.34,
   "say": "Восемнадцатого декабря «Арктор» приходит в порт Лит, и капитан сообщает об этом.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 39.72,
   "t1": 43.73,
   "say": "Но сообщение так никто и не передаёт тем, кто отвечает за маяки.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 44.21,
   "t1": 48.09,
   "say": "А с острова Льюис, с ближайшего берега, огня тоже не видно.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 48.97,
   "t1": 49.51,
   "say": "День.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 49.57,
   "t1": 50.14,
   "say": "Второй.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 50.49,
   "t1": 51.91,
   "say": "Десять дней подряд.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 52.47,
   "t1": 55.69,
   "say": "Судно снабжения «Гесперус» должно было прийти раньше.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 55.87,
   "t1": 57.87,
   "say": "Но шторм не пускает его в море.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 58.19,
   "t1": 60.41,
   "say": "Оно выходит только после Рождества.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0,
   "t1": 1.57,
   "say": "Двадцать шестое декабря.",
   "gap": 0.46,
   "who": "narrator",
   "chapter": "4. Находка"
  },
  {
   "src": "ch4.mp3",
   "t0": 1.93,
   "t1": 2.45,
   "say": "Полдень.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 3.02,
   "t1": 4.99,
   "say": "«Гесперус» подходит к Эйлен-Мору.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 5.43,
   "t1": 9.0,
   "say": "Капитан Джим Харви сразу понимает: что-то не так.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 9.53,
   "t1": 12.31,
   "say": "Обычно смотрители встречают судно на причале.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 12.59,
   "t1": 13.55,
   "say": "Поднимают флаг.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 13.8,
   "t1": 15.98,
   "say": "Выносят пустые ящики для провизии.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 16.39,
   "t1": 18.14,
   "say": "Сегодня — ничего.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 18.55,
   "t1": 19.73,
   "say": "Флагшток пуст.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 19.94,
   "t1": 21.16,
   "say": "Ящиков нет.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 21.4,
   "t1": 22.62,
   "say": "Людей нет.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 23.32,
   "t1": 24.55,
   "say": "Капитан даёт гудок.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 24.82,
   "t1": 25.8,
   "say": "Пускает ракету.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 26.45,
   "t1": 27.03,
   "say": "Тишина.",
   "gap": 0.81,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 27.74,
   "t1": 31.4,
   "say": "Джозеф Мур, который приехал на смену, высаживается на берег.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 31.78,
   "t1": 33.2,
   "say": "Он поднимается к маяку.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.59,
   "t1": 34.65,
   "say": "Ворота закрыты.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 34.95,
   "t1": 36.48,
   "say": "Входная дверь закрыта.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 37.07,
   "t1": 38.3,
   "say": "Мур заходит внутрь.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 38.5,
   "t1": 39.57,
   "say": "Зовёт товарищей.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 39.91,
   "t1": 41.21,
   "say": "Никто не отвечает.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 41.78,
   "t1": 43.14,
   "say": "Он проходит по комнатам.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 43.52,
   "t1": 46.8,
   "say": "Лампы почищены и заправлены — к ночи всё готово.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 47.15,
   "t1": 48.18,
   "say": "Линзы чистые.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 48.57,
   "t1": 49.76,
   "say": "На кухне прибрано.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 49.92,
   "t1": 51.23,
   "say": "Кровати не застелены.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 51.55,
   "t1": 54.55,
   "say": "Часы стоят — их давно никто не заводил.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 55.2,
   "t1": 59.95,
   "say": "А потом Мур замечает вещь, которая станет главной загадкой этой истории.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 60.5,
   "t1": 63.74,
   "say": "На острове у смотрителей есть непромокаемые плащи.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 64.03,
   "t1": 66.62,
   "say": "Их надевают, когда идут к причалам, к морю.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 67.05,
   "t1": 68.48,
   "say": "Двух плащей нет.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 68.88,
   "t1": 70.76,
   "say": "А третий висит на месте.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 71.2,
   "t1": 73.5,
   "say": "Значит, двое ушли в плащах.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 73.78,
   "t1": 77.4,
   "say": "А третий — Макартур — вышел наружу в одной рубашке.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 77.57,
   "t1": 79.65,
   "say": "Под декабрьский дождь и ветер.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 80.24,
   "t1": 83.07,
   "say": "Мур и двое моряков обыскивают весь остров.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 83.35,
   "t1": 84.17,
   "say": "Каждый обрыв.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 84.36,
   "t1": 85.6,
   "say": "Каждую расселину.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 85.92,
   "t1": 86.65,
   "say": "Никого.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 87.25,
   "t1": 91.17,
   "say": "Капитан Харви отправляет на большую землю телеграмму.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 91.53,
   "t1": 94.09,
   "say": "Он пишет: смотрителей, скорее всего, сдуло со скал.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 94.28,
   "t1": 97.55,
   "say": "Или они утонули, пытаясь закрепить кран у причала.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0,
   "t1": 4.04,
   "say": "Двадцать девятого декабря на остров прибывает Роберт Мьюирхед.",
   "gap": 0.54,
   "who": "narrator",
   "chapter": "5. Расследование"
  },
  {
   "src": "ch5.mp3",
   "t0": 4.48,
   "t1": 6.59,
   "say": "Он отвечает за маяки этого района.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 7.03,
   "t1": 8.91,
   "say": "Этих троих он знал лично.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 9.25,
   "t1": 12.19,
   "say": "Когда-то он сам взял каждого из них на службу.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 12.68,
   "t1": 14.69,
   "say": "Мьюирхед осматривает остров.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 15.03,
   "t1": 16.19,
   "say": "И находит следы.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 16.67,
   "t1": 22.89,
   "say": "У западного причала — на высоте около тридцати трёх метров над морем — стоял ящик с канатами.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 23.31,
   "t1": 24.01,
   "say": "Он разбит.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 24.4,
   "t1": 26.49,
   "say": "Железные перила рядом погнуты.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 26.9,
   "t1": 29.91,
   "say": "Камень весом больше тонны сдвинут с места.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 30.35,
   "t1": 35.77,
   "say": "А ещё выше, больше чем на шестьдесят метров над водой, с обрыва сорван дёрн.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 36.19,
   "t1": 41.49,
   "say": "Мьюирхед пишет в отчёте: в это трудно поверить, пока не увидишь своими глазами.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.95,
   "t1": 44.56,
   "say": "А ещё он обращает внимание на одежду.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 44.95,
   "t1": 48.91,
   "say": "Дукат и Маршалл ушли в высоких морских сапогах и плащах.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 49.33,
   "t1": 54.59,
   "say": "По словам Мура, так одевались только в одном случае — когда шли вниз, к причалам.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 54.97,
   "t1": 57.3,
   "say": "Значит, они точно собирались к воде.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 57.77,
   "t1": 58.9,
   "say": "Его вывод такой.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 59.38,
   "t1": 65.93,
   "say": "В субботу, пятнадцатого декабря, днём, Дукат и Маршалл надели плащи и пошли к западному причалу.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 66.27,
   "t1": 69.0,
   "say": "Наверное, хотели закрепить снаряжение после шторма.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 69.42,
   "t1": 72.05,
   "say": "И там их накрыла огромная волна.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 72.35,
   "t1": 73.29,
   "say": "Неожиданная.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 73.54,
   "t1": 76.35,
   "say": "Такая, какой на этой высоте никто не ждал.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 76.8,
   "t1": 80.92,
   "say": "Но и сам Мьюирхед понимает: этот вывод объясняет не всё.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 81.39,
   "t1": 83.73,
   "say": "Почему Макартур выбежал без плаща?",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 84.12,
   "t1": 87.56,
   "say": "И главное — почему огонь остался без присмотра?",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 87.96,
   "t1": 90.02,
   "say": "Это нарушение главного правила.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 90.33,
   "t1": 92.48,
   "say": "Опытные смотрители так не поступают.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 93.05,
   "t1": 94.6,
   "say": "Тела так и не нашли.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 95.0,
   "t1": 95.82,
   "say": "Ни одного.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0.06,
   "t1": 2.45,
   "say": "Эта история быстро обросла легендами.",
   "gap": 0.43,
   "who": "narrator",
   "chapter": "6. Мифы"
  },
  {
   "src": "ch6.mp3",
   "t0": 2.78,
   "t1": 6.01,
   "say": "Ещё в те годы газеты писали о морском змее.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 6.29,
   "t1": 7.2,
   "say": "О шпионах.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 7.43,
   "t1": 10.44,
   "say": "О том, что смотрители сбежали на проходившем корабле.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 10.82,
   "t1": 14.5,
   "say": "А местные шептались о призраке Семи охотников.",
   "gap": 0.77,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 15.17,
   "t1": 20.72,
   "say": "В тысяча девятьсот двенадцатом году поэт Уилфрид Гибсон написал стихи «Остров Фланнан».",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 21.13,
   "t1": 24.83,
   "say": "В них на маяке стоит накрытый стол с недоеденной едой.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 25.09,
   "t1": 26.46,
   "say": "И перевёрнутый стул.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 26.9,
   "t1": 28.6,
   "say": "Красиво и жутко.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 29.11,
   "t1": 31.14,
   "say": "Но ничего этого не было.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 31.31,
   "t1": 33.52,
   "say": "Ни в отчёте, ни в рассказах Мура.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 33.96,
   "t1": 37.56,
   "say": "Самая известная легенда — записи из журнала маяка.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 38.08,
   "t1": 45.15,
   "say": "Будто бы в последние дни смотрители писали: шторм, какого мы не видели двадцать лет.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 45.61,
   "t1": 46.85,
   "say": "Дукат молчит.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 47.35,
   "t1": 48.51,
   "say": "Макартур плачет.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 48.96,
   "t1": 52.51,
   "say": "И последняя строчка: шторм кончился, море спокойно.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 52.65,
   "t1": 53.3,
   "say": "Бог над всем.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 53.95,
   "t1": 56.07,
   "say": "От этих слов мурашки по коже.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 56.56,
   "t1": 63.56,
   "say": "Но в две тысячи четырнадцатом году Совет северных маяков ответил прямо: таких записей не существует.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 63.77,
   "t1": 64.73,
   "say": "Это выдумка.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 65.11,
   "t1": 70.76,
   "say": "Впервые они появились в книге американского писателя только в тысяча девятьсот шестьдесят пятом году.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 70.96,
   "t1": 73.56,
   "say": "Через шестьдесят пять лет после событий.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 73.94,
   "t1": 76.89,
   "say": "Поэтому дальше — только то, что есть в документах.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0,
   "t1": 2.79,
   "say": "Версий за сто с лишним лет — множество.",
   "gap": 0.54,
   "who": "narrator",
   "chapter": "7. Версии"
  },
  {
   "src": "ch7.mp3",
   "t0": 3.23,
   "t1": 5.61,
   "say": "Давай разберём три самые серьёзные.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 5.81,
   "t1": 8.12,
   "say": "И что говорит за и против каждой.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 8.73,
   "t1": 9.81,
   "say": "Версия первая.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 10.16,
   "t1": 10.84,
   "say": "Волна.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 11.34,
   "t1": 13.17,
   "say": "Это вывод самого Мьюирхеда.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 13.54,
   "t1": 17.71,
   "say": "Западный причал стоит в узкой расселине, которая кончается пещерой.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 18.13,
   "t1": 24.42,
   "say": "Когда в такую пещеру заходит большая волна, вода может выстрелить оттуда вверх с огромной силой.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 24.87,
   "t1": 31.53,
   "say": "Следы на высоте тридцати трёх метров говорят: волны в те дни доходили туда, куда обычно не доходят.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 32.03,
   "t1": 33.77,
   "say": "А помнишь штраф Маршалла?",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 34.23,
   "t1": 39.95,
   "say": "Один исследователь считает: Маршалл мог особенно бояться снова потерять снаряжение в шторм.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 40.3,
   "t1": 43.79,
   "say": "Поэтому они с Дукатом и пошли к причалу, несмотря на волны.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 44.21,
   "t1": 47.9,
   "say": "Возможно, Макартур увидел из окна, как идёт огромный вал.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 48.2,
   "t1": 50.88,
   "say": "Выбежал без плаща, чтобы предупредить товарищей.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 51.16,
   "t1": 52.94,
   "say": "И его смыло вместе с ними.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 53.62,
   "t1": 56.46,
   "say": "Против: этой волны никто не видел.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 56.74,
   "t1": 60.0,
   "say": "И непонятно, почему огонь оставил и третий смотритель.",
   "gap": 0.87,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 60.77,
   "t1": 61.8,
   "say": "Версия вторая.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 62.11,
   "t1": 62.81,
   "say": "Цепочка.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 63.2,
   "t1": 68.19,
   "say": "Её много лет спустя предложил человек, который сам служил смотрителем на этом маяке.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 68.74,
   "t1": 70.66,
   "say": "Один из троих сорвался в воду.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 70.97,
   "t1": 72.81,
   "say": "Двое бросились его спасать.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 73.14,
   "t1": 74.16,
   "say": "И погибли тоже.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 74.65,
   "t1": 79.08,
   "say": "Это объясняет, почему все трое ушли, а огонь остался без присмотра.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 79.52,
   "t1": 81.6,
   "say": "В такую минуту о правилах не думают.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 82.1,
   "t1": 83.8,
   "say": "И это объясняет плащ.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 84.1,
   "t1": 86.56,
   "say": "Кто-то бежал на крик, не успев одеться.",
   "gap": 0.79,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 87.25,
   "t1": 88.91,
   "say": "Против: доказательств нет.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 89.0,
   "t1": 91.15,
   "say": "Это только реконструкция.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 92.05,
   "t1": 93.12,
   "say": "Версия третья.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 93.35,
   "t1": 93.97,
   "say": "Ссора.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 94.45,
   "t1": 98.84,
   "say": "Автор одной из книг об этой истории пишет: Макартур был вспыльчивым.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 99.17,
   "t1": 101.86,
   "say": "Трое мужчин, неделями запертые на скале.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 102.15,
   "t1": 103.68,
   "say": "Ссора на краю обрыва.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 103.95,
   "t1": 104.57,
   "say": "Драка.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 104.82,
   "t1": 106.66,
   "say": "И все трое падают в море.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 107.47,
   "t1": 111.96,
   "say": "Против: ни одного свидетеля, ни одного следа борьбы на маяке.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 112.29,
   "t1": 114.27,
   "say": "Все трое были опытными людьми.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0,
   "t1": 1.46,
   "say": "А что стало с маяком?",
   "gap": 0.49,
   "who": "narrator",
   "chapter": "8. Финал"
  },
  {
   "src": "ch8.mp3",
   "t0": 1.85,
   "t1": 3.24,
   "say": "Он продолжает светить.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 3.68,
   "t1": 6.96,
   "say": "После той зимы на остров приезжают новые смотрители.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 7.35,
   "t1": 13.04,
   "say": "Двадцать восьмого сентября тысяча девятьсот семьдесят первого года маяк делают автоматическим.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 13.43,
   "t1": 15.49,
   "say": "С тех пор людей на острове нет.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 15.94,
   "t1": 17.4,
   "say": "Огонь горит сам.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 17.79,
   "t1": 20.57,
   "say": "А история трёх смотрителей стала легендой.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.05,
   "t1": 25.14,
   "say": "В тысяча девятьсот шестьдесят восьмом году о ней спела группа «Дженезис».",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 25.56,
   "t1": 31.26,
   "say": "В тысяча девятьсот семьдесят девятом композитор Питер Максвелл Дэвис написал оперу «Маяк».",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 31.63,
   "t1": 35.17,
   "say": "А в две тысячи восемнадцатом вышел фильм «Исчезновение».",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 35.61,
   "t1": 38.87,
   "say": "Но ни одна из этих историй так и не дала ответа.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 39.39,
   "t1": 41.2,
   "say": "Так что же мы знаем точно?",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 41.73,
   "t1": 48.44,
   "say": "В субботу, пятнадцатого декабря тысяча девятисотого года, трое опытных смотрителей подготовили маяк к ночи.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 48.86,
   "t1": 50.88,
   "say": "Потом все трое вышли наружу.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 51.25,
   "t1": 52.74,
   "say": "Один — без плаща.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 53.2,
   "t1": 57.12,
   "say": "Высоко над морем после этого нашли следы огромной силы.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 57.55,
   "t1": 59.64,
   "say": "И больше их никто не видел.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 60.24,
   "t1": 61.65,
   "say": "Чего мы не знаем?",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 62.06,
   "t1": 64.88,
   "say": "Что заставило всех троих оставить огонь.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 65.25,
   "t1": 66.84,
   "say": "И что с ними случилось.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 67.4,
   "t1": 70.72,
   "say": "А ты как думаешь, что произошло на острове Эйлен-Мор?",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 71.2,
   "t1": 72.9,
   "say": "А — огромная волна.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 73.35,
   "t1": 77.01,
   "say": "Б — один сорвался, а двое погибли, спасая его.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 77.51,
   "t1": 79.88,
   "say": "В — ссора на краю обрыва.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 80.41,
   "t1": 81.9,
   "say": "Напиши букву в комментариях.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 82.08,
   "t1": 83.61,
   "say": "Мы прочитаем каждый.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 84.1,
   "t1": 89.38,
   "say": "Если ещё не смотрел — у нас есть разбор перевала Дятлова и корабля-призрака «Мэри Селест».",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 89.76,
   "t1": 91.47,
   "say": "Там тоже всё было на месте.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 91.79,
   "t1": 92.48,
   "say": "Кроме людей.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 92.97,
   "t1": 94.89,
   "say": "А какую загадку разобрать следующей?",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 95.07,
   "t1": 96.2,
   "say": "Напиши в комментариях.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 96.54,
   "t1": 99.76,
   "say": "И подпишись, чтобы не пропустить новое расследование.",
   "gap": 2.0,
   "who": "narrator"
  }
 ]
}