{
 "dir": "public/maya/el",
 "lead": 5,
 "tail": 14,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0,
   "t1": 1.23,
   "say": "Джунгли Гватемалы.",
   "gap": 0.44,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 1.57,
   "t1": 3.56,
   "say": "Тысяча восемьсот тридцать девятый год.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.1,
   "t1": 7.81,
   "say": "Двое путешественников прорубают дорогу мачете сквозь лианы.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 8.25,
   "t1": 11.69,
   "say": "И вдруг из зелени выступает каменное лицо.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 11.98,
   "t1": 14.13,
   "say": "Высотой в два человеческих роста.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.58,
   "t1": 16.19,
   "say": "За ним — ещё одно.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 16.68,
   "t1": 18.58,
   "say": "Лестницы, уходящие в небо.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.94,
   "t1": 19.7,
   "say": "Площади.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 19.82,
   "t1": 20.64,
   "say": "Дворцы.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 20.94,
   "t1": 22.0,
   "say": "Целый город.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.49,
   "t1": 23.04,
   "say": "Пустой.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.62,
   "t1": 25.97,
   "say": "Деревья растут прямо из крыш храмов.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 26.45,
   "t1": 28.16,
   "say": "Корни разламывают ступени.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 28.64,
   "t1": 31.0,
   "say": "Здесь когда-то жили тысячи людей.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 31.36,
   "t1": 35.04,
   "say": "Здесь правили цари, считали звёзды, писали книги.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.53,
   "t1": 37.13,
   "say": "А потом все ушли.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.78,
   "t1": 38.66,
   "say": "Не один город.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 38.95,
   "t1": 39.79,
   "say": "Десятки.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 39.88,
   "t1": 40.61,
   "say": "Сотни.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 41.09,
   "t1": 47.51,
   "say": "Примерно за сто пятьдесят лет одна из самых развитых цивилизаций древнего мира покинула свои города.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 47.89,
   "t1": 49.71,
   "say": "И джунгли проглотили их.",
   "gap": 0.86,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.47,
   "t1": 51.85,
   "say": "Что случилось с майя?",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 52.28,
   "t1": 52.87,
   "say": "Война?",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 53.08,
   "t1": 53.8,
   "say": "Засуха?",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 53.91,
   "t1": 54.59,
   "say": "Болезнь?",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 54.93,
   "t1": 56.99,
   "say": "Или что-то, о чём мы ещё не знаем?",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 57.45,
   "t1": 58.45,
   "say": "Давай разберёмся.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 58.83,
   "t1": 64.12,
   "say": "По раскопкам, по надписям на камне и по тому, что рассказали учёным озёра и пещеры.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 64.46,
   "t1": 66.76,
   "say": "А в конце — три главные версии.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 66.99,
   "t1": 69.78,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0,
   "t1": 1.24,
   "say": "Представь себе карту.",
   "gap": 0.42,
   "who": "narrator",
   "chapter": "1. Царства в джунглях"
  },
  {
   "src": "ch1.mp3",
   "t0": 1.56,
   "t1": 5.73,
   "say": "Юг Мексики, Гватемала, Белиз, кусочек Гондураса.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 6.17,
   "t1": 9.19,
   "say": "Сейчас здесь в основном влажный тропический лес.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 9.51,
   "t1": 15.25,
   "say": "Но тысячу триста лет назад это была одна из самых густонаселённых земель планеты.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.63,
   "t1": 17.92,
   "say": "Здесь стояли города майя.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 18.37,
   "t1": 19.01,
   "say": "Тикаль.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 19.15,
   "t1": 19.94,
   "say": "Калакмуль.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 20.11,
   "t1": 20.72,
   "say": "Копан.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 20.84,
   "t1": 21.57,
   "say": "Паленке.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 22.02,
   "t1": 24.35,
   "say": "Каждый город — отдельное царство.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 24.57,
   "t1": 28.16,
   "say": "Со своим царём, своей армией и своими врагами.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 28.63,
   "t1": 30.8,
   "say": "В центре — огромные пирамиды.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 31.12,
   "t1": 34.21,
   "say": "Наверху — храмы, где цари говорили с богами.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 34.6,
   "t1": 38.97,
   "say": "Вокруг — дворцы, водохранилища, дороги из белого камня.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 39.3,
   "t1": 41.71,
   "say": "И площадки для священной игры в мяч.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 42.11,
   "t1": 46.5,
   "say": "Тяжёлый каучуковый мяч нельзя было трогать руками — только бёдрами.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 46.9,
   "t1": 50.03,
   "say": "А игра иногда заканчивалась жертвоприношением.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 50.52,
   "t1": 52.25,
   "say": "Майя не знали железа.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.5,
   "t1": 54.76,
   "say": "Не пользовались колесом для перевозки грузов.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 55.09,
   "t1": 56.95,
   "say": "У них не было вьючных животных.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 57.41,
   "t1": 61.73,
   "say": "И всё равно они строили пирамиды выше двадцатиэтажного дома.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 62.14,
   "t1": 65.44,
   "say": "Они придумали письменность — больше восьмисот знаков.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 65.93,
   "t1": 68.67,
   "say": "Они вели календарь поразительной точности.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 68.99,
   "t1": 70.74,
   "say": "Они предсказывали затмения.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 70.86,
   "t1": 72.04,
   "say": "Следили за Венерой.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 72.44,
   "t1": 77.16,
   "say": "И каждое важное событие высекали на каменных столбах — стелах.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 77.37,
   "t1": 78.5,
   "say": "С точной датой.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 79.01,
   "t1": 80.19,
   "say": "Запомни эти даты.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 80.44,
   "t1": 82.04,
   "say": "Они ещё сыграют свою роль.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0,
   "t1": 5.21,
   "say": "Долго считалось, что майя жили в отдельных городах среди почти пустых джунглей.",
   "gap": 0.57,
   "who": "narrator",
   "chapter": "2. Миллионы под листвой"
  },
  {
   "src": "ch2.mp3",
   "t0": 5.68,
   "t1": 7.79,
   "say": "А потом появился лидар.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 8.24,
   "t1": 11.05,
   "say": "Это лазер, который сканирует землю с самолёта.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 11.49,
   "t1": 15.24,
   "say": "Луч проходит сквозь листву и показывает, что лежит под ней.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 15.72,
   "t1": 23.13,
   "say": "В две тысячи восемнадцатом году учёные отсканировали две тысячи сто квадратных километров джунглей на севере Гватемалы.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 23.42,
   "t1": 26.14,
   "say": "И увидели то, чего никто не ожидал.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 26.51,
   "t1": 30.49,
   "say": "Шестьдесят одна тысяча четыреста восемьдесят построек.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 30.83,
   "t1": 35.61,
   "say": "Дома, террасы, каналы, крепостные стены, дороги между городами.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 35.94,
   "t1": 40.83,
   "say": "Под деревьями лежала не россыпь городов, а сплошная обжитая земля.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.26,
   "t1": 46.36,
   "say": "По новой оценке, на пике здесь жило от семи до одиннадцати миллионов человек.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 46.59,
   "t1": 48.52,
   "say": "Как в целой современной стране.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 48.92,
   "t1": 54.83,
   "say": "Каждое поле, каждая терраса, каждый водоём были нужны, чтобы прокормить столько людей.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 55.3,
   "t1": 58.27,
   "say": "А теперь представь: почти все они ушли.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 58.68,
   "t1": 61.01,
   "say": "Население этих земель упало в разы.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 61.3,
   "t1": 62.75,
   "say": "Города опустели.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 63.01,
   "t1": 64.29,
   "say": "Поля заросли.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 64.69,
   "t1": 68.09,
   "say": "И лес, который люди вырубали веками, вернулся.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0,
   "t1": 1.37,
   "say": "Помнишь стелы с датами?",
   "gap": 0.48,
   "who": "narrator",
   "chapter": "3. Последняя дата"
  },
  {
   "src": "ch3.mp3",
   "t0": 1.75,
   "t1": 4.73,
   "say": "Ещё сто лет назад никто не умел их читать.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 5.12,
   "t1": 7.99,
   "say": "От испанцев остались записи о знаках майя.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 8.39,
   "t1": 10.45,
   "say": "Учёные думали, что это алфавит.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 10.75,
   "t1": 13.76,
   "say": "Пытались читать по буквам — и ничего не выходило.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 14.23,
   "t1": 20.67,
   "say": "В тысяча девятьсот пятьдесят втором году молодой учёный Юрий Кнорозов, родом из Украины, понял ошибку.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 21.03,
   "t1": 23.15,
   "say": "Знаки майя — это не буквы.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 23.42,
   "t1": 24.43,
   "say": "Это слоги.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 24.98,
   "t1": 25.97,
   "say": "Ему не поверили.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 26.25,
   "t1": 29.08,
   "say": "Западные учёные спорили с ним десятки лет.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 29.39,
   "t1": 31.0,
   "say": "Но он оказался прав.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 31.51,
   "t1": 34.0,
   "say": "Так камни майя заговорили.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 34.84,
   "t1": 37.15,
   "say": "Майя ставили стелы сотни лет.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 37.49,
   "t1": 42.08,
   "say": "Каждый царь отмечал на камне свои победы, свадьбы, восшествие на трон.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 42.53,
   "t1": 44.71,
   "say": "Учёные расшифровали эти даты.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 44.9,
   "t1": 46.84,
   "say": "И нанесли их на шкалу времени.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 47.21,
   "t1": 49.07,
   "say": "И увидели странную картину.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 49.44,
   "t1": 52.6,
   "say": "Сначала дат становится всё больше и больше.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 52.85,
   "t1": 53.48,
   "say": "Расцвет.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 53.69,
   "t1": 54.54,
   "say": "Восьмой век.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 54.94,
   "t1": 58.32,
   "say": "А потом города один за другим замолкают.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 58.87,
   "t1": 62.1,
   "say": "В одном последняя дата стоит в начале девятого века.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 62.37,
   "t1": 63.8,
   "say": "В другом — в середине.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 64.24,
   "t1": 68.66,
   "say": "Великий Тикаль ставит свою последнюю стелу в конце девятого века.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 69.08,
   "t1": 73.53,
   "say": "Как будто кто-то по очереди выключает свет в окнах огромного дома.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 74.14,
   "t1": 78.53,
   "say": "Последняя известная дата длинного счёта высечена в городе Тонина.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 78.9,
   "t1": 81.6,
   "say": "Пятнадцатое января девятьсот девятого года.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 82.04,
   "t1": 83.73,
   "say": "После неё — тишина.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 84.23,
   "t1": 86.15,
   "say": "Больше никто не ставит стел.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 86.47,
   "t1": 88.82,
   "say": "Больше никто не высекает имён царей.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 89.33,
   "t1": 93.44,
   "say": "Камни, которые веками рассказывали историю, просто замолчали.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 93.99,
   "t1": 98.73,
   "say": "И чтобы понять, что произошло, учёным пришлось искать другие свидетельства.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0,
   "t1": 0.78,
   "say": "Канкуэн.",
   "gap": 0.49,
   "who": "narrator",
   "chapter": "4. Резня в Канкуэне"
  },
  {
   "src": "ch4.mp3",
   "t0": 1.17,
   "t1": 4.98,
   "say": "Небольшой, но очень богатый город на реке в Гватемале.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 5.38,
   "t1": 7.96,
   "say": "Здесь торговали нефритом и обсидианом.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 8.25,
   "t1": 11.01,
   "say": "У царя был огромный каменный дворец.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 11.43,
   "t1": 17.12,
   "say": "В две тысячи пятом году археологи раскапывают священный водоём у главного входа во дворец.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 17.51,
   "t1": 19.47,
   "say": "И находят на дне кости.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 20.04,
   "t1": 21.53,
   "say": "Тридцать один человек.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 21.96,
   "t1": 22.7,
   "say": "Мужчины.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 22.82,
   "t1": 23.61,
   "say": "Женщины.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 23.7,
   "t1": 24.29,
   "say": "Дети.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 24.85,
   "t1": 28.42,
   "say": "На них ожерелья, украшения из нефрита, ракушки.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 28.93,
   "t1": 30.76,
   "say": "Это не рабы и не пленники.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 31.05,
   "t1": 31.82,
   "say": "Это знать.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 32.16,
   "t1": 33.08,
   "say": "Царский двор.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.71,
   "t1": 36.27,
   "say": "На костях следы ударов копий и топоров.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 36.69,
   "t1": 37.5,
   "say": "Их убили.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 37.72,
   "t1": 38.57,
   "say": "Всех сразу.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 38.81,
   "t1": 39.91,
   "say": "И сбросили в воду.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 40.56,
   "t1": 42.93,
   "say": "Вокруг дворца — оборонительная стена.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 43.21,
   "t1": 44.21,
   "say": "Недостроенная.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 44.52,
   "t1": 45.84,
   "say": "Её начали возводить.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 46.12,
   "t1": 46.91,
   "say": "И не успели.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 47.46,
   "t1": 49.72,
   "say": "Случилось это около восьмисотого года.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 50.27,
   "t1": 53.29,
   "say": "После этого в Канкуэне никто больше не жил.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 53.62,
   "t1": 55.21,
   "say": "Город опустел сразу.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 55.85,
   "t1": 57.55,
   "say": "Кто напал — неизвестно.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 57.78,
   "t1": 59.02,
   "say": "Ни одной надписи.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 59.18,
   "t1": 60.31,
   "say": "Ни одного имени.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 60.95,
   "t1": 64.73,
   "say": "Но это не единственное место, где учёные находят следы войны.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 65.09,
   "t1": 68.75,
   "say": "Укрепления, сожжённые дворцы, наконечники копий.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 69.19,
   "t1": 72.66,
   "say": "В конце эпохи майя воевали больше, чем когда-либо.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0,
   "t1": 1.81,
   "say": "Но было ли это вторжением?",
   "gap": 0.53,
   "who": "narrator",
   "chapter": "5. Пустые дворцы"
  },
  {
   "src": "ch5.mp3",
   "t0": 2.24,
   "t1": 4.4,
   "say": "Или города разваливались изнутри?",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 4.92,
   "t1": 7.29,
   "say": "Царь майя был не просто правителем.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 7.62,
   "t1": 10.07,
   "say": "Его называли священным владыкой.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 10.49,
   "t1": 12.19,
   "say": "Он говорил с богами.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 12.5,
   "t1": 14.74,
   "say": "Он отвечал за дождь и урожай.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 15.12,
   "t1": 20.18,
   "say": "Ради этого он проводил обряды и приносил жертвы — даже собственную кровь.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 20.7,
   "t1": 24.74,
   "say": "Пока шли дожди и росла кукуруза, народ верил в своего царя.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 25.32,
   "t1": 27.73,
   "say": "А если боги молчат год за годом?",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 28.09,
   "t1": 30.69,
   "say": "Если не помогают ни обряды, ни жертвы?",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 31.17,
   "t1": 33.13,
   "say": "Тогда царь больше не нужен.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 33.57,
   "t1": 36.19,
   "say": "Посмотри, что находят археологи в других городах.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 36.57,
   "t1": 38.34,
   "say": "Не везде есть следы резни.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 38.73,
   "t1": 40.82,
   "say": "Часто город умирает тихо.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.22,
   "t1": 43.3,
   "say": "Сначала перестают ставить стелы.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 43.6,
   "t1": 45.91,
   "say": "Потом перестают строить новые храмы.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 46.25,
   "t1": 47.63,
   "say": "Цари исчезают.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 47.95,
   "t1": 50.56,
   "say": "А в их дворцах поселяются простые люди.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 50.94,
   "t1": 53.82,
   "say": "Они разводят костры прямо на полу парадных залов.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 54.08,
   "t1": 55.77,
   "say": "Бросают мусор в коридорах.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 56.15,
   "t1": 58.06,
   "say": "Живут ещё несколько поколений.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 58.24,
   "t1": 59.95,
   "say": "А потом уходят и они.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 60.34,
   "t1": 62.57,
   "say": "Население падает год за годом.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 62.84,
   "t1": 66.29,
   "say": "Как будто людям становится всё труднее жить на этой земле.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 66.76,
   "t1": 67.34,
   "say": "Почему?",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 67.78,
   "t1": 69.7,
   "say": "Ответ нашли не в камне.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 70.04,
   "t1": 71.86,
   "say": "Ответ нашли в воде.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0,
   "t1": 3.2,
   "say": "На полуострове Юкатан есть озеро Чичанкнаб.",
   "gap": 0.59,
   "who": "narrator",
   "chapter": "6. Что рассказало озеро"
  },
  {
   "src": "ch6.mp3",
   "t0": 3.69,
   "t1": 7.32,
   "say": "Каждый год на его дне откладывается новый слой ила.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 7.65,
   "t1": 9.35,
   "say": "Как кольца на срезе дерева.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 9.67,
   "t1": 12.7,
   "say": "Слой за слоем — тысячи лет истории.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 13.27,
   "t1": 18.01,
   "say": "В засушливые годы вода испаряется, и в озере вырастают кристаллы гипса.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 18.42,
   "t1": 22.13,
   "say": "А внутри этих кристаллов заперты капли древней воды.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 22.52,
   "t1": 25.68,
   "say": "Той самой, что была в озере тысячу лет назад.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 26.29,
   "t1": 29.88,
   "say": "В две тысячи восемнадцатом году учёные изучили эту воду.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 30.13,
   "t1": 33.14,
   "say": "И смогли посчитать, сколько тогда выпадало дождей.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 33.63,
   "t1": 35.76,
   "say": "Результат оказался пугающим.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 36.21,
   "t1": 41.66,
   "say": "Как раз в те годы, когда города майя пустели, дождей стало почти вдвое меньше.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 42.09,
   "t1": 44.71,
   "say": "В среднем — на сорок–пятьдесят процентов.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 45.06,
   "t1": 47.62,
   "say": "А в самые тяжёлые годы — на семьдесят.",
   "gap": 0.88,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 48.4,
   "t1": 51.79,
   "say": "Теперь представь город, где живут десятки тысяч людей.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 52.2,
   "t1": 53.85,
   "say": "Их кормят поля кукурузы.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 54.1,
   "t1": 56.71,
   "say": "А воду дают дожди и водохранилища.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 57.21,
   "t1": 58.53,
   "say": "Дождей нет год.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 58.8,
   "t1": 59.37,
   "say": "Два.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 59.53,
   "t1": 60.22,
   "say": "Десять.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 60.62,
   "t1": 61.52,
   "say": "Поля сохнут.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 61.81,
   "t1": 63.25,
   "say": "Водохранилища пустеют.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 63.63,
   "t1": 64.76,
   "say": "Начинается голод.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 65.33,
   "t1": 67.87,
   "say": "Люди уходят туда, где ещё есть вода.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 68.25,
   "t1": 70.35,
   "say": "Или идут отнимать её у соседей.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 71.15,
   "t1": 73.04,
   "say": "И это не единственная улика.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 73.64,
   "t1": 76.62,
   "say": "В пещере Йок-Балум в Белизе растёт сталагмит.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 77.14,
   "t1": 83.32,
   "say": "Он нарастает тонкими слоями — и в каждом слое записано, сколько дождей прошло над пещерой.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 83.86,
   "t1": 85.79,
   "say": "Он рассказал похожую историю.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 86.25,
   "t1": 88.8,
   "say": "Сначала — века обильных дождей.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 89.14,
   "t1": 92.1,
   "say": "Урожаи, рост городов, рост населения.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 92.61,
   "t1": 94.69,
   "say": "Потом климат начал засыхать.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 95.01,
   "t1": 96.82,
   "say": "И войн становилось всё больше.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 97.31,
   "t1": 103.56,
   "say": "А самая страшная засуха за две тысячи лет пришла позже — и добила тех, кто ещё держался.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 104.39,
   "t1": 106.3,
   "say": "Но сами учёные осторожны.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 106.74,
   "t1": 108.48,
   "say": "Засуха — важный фактор.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 108.81,
   "t1": 110.55,
   "say": "Но объясняет ли она всё?",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 110.92,
   "t1": 113.1,
   "say": "Ведь некоторые города пережили её.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 113.38,
   "t1": 116.52,
   "say": "А некоторые опустели ещё до самых сухих лет.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0.03,
   "t1": 3.25,
   "say": "И вот самое главное, о чём часто забывают.",
   "gap": 0.54,
   "who": "narrator",
   "chapter": "7. Они не исчезли"
  },
  {
   "src": "ch7.mp3",
   "t0": 3.69,
   "t1": 5.47,
   "say": "Майя не исчезли.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 6.06,
   "t1": 8.29,
   "say": "Опустели великие города юга.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 8.58,
   "t1": 12.05,
   "say": "Но на севере, на Юкатане, жизнь продолжалась.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 12.56,
   "t1": 15.88,
   "say": "Там вырос новый великий город — Чичен-Ица.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 16.25,
   "t1": 22.14,
   "say": "С огромной пирамидой, на ступенях которой в день равноденствия появляется тень в виде змеи.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 22.72,
   "t1": 24.08,
   "say": "Потом — Майяпан.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 24.63,
   "t1": 29.9,
   "say": "Когда в шестнадцатом веке пришли испанцы, их встретили города майя.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 30.01,
   "t1": 31.38,
   "say": "Царства, армии, жрецы.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 31.86,
   "t1": 34.56,
   "say": "Испанцы воевали с ними почти двести лет.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 35.21,
   "t1": 39.88,
   "say": "Епископ Диего де Ланда решил, что книги майя — дело рук дьявола.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 40.39,
   "t1": 45.33,
   "say": "Двенадцатого июля тысяча пятьсот шестьдесят второго года он приказал их сжечь.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 45.77,
   "t1": 47.16,
   "say": "Двадцать семь книг.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 47.58,
   "t1": 49.47,
   "say": "Тысячи священных изображений.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 50.08,
   "t1": 53.09,
   "say": "До нас дошли всего три или четыре книги майя.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 53.59,
   "t1": 57.91,
   "say": "Целая библиотека цивилизации — и только три-четыре книги.",
   "gap": 0.84,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 58.65,
   "t1": 62.28,
   "say": "Может быть, в сгоревших книгах был ответ и на наш вопрос.",
   "gap": 0.84,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 63.02,
   "t1": 67.9,
   "say": "Последнее независимое царство майя пало в тысяча шестьсот девяносто седьмом году.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 68.37,
   "t1": 70.6,
   "say": "А сами майя живут до сих пор.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 71.11,
   "t1": 75.03,
   "say": "Сегодня на языках майя говорят шесть–семь миллионов человек.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 75.45,
   "t1": 76.32,
   "say": "В Гватемале.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 76.39,
   "t1": 77.93,
   "say": "В Мексике.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 78.42,
   "t1": 79.24,
   "say": "В Белизе.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 79.3,
   "t1": 80.19,
   "say": "Их предки не исчезли.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 80.57,
   "t1": 81.9,
   "say": "Они ушли из городов.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 82.28,
   "t1": 84.34,
   "say": "И остались жить на своей земле.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.03,
   "t1": 2.76,
   "say": "Так что же случилось с великими городами юга?",
   "gap": 0.63,
   "who": "narrator",
   "chapter": "8. Три версии"
  },
  {
   "src": "ch8.mp3",
   "t0": 3.29,
   "t1": 4.29,
   "say": "Версия А.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 4.66,
   "t1": 5.36,
   "say": "Засуха.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 5.76,
   "t1": 10.13,
   "say": "Озёра и пещеры показывают: дождей стало почти вдвое меньше.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 10.5,
   "t1": 12.77,
   "say": "Миллионы людей зависели от урожая.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 13.02,
   "t1": 15.18,
   "say": "Без воды города не могли выжить.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 15.53,
   "t1": 18.27,
   "say": "Люди просто ушли туда, где можно было жить.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 18.81,
   "t1": 19.77,
   "say": "Версия Б.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 20.11,
   "t1": 20.74,
   "say": "Война.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.14,
   "t1": 23.16,
   "say": "Царства майя воевали всегда.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 23.35,
   "t1": 25.95,
   "say": "Но в конце эпохи — больше, чем когда-либо.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 26.37,
   "t1": 29.98,
   "say": "Канкуэн, сожжённые дворцы, недостроенные стены.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 30.28,
   "t1": 31.61,
   "say": "Цари теряли власть.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 31.79,
   "t1": 33.86,
   "say": "И города уничтожали друг друга.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 34.4,
   "t1": 35.36,
   "say": "Версия В.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 35.68,
   "t1": 37.3,
   "say": "Слишком много людей.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 37.58,
   "t1": 39.97,
   "say": "Семь, а может, и одиннадцать миллионов.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 40.4,
   "t1": 44.76,
   "say": "Чтобы их прокормить, вырубали леса и распахивали каждый клочок земли.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 45.11,
   "t1": 46.36,
   "say": "Земля истощилась.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 46.6,
   "t1": 48.16,
   "say": "Почва смывалась дождями.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 48.38,
   "t1": 51.24,
   "say": "И однажды её просто перестало хватать.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 51.77,
   "t1": 54.92,
   "say": "Большинство учёных считают, что виновато не что-то одно.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 55.28,
   "t1": 58.9,
   "say": "Засуха ударила по земле, которая и так была на пределе.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 59.27,
   "t1": 60.92,
   "say": "Голод разжёг войны.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 61.14,
   "t1": 63.5,
   "say": "А войны добили то, что осталось.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 63.85,
   "t1": 66.28,
   "say": "Но точного ответа нет до сих пор.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 66.81,
   "t1": 67.81,
   "say": "А ты как думаешь?",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 67.96,
   "t1": 71.05,
   "say": "Какая версия главная — А, Б или В?",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 71.39,
   "t1": 72.85,
   "say": "Напиши букву в комментариях.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 73.22,
   "t1": 79.08,
   "say": "Если тебе нравятся такие загадки — у нас есть Перевал Дятлова, Мэри Селест и Маяк Фланнан.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 79.35,
   "t1": 81.86,
   "say": "И напиши, какую загадку разобрать дальше.",
   "gap": 8.0,
   "who": "narrator"
  }
 ]
}