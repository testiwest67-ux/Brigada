{
 "dir": "public/kolskaya/el",
 "lead": 1.0,
 "tail": 3.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0.01,
   "t1": 1.18,
   "say": "Север России.",
   "gap": 0.45,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 1.53,
   "t1": 2.67,
   "say": "Кольский полуостров.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 3.2,
   "t1": 4.57,
   "say": "Тундра, ветер и снег.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.63,
   "t1": 8.0,
   "say": "Среди камней стоят пустые здания.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 8.4,
   "t1": 9.33,
   "say": "Окна выбиты.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 9.6,
   "t1": 10.76,
   "say": "Крыша провалилась.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 11.1,
   "t1": 14.09,
   "say": "А посреди бетона — ржавая железная крышка.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.48,
   "t1": 15.6,
   "say": "Чуть больше тарелки.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 15.95,
   "t1": 16.84,
   "say": "Её заварили.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 17.09,
   "t1": 17.76,
   "say": "Наглухо.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.24,
   "t1": 23.63,
   "say": "Под этой крышкой — самая глубокая дыра, которую человек когда-либо сделал в Земле.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 23.98,
   "t1": 26.01,
   "say": "Двенадцать километров вниз.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 26.37,
   "t1": 28.5,
   "say": "Это глубже, чем Эверест высокий.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 28.93,
   "t1": 32.46,
   "say": "Про эту дыру по всему миру рассказывают страшную историю.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 32.86,
   "t1": 35.36,
   "say": "Будто учёные опустили туда микрофон.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.75,
   "t1": 36.95,
   "say": "И услышали крики.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 37.41,
   "t1": 38.44,
   "say": "Тысячи голосов.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 38.8,
   "t1": 39.97,
   "say": "Из самой глубины.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 40.42,
   "t1": 42.71,
   "say": "Будто после этого скважину закрыли.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 42.96,
   "t1": 43.67,
   "say": "И заварили.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 43.93,
   "t1": 45.7,
   "say": "Чтобы никто больше не слушал.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 46.22,
   "t1": 47.49,
   "say": "Звучит как сказка.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 47.8,
   "t1": 49.7,
   "say": "Но скважина настоящая.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.02,
   "t1": 52.0,
   "say": "Её бурили больше двадцати лет.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 52.29,
   "t1": 53.94,
   "say": "Там работали сотни людей.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 54.28,
   "t1": 58.35,
   "say": "И на глубине они действительно нашли то, чего не ждал никто.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 58.87,
   "t1": 60.5,
   "say": "Так что же там, под крышкой?",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 60.89,
   "t1": 63.94,
   "say": "Почему самую глубокую дыру на планете бросили?",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 64.24,
   "t1": 65.79,
   "say": "И откуда взялись крики?",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 66.28,
   "t1": 67.79,
   "say": "Давай разберёмся по порядку.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 68.04,
   "t1": 68.66,
   "say": "По фактам.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 69.02,
   "t1": 70.68,
   "say": "А в конце — три версии.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 70.93,
   "t1": 73.64,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0.05,
   "t1": 2.48,
   "say": "Пятидесятые и шестидесятые годы.",
   "gap": 0.37,
   "who": "narrator",
   "chapter": "1. Гонка в недра"
  },
  {
   "src": "ch1.mp3",
   "t0": 2.75,
   "t1": 4.03,
   "say": "Холодная война.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 4.49,
   "t1": 7.85,
   "say": "СССР и Америка соревнуются во всём.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 8.21,
   "t1": 10.09,
   "say": "Кто первым запустит спутник.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 10.27,
   "t1": 12.58,
   "say": "Кто первым отправит человека в космос.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 12.84,
   "t1": 14.71,
   "say": "Кто первым долетит до Луны.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.14,
   "t1": 18.0,
   "say": "Но есть место, куда не заглянул никто.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 18.41,
   "t1": 19.92,
   "say": "Оно у нас под ногами.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 20.43,
   "t1": 22.99,
   "say": "Мы видим звёзды за миллиарды километров.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 23.31,
   "t1": 25.94,
   "say": "А что под землёй глубже нескольких километров — не знаем.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 26.24,
   "t1": 28.35,
   "say": "Только догадываемся.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 28.89,
   "t1": 32.57,
   "say": "Учёные слушают, как по Земле бегут волны от землетрясений.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 32.83,
   "t1": 35.67,
   "say": "И рисуют картину: сверху гранит.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 35.96,
   "t1": 37.25,
   "say": "Под ним базальт.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 37.54,
   "t1": 39.36,
   "say": "Ещё глубже — мантия.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 39.87,
   "t1": 42.98,
   "say": "Проверить эту картину можно только одним способом.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 43.32,
   "t1": 44.05,
   "say": "Пробурить.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 44.57,
   "t1": 46.4,
   "say": "Американцы пробуют первыми.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 46.69,
   "t1": 48.84,
   "say": "Их проект бурит дно океана.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 49.12,
   "t1": 50.34,
   "say": "Но денег не хватает.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 50.65,
   "t1": 51.81,
   "say": "Проект закрывают.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.3,
   "t1": 56.18,
   "say": "А Советский Союз решает: мы пройдём глубже всех.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 56.75,
   "t1": 59.09,
   "say": "Место выбирают на Кольском полуострове.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 59.4,
   "t1": 62.47,
   "say": "Здесь древние камни выходят прямо к поверхности.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 62.84,
   "t1": 66.11,
   "say": "Возраст некоторых из них — почти три миллиарда лет.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 66.74,
   "t1": 72.29,
   "say": "Двадцать четвёртого мая тысяча девятьсот семидесятого года бур впервые входит в землю.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 72.65,
   "t1": 74.65,
   "say": "Сначала цель — семь километров.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 75.05,
   "t1": 77.06,
   "say": "Но очень скоро её поднимут.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 77.29,
   "t1": 78.27,
   "say": "До пятнадцати.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0.01,
   "t1": 1.95,
   "say": "Ближайший город — Заполярный.",
   "gap": 0.42,
   "who": "narrator",
   "chapter": "2. Город на краю"
  },
  {
   "src": "ch2.mp3",
   "t0": 2.27,
   "t1": 4.18,
   "say": "Двенадцать километров по тундре.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 4.58,
   "t1": 6.45,
   "say": "Зимой здесь полярная ночь.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 6.71,
   "t1": 8.48,
   "say": "Солнце не встаёт неделями.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 8.75,
   "t1": 10.27,
   "say": "Летом оно не садится.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 10.75,
   "t1": 12.82,
   "say": "На буровой работают круглые сутки.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 12.92,
   "t1": 14.08,
   "say": "Смена за сменой.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 14.47,
   "t1": 17.53,
   "say": "В лучшие годы здесь трудятся около пятисот человек.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 17.77,
   "t1": 20.85,
   "say": "Буровики, геологи, химики, инженеры.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 21.25,
   "t1": 24.22,
   "say": "Руководит экспедицией геолог Давид Губерман.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 24.67,
   "t1": 27.67,
   "say": "Над скважиной вырастает высокая буровая башня.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 28.12,
   "t1": 32.67,
   "say": "В тысяча девятьсот семьдесят четвёртом сюда привозят новую буровую установку.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 32.96,
   "t1": 35.88,
   "say": "Её называют «Уралмаш-пятнадцать тысяч».",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 36.25,
   "t1": 39.06,
   "say": "По новой цели — пятнадцать тысяч метров.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 39.64,
   "t1": 41.12,
   "say": "Представь, как это работает.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.59,
   "t1": 43.69,
   "say": "Вниз уходит колонна из труб.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 44.06,
   "t1": 46.1,
   "say": "Трубы свинчивают одну за другой.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 46.43,
   "t1": 48.61,
   "say": "А на самом дне крутится долото.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 48.95,
   "t1": 50.35,
   "say": "Оно грызёт камень.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 50.75,
   "t1": 53.6,
   "say": "Ширина ствола — около двадцати трёх сантиметров.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 53.96,
   "t1": 56.53,
   "say": "Чуть шире твоей ладони с растопыренными пальцами.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 56.93,
   "t1": 60.8,
   "say": "И вот такой узкий ход уходит на километры вниз.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 61.24,
   "t1": 64.85,
   "say": "Каждый раз, когда долото стирается, всю колонну поднимают.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 65.14,
   "t1": 66.97,
   "say": "Разбирают трубу за трубой.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 67.22,
   "t1": 68.24,
   "say": "Меняют долото.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 68.54,
   "t1": 69.62,
   "say": "И опускают снова.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 70.1,
   "t1": 74.95,
   "say": "На глубине в десять километров один такой подъём занимает многие часы.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 75.41,
   "t1": 78.11,
   "say": "А вместе с породой наверх достают керн.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 78.42,
   "t1": 80.5,
   "say": "Это столбик камня из глубины.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 80.88,
   "t1": 83.39,
   "say": "Его режут, изучают, подписывают.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 83.87,
   "t1": 88.17,
   "say": "Каждый метр — как страница книги, которую раньше не читал никто.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0.01,
   "t1": 3.39,
   "say": "Шестого июня тысяча девятьсот семьдесят девятого года.",
   "gap": 0.55,
   "who": "narrator",
   "chapter": "3. Рекорд"
  },
  {
   "src": "ch3.mp3",
   "t0": 3.84,
   "t1": 8.04,
   "say": "Кольская скважина проходит девять тысяч пятьсот восемьдесят три метра.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 8.41,
   "t1": 13.44,
   "say": "До этого дня самой глубокой в мире была скважина в Америке, в штате Оклахома.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 13.8,
   "t1": 16.2,
   "say": "Теперь рекорд у Советского Союза.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 16.63,
   "t1": 18.27,
   "say": "Но бур идёт дальше.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 18.69,
   "t1": 24.85,
   "say": "В тысяча девятьсот восемьдесят третьем году скважина проходит двенадцать километров.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 24.93,
   "t1": 26.39,
   "say": "Двенадцать тысяч метров вниз.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 26.68,
   "t1": 29.16,
   "say": "Это больше, чем глубина Марианской впадины.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 29.54,
   "t1": 31.85,
   "say": "Бурение останавливают почти на год.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 32.41,
   "t1": 37.84,
   "say": "В тысяча девятьсот восемьдесят четвёртом в Москве собирается Международный геологический конгресс.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 38.11,
   "t1": 39.72,
   "say": "Учёные со всего мира.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 40.1,
   "t1": 42.82,
   "say": "И Советский Союз показывает им Кольскую.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 43.17,
   "t1": 45.03,
   "say": "Керны, цифры, графики.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 45.32,
   "t1": 47.73,
   "say": "Иностранцы приезжают прямо на буровую.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 48.03,
   "t1": 50.38,
   "say": "Для геологов это как первый спутник.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 50.76,
   "t1": 54.67,
   "say": "Кажется, ещё немного — и пятнадцать километров будут взяты.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 55.08,
   "t1": 58.16,
   "say": "Но после конгресса бурение начинают снова.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 58.49,
   "t1": 61.49,
   "say": "И случается то, чего боится каждый буровик.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0,
   "t1": 4.12,
   "say": "Двадцать седьмое сентября тысяча девятьсот восемьдесят четвёртого года.",
   "gap": 0.39,
   "who": "narrator",
   "chapter": "4. Обрыв"
  },
  {
   "src": "ch4.mp3",
   "t0": 4.41,
   "t1": 7.66,
   "say": "Глубина — двенадцать тысяч шестьдесят шесть метров.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 8.26,
   "t1": 9.91,
   "say": "Колонну поднимают наверх.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 10.38,
   "t1": 12.46,
   "say": "И вдруг она становится лёгкой.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 12.9,
   "t1": 14.05,
   "say": "Слишком лёгкой.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 14.46,
   "t1": 15.86,
   "say": "Труба оборвалась.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 16.18,
   "t1": 18.75,
   "say": "Где-то в глубине осталась часть колонны.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 19.06,
   "t1": 21.07,
   "say": "Около пяти километров труб.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 21.49,
   "t1": 23.08,
   "say": "Пять километров железа.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 23.35,
   "t1": 25.21,
   "say": "В дыре шириной с тарелку.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 25.52,
   "t1": 27.2,
   "say": "Достать их невозможно.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 27.53,
   "t1": 29.38,
   "say": "Годы работы — на дне.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 29.85,
   "t1": 31.56,
   "say": "Есть только один выход.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 31.9,
   "t1": 32.94,
   "say": "Бурить заново.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.2,
   "t1": 33.85,
   "say": "В обход.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 34.2,
   "t1": 38.48,
   "say": "Буровики уходят в сторону от старого ствола и снова идут вниз.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 38.73,
   "t1": 39.92,
   "say": "Метр за метром.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 40.06,
   "t1": 41.44,
   "say": "Месяц за месяцем.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 41.73,
   "t1": 43.41,
   "say": "Проходит почти пять лет.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 43.77,
   "t1": 51.59,
   "say": "И в тысяча девятьсот восемьдесят девятом году новый ствол достигает глубины двенадцать тысяч двести шестьдесят два метра.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 51.93,
   "t1": 53.07,
   "say": "Это рекорд.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 53.33,
   "t1": 54.74,
   "say": "Он не побит до сих пор.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 55.01,
   "t1": 56.5,
   "say": "Уже почти сорок лет.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 56.76,
   "t1": 60.12,
   "say": "Ни одна скважина на Земле не ушла вглубь дальше.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 60.65,
   "t1": 63.66,
   "say": "Позже Кольскую внесут в Книгу рекордов Гиннесса.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 63.78,
   "t1": 67.3,
   "say": "Как самую глубокую точку, до которой добрался человек.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 67.7,
   "t1": 70.26,
   "say": "Но сами буровики гордились не рекордом.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 70.51,
   "t1": 73.06,
   "say": "Они гордились тем, что подняли наверх.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 73.54,
   "t1": 76.14,
   "say": "Но что же нашли там, внизу?",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0.07,
   "t1": 1.61,
   "say": "Помнишь картину из учебников?",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "5. Что нашли"
  },
  {
   "src": "ch5.mp3",
   "t0": 2.02,
   "t1": 3.1,
   "say": "Сверху гранит.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 3.3,
   "t1": 4.6,
   "say": "Под ним базальт.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 5.02,
   "t1": 9.61,
   "say": "Учёные были уверены: примерно на семи километрах гранит закончится.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 9.81,
   "t1": 11.21,
   "say": "Начнётся базальт.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 11.67,
   "t1": 13.42,
   "say": "Бур проходит семь километров.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 13.74,
   "t1": 14.44,
   "say": "Восемь.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 14.6,
   "t1": 15.28,
   "say": "Десять.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 15.53,
   "t1": 16.4,
   "say": "Двенадцать.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 16.91,
   "t1": 17.9,
   "say": "Базальта нет.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 18.13,
   "t1": 19.48,
   "say": "Ни на какой глубине.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 19.85,
   "t1": 23.17,
   "say": "Внизу всё тот же гранит и другие древние породы.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 23.57,
   "t1": 28.78,
   "say": "А волны от землетрясений, которые приняли за границу базальта, оказались чем-то другим.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 29.06,
   "t1": 32.73,
   "say": "Камнем, который давление и жар изменили изнутри.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 33.17,
   "t1": 35.55,
   "say": "Картину Земли пришлось перерисовывать.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 35.97,
   "t1": 36.94,
   "say": "Но это не всё.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 37.3,
   "t1": 40.73,
   "say": "На глубине от трёх до шести километров нашли воду.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.07,
   "t1": 42.68,
   "say": "Её там не должно было быть.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 43.0,
   "t1": 45.76,
   "say": "Давление выжимает воду прямо из камня.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 46.02,
   "t1": 48.58,
   "say": "А плотный слой сверху не даёт ей уйти.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 49.0,
   "t1": 52.46,
   "say": "Буровой раствор, который выходил из скважины, словно кипел.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 52.72,
   "t1": 55.8,
   "say": "В нём было столько водорода, сколько не ждал никто.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 56.14,
   "t1": 57.68,
   "say": "А ещё трещины.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 58.04,
   "t1": 61.26,
   "say": "Думали, что глубже порода станет плотной и цельной.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 61.57,
   "t1": 63.89,
   "say": "А трещин с глубиной становилось больше.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 64.28,
   "t1": 67.07,
   "say": "И самое удивительное — окаменелости.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 67.45,
   "t1": 72.25,
   "say": "На глубине около шести километров в керне нашли следы древнего планктона.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 72.51,
   "t1": 74.25,
   "say": "Крошечные морские существа.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 74.52,
   "t1": 75.47,
   "say": "Окаменевшие.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 75.78,
   "t1": 77.25,
   "say": "Они лежали в камне.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 77.48,
   "t1": 79.37,
   "say": "На глубине в шесть километров.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 79.88,
   "t1": 86.12,
   "say": "А на самом дне бур дошёл до пород, которым около двух целых семи десятых миллиарда лет.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 86.52,
   "t1": 91.23,
   "say": "Когда они застывали, на Земле ещё не было ни растений, ни животных на суше.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 91.57,
   "t1": 94.05,
   "say": "Только океан, камень и небо.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 94.59,
   "t1": 96.98,
   "say": "Каждая находка — новая загадка.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 97.32,
   "t1": 100.5,
   "say": "Но чем глубже, тем страшнее становилось внизу.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0,
   "t1": 2.1,
   "say": "Чем глубже, тем горячее.",
   "gap": 0.45,
   "who": "narrator",
   "chapter": "6. Жар"
  },
  {
   "src": "ch6.mp3",
   "t0": 2.45,
   "t1": 3.57,
   "say": "Это знали все.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 3.98,
   "t1": 8.23,
   "say": "Учёные считали: на двенадцати километрах будет около ста градусов.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 8.57,
   "t1": 9.43,
   "say": "Как кипяток.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 9.82,
   "t1": 12.5,
   "say": "Термометр показал около ста восьмидесяти.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 12.81,
   "t1": 14.54,
   "say": "Почти вдвое горячее.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 14.95,
   "t1": 17.39,
   "say": "В такой жаре камень ведёт себя странно.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 17.63,
   "t1": 18.96,
   "say": "Он становится мягким.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 19.26,
   "t1": 23.74,
   "say": "Учёные говорили, что порода на дне похожа скорее на пластик, чем на камень.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 24.03,
   "t1": 26.06,
   "say": "Она медленно сжимает ствол.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 26.36,
   "t1": 28.2,
   "say": "Затягивает его, как рану.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 28.48,
   "t1": 29.64,
   "say": "Ломает долото.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 29.79,
   "t1": 31.07,
   "say": "Скручивает трубы.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 31.46,
   "t1": 36.29,
   "say": "Чтобы колонна выдержала, внизу ставят трубы из лёгкого алюминиевого сплава.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 36.57,
   "t1": 37.8,
   "say": "Но и они не вечны.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 38.09,
   "t1": 40.82,
   "say": "Каждый новый метр даётся всё тяжелее.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 41.26,
   "t1": 47.87,
   "say": "В тысяча девятьсот девяностом году на глубине двенадцать тысяч двести шестьдесят два метра снова авария.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 48.22,
   "t1": 50.05,
   "say": "Буровики пробуют ещё раз.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 50.2,
   "t1": 51.06,
   "say": "Новый ствол.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 51.46,
   "t1": 57.88,
   "say": "В тысяча девятьсот девяносто втором его останавливают на одиннадцати тысячах восьмистах восьмидесяти двух метрах.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 58.29,
   "t1": 59.72,
   "say": "Причина — жара.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 59.98,
   "t1": 61.74,
   "say": "Сто восемьдесят градусов.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 62.21,
   "t1": 65.08,
   "say": "Пятнадцать километров так и остались мечтой.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 65.5,
   "t1": 67.37,
   "say": "И это случилось не только с нами.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 67.68,
   "t1": 71.33,
   "say": "В те же годы свою сверхглубокую скважину бурила Германия.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 71.66,
   "t1": 74.23,
   "say": "Немцы прошли чуть больше девяти километров.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 74.53,
   "t1": 76.32,
   "say": "И упёрлись в ту же стену.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 76.59,
   "t1": 79.44,
   "say": "Жара больше двухсот шестидесяти градусов.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 79.81,
   "t1": 82.08,
   "say": "Трубы и приборы просто не выдерживали.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 82.46,
   "t1": 86.06,
   "say": "Похоже, на этой глубине Земля ставит свой предел.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 86.41,
   "t1": 88.63,
   "say": "Земля просто не пустила дальше.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 89.17,
   "t1": 93.47,
   "say": "А в это время по миру уже вовсю гуляла совсем другая история.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 93.77,
   "t1": 97.28,
   "say": "Про то, почему на самом деле остановили бурение.",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0,
   "t1": 2.31,
   "say": "Тысяча девятьсот восемьдесят девятый год.",
   "gap": 0.5,
   "who": "narrator",
   "chapter": "7. Колодец в ад"
  },
  {
   "src": "ch7.mp3",
   "t0": 2.71,
   "t1": 5.71,
   "say": "Новость появляется в маленьком журнале в Финляндии.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 6.09,
   "t1": 9.64,
   "say": "Потом её подхватывает американский христианский телеканал.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 10.14,
   "t1": 11.41,
   "say": "История звучит так.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 11.93,
   "t1": 16.52,
   "say": "В Сибири советские учёные пробурили скважину на четырнадцать километров.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 17.01,
   "t1": 19.54,
   "say": "И бур вдруг провалился в пустоту.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 20.01,
   "t1": 22.56,
   "say": "Внизу оказалась огромная полость.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 22.8,
   "t1": 25.29,
   "say": "Температура — больше тысячи градусов.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 25.84,
   "t1": 30.68,
   "say": "Руководитель работ, некий доктор Азаков, приказал опустить туда микрофон.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 31.14,
   "t1": 33.16,
   "say": "И микрофон записал звук.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 33.63,
   "t1": 34.17,
   "say": "Крики.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 34.61,
   "t1": 35.64,
   "say": "Тысячи голосов.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 35.95,
   "t1": 37.76,
   "say": "Люди кричали от боли.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 38.24,
   "t1": 41.0,
   "say": "Через семнадцать секунд микрофон расплавился.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 41.37,
   "t1": 45.13,
   "say": "А потом из скважины вырвалось облако светящегося газа.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 45.4,
   "t1": 48.51,
   "say": "И в нём, будто бы, видели крылатую фигуру.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 49.04,
   "t1": 50.86,
   "say": "Рабочие в ужасе разбежались.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 51.32,
   "t1": 53.96,
   "say": "Позже в интернете появилась и сама «запись».",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 54.35,
   "t1": 56.98,
   "say": "Жуткий вой, от которого бегут мурашки.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 57.39,
   "t1": 59.66,
   "say": "Её переслушивали снова и снова.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 60.02,
   "t1": 62.12,
   "say": "Многие верят в неё до сих пор.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 62.66,
   "t1": 64.01,
   "say": "Но давай сравним.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 64.34,
   "t1": 67.4,
   "say": "Скважина не в Сибири, а на Кольском полуострове.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 67.78,
   "t1": 70.72,
   "say": "Глубина не четырнадцать километров, а двенадцать.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 71.09,
   "t1": 74.17,
   "say": "Температура не тысяча градусов, а сто восемьдесят.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 74.62,
   "t1": 76.67,
   "say": "Никакой пустоты внизу не было.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 76.82,
   "t1": 78.76,
   "say": "Внизу был горячий камень.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 79.27,
   "t1": 81.19,
   "say": "Так откуда взялась эта история?",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.01,
   "t1": 3.33,
   "say": "Путь легенды можно проследить почти шаг за шагом.",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "8. Кто это придумал"
  },
  {
   "src": "ch8.mp3",
   "t0": 3.74,
   "t1": 7.68,
   "say": "Сначала её напечатал маленький религиозный журнал в Финляндии.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 8.07,
   "t1": 11.47,
   "say": "Автор пересказал по памяти письмо читателя из газеты.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 11.91,
   "t1": 15.02,
   "say": "Потом историю перепечатал другой финский листок.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 15.19,
   "t1": 17.76,
   "say": "Летом тысяча девятьсот восемьдесят девятого.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 18.13,
   "t1": 19.98,
   "say": "И она попала в Америку.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 20.17,
   "t1": 21.65,
   "say": "На религиозный телеканал.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.9,
   "t1": 23.37,
   "say": "Её показали в эфире.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 23.53,
   "t1": 25.03,
   "say": "Без всякой проверки.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 25.48,
   "t1": 28.74,
   "say": "И тут в истории появляется норвежский учитель.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 29.05,
   "t1": 30.83,
   "say": "Его зовут Оге Рендален.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 31.16,
   "t1": 33.81,
   "say": "Он видит этот выпуск, когда бывает в Америке.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 34.02,
   "t1": 37.26,
   "say": "И решает проверить, насколько легко люди верят.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 37.68,
   "t1": 43.58,
   "say": "Рендален пишет на телеканал: да, я знаю эту историю, у нас в Норвегии о ней писали.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 43.89,
   "t1": 46.79,
   "say": "И присылает вырезку из норвежской газеты.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 46.94,
   "t1": 48.55,
   "say": "С «переводом» на английский.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 48.93,
   "t1": 52.15,
   "say": "Только в настоящей статье говорилось совсем о другом.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 52.34,
   "t1": 53.88,
   "say": "О строительном инспекторе.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 54.2,
   "t1": 56.91,
   "say": "А Рендален добавил в «перевод» всё, что хотел.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 57.13,
   "t1": 60.24,
   "say": "Даже летучую мышь, которая вылетела из скважины.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 60.58,
   "t1": 61.96,
   "say": "Телеканал поверил.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 62.1,
   "t1": 63.35,
   "say": "И показал и это.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 63.8,
   "t1": 67.13,
   "say": "Позже Рендален сам рассказал, что это был розыгрыш.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 67.39,
   "t1": 72.47,
   "say": "Он хотел показать, как легко люди принимают на веру то, что им хочется услышать.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 72.78,
   "t1": 73.72,
   "say": "И ведь показал.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 74.18,
   "t1": 77.2,
   "say": "Подумай, почему эта история так цепляет.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 77.55,
   "t1": 79.52,
   "say": "Секретный советский объект.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 79.76,
   "t1": 82.34,
   "say": "Учёные, которые зашли слишком далеко.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 82.65,
   "t1": 84.34,
   "say": "Крышка, которую заварили.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 84.68,
   "t1": 87.27,
   "say": "Всё это звучит как начало фильма ужасов.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 87.79,
   "t1": 89.79,
   "say": "А правду рассказать сложнее.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 90.14,
   "t1": 93.91,
   "say": "Про гранит, водород и трубы, которые ломает жара.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 94.26,
   "t1": 97.07,
   "say": "Но правда здесь не менее удивительная.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 97.53,
   "t1": 98.26,
   "say": "А «крики»?",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 98.59,
   "t1": 101.77,
   "say": "Это зацикленные звуки, наложенные друг на друга.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 102.17,
   "t1": 105.21,
   "say": "Часто говорят, что их взяли из старого фильма ужасов.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 105.63,
   "t1": 108.36,
   "say": "И с тех пор легенда только переезжала.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 108.66,
   "t1": 109.99,
   "say": "Сначала на Аляску.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 110.12,
   "t1": 111.61,
   "say": "Потом на нефтяную вышку.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 111.81,
   "t1": 115.56,
   "say": "А в две тысячи двадцатом году в России сняли фильм ужасов.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 115.9,
   "t1": 119.29,
   "say": "Он так и называется — «Кольская сверхглубокая».",
   "gap": 8.0,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 0.05,
   "t1": 1.98,
   "say": "А что же настоящая скважина?",
   "gap": 0.68,
   "who": "narrator",
   "chapter": "9. Финал"
  },
  {
   "src": "ch9.mp3",
   "t0": 2.56,
   "t1": 4.75,
   "say": "Тысяча девятьсот девяносто первый год.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 5.05,
   "t1": 7.06,
   "say": "Советского Союза больше нет.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 7.3,
   "t1": 9.27,
   "say": "Денег на науку почти нет.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 9.74,
   "t1": 13.75,
   "say": "В тысяча девятьсот девяносто четвёртом году бурят последний раз.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 14.1,
   "t1": 16.65,
   "say": "Глубина всего восемь с половиной километров.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 17.1,
   "t1": 19.09,
   "say": "Потом бурение останавливают.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 19.39,
   "t1": 20.09,
   "say": "Навсегда.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 20.69,
   "t1": 23.09,
   "say": "Когда-то здесь работали пятьсот человек.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 23.5,
   "t1": 26.65,
   "say": "К две тысячи восьмому году осталось около двадцати.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 27.09,
   "t1": 28.62,
   "say": "Предприятие закрывают.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 28.93,
   "t1": 31.07,
   "say": "Оборудование увозят и разбирают.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 31.44,
   "t1": 32.74,
   "say": "Здания пустеют.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 33.18,
   "t1": 35.84,
   "say": "А скважину заваривают железной крышкой.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 36.46,
   "t1": 38.01,
   "say": "Двенадцать километров.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 38.34,
   "t1": 41.01,
   "say": "Это рекорд, который не побит до сих пор.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 41.48,
   "t1": 44.09,
   "say": "Да, сегодня есть скважины и длиннее.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 44.39,
   "t1": 49.56,
   "say": "В Катаре, на Сахалине нефтяники бурят на двенадцать, даже на пятнадцать километров.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 49.99,
   "t1": 53.77,
   "say": "Но эти скважины идут почти горизонтально, под небольшим углом.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 54.11,
   "t1": 56.73,
   "say": "Настоящая глубина у них гораздо меньше.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 57.09,
   "t1": 59.41,
   "say": "А Кольская шла прямо вниз.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 59.79,
   "t1": 64.23,
   "say": "И всё равно это меньше половины процента пути до центра Земли.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 64.7,
   "t1": 66.31,
   "say": "Мы долетели до Луны.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 66.54,
   "t1": 69.26,
   "say": "Отправили зонды за пределы Солнечной системы.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 69.49,
   "t1": 73.61,
   "say": "А вглубь собственной планеты прошли всего на двенадцать километров.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 74.15,
   "t1": 75.11,
   "say": "И остановились.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 75.63,
   "t1": 76.17,
   "say": "Почему?",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 76.82,
   "t1": 78.21,
   "say": "Итак, три версии.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 78.79,
   "t1": 80.51,
   "say": "А — Земля не пустила.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 80.73,
   "t1": 86.66,
   "say": "Жара и мягкий, как пластик, камень сделали дальнейшее бурение невозможным.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 87.01,
   "t1": 87.98,
   "say": "Б — кончились деньги.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 88.19,
   "t1": 90.95,
   "say": "Скважина умерла вместе с Советским Союзом.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 91.59,
   "t1": 95.01,
   "say": "В — там нашли что-то, о чём решили молчать.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 95.22,
   "t1": 97.27,
   "say": "И крышку заварили не просто так.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 98.07,
   "t1": 99.01,
   "say": "А ты как думаешь?",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 99.23,
   "t1": 100.72,
   "say": "Напиши букву в комментариях.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 101.06,
   "t1": 103.85,
   "say": "И напиши, какую загадку разобрать следующей.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 104.18,
   "t1": 106.25,
   "say": "А если тебе понравилось — подпишись.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 106.55,
   "t1": 108.68,
   "say": "Впереди ещё много неразгаданного.",
   "gap": 8.0,
   "who": "narrator"
  }
 ]
}