  },
  {
   "src": "D_DIANAa.mp3",
   "t0": 7.34,
   "t1": 8.3,
   "say": "Я слышу.",
   "gap": 0.3,
   "who": "eva",
   "fx": "volume=3.697,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "D_DIANAa.mp3",
   "t0": 8.57,
   "t1": 10.15,
