   "who": "mom",
   "tempo": 1.05,
   "fx": "lowpass=f=1500,highpass=f=200,aecho=0.7:0.6:30|70:0.35|0.2,volume=1.35",
   "gap": 0.3
  },
  {
   "src": "N2a.mp3",
   "t0": 5.65,
   "t1": 8.38,
   "say": "Ты жмёшь «один». Кнопка не горит."
  },
  {
   "src": "N2a.mp3",
   "t0": 9.29,
   "t1": 11.41,
   "say": "Из твоей квартиры выходит девочка.",
