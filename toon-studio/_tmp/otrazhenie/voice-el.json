 "lines": [
  {
   "src": "N1a.mp3",
   "t0": 0.04,
   "t1": 0.54,
   "say": "Утро.",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "N1"
  },
  {
   "src": "N1a.mp3",
   "t0": 0.95,
   "t1": 2.78,
   "say": "Ты чистишь зубы перед зеркалом.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 3.22,
   "t1": 4.04,
   "say": "Ты моргаешь.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 4.4,
   "t1": 6.06,
   "say": "Отражение тоже моргает.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 6.29,
   "t1": 7.45,
   "say": "Только чуть позже.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 7.63,
   "t1": 8.49,
   "say": "На полсекунды.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 8.81,
   "t1": 9.73,
   "say": "Тебе показалось.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 10.2,
   "t1": 12.19,
   "say": "Вечером ты машешь себе рукой.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 12.48,
   "t1": 14.2,
   "say": "Отражение поднимает руку.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 14.43,
   "t1": 15.3,
   "say": "Через секунду.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 15.71,
   "t1": 17.41,
   "say": "Ты резко поворачиваешь голову.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 17.64,
   "t1": 19.27,
   "say": "А оно ещё смотрит на тебя.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 19.47,
   "t1": 21.41,
   "say": "И только потом отворачивается.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 21.81,
   "t1": 24.1,
   "say": "На следующий день то же самое.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 24.34,
   "t1": 25.0,
   "say": "В лифте.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 25.0,
   "t1": 26.0,
   "say": "В витрине.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 26.07,
   "t1": 27.3,
   "say": "В экране телефона.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 27.48,
   "t1": 29.76,
   "say": "Все твои отражения опаздывают.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 30.13,
   "t1": 31.45,
   "say": "Ты показываешь подруге.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "LIZAa.mp3",
   "t0": 0.01,
   "t1": 1.06,
   "say": "Всё нормально.",
   "gap": 0.25,
   "who": "liza",
   "chapter": "LIZA"
  },
  {
   "src": "LIZAa.mp3",
   "t0": 1.16,
   "t1": 2.67,
   "say": "Ты просто не выспалась.",
   "gap": 0.6,
   "who": "liza"
  },
  {
   "src": "N2a.mp3",
   "t0": 0.0,
   "t1": 3.02,
   "say": "Ночью ты завешиваешь все зеркала простынями.",
   "gap": 0.54,
   "who": "narrator",
   "chapter": "N2"
  },
  {
   "src": "N2a.mp3",
   "t0": 3.46,
   "t1": 6.53,
   "say": "В ванной под простынёй что-то тихо стучит.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 7.02,
   "t1": 7.48,
   "say": "Тук.",
   "gap": 0.7,
   "who": "narrator",
   "fx": "volume=3.5"
  },
  {
   "src": "N2a.mp3",
   "t0": 7.97,
   "t1": 8.36,
   "say": "Тук.",
   "gap": 0.8,
   "who": "narrator",
   "fx": "volume=2.2"
  },
  {
   "src": "N2a.mp3",
   "t0": 9.01,
   "t1": 10.94,
   "say": "Утром простыня лежит на полу.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 11.31,
   "t1": 13.25,
   "say": "На стекле отпечаток ладони.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 13.61,
   "t1": 14.52,
   "say": "С той стороны.",
   "gap": 1.0,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 14.92,
   "t1": 17.79,
   "say": "Теперь отражение опаздывает на три секунды.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 18.33,
   "t1": 19.32,
   "say": "Ты улыбаешься.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 19.74,
   "t1": 20.5,
   "say": "Оно ждёт.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 20.87,
   "t1": 22.61,
   "say": "И улыбается шире тебя.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 23.09,
   "t1": 24.69,
   "say": "И тут ты понимаешь.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 25.01,
   "t1": 26.19,
   "say": "Оно не опаздывает.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 26.5,
   "t1": 27.64,
   "say": "Оно повторяет.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 27.9,
   "t1": 28.89,
   "say": "Запоминает.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 29.25,
   "t1": 30.72,
   "say": "Учится быть тобой.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 31.21,
   "t1": 33.31,
   "say": "С каждым днём ошибок всё меньше.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 33.55,
   "t1": 35.27,
   "say": "Через неделю — ни одной.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 35.7,
   "t1": 37.61,
   "say": "Оно моргает вместе с тобой.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 37.85,
   "t1": 39.57,
   "say": "Улыбается вместе с тобой.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 40.13,
   "t1": 41.07,
   "say": "Ты выдыхаешь.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 41.52,
   "t1": 42.52,
   "say": "Всё закончилось.",
   "gap": 1.0,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 43.03,
   "t1": 44.39,
   "say": "Ты отходишь от зеркала.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 44.69,
   "t1": 46.85,
   "say": "А отражение остаётся стоять.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 47.28,
   "t1": 48.59,
   "say": "Оно машет тебе рукой.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "REFa.mp3",
   "t0": 0.09,
   "t1": 0.93,
   "say": "Спасибо.",
   "gap": 0.43,
   "who": "refl",
   "chapter": "REF",
   "fx": "volume=0.5,aecho=0.8:0.7:60|120:0.25|0.15,highpass=f=180"
  },
  {
   "src": "REFa.mp3",
   "t0": 1.26,
   "t1": 2.19,
   "say": "Дальше я сама.",
   "gap": 1.0,
   "who": "refl",
   "fx": "volume=0.5,aecho=0.8:0.7:60|120:0.25|0.15,highpass=f=180"
  },
  {
   "src": "N3a.mp3",
   "t0": 0,
   "t1": 1.33,
   "say": "Стекло холодное.",
   "gap": 0.4,
   "who": "narrator",
   "chapter": "N3"
  },
  {
   "src": "N3a.mp3",
   "t0": 1.63,
   "t1": 3.1,
   "say": "Ты стучишь по нему ладонью.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 3.4,
   "t1": 4.24,
   "say": "С той стороны.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 4.63,
   "t1": 6.21,
   "say": "А она чистит зубы.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 6.38,
   "t1": 7.27,
   "say": "И не слышит.",
   "gap": 1.0,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 7.67,
   "t1": 8.84,
   "say": "Посмотри на родинку.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 9.05,
   "t1": 10.44,
   "say": "Раньше она была слева.",
   "gap": 0.8,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
   "t0": 10.85,
   "t1": 12.17,
   "say": "Проверь своё отражение.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "N3a.mp3",
