{
 "voice": "elevenlabs",
 "total": 57.707,
 "lines": [
  {
   "i": 0,
   "text": "В твоём доме двенадцать этажей.",
   "start": 0.5,
   "end": 2.699,
   "who": "narrator",
   "words": [
    {
     "w": "В",
     "t": 0.62
    },
    {
     "w": "твоём",
     "t": 0.8
    },
    {
     "w": "доме",
     "t": 1.1
    },
    {
     "w": "двенадцать",
     "t": 1.6
    },
    {
     "w": "этажей.",
     "t": 2.06
    }
   ]
  },
  {
   "i": 1,
   "text": "А лифт приехал на тринадцатый.",
   "start": 2.999,
   "end": 4.816,
   "who": "narrator",
   "words": [
    {
     "w": "А",
     "t": 3.059
    },
    {
     "w": "лифт",
     "t": 3.199
    },
    {
     "w": "приехал",
     "t": 3.359
    },
    {
     "w": "на",
     "t": 3.839
    },
    {
     "w": "тринадцатый.",
     "t": 3.999
    }
   ]
  },
  {
   "i": 2,
   "text": "Дед Миша, лифтёр, учил всех детей в подъезде:",
   "start": 5.116,
   "end": 8.223,
   "who": "narrator",
   "words": [
    {
     "w": "Дед",
     "t": 5.136
    },
    {
     "w": "Миша,",
     "t": 5.296
    },
    {
     "w": "лифтёр,",
     "t": 5.676
    },
    {
     "w": "учил",
     "t": 6.176
    },
    {
     "w": "всех",
     "t": 6.796
    },
    {
     "w": "детей",
     "t": 7.036
    },
    {
     "w": "в",
     "t": 7.376
    },
    {
     "w": "подъезде:",
     "t": 7.556
    }
   ]
  },
  {
   "i": 3,
   "text": "Приедешь на тринадцатый — не выходи.",
   "start": 8.473,
   "end": 11.201,
   "who": "misha",
   "words": [
    {
     "w": "Приедешь",
     "t": 8.572
    },
    {
     "w": "на",
     "t": 8.912
    },
    {
     "w": "тринадцатый",
     "t": 8.992
    },
    {
     "w": "—",
     "t": 9.453
    },
    {
     "w": "не",
     "t": 9.553
    },
    {
     "w": "выходи.",
     "t": 9.713
    }
   ]
  },
  {
   "i": 4,
   "text": "И никогда не стой спиной к зеркалу.",
   "start": 11.401,
   "end": 14.125,
   "who": "misha",
   "words": [
    {
     "w": "И",
     "t": 11.441
    },
    {
     "w": "никогда",
     "t": 11.541
    },
    {
     "w": "не",
     "t": 11.941
    },
    {
     "w": "стой",
     "t": 12.081
    },
    {
     "w": "спиной",
     "t": 12.301
    },
    {
     "w": "к",
     "t": 12.721
    },
    {
     "w": "зеркалу.",
     "t": 12.841
    }
   ]
  },
  {
   "i": 5,
   "text": "Двери открываются.",
   "start": 14.575,
   "end": 15.92,
   "who": "narrator",
   "words": [
    {
     "w": "Двери",
     "t": 14.615
    },
    {
     "w": "открываются.",
     "t": 14.935
    }
   ]
  },
  {
   "i": 6,
   "text": "Это твой этаж. Твоя дверь.",
   "start": 16.17,
   "end": 18.343,
   "who": "narrator",
   "words": [
    {
     "w": "Это",
     "t": 16.19
    },
    {
     "w": "твой",
     "t": 16.57
    },
    {
     "w": "этаж.",
     "t": 16.75
    },
    {
     "w": "Твоя",
     "t": 17.75
    },
    {
     "w": "дверь.",
     "t": 18.07
    }
   ]
  },
  {
   "i": 7,
   "text": "«Алиса, ты? Иди ужинать, всё остыло!»",
   "start": 18.593,
   "end": 21.718,
   "who": "mom",
   "words": [
    {
     "w": "«Алиса,",
     "t": 18.633
    },
    {
     "w": "ты?",
     "t": 19.173
    },
    {
     "w": "Иди",
     "t": 19.433
    },
    {
     "w": "ужинать,",
     "t": 20.153
    },
    {
     "w": "всё",
     "t": 20.633
    },
    {
     "w": "остыло!»",
     "t": 20.953
    }
   ]
  },
  {
   "i": 8,
   "text": "Ты жмёшь «один». Кнопка не горит.",
   "start": 22.018,
   "end": 24.468,
   "who": "narrator",
   "words": [
    {
     "w": "Ты",
     "t": 22.038
    },
    {
     "w": "жмёшь",
     "t": 22.278
    },
    {
     "w": "«один».",
     "t": 22.518
    },
    {
     "w": "Кнопка",
     "t": 23.578
    },
    {
     "w": "не",
     "t": 23.898
    },
    {
     "w": "горит.",
     "t": 24.058
    }
   ]
  },
  {
   "i": 9,
   "text": "Из твоей квартиры выходит девочка.",
   "start": 24.768,
   "end": 26.675,
   "who": "narrator",
   "words": [
    {
     "w": "Из",
     "t": 24.788
    },
    {
     "w": "твоей",
     "t": 24.928
    },
    {
     "w": "квартиры",
     "t": 25.228
    },
    {
     "w": "выходит",
     "t": 25.688
    },
    {
     "w": "девочка.",
     "t": 26.128
    }
   ]
  },
  {
   "i": 10,
   "text": "В твоём худи. С твоим лицом.",
   "start": 26.875,
   "end": 29.02,
   "who": "narrator",
   "words": [
    {
     "w": "В",
     "t": 26.935
    },
    {
     "w": "твоём",
     "t": 27.075
    },
    {
     "w": "худи.",
     "t": 27.395
    },
    {
     "w": "С",
     "t": 28.155
    },
    {
     "w": "твоим",
     "t": 28.315
    },
    {
     "w": "лицом.",
     "t": 28.635
    }
   ]
  },
  {
   "i": 11,
   "text": "Она идёт к лифту. И улыбается.",
   "start": 29.32,
   "end": 31.581,
   "who": "narrator",
   "words": [
    {
     "w": "Она",
     "t": 29.36
    },
    {
     "w": "идёт",
     "t": 29.62
