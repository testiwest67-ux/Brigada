   "who": "eva",
   "fx": "volume=4.265,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "N4a.mp3",
   "t0": 0,
   "t1": 2.13,
   "say": "Ты выдёргиваешь колонку из розетки.",
