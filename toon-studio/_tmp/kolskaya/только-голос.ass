Dialogue: 0,0:00:05.00,0:00:06.60,N,,0,0,0,,1
Dialogue: 0,0:00:05.00,0:00:06.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:05.00,0:00:06.60,T,,0,0,0,,Север России.
Dialogue: 0,0:00:06.62,0:00:08.40,N,,0,0,0,,2
Dialogue: 0,0:00:06.62,0:00:08.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:06.62,0:00:08.40,T,,0,0,0,,Кольский полуостров.
Dialogue: 0,0:00:08.42,0:00:10.01,N,,0,0,0,,3
Dialogue: 0,0:00:08.42,0:00:10.01,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:08.42,0:00:10.01,T,,0,0,0,,Тундра, ветер и снег.
Dialogue: 0,0:00:10.03,0:00:13.94,N,,0,0,0,,4
Dialogue: 0,0:00:10.03,0:00:13.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:10.03,0:00:13.94,T,,0,0,0,,Среди камней стоят пустые здания.
Dialogue: 0,0:00:13.96,0:00:15.26,N,,0,0,0,,5
Dialogue: 0,0:00:13.96,0:00:15.26,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:13.96,0:00:15.26,T,,0,0,0,,Окна выбиты.
Dialogue: 0,0:00:15.28,0:00:16.89,N,,0,0,0,,6
Dialogue: 0,0:00:15.28,0:00:16.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:15.28,0:00:16.89,T,,0,0,0,,Крыша провалилась.
Dialogue: 0,0:00:16.91,0:00:20.69,N,,0,0,0,,7
Dialogue: 0,0:00:16.91,0:00:20.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:16.91,0:00:20.69,T,,0,0,0,,А посреди бетона — ржавая железная крышка.
Dialogue: 0,0:00:20.71,0:00:22.36,N,,0,0,0,,8
Dialogue: 0,0:00:20.71,0:00:22.36,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:20.71,0:00:22.36,T,,0,0,0,,Чуть больше тарелки.
Dialogue: 0,0:00:22.38,0:00:23.69,N,,0,0,0,,9
Dialogue: 0,0:00:22.38,0:00:23.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:22.38,0:00:23.69,T,,0,0,0,,Её заварили.
Dialogue: 0,0:00:23.71,0:00:24.96,N,,0,0,0,,10
Dialogue: 0,0:00:23.71,0:00:24.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:23.71,0:00:24.96,T,,0,0,0,,Наглухо.
Dialogue: 0,0:00:24.98,0:00:30.79,N,,0,0,0,,11
Dialogue: 0,0:00:24.98,0:00:30.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:24.98,0:00:30.79,T,,0,0,0,,Под этой крышкой — самая глубокая дыра, которую человек когда-либо сделал в Земле.
Dialogue: 0,0:00:30.81,0:00:33.32,N,,0,0,0,,12
Dialogue: 0,0:00:30.81,0:00:33.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:30.81,0:00:33.32,T,,0,0,0,,Двенадцать километров вниз.
Dialogue: 0,0:00:33.34,0:00:36.23,N,,0,0,0,,13
Dialogue: 0,0:00:33.34,0:00:36.23,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:33.34,0:00:36.23,T,,0,0,0,,Это глубже, чем Эверест высокий.
Dialogue: 0,0:00:36.25,0:00:40.72,N,,0,0,0,,14
Dialogue: 0,0:00:36.25,0:00:40.72,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:36.25,0:00:40.72,T,,0,0,0,,Про эту дыру по всему миру рассказывают страшную историю.
Dialogue: 0,0:00:40.74,0:00:43.74,N,,0,0,0,,15
Dialogue: 0,0:00:40.74,0:00:43.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:40.74,0:00:43.74,T,,0,0,0,,Будто учёные опустили туда микрофон.
Dialogue: 0,0:00:43.76,0:00:45.64,N,,0,0,0,,16
Dialogue: 0,0:00:43.76,0:00:45.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:43.76,0:00:45.64,T,,0,0,0,,И услышали крики.
Dialogue: 0,0:00:45.66,0:00:47.27,N,,0,0,0,,17
Dialogue: 0,0:00:45.66,0:00:47.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:45.66,0:00:47.27,T,,0,0,0,,Тысячи голосов.
Dialogue: 0,0:00:47.29,0:00:49.40,N,,0,0,0,,18
Dialogue: 0,0:00:47.29,0:00:49.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:47.29,0:00:49.40,T,,0,0,0,,Из самой глубины.
Dialogue: 0,0:00:49.42,0:00:52.09,N,,0,0,0,,19
Dialogue: 0,0:00:49.42,0:00:52.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:49.42,0:00:52.09,T,,0,0,0,,Будто после этого скважину закрыли.
Dialogue: 0,0:00:52.11,0:00:53.42,N,,0,0,0,,20
Dialogue: 0,0:00:52.11,0:00:53.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:52.11,0:00:53.42,T,,0,0,0,,И заварили.
Dialogue: 0,0:00:53.44,0:00:56.16,N,,0,0,0,,21
Dialogue: 0,0:00:53.44,0:00:56.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:53.44,0:00:56.16,T,,0,0,0,,Чтобы никто больше не слушал.
Dialogue: 0,0:00:56.18,0:00:57.90,N,,0,0,0,,22
Dialogue: 0,0:00:56.18,0:00:57.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:56.18,0:00:57.90,T,,0,0,0,,Звучит как сказка.
Dialogue: 0,0:00:57.92,0:01:00.27,N,,0,0,0,,23
Dialogue: 0,0:00:57.92,0:01:00.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:57.92,0:01:00.27,T,,0,0,0,,Но скважина настоящая.
Dialogue: 0,0:01:00.29,0:01:02.70,N,,0,0,0,,24
Dialogue: 0,0:01:00.29,0:01:02.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:00.29,0:01:02.70,T,,0,0,0,,Её бурили больше двадцати лет.
Dialogue: 0,0:01:02.72,0:01:04.91,N,,0,0,0,,25
Dialogue: 0,0:01:02.72,0:01:04.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:02.72,0:01:04.91,T,,0,0,0,,Там работали сотни людей.
Dialogue: 0,0:01:04.93,0:01:09.86,N,,0,0,0,,26
Dialogue: 0,0:01:04.93,0:01:09.86,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:04.93,0:01:09.86,T,,0,0,0,,И на глубине они действительно нашли то, чего не ждал никто.
Dialogue: 0,0:01:09.88,0:01:12.06,N,,0,0,0,,27
Dialogue: 0,0:01:09.88,0:01:12.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:09.88,0:01:12.06,T,,0,0,0,,Так что же там, под крышкой?
Dialogue: 0,0:01:12.08,0:01:15.54,N,,0,0,0,,28
Dialogue: 0,0:01:12.08,0:01:15.54,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:12.08,0:01:15.54,T,,0,0,0,,Почему самую глубокую дыру на планете бросили?
Dialogue: 0,0:01:15.56,0:01:17.81,N,,0,0,0,,29
Dialogue: 0,0:01:15.56,0:01:17.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:15.56,0:01:17.81,T,,0,0,0,,И откуда взялись крики?
Dialogue: 0,0:01:17.83,0:01:19.79,N,,0,0,0,,30
Dialogue: 0,0:01:17.83,0:01:19.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:17.83,0:01:19.79,T,,0,0,0,,Давай разберёмся по порядку.
Dialogue: 0,0:01:19.81,0:01:21.02,N,,0,0,0,,31
Dialogue: 0,0:01:19.81,0:01:21.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:19.81,0:01:21.02,T,,0,0,0,,По фактам.
Dialogue: 0,0:01:21.04,0:01:23.17,N,,0,0,0,,32
Dialogue: 0,0:01:21.04,0:01:23.17,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:21.04,0:01:23.17,T,,0,0,0,,А в конце — три версии.
Dialogue: 0,0:01:23.19,0:01:33.95,N,,0,0,0,,33
Dialogue: 0,0:01:23.19,0:01:33.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:23.19,0:01:33.95,T,,0,0,0,,И ты решишь, какая из них ближе к правде.
Dialogue: 0,0:01:33.97,0:01:36.78,N,,0,0,0,,34
Dialogue: 0,0:01:33.97,0:01:36.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:33.97,0:01:36.78,T,,0,0,0,,Пятидесятые и шестидесятые годы.
Dialogue: 0,0:01:36.80,0:01:38.74,N,,0,0,0,,35
Dialogue: 0,0:01:36.80,0:01:38.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:36.80,0:01:38.74,T,,0,0,0,,Холодная война.
Dialogue: 0,0:01:38.76,0:01:42.55,N,,0,0,0,,36
Dialogue: 0,0:01:38.76,0:01:42.55,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:38.76,0:01:42.55,T,,0,0,0,,СССР и Америка соревнуются во всём.
Dialogue: 0,0:01:42.57,0:01:44.60,N,,0,0,0,,37
Dialogue: 0,0:01:42.57,0:01:44.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:42.57,0:01:44.60,T,,0,0,0,,Кто первым запустит спутник.
Dialogue: 0,0:01:44.62,0:01:47.34,N,,0,0,0,,38
Dialogue: 0,0:01:44.62,0:01:47.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:44.62,0:01:47.34,T,,0,0,0,,Кто первым отправит человека в космос.
Dialogue: 0,0:01:47.36,0:01:49.96,N,,0,0,0,,39
Dialogue: 0,0:01:47.36,0:01:49.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:47.36,0:01:49.96,T,,0,0,0,,Кто первым долетит до Луны.
Dialogue: 0,0:01:49.98,0:01:53.41,N,,0,0,0,,40
Dialogue: 0,0:01:49.98,0:01:53.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:49.98,0:01:53.41,T,,0,0,0,,Но есть место, куда не заглянул никто.
Dialogue: 0,0:01:53.43,0:01:55.71,N,,0,0,0,,41
Dialogue: 0,0:01:53.43,0:01:55.71,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:53.43,0:01:55.71,T,,0,0,0,,Оно у нас под ногами.
Dialogue: 0,0:01:55.73,0:01:58.83,N,,0,0,0,,42
Dialogue: 0,0:01:55.73,0:01:58.83,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:55.73,0:01:58.83,T,,0,0,0,,Мы видим звёзды за миллиарды километров.
Dialogue: 0,0:01:58.85,0:02:03.04,N,,0,0,0,,43
Dialogue: 0,0:01:58.85,0:02:03.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:58.85,0:02:03.04,T,,0,0,0,,А что под землёй глубже нескольких километров — не знаем.
Dialogue: 0,0:02:03.06,0:02:04.91,N,,0,0,0,,44
Dialogue: 0,0:02:03.06,0:02:04.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:03.06,0:02:04.91,T,,0,0,0,,Только догадываемся.
Dialogue: 0,0:02:04.93,0:02:09.42,N,,0,0,0,,45
Dialogue: 0,0:02:04.93,0:02:09.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:04.93,0:02:09.42,T,,0,0,0,,Учёные слушают, как по Земле бегут волны от землетрясений.
Dialogue: 0,0:02:09.44,0:02:12.97,N,,0,0,0,,46
Dialogue: 0,0:02:09.44,0:02:12.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:09.44,0:02:12.97,T,,0,0,0,,И рисуют картину: сверху гранит.
Dialogue: 0,0:02:12.99,0:02:14.80,N,,0,0,0,,47
Dialogue: 0,0:02:12.99,0:02:14.80,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:12.99,0:02:14.80,T,,0,0,0,,Под ним базальт.
Dialogue: 0,0:02:14.82,0:02:17.33,N,,0,0,0,,48
Dialogue: 0,0:02:14.82,0:02:17.33,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:14.82,0:02:17.33,T,,0,0,0,,Ещё глубже — мантия.
Dialogue: 0,0:02:17.35,0:02:21.00,N,,0,0,0,,49
Dialogue: 0,0:02:17.35,0:02:21.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:17.35,0:02:21.00,T,,0,0,0,,Проверить эту картину можно только одним способом.
Dialogue: 0,0:02:21.02,0:02:22.65,N,,0,0,0,,50
Dialogue: 0,0:02:21.02,0:02:22.65,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:21.02,0:02:22.65,T,,0,0,0,,Пробурить.
Dialogue: 0,0:02:22.67,0:02:25.01,N,,0,0,0,,51
Dialogue: 0,0:02:22.67,0:02:25.01,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:22.67,0:02:25.01,T,,0,0,0,,Американцы пробуют первыми.
Dialogue: 0,0:02:25.03,0:02:27.60,N,,0,0,0,,52
Dialogue: 0,0:02:25.03,0:02:27.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:25.03,0:02:27.60,T,,0,0,0,,Их проект бурит дно океана.
Dialogue: 0,0:02:27.62,0:02:29.35,N,,0,0,0,,53
Dialogue: 0,0:02:27.62,0:02:29.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:27.62,0:02:29.35,T,,0,0,0,,Но денег не хватает.
Dialogue: 0,0:02:29.37,0:02:31.39,N,,0,0,0,,54
Dialogue: 0,0:02:29.37,0:02:31.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:29.37,0:02:31.39,T,,0,0,0,,Проект закрывают.
Dialogue: 0,0:02:31.41,0:02:36.02,N,,0,0,0,,55
Dialogue: 0,0:02:31.41,0:02:36.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:31.41,0:02:36.02,T,,0,0,0,,А Советский Союз решает: мы пройдём глубже всех.
Dialogue: 0,0:02:36.04,0:02:39.51,N,,0,0,0,,56
Dialogue: 0,0:02:36.04,0:02:39.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:36.04,0:02:39.51,T,,0,0,0,,Место выбирают на Кольском полуострове.
Dialogue: 0,0:02:39.53,0:02:43.15,N,,0,0,0,,57
Dialogue: 0,0:02:39.53,0:02:43.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:39.53,0:02:43.15,T,,0,0,0,,Здесь древние камни выходят прямо к поверхности.
Dialogue: 0,0:02:43.17,0:02:47.16,N,,0,0,0,,58
Dialogue: 0,0:02:43.17,0:02:47.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:43.17,0:02:47.16,T,,0,0,0,,Возраст некоторых из них — почти три миллиарда лет.
Dialogue: 0,0:02:47.18,0:02:53.19,N,,0,0,0,,59
Dialogue: 0,0:02:47.18,0:02:53.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:47.18,0:02:53.19,T,,0,0,0,,Двадцать четвёртого мая тысяча девятьсот семидесятого года бур впервые входит в землю.
Dialogue: 0,0:02:53.21,0:02:55.78,N,,0,0,0,,60
Dialogue: 0,0:02:53.21,0:02:55.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:53.21,0:02:55.78,T,,0,0,0,,Сначала цель — семь километров.
Dialogue: 0,0:02:55.80,0:02:58.09,N,,0,0,0,,61
Dialogue: 0,0:02:55.80,0:02:58.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:55.80,0:02:58.09,T,,0,0,0,,Но очень скоро её поднимут.
Dialogue: 0,0:02:58.11,0:03:07.09,N,,0,0,0,,62
Dialogue: 0,0:02:58.11,0:03:07.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:58.11,0:03:07.09,T,,0,0,0,,До пятнадцати.
Dialogue: 0,0:03:07.11,0:03:09.44,N,,0,0,0,,63
Dialogue: 0,0:03:07.11,0:03:09.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:07.11,0:03:09.44,T,,0,0,0,,Ближайший город — Заполярный.
Dialogue: 0,0:03:09.46,0:03:12.22,N,,0,0,0,,64
Dialogue: 0,0:03:09.46,0:03:12.22,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:09.46,0:03:12.22,T,,0,0,0,,Двенадцать километров по тундре.
Dialogue: 0,0:03:12.24,0:03:14.57,N,,0,0,0,,65
Dialogue: 0,0:03:12.24,0:03:14.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:12.24,0:03:14.57,T,,0,0,0,,Зимой здесь полярная ночь.
Dialogue: 0,0:03:14.59,0:03:16.89,N,,0,0,0,,66
Dialogue: 0,0:03:14.59,0:03:16.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:14.59,0:03:16.89,T,,0,0,0,,Солнце не встаёт неделями.
Dialogue: 0,0:03:16.91,0:03:19.13,N,,0,0,0,,67
Dialogue: 0,0:03:16.91,0:03:19.13,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:16.91,0:03:19.13,T,,0,0,0,,Летом оно не садится.
Dialogue: 0,0:03:19.15,0:03:21.52,N,,0,0,0,,68
Dialogue: 0,0:03:19.15,0:03:21.52,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:19.15,0:03:21.52,T,,0,0,0,,На буровой работают круглые сутки.
Dialogue: 0,0:03:21.54,0:03:23.32,N,,0,0,0,,69
Dialogue: 0,0:03:21.54,0:03:23.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:21.54,0:03:23.32,T,,0,0,0,,Смена за сменой.
Dialogue: 0,0:03:23.34,0:03:26.76,N,,0,0,0,,70
Dialogue: 0,0:03:23.34,0:03:26.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:23.34,0:03:26.76,T,,0,0,0,,В лучшие годы здесь трудятся около пятисот человек.
Dialogue: 0,0:03:26.78,0:03:30.40,N,,0,0,0,,71
Dialogue: 0,0:03:26.78,0:03:30.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:26.78,0:03:30.40,T,,0,0,0,,Буровики, геологи, химики, инженеры.
Dialogue: 0,0:03:30.42,0:03:34.08,N,,0,0,0,,72
Dialogue: 0,0:03:30.42,0:03:34.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:30.42,0:03:34.08,T,,0,0,0,,Руководит экспедицией геолог Давид Губерман.
Dialogue: 0,0:03:34.10,0:03:37.91,N,,0,0,0,,73
Dialogue: 0,0:03:34.10,0:03:37.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:34.10,0:03:37.91,T,,0,0,0,,Над скважиной вырастает высокая буровая башня.
Dialogue: 0,0:03:37.93,0:03:43.41,N,,0,0,0,,74
Dialogue: 0,0:03:37.93,0:03:43.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:37.93,0:03:43.41,T,,0,0,0,,В тысяча девятьсот семьдесят четвёртом сюда привозят новую буровую установку.
Dialogue: 0,0:03:43.43,0:03:46.81,N,,0,0,0,,75
Dialogue: 0,0:03:43.43,0:03:46.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:43.43,0:03:46.81,T,,0,0,0,,Её называют «Уралмаш-пятнадцать тысяч».
Dialogue: 0,0:03:46.83,0:03:50.65,N,,0,0,0,,76
Dialogue: 0,0:03:46.83,0:03:50.65,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:46.83,0:03:50.65,T,,0,0,0,,По новой цели — пятнадцать тысяч метров.
Dialogue: 0,0:03:50.67,0:03:52.92,N,,0,0,0,,77
Dialogue: 0,0:03:50.67,0:03:52.92,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:50.67,0:03:52.92,T,,0,0,0,,Представь, как это работает.
Dialogue: 0,0:03:52.94,0:03:55.53,N,,0,0,0,,78
Dialogue: 0,0:03:52.94,0:03:55.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:52.94,0:03:55.53,T,,0,0,0,,Вниз уходит колонна из труб.
Dialogue: 0,0:03:55.55,0:03:58.05,N,,0,0,0,,79
Dialogue: 0,0:03:55.55,0:03:58.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:55.55,0:03:58.05,T,,0,0,0,,Трубы свинчивают одну за другой.
Dialogue: 0,0:03:58.07,0:04:00.71,N,,0,0,0,,80
Dialogue: 0,0:03:58.07,0:04:00.71,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:58.07,0:04:00.71,T,,0,0,0,,А на самом дне крутится долото.
Dialogue: 0,0:04:00.73,0:04:02.81,N,,0,0,0,,81
Dialogue: 0,0:04:00.73,0:04:02.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:00.73,0:04:02.81,T,,0,0,0,,Оно грызёт камень.
Dialogue: 0,0:04:02.83,0:04:06.41,N,,0,0,0,,82
Dialogue: 0,0:04:02.83,0:04:06.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:02.83,0:04:06.41,T,,0,0,0,,Ширина ствола — около двадцати трёх сантиметров.
Dialogue: 0,0:04:06.43,0:04:09.48,N,,0,0,0,,83
Dialogue: 0,0:04:06.43,0:04:09.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:06.43,0:04:09.48,T,,0,0,0,,Чуть шире твоей ладони с растопыренными пальцами.
Dialogue: 0,0:04:09.50,0:04:13.89,N,,0,0,0,,84
Dialogue: 0,0:04:09.50,0:04:13.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:09.50,0:04:13.89,T,,0,0,0,,И вот такой узкий ход уходит на километры вниз.
Dialogue: 0,0:04:13.91,0:04:18.02,N,,0,0,0,,85
Dialogue: 0,0:04:13.91,0:04:18.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:13.91,0:04:18.02,T,,0,0,0,,Каждый раз, когда долото стирается, всю колонну поднимают.
Dialogue: 0,0:04:18.04,0:04:20.35,N,,0,0,0,,86
Dialogue: 0,0:04:18.04,0:04:20.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:18.04,0:04:20.35,T,,0,0,0,,Разбирают трубу за трубой.
Dialogue: 0,0:04:20.37,0:04:21.88,N,,0,0,0,,87
Dialogue: 0,0:04:20.37,0:04:21.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:20.37,0:04:21.88,T,,0,0,0,,Меняют долото.
Dialogue: 0,0:04:21.90,0:04:23.66,N,,0,0,0,,88
Dialogue: 0,0:04:21.90,0:04:23.66,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:21.90,0:04:23.66,T,,0,0,0,,И опускают снова.
Dialogue: 0,0:04:23.68,0:04:29.11,N,,0,0,0,,89
Dialogue: 0,0:04:23.68,0:04:29.11,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:23.68,0:04:29.11,T,,0,0,0,,На глубине в десять километров один такой подъём занимает многие часы.
Dialogue: 0,0:04:29.13,0:04:32.39,N,,0,0,0,,90
Dialogue: 0,0:04:29.13,0:04:32.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:29.13,0:04:32.39,T,,0,0,0,,А вместе с породой наверх достают керн.
Dialogue: 0,0:04:32.41,0:04:34.99,N,,0,0,0,,91
Dialogue: 0,0:04:32.41,0:04:34.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:32.41,0:04:34.99,T,,0,0,0,,Это столбик камня из глубины.
Dialogue: 0,0:04:35.01,0:04:38.29,N,,0,0,0,,92
Dialogue: 0,0:04:35.01,0:04:38.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:35.01,0:04:38.29,T,,0,0,0,,Его режут, изучают, подписывают.
Dialogue: 0,0:04:38.31,0:04:50.61,N,,0,0,0,,93
Dialogue: 0,0:04:38.31,0:04:50.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:38.31,0:04:50.61,T,,0,0,0,,Каждый метр — как страница книги, которую раньше не читал никто.
Dialogue: 0,0:04:50.63,0:04:54.57,N,,0,0,0,,94
Dialogue: 0,0:04:50.63,0:04:54.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:50.63,0:04:54.57,T,,0,0,0,,Шестого июня тысяча девятьсот семьдесят девятого года.
Dialogue: 0,0:04:54.59,0:04:59.26,N,,0,0,0,,95
Dialogue: 0,0:04:54.59,0:04:59.26,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:54.59,0:04:59.26,T,,0,0,0,,Кольская скважина проходит девять тысяч пятьсот восемьдесят три метра.
Dialogue: 0,0:04:59.28,0:05:04.76,N,,0,0,0,,96
Dialogue: 0,0:04:59.28,0:05:04.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:59.28,0:05:04.76,T,,0,0,0,,До этого дня самой глубокой в мире была скважина в Америке, в штате Оклахома.
Dialogue: 0,0:05:04.78,0:05:07.79,N,,0,0,0,,97
Dialogue: 0,0:05:04.78,0:05:07.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:04.78,0:05:07.79,T,,0,0,0,,Теперь рекорд у Советского Союза.
Dialogue: 0,0:05:07.81,0:05:09.88,N,,0,0,0,,98
Dialogue: 0,0:05:07.81,0:05:09.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:07.81,0:05:09.88,T,,0,0,0,,Но бур идёт дальше.
Dialogue: 0,0:05:09.90,0:05:16.66,N,,0,0,0,,99
Dialogue: 0,0:05:09.90,0:05:16.66,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:09.90,0:05:16.66,T,,0,0,0,,В тысяча девятьсот восемьдесят третьем году скважина проходит двенадцать километров.
Dialogue: 0,0:05:16.68,0:05:18.75,N,,0,0,0,,100
Dialogue: 0,0:05:16.68,0:05:18.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:16.68,0:05:18.75,T,,0,0,0,,Двенадцать тысяч метров вниз.
Dialogue: 0,0:05:18.77,0:05:21.74,N,,0,0,0,,101
Dialogue: 0,0:05:18.77,0:05:21.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:18.77,0:05:21.74,T,,0,0,0,,Это больше, чем глубина Марианской впадины.
Dialogue: 0,0:05:21.76,0:05:25.25,N,,0,0,0,,102
Dialogue: 0,0:05:21.76,0:05:25.25,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:21.76,0:05:25.25,T,,0,0,0,,Бурение останавливают почти на год.
Dialogue: 0,0:05:25.27,0:05:31.50,N,,0,0,0,,103
Dialogue: 0,0:05:25.27,0:05:31.50,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:25.27,0:05:31.50,T,,0,0,0,,В тысяча девятьсот восемьдесят четвёртом в Москве собирается Международный геологический конгресс.
Dialogue: 0,0:05:31.51,0:05:33.66,N,,0,0,0,,104
Dialogue: 0,0:05:31.51,0:05:33.66,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:31.51,0:05:33.66,T,,0,0,0,,Учёные со всего мира.
Dialogue: 0,0:05:33.68,0:05:36.91,N,,0,0,0,,105
Dialogue: 0,0:05:33.68,0:05:36.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:33.68,0:05:36.91,T,,0,0,0,,И Советский Союз показывает им Кольскую.
Dialogue: 0,0:05:36.93,0:05:39.36,N,,0,0,0,,106
Dialogue: 0,0:05:36.93,0:05:39.36,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:36.93,0:05:39.36,T,,0,0,0,,Керны, цифры, графики.
Dialogue: 0,0:05:39.38,0:05:42.20,N,,0,0,0,,107
Dialogue: 0,0:05:39.38,0:05:42.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:39.38,0:05:42.20,T,,0,0,0,,Иностранцы приезжают прямо на буровую.
Dialogue: 0,0:05:42.22,0:05:45.05,N,,0,0,0,,108
Dialogue: 0,0:05:42.22,0:05:45.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:42.22,0:05:45.05,T,,0,0,0,,Для геологов это как первый спутник.
Dialogue: 0,0:05:45.07,0:05:49.81,N,,0,0,0,,109
Dialogue: 0,0:05:45.07,0:05:49.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:45.07,0:05:49.81,T,,0,0,0,,Кажется, ещё немного — и пятнадцать километров будут взяты.
Dialogue: 0,0:05:49.83,0:05:53.43,N,,0,0,0,,110
Dialogue: 0,0:05:49.83,0:05:53.43,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:49.83,0:05:53.43,T,,0,0,0,,Но после конгресса бурение начинают снова.
Dialogue: 0,0:05:53.44,0:06:04.85,N,,0,0,0,,111
Dialogue: 0,0:05:53.44,0:06:04.85,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:53.44,0:06:04.85,T,,0,0,0,,И случается то, чего боится каждый буровик.
Dialogue: 0,0:06:04.87,0:06:09.38,N,,0,0,0,,112
Dialogue: 0,0:06:04.87,0:06:09.38,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:04.87,0:06:09.38,T,,0,0,0,,Двадцать седьмое сентября тысяча девятьсот восемьдесят четвёртого года.
Dialogue: 0,0:06:09.40,0:06:13.35,N,,0,0,0,,113
Dialogue: 0,0:06:09.40,0:06:13.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:09.40,0:06:13.35,T,,0,0,0,,Глубина — двенадцать тысяч шестьдесят шесть метров.
Dialogue: 0,0:06:13.37,0:06:15.81,N,,0,0,0,,114
Dialogue: 0,0:06:13.37,0:06:15.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:13.37,0:06:15.81,T,,0,0,0,,Колонну поднимают наверх.
Dialogue: 0,0:06:15.83,0:06:18.53,N,,0,0,0,,115
Dialogue: 0,0:06:15.83,0:06:18.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:15.83,0:06:18.53,T,,0,0,0,,И вдруг она становится лёгкой.
Dialogue: 0,0:06:18.55,0:06:20.39,N,,0,0,0,,116
Dialogue: 0,0:06:18.55,0:06:20.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:18.55,0:06:20.39,T,,0,0,0,,Слишком лёгкой.
Dialogue: 0,0:06:20.41,0:06:22.29,N,,0,0,0,,117
Dialogue: 0,0:06:20.41,0:06:22.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:20.41,0:06:22.29,T,,0,0,0,,Труба оборвалась.
Dialogue: 0,0:06:22.31,0:06:25.48,N,,0,0,0,,118
Dialogue: 0,0:06:22.31,0:06:25.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:22.31,0:06:25.48,T,,0,0,0,,Где-то в глубине осталась часть колонны.
Dialogue: 0,0:06:25.50,0:06:28.00,N,,0,0,0,,119
Dialogue: 0,0:06:25.50,0:06:28.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:25.50,0:06:28.00,T,,0,0,0,,Около пяти километров труб.
Dialogue: 0,0:06:28.02,0:06:30.18,N,,0,0,0,,120
Dialogue: 0,0:06:28.02,0:06:30.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:28.02,0:06:30.18,T,,0,0,0,,Пять километров железа.
Dialogue: 0,0:06:30.20,0:06:32.45,N,,0,0,0,,121
Dialogue: 0,0:06:30.20,0:06:32.45,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:30.20,0:06:32.45,T,,0,0,0,,В дыре шириной с тарелку.
Dialogue: 0,0:06:32.47,0:06:34.64,N,,0,0,0,,122
Dialogue: 0,0:06:32.47,0:06:34.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:32.47,0:06:34.64,T,,0,0,0,,Достать их невозможно.
Dialogue: 0,0:06:34.66,0:06:37.05,N,,0,0,0,,123
Dialogue: 0,0:06:34.66,0:06:37.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:34.66,0:06:37.05,T,,0,0,0,,Годы работы — на дне.
Dialogue: 0,0:06:37.07,0:06:39.28,N,,0,0,0,,124
Dialogue: 0,0:06:37.07,0:06:39.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:37.07,0:06:39.28,T,,0,0,0,,Есть только один выход.
Dialogue: 0,0:06:39.30,0:06:40.76,N,,0,0,0,,125
Dialogue: 0,0:06:39.30,0:06:40.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:39.30,0:06:40.76,T,,0,0,0,,Бурить заново.
Dialogue: 0,0:06:40.78,0:06:41.97,N,,0,0,0,,126
Dialogue: 0,0:06:40.78,0:06:41.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:40.78,0:06:41.97,T,,0,0,0,,В обход.
Dialogue: 0,0:06:41.99,0:06:46.62,N,,0,0,0,,127
Dialogue: 0,0:06:41.99,0:06:46.62,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:41.99,0:06:46.62,T,,0,0,0,,Буровики уходят в сторону от старого ствола и снова идут вниз.
Dialogue: 0,0:06:46.64,0:06:48.14,N,,0,0,0,,128
Dialogue: 0,0:06:46.64,0:06:48.14,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:46.64,0:06:48.14,T,,0,0,0,,Метр за метром.
Dialogue: 0,0:06:48.16,0:06:50.00,N,,0,0,0,,129
Dialogue: 0,0:06:48.16,0:06:50.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:48.16,0:06:50.00,T,,0,0,0,,Месяц за месяцем.
Dialogue: 0,0:06:50.02,0:06:52.08,N,,0,0,0,,130
Dialogue: 0,0:06:50.02,0:06:52.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:50.02,0:06:52.08,T,,0,0,0,,Проходит почти пять лет.
Dialogue: 0,0:06:52.10,0:07:00.37,N,,0,0,0,,131
Dialogue: 0,0:06:52.10,0:07:00.37,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:52.10,0:07:00.37,T,,0,0,0,,И в тысяча девятьсот восемьдесят девятом году новый ствол достигает глубины двенадцать тысяч двести шестьдесят два метра.
Dialogue: 0,0:07:00.39,0:07:01.93,N,,0,0,0,,132
Dialogue: 0,0:07:00.39,0:07:01.93,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:00.39,0:07:01.93,T,,0,0,0,,Это рекорд.
Dialogue: 0,0:07:01.95,0:07:03.80,N,,0,0,0,,133
Dialogue: 0,0:07:01.95,0:07:03.80,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:01.95,0:07:03.80,T,,0,0,0,,Он не побит до сих пор.
Dialogue: 0,0:07:03.81,0:07:05.60,N,,0,0,0,,134
Dialogue: 0,0:07:03.81,0:07:05.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:03.81,0:07:05.60,T,,0,0,0,,Уже почти сорок лет.
Dialogue: 0,0:07:05.62,0:07:10.07,N,,0,0,0,,135
Dialogue: 0,0:07:05.62,0:07:10.07,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:05.62,0:07:10.07,T,,0,0,0,,Ни одна скважина на Земле не ушла вглубь дальше.
Dialogue: 0,0:07:10.09,0:07:13.59,N,,0,0,0,,136
Dialogue: 0,0:07:10.09,0:07:13.59,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:10.09,0:07:13.59,T,,0,0,0,,Позже Кольскую внесут в Книгу рекордов Гиннесса.
Dialogue: 0,0:07:13.61,0:07:17.57,N,,0,0,0,,137
Dialogue: 0,0:07:13.61,0:07:17.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:13.61,0:07:17.57,T,,0,0,0,,Как самую глубокую точку, до которой добрался человек.
Dialogue: 0,0:07:17.59,0:07:20.62,N,,0,0,0,,138
Dialogue: 0,0:07:17.59,0:07:20.62,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:17.59,0:07:20.62,T,,0,0,0,,Но сами буровики гордились не рекордом.
Dialogue: 0,0:07:20.64,0:07:24.05,N,,0,0,0,,139
Dialogue: 0,0:07:20.64,0:07:24.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:20.64,0:07:24.05,T,,0,0,0,,Они гордились тем, что подняли наверх.
Dialogue: 0,0:07:24.07,0:07:34.53,N,,0,0,0,,140
Dialogue: 0,0:07:24.07,0:07:34.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:24.07,0:07:34.53,T,,0,0,0,,Но что же нашли там, внизу?
Dialogue: 0,0:07:34.55,0:07:36.57,N,,0,0,0,,141
Dialogue: 0,0:07:34.55,0:07:36.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:34.55,0:07:36.57,T,,0,0,0,,Помнишь картину из учебников?
Dialogue: 0,0:07:36.59,0:07:37.86,N,,0,0,0,,142
Dialogue: 0,0:07:36.59,0:07:37.86,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:36.59,0:07:37.86,T,,0,0,0,,Сверху гранит.
Dialogue: 0,0:07:37.88,0:07:39.84,N,,0,0,0,,143
Dialogue: 0,0:07:37.88,0:07:39.84,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:37.88,0:07:39.84,T,,0,0,0,,Под ним базальт.
Dialogue: 0,0:07:39.86,0:07:44.60,N,,0,0,0,,144
Dialogue: 0,0:07:39.86,0:07:44.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:39.86,0:07:44.60,T,,0,0,0,,Учёные были уверены: примерно на семи километрах гранит закончится.
Dialogue: 0,0:07:44.62,0:07:46.86,N,,0,0,0,,145
Dialogue: 0,0:07:44.62,0:07:46.86,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:44.62,0:07:46.86,T,,0,0,0,,Начнётся базальт.
Dialogue: 0,0:07:46.88,0:07:48.97,N,,0,0,0,,146
Dialogue: 0,0:07:46.88,0:07:48.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:46.88,0:07:48.97,T,,0,0,0,,Бур проходит семь километров.
Dialogue: 0,0:07:48.99,0:07:49.95,N,,0,0,0,,147
Dialogue: 0,0:07:48.99,0:07:49.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:48.99,0:07:49.95,T,,0,0,0,,Восемь.
Dialogue: 0,0:07:49.97,0:07:51.01,N,,0,0,0,,148
Dialogue: 0,0:07:49.97,0:07:51.01,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:49.97,0:07:51.01,T,,0,0,0,,Десять.
Dialogue: 0,0:07:51.03,0:07:52.52,N,,0,0,0,,149
Dialogue: 0,0:07:51.03,0:07:52.52,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:51.03,0:07:52.52,T,,0,0,0,,Двенадцать.
Dialogue: 0,0:07:52.54,0:07:53.99,N,,0,0,0,,150
Dialogue: 0,0:07:52.54,0:07:53.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:52.54,0:07:53.99,T,,0,0,0,,Базальта нет.
Dialogue: 0,0:07:54.01,0:07:55.88,N,,0,0,0,,151
Dialogue: 0,0:07:54.01,0:07:55.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:54.01,0:07:55.88,T,,0,0,0,,Ни на какой глубине.
Dialogue: 0,0:07:55.90,0:08:00.02,N,,0,0,0,,152
Dialogue: 0,0:07:55.90,0:08:00.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:55.90,0:08:00.02,T,,0,0,0,,Внизу всё тот же гранит и другие древние породы.
Dialogue: 0,0:08:00.04,0:08:05.63,N,,0,0,0,,153
Dialogue: 0,0:08:00.04,0:08:05.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:00.04,0:08:05.63,T,,0,0,0,,А волны от землетрясений, которые приняли за границу базальта, оказались чем-то другим.
Dialogue: 0,0:08:05.65,0:08:10.13,N,,0,0,0,,154
Dialogue: 0,0:08:05.65,0:08:10.13,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:05.65,0:08:10.13,T,,0,0,0,,Камнем, который давление и жар изменили изнутри.
Dialogue: 0,0:08:10.15,0:08:13.19,N,,0,0,0,,155
Dialogue: 0,0:08:10.15,0:08:13.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:10.15,0:08:13.19,T,,0,0,0,,Картину Земли пришлось перерисовывать.
Dialogue: 0,0:08:13.21,0:08:14.91,N,,0,0,0,,156
Dialogue: 0,0:08:13.21,0:08:14.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:13.21,0:08:14.91,T,,0,0,0,,Но это не всё.
Dialogue: 0,0:08:14.93,0:08:18.87,N,,0,0,0,,157
Dialogue: 0,0:08:14.93,0:08:18.87,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:14.93,0:08:18.87,T,,0,0,0,,На глубине от трёх до шести километров нашли воду.
Dialogue: 0,0:08:18.89,0:08:20.99,N,,0,0,0,,158
Dialogue: 0,0:08:18.89,0:08:20.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:18.89,0:08:20.99,T,,0,0,0,,Её там не должно было быть.
Dialogue: 0,0:08:21.01,0:08:24.23,N,,0,0,0,,159
Dialogue: 0,0:08:21.01,0:08:24.23,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:21.01,0:08:24.23,T,,0,0,0,,Давление выжимает воду прямо из камня.
Dialogue: 0,0:08:24.25,0:08:27.44,N,,0,0,0,,160
Dialogue: 0,0:08:24.25,0:08:27.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:24.25,0:08:27.44,T,,0,0,0,,А плотный слой сверху не даёт ей уйти.
Dialogue: 0,0:08:27.46,0:08:31.42,N,,0,0,0,,161
Dialogue: 0,0:08:27.46,0:08:31.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:27.46,0:08:31.42,T,,0,0,0,,Буровой раствор, который выходил из скважины, словно кипел.
Dialogue: 0,0:08:31.44,0:08:34.96,N,,0,0,0,,162
Dialogue: 0,0:08:31.44,0:08:34.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:31.44,0:08:34.96,T,,0,0,0,,В нём было столько водорода, сколько не ждал никто.
Dialogue: 0,0:08:34.98,0:08:37.00,N,,0,0,0,,163
Dialogue: 0,0:08:34.98,0:08:37.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:34.98,0:08:37.00,T,,0,0,0,,А ещё трещины.
Dialogue: 0,0:08:37.01,0:08:40.74,N,,0,0,0,,164
Dialogue: 0,0:08:37.01,0:08:40.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:37.01,0:08:40.74,T,,0,0,0,,Думали, что глубже порода станет плотной и цельной.
Dialogue: 0,0:08:40.76,0:08:43.66,N,,0,0,0,,165
Dialogue: 0,0:08:40.76,0:08:43.66,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:40.76,0:08:43.66,T,,0,0,0,,А трещин с глубиной становилось больше.
Dialogue: 0,0:08:43.68,0:08:47.07,N,,0,0,0,,166
Dialogue: 0,0:08:43.68,0:08:47.07,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:43.68,0:08:47.07,T,,0,0,0,,И самое удивительное — окаменелости.
Dialogue: 0,0:08:47.09,0:08:52.35,N,,0,0,0,,167
Dialogue: 0,0:08:47.09,0:08:52.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:47.09,0:08:52.35,T,,0,0,0,,На глубине около шести километров в керне нашли следы древнего планктона.
Dialogue: 0,0:08:52.37,0:08:54.56,N,,0,0,0,,168
Dialogue: 0,0:08:52.37,0:08:54.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:52.37,0:08:54.56,T,,0,0,0,,Крошечные морские существа.
Dialogue: 0,0:08:54.58,0:08:56.03,N,,0,0,0,,169
Dialogue: 0,0:08:54.58,0:08:56.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:54.58,0:08:56.03,T,,0,0,0,,Окаменевшие.
Dialogue: 0,0:08:56.05,0:08:57.85,N,,0,0,0,,170
Dialogue: 0,0:08:56.05,0:08:57.85,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:56.05,0:08:57.85,T,,0,0,0,,Они лежали в камне.
Dialogue: 0,0:08:57.87,0:09:00.36,N,,0,0,0,,171
Dialogue: 0,0:08:57.87,0:09:00.36,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:57.87,0:09:00.36,T,,0,0,0,,На глубине в шесть километров.
Dialogue: 0,0:09:00.38,0:09:07.20,N,,0,0,0,,172
Dialogue: 0,0:09:00.38,0:09:07.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:00.38,0:09:07.20,T,,0,0,0,,А на самом дне бур дошёл до пород, которым около двух целых семи десятых миллиарда лет.
Dialogue: 0,0:09:07.22,0:09:12.69,N,,0,0,0,,173
Dialogue: 0,0:09:07.22,0:09:12.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:07.22,0:09:12.69,T,,0,0,0,,Когда они застывали, на Земле ещё не было ни растений, ни животных на суше.
Dialogue: 0,0:09:12.71,0:09:15.85,N,,0,0,0,,174
Dialogue: 0,0:09:12.71,0:09:15.85,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:12.71,0:09:15.85,T,,0,0,0,,Только океан, камень и небо.
Dialogue: 0,0:09:15.87,0:09:18.87,N,,0,0,0,,175
Dialogue: 0,0:09:15.87,0:09:18.87,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:15.87,0:09:18.87,T,,0,0,0,,Каждая находка — новая загадка.
Dialogue: 0,0:09:18.89,0:09:30.06,N,,0,0,0,,176
Dialogue: 0,0:09:18.89,0:09:30.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:18.89,0:09:30.06,T,,0,0,0,,Но чем глубже, тем страшнее становилось внизу.
Dialogue: 0,0:09:30.08,0:09:32.61,N,,0,0,0,,177
Dialogue: 0,0:09:30.08,0:09:32.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:30.08,0:09:32.61,T,,0,0,0,,Чем глубже, тем горячее.
Dialogue: 0,0:09:32.63,0:09:34.34,N,,0,0,0,,178
Dialogue: 0,0:09:32.63,0:09:34.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:32.63,0:09:34.34,T,,0,0,0,,Это знали все.
Dialogue: 0,0:09:34.36,0:09:39.27,N,,0,0,0,,179
Dialogue: 0,0:09:34.36,0:09:39.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:34.36,0:09:39.27,T,,0,0,0,,Учёные считали: на двенадцати километрах будет около ста градусов.
Dialogue: 0,0:09:39.29,0:09:40.99,N,,0,0,0,,180
Dialogue: 0,0:09:39.29,0:09:40.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:39.29,0:09:40.99,T,,0,0,0,,Как кипяток.
Dialogue: 0,0:09:41.01,0:09:44.28,N,,0,0,0,,181
Dialogue: 0,0:09:41.01,0:09:44.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:41.01,0:09:44.28,T,,0,0,0,,Термометр показал около ста восьмидесяти.
Dialogue: 0,0:09:44.30,0:09:46.80,N,,0,0,0,,182
Dialogue: 0,0:09:44.30,0:09:46.80,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:44.30,0:09:46.80,T,,0,0,0,,Почти вдвое горячее.
Dialogue: 0,0:09:46.82,0:09:49.87,N,,0,0,0,,183
Dialogue: 0,0:09:46.82,0:09:49.87,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:46.82,0:09:49.87,T,,0,0,0,,В такой жаре камень ведёт себя странно.
Dialogue: 0,0:09:49.89,0:09:51.67,N,,0,0,0,,184
Dialogue: 0,0:09:49.89,0:09:51.67,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:49.89,0:09:51.67,T,,0,0,0,,Он становится мягким.
Dialogue: 0,0:09:51.69,0:09:56.64,N,,0,0,0,,185
Dialogue: 0,0:09:51.69,0:09:56.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:51.69,0:09:56.64,T,,0,0,0,,Учёные говорили, что порода на дне похожа скорее на пластик, чем на камень.
Dialogue: 0,0:09:56.66,0:09:59.21,N,,0,0,0,,186
Dialogue: 0,0:09:56.66,0:09:59.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:56.66,0:09:59.21,T,,0,0,0,,Она медленно сжимает ствол.
Dialogue: 0,0:09:59.23,0:10:01.51,N,,0,0,0,,187
Dialogue: 0,0:09:59.23,0:10:01.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:59.23,0:10:01.51,T,,0,0,0,,Затягивает его, как рану.
Dialogue: 0,0:10:01.53,0:10:02.88,N,,0,0,0,,188
Dialogue: 0,0:10:01.53,0:10:02.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:01.53,0:10:02.88,T,,0,0,0,,Ломает долото.
Dialogue: 0,0:10:02.90,0:10:04.90,N,,0,0,0,,189
Dialogue: 0,0:10:02.90,0:10:04.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:02.90,0:10:04.90,T,,0,0,0,,Скручивает трубы.
Dialogue: 0,0:10:04.92,0:10:10.39,N,,0,0,0,,190
Dialogue: 0,0:10:04.92,0:10:10.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:04.92,0:10:10.39,T,,0,0,0,,Чтобы колонна выдержала, внизу ставят трубы из лёгкого алюминиевого сплава.
Dialogue: 0,0:10:10.41,0:10:12.05,N,,0,0,0,,191
Dialogue: 0,0:10:10.41,0:10:12.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:10.41,0:10:12.05,T,,0,0,0,,Но и они не вечны.
Dialogue: 0,0:10:12.07,0:10:15.21,N,,0,0,0,,192
Dialogue: 0,0:10:12.07,0:10:15.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:12.07,0:10:15.21,T,,0,0,0,,Каждый новый метр даётся всё тяжелее.
Dialogue: 0,0:10:15.23,0:10:22.29,N,,0,0,0,,193
Dialogue: 0,0:10:15.23,0:10:22.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:15.23,0:10:22.29,T,,0,0,0,,В тысяча девятьсот девяностом году на глубине двенадцать тысяч двести шестьдесят два метра снова авария.
Dialogue: 0,0:10:22.31,0:10:24.40,N,,0,0,0,,194
Dialogue: 0,0:10:22.31,0:10:24.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:22.31,0:10:24.40,T,,0,0,0,,Буровики пробуют ещё раз.
Dialogue: 0,0:10:24.42,0:10:25.62,N,,0,0,0,,195
Dialogue: 0,0:10:24.42,0:10:25.62,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:24.42,0:10:25.62,T,,0,0,0,,Новый ствол.
Dialogue: 0,0:10:25.64,0:10:33.05,N,,0,0,0,,196
Dialogue: 0,0:10:25.64,0:10:33.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:25.64,0:10:33.05,T,,0,0,0,,В тысяча девятьсот девяносто втором его останавливают на одиннадцати тысячах восьмистах восьмидесяти двух метрах.
Dialogue: 0,0:10:33.07,0:10:34.74,N,,0,0,0,,197
Dialogue: 0,0:10:33.07,0:10:34.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:33.07,0:10:34.74,T,,0,0,0,,Причина — жара.
Dialogue: 0,0:10:34.76,0:10:37.08,N,,0,0,0,,198
Dialogue: 0,0:10:34.76,0:10:37.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:34.76,0:10:37.08,T,,0,0,0,,Сто восемьдесят градусов.
Dialogue: 0,0:10:37.10,0:10:40.56,N,,0,0,0,,199
Dialogue: 0,0:10:37.10,0:10:40.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:37.10,0:10:40.56,T,,0,0,0,,Пятнадцать километров так и остались мечтой.
Dialogue: 0,0:10:40.58,0:10:43.05,N,,0,0,0,,200
Dialogue: 0,0:10:40.58,0:10:43.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:40.58,0:10:43.05,T,,0,0,0,,И это случилось не только с нами.
Dialogue: 0,0:10:43.07,0:10:47.29,N,,0,0,0,,201
Dialogue: 0,0:10:43.07,0:10:47.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:43.07,0:10:47.29,T,,0,0,0,,В те же годы свою сверхглубокую скважину бурила Германия.
Dialogue: 0,0:10:47.31,0:10:50.32,N,,0,0,0,,202
Dialogue: 0,0:10:47.31,0:10:50.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:47.31,0:10:50.32,T,,0,0,0,,Немцы прошли чуть больше девяти километров.
Dialogue: 0,0:10:50.34,0:10:52.83,N,,0,0,0,,203
Dialogue: 0,0:10:50.34,0:10:52.83,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:50.34,0:10:52.83,T,,0,0,0,,И упёрлись в ту же стену.
Dialogue: 0,0:10:52.85,0:10:56.32,N,,0,0,0,,204
Dialogue: 0,0:10:52.85,0:10:56.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:52.85,0:10:56.32,T,,0,0,0,,Жара больше двухсот шестидесяти градусов.
Dialogue: 0,0:10:56.34,0:10:59.15,N,,0,0,0,,205
Dialogue: 0,0:10:56.34,0:10:59.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:56.34,0:10:59.15,T,,0,0,0,,Трубы и приборы просто не выдерживали.
Dialogue: 0,0:10:59.17,0:11:03.35,N,,0,0,0,,206
Dialogue: 0,0:10:59.17,0:11:03.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:59.17,0:11:03.35,T,,0,0,0,,Похоже, на этой глубине Земля ставит свой предел.
Dialogue: 0,0:11:03.37,0:11:06.34,N,,0,0,0,,207
Dialogue: 0,0:11:03.37,0:11:06.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:03.37,0:11:06.34,T,,0,0,0,,Земля просто не пустила дальше.
Dialogue: 0,0:11:06.36,0:11:11.13,N,,0,0,0,,208
Dialogue: 0,0:11:06.36,0:11:11.13,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:06.36,0:11:11.13,T,,0,0,0,,А в это время по миру уже вовсю гуляла совсем другая история.
Dialogue: 0,0:11:11.15,0:11:22.77,N,,0,0,0,,209
Dialogue: 0,0:11:11.15,0:11:22.77,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:11.15,0:11:22.77,T,,0,0,0,,Про то, почему на самом деле остановили бурение.
Dialogue: 0,0:11:22.79,0:11:25.59,N,,0,0,0,,210
Dialogue: 0,0:11:22.79,0:11:25.59,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:22.79,0:11:25.59,T,,0,0,0,,Тысяча девятьсот восемьдесят девятый год.
Dialogue: 0,0:11:25.61,0:11:29.21,N,,0,0,0,,211
Dialogue: 0,0:11:25.61,0:11:29.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:25.61,0:11:29.21,T,,0,0,0,,Новость появляется в маленьком журнале в Финляндии.
Dialogue: 0,0:11:29.23,0:11:33.63,N,,0,0,0,,212
Dialogue: 0,0:11:29.23,0:11:33.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:29.23,0:11:33.63,T,,0,0,0,,Потом её подхватывает американский христианский телеканал.
Dialogue: 0,0:11:33.65,0:11:35.73,N,,0,0,0,,213
Dialogue: 0,0:11:33.65,0:11:35.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:33.65,0:11:35.73,T,,0,0,0,,История звучит так.
Dialogue: 0,0:11:35.75,0:11:41.14,N,,0,0,0,,214
Dialogue: 0,0:11:35.75,0:11:41.14,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:35.75,0:11:41.14,T,,0,0,0,,В Сибири советские учёные пробурили скважину на четырнадцать километров.
Dialogue: 0,0:11:41.16,0:11:44.44,N,,0,0,0,,215
Dialogue: 0,0:11:41.16,0:11:44.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:41.16,0:11:44.44,T,,0,0,0,,И бур вдруг провалился в пустоту.
Dialogue: 0,0:11:44.46,0:11:47.46,N,,0,0,0,,216
Dialogue: 0,0:11:44.46,0:11:47.46,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:44.46,0:11:47.46,T,,0,0,0,,Внизу оказалась огромная полость.
Dialogue: 0,0:11:47.48,0:11:50.63,N,,0,0,0,,217
Dialogue: 0,0:11:47.48,0:11:50.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:47.48,0:11:50.63,T,,0,0,0,,Температура — больше тысячи градусов.
Dialogue: 0,0:11:50.65,0:11:56.69,N,,0,0,0,,218
Dialogue: 0,0:11:50.65,0:11:56.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:50.65,0:11:56.69,T,,0,0,0,,Руководитель работ, некий доктор Азаков, приказал опустить туда микрофон.
Dialogue: 0,0:11:56.71,0:11:59.65,N,,0,0,0,,219
Dialogue: 0,0:11:56.71,0:11:59.65,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:56.71,0:11:59.65,T,,0,0,0,,И микрофон записал звук.
Dialogue: 0,0:11:59.67,0:12:00.90,N,,0,0,0,,220
Dialogue: 0,0:11:59.67,0:12:00.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:59.67,0:12:00.90,T,,0,0,0,,Крики.
Dialogue: 0,0:12:00.92,0:12:02.63,N,,0,0,0,,221
Dialogue: 0,0:12:00.92,0:12:02.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:00.92,0:12:02.63,T,,0,0,0,,Тысячи голосов.
Dialogue: 0,0:12:02.65,0:12:05.20,N,,0,0,0,,222
Dialogue: 0,0:12:02.65,0:12:05.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:02.65,0:12:05.20,T,,0,0,0,,Люди кричали от боли.
Dialogue: 0,0:12:05.22,0:12:08.51,N,,0,0,0,,223
Dialogue: 0,0:12:05.22,0:12:08.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:05.22,0:12:08.51,T,,0,0,0,,Через семнадцать секунд микрофон расплавился.
Dialogue: 0,0:12:08.53,0:12:12.82,N,,0,0,0,,224
Dialogue: 0,0:12:08.53,0:12:12.82,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:08.53,0:12:12.82,T,,0,0,0,,А потом из скважины вырвалось облако светящегося газа.
Dialogue: 0,0:12:12.84,0:12:16.73,N,,0,0,0,,225
Dialogue: 0,0:12:12.84,0:12:16.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:12.84,0:12:16.73,T,,0,0,0,,И в нём, будто бы, видели крылатую фигуру.
Dialogue: 0,0:12:16.75,0:12:19.34,N,,0,0,0,,226
Dialogue: 0,0:12:16.75,0:12:19.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:16.75,0:12:19.34,T,,0,0,0,,Рабочие в ужасе разбежались.
Dialogue: 0,0:12:19.36,0:12:22.75,N,,0,0,0,,227
Dialogue: 0,0:12:19.36,0:12:22.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:19.36,0:12:22.75,T,,0,0,0,,Позже в интернете появилась и сама «запись».
Dialogue: 0,0:12:22.77,0:12:25.97,N,,0,0,0,,228
Dialogue: 0,0:12:22.77,0:12:25.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:22.77,0:12:25.97,T,,0,0,0,,Жуткий вой, от которого бегут мурашки.
Dialogue: 0,0:12:25.99,0:12:28.79,N,,0,0,0,,229
Dialogue: 0,0:12:25.99,0:12:28.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:25.99,0:12:28.79,T,,0,0,0,,Её переслушивали снова и снова.
Dialogue: 0,0:12:28.81,0:12:31.69,N,,0,0,0,,230
Dialogue: 0,0:12:28.81,0:12:31.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:28.81,0:12:31.69,T,,0,0,0,,Многие верят в неё до сих пор.
Dialogue: 0,0:12:31.71,0:12:33.62,N,,0,0,0,,231
Dialogue: 0,0:12:31.71,0:12:33.62,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:31.71,0:12:33.62,T,,0,0,0,,Но давай сравним.
Dialogue: 0,0:12:33.64,0:12:37.45,N,,0,0,0,,232
Dialogue: 0,0:12:33.64,0:12:37.45,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:33.64,0:12:37.45,T,,0,0,0,,Скважина не в Сибири, а на Кольском полуострове.
Dialogue: 0,0:12:37.47,0:12:40.84,N,,0,0,0,,233
Dialogue: 0,0:12:37.47,0:12:40.84,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:37.47,0:12:40.84,T,,0,0,0,,Глубина не четырнадцать километров, а двенадцать.
Dialogue: 0,0:12:40.86,0:12:44.49,N,,0,0,0,,234
Dialogue: 0,0:12:40.86,0:12:44.49,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:40.86,0:12:44.49,T,,0,0,0,,Температура не тысяча градусов, а сто восемьдесят.
Dialogue: 0,0:12:44.51,0:12:46.84,N,,0,0,0,,235
Dialogue: 0,0:12:44.51,0:12:46.84,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:44.51,0:12:46.84,T,,0,0,0,,Никакой пустоты внизу не было.
Dialogue: 0,0:12:46.86,0:12:49.60,N,,0,0,0,,236
Dialogue: 0,0:12:46.86,0:12:49.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:46.86,0:12:49.60,T,,0,0,0,,Внизу был горячий камень.
Dialogue: 0,0:12:49.62,0:12:59.53,N,,0,0,0,,237
Dialogue: 0,0:12:49.62,0:12:59.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:49.62,0:12:59.53,T,,0,0,0,,Так откуда взялась эта история?
Dialogue: 0,0:12:59.55,0:13:03.35,N,,0,0,0,,238
Dialogue: 0,0:12:59.55,0:13:03.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:59.55,0:13:03.35,T,,0,0,0,,Путь легенды можно проследить почти шаг за шагом.
Dialogue: 0,0:13:03.37,0:13:07.95,N,,0,0,0,,239
Dialogue: 0,0:13:03.37,0:13:07.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:03.37,0:13:07.95,T,,0,0,0,,Сначала её напечатал маленький религиозный журнал в Финляндии.
Dialogue: 0,0:13:07.97,0:13:12.04,N,,0,0,0,,240
Dialogue: 0,0:13:07.97,0:13:12.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:07.97,0:13:12.04,T,,0,0,0,,Автор пересказал по памяти письмо читателя из газеты.
Dialogue: 0,0:13:12.06,0:13:15.61,N,,0,0,0,,241
Dialogue: 0,0:13:12.06,0:13:15.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:12.06,0:13:15.61,T,,0,0,0,,Потом историю перепечатал другой финский листок.
Dialogue: 0,0:13:15.63,0:13:18.68,N,,0,0,0,,242
Dialogue: 0,0:13:15.63,0:13:18.68,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:15.63,0:13:18.68,T,,0,0,0,,Летом тысяча девятьсот восемьдесят девятого.
Dialogue: 0,0:13:18.70,0:13:20.91,N,,0,0,0,,243
Dialogue: 0,0:13:18.70,0:13:20.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:18.70,0:13:20.91,T,,0,0,0,,И она попала в Америку.
Dialogue: 0,0:13:20.93,0:13:22.90,N,,0,0,0,,244
Dialogue: 0,0:13:20.93,0:13:22.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:20.93,0:13:22.90,T,,0,0,0,,На религиозный телеканал.
Dialogue: 0,0:13:22.92,0:13:24.72,N,,0,0,0,,245
Dialogue: 0,0:13:22.92,0:13:24.72,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:22.92,0:13:24.72,T,,0,0,0,,Её показали в эфире.
Dialogue: 0,0:13:24.74,0:13:26.91,N,,0,0,0,,246
Dialogue: 0,0:13:24.74,0:13:26.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:24.74,0:13:26.91,T,,0,0,0,,Без всякой проверки.
Dialogue: 0,0:13:26.93,0:13:30.70,N,,0,0,0,,247
Dialogue: 0,0:13:26.93,0:13:30.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:26.93,0:13:30.70,T,,0,0,0,,И тут в истории появляется норвежский учитель.
Dialogue: 0,0:13:30.72,0:13:32.93,N,,0,0,0,,248
Dialogue: 0,0:13:30.72,0:13:32.93,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:30.72,0:13:32.93,T,,0,0,0,,Его зовут Оге Рендален.
Dialogue: 0,0:13:32.95,0:13:35.94,N,,0,0,0,,249
Dialogue: 0,0:13:32.95,0:13:35.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:32.95,0:13:35.94,T,,0,0,0,,Он видит этот выпуск, когда бывает в Америке.
Dialogue: 0,0:13:35.96,0:13:40.02,N,,0,0,0,,250
Dialogue: 0,0:13:35.96,0:13:40.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:35.96,0:13:40.02,T,,0,0,0,,И решает проверить, насколько легко люди верят.
Dialogue: 0,0:13:40.04,0:13:46.40,N,,0,0,0,,251
Dialogue: 0,0:13:40.04,0:13:46.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:40.04,0:13:46.40,T,,0,0,0,,Рендален пишет на телеканал: да, я знаю эту историю, у нас в Норвегии о ней писали.
Dialogue: 0,0:13:46.42,0:13:49.70,N,,0,0,0,,252
Dialogue: 0,0:13:46.42,0:13:49.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:46.42,0:13:49.70,T,,0,0,0,,И присылает вырезку из норвежской газеты.
Dialogue: 0,0:13:49.72,0:13:51.94,N,,0,0,0,,253
Dialogue: 0,0:13:49.72,0:13:51.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:49.72,0:13:51.94,T,,0,0,0,,С «переводом» на английский.
Dialogue: 0,0:13:51.96,0:13:55.64,N,,0,0,0,,254
Dialogue: 0,0:13:51.96,0:13:55.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:51.96,0:13:55.64,T,,0,0,0,,Только в настоящей статье говорилось совсем о другом.
Dialogue: 0,0:13:55.66,0:13:57.70,N,,0,0,0,,255
Dialogue: 0,0:13:55.66,0:13:57.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:55.66,0:13:57.70,T,,0,0,0,,О строительном инспекторе.
Dialogue: 0,0:13:57.72,0:14:00.94,N,,0,0,0,,256
Dialogue: 0,0:13:57.72,0:14:00.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:57.72,0:14:00.94,T,,0,0,0,,А Рендален добавил в «перевод» всё, что хотел.
Dialogue: 0,0:14:00.96,0:14:04.73,N,,0,0,0,,257
Dialogue: 0,0:14:00.96,0:14:04.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:00.96,0:14:04.73,T,,0,0,0,,Даже летучую мышь, которая вылетела из скважины.
Dialogue: 0,0:14:04.75,0:14:06.39,N,,0,0,0,,258
Dialogue: 0,0:14:04.75,0:14:06.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:04.75,0:14:06.39,T,,0,0,0,,Телеканал поверил.
Dialogue: 0,0:14:06.41,0:14:08.46,N,,0,0,0,,259
Dialogue: 0,0:14:06.41,0:14:08.46,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:06.41,0:14:08.46,T,,0,0,0,,И показал и это.
Dialogue: 0,0:14:08.48,0:14:12.50,N,,0,0,0,,260
Dialogue: 0,0:14:08.48,0:14:12.50,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:08.48,0:14:12.50,T,,0,0,0,,Позже Рендален сам рассказал, что это был розыгрыш.
Dialogue: 0,0:14:12.52,0:14:18.03,N,,0,0,0,,261
Dialogue: 0,0:14:12.52,0:14:18.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:12.52,0:14:18.03,T,,0,0,0,,Он хотел показать, как легко люди принимают на веру то, что им хочется услышать.
Dialogue: 0,0:14:18.05,0:14:19.70,N,,0,0,0,,262
Dialogue: 0,0:14:18.05,0:14:19.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:18.05,0:14:19.70,T,,0,0,0,,И ведь показал.
Dialogue: 0,0:14:19.72,0:14:23.24,N,,0,0,0,,263
Dialogue: 0,0:14:19.72,0:14:23.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:19.72,0:14:23.24,T,,0,0,0,,Подумай, почему эта история так цепляет.
Dialogue: 0,0:14:23.26,0:14:25.73,N,,0,0,0,,264
Dialogue: 0,0:14:23.26,0:14:25.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:23.26,0:14:25.73,T,,0,0,0,,Секретный советский объект.
Dialogue: 0,0:14:25.75,0:14:28.73,N,,0,0,0,,265
Dialogue: 0,0:14:25.75,0:14:28.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:25.75,0:14:28.73,T,,0,0,0,,Учёные, которые зашли слишком далеко.
Dialogue: 0,0:14:28.75,0:14:30.85,N,,0,0,0,,266
Dialogue: 0,0:14:28.75,0:14:30.85,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:28.75,0:14:30.85,T,,0,0,0,,Крышка, которую заварили.
Dialogue: 0,0:14:30.87,0:14:34.34,N,,0,0,0,,267
Dialogue: 0,0:14:30.87,0:14:34.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:30.87,0:14:34.34,T,,0,0,0,,Всё это звучит как начало фильма ужасов.
Dialogue: 0,0:14:34.36,0:14:36.96,N,,0,0,0,,268
Dialogue: 0,0:14:34.36,0:14:36.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:34.36,0:14:36.96,T,,0,0,0,,А правду рассказать сложнее.
Dialogue: 0,0:14:36.98,0:14:41.41,N,,0,0,0,,269
Dialogue: 0,0:14:36.98,0:14:41.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:36.98,0:14:41.41,T,,0,0,0,,Про гранит, водород и трубы, которые ломает жара.
Dialogue: 0,0:14:41.43,0:14:44.97,N,,0,0,0,,270
Dialogue: 0,0:14:41.43,0:14:44.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:41.43,0:14:44.97,T,,0,0,0,,Но правда здесь не менее удивительная.
Dialogue: 0,0:14:44.99,0:14:46.16,N,,0,0,0,,271
Dialogue: 0,0:14:44.99,0:14:46.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:44.99,0:14:46.16,T,,0,0,0,,А «крики»?
Dialogue: 0,0:14:46.18,0:14:49.97,N,,0,0,0,,272
Dialogue: 0,0:14:46.18,0:14:49.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:46.18,0:14:49.97,T,,0,0,0,,Это зацикленные звуки, наложенные друг на друга.
Dialogue: 0,0:14:49.99,0:14:53.65,N,,0,0,0,,273
Dialogue: 0,0:14:49.99,0:14:53.65,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:49.99,0:14:53.65,T,,0,0,0,,Часто говорят, что их взяли из старого фильма ужасов.
Dialogue: 0,0:14:53.67,0:14:56.89,N,,0,0,0,,274
Dialogue: 0,0:14:53.67,0:14:56.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:53.67,0:14:56.89,T,,0,0,0,,И с тех пор легенда только переезжала.
Dialogue: 0,0:14:56.91,0:14:58.53,N,,0,0,0,,275
Dialogue: 0,0:14:56.91,0:14:58.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:56.91,0:14:58.53,T,,0,0,0,,Сначала на Аляску.
Dialogue: 0,0:14:58.55,0:15:00.33,N,,0,0,0,,276
Dialogue: 0,0:14:58.55,0:15:00.33,W,,0,0,0,,рассказчик
Dialogue: 0,0:14:58.55,0:15:00.33,T,,0,0,0,,Потом на нефтяную вышку.
Dialogue: 0,0:15:00.35,0:15:04.88,N,,0,0,0,,277
Dialogue: 0,0:15:00.35,0:15:04.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:00.35,0:15:04.88,T,,0,0,0,,А в две тысячи двадцатом году в России сняли фильм ужасов.
Dialogue: 0,0:15:04.90,0:15:16.28,N,,0,0,0,,278
Dialogue: 0,0:15:04.90,0:15:16.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:04.90,0:15:16.28,T,,0,0,0,,Он так и называется — «Кольская сверхглубокая».
Dialogue: 0,0:15:16.30,0:15:18.89,N,,0,0,0,,279
Dialogue: 0,0:15:16.30,0:15:18.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:16.30,0:15:18.89,T,,0,0,0,,А что же настоящая скважина?
Dialogue: 0,0:15:18.91,0:15:21.49,N,,0,0,0,,280
Dialogue: 0,0:15:18.91,0:15:21.49,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:18.91,0:15:21.49,T,,0,0,0,,Тысяча девятьсот девяносто первый год.
Dialogue: 0,0:15:21.51,0:15:23.90,N,,0,0,0,,281
Dialogue: 0,0:15:21.51,0:15:23.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:21.51,0:15:23.90,T,,0,0,0,,Советского Союза больше нет.
Dialogue: 0,0:15:23.92,0:15:26.34,N,,0,0,0,,282
Dialogue: 0,0:15:23.92,0:15:26.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:23.92,0:15:26.34,T,,0,0,0,,Денег на науку почти нет.
Dialogue: 0,0:15:26.36,0:15:30.83,N,,0,0,0,,283
Dialogue: 0,0:15:26.36,0:15:30.83,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:26.36,0:15:30.83,T,,0,0,0,,В тысяча девятьсот девяносто четвёртом году бурят последний раз.
Dialogue: 0,0:15:30.85,0:15:33.96,N,,0,0,0,,284
Dialogue: 0,0:15:30.85,0:15:33.96,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:30.85,0:15:33.96,T,,0,0,0,,Глубина всего восемь с половиной километров.
Dialogue: 0,0:15:33.98,0:15:36.47,N,,0,0,0,,285
Dialogue: 0,0:15:33.98,0:15:36.47,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:33.98,0:15:36.47,T,,0,0,0,,Потом бурение останавливают.
Dialogue: 0,0:15:36.49,0:15:38.19,N,,0,0,0,,286
Dialogue: 0,0:15:36.49,0:15:38.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:36.49,0:15:38.19,T,,0,0,0,,Навсегда.
Dialogue: 0,0:15:38.21,0:15:41.53,N,,0,0,0,,287
Dialogue: 0,0:15:38.21,0:15:41.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:38.21,0:15:41.53,T,,0,0,0,,Когда-то здесь работали пятьсот человек.
Dialogue: 0,0:15:41.55,0:15:45.24,N,,0,0,0,,288
Dialogue: 0,0:15:41.55,0:15:45.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:41.55,0:15:45.24,T,,0,0,0,,К две тысячи восьмому году осталось около двадцати.
Dialogue: 0,0:15:45.26,0:15:47.18,N,,0,0,0,,289
Dialogue: 0,0:15:45.26,0:15:47.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:45.26,0:15:47.18,T,,0,0,0,,Предприятие закрывают.
Dialogue: 0,0:15:47.20,0:15:49.88,N,,0,0,0,,290
Dialogue: 0,0:15:47.20,0:15:49.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:47.20,0:15:49.88,T,,0,0,0,,Оборудование увозят и разбирают.
Dialogue: 0,0:15:49.90,0:15:52.10,N,,0,0,0,,291
Dialogue: 0,0:15:49.90,0:15:52.10,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:49.90,0:15:52.10,T,,0,0,0,,Здания пустеют.
Dialogue: 0,0:15:52.12,0:15:55.63,N,,0,0,0,,292
Dialogue: 0,0:15:52.12,0:15:55.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:52.12,0:15:55.63,T,,0,0,0,,А скважину заваривают железной крышкой.
Dialogue: 0,0:15:55.65,0:15:57.63,N,,0,0,0,,293
Dialogue: 0,0:15:55.65,0:15:57.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:55.65,0:15:57.63,T,,0,0,0,,Двенадцать километров.
Dialogue: 0,0:15:57.65,0:16:00.94,N,,0,0,0,,294
Dialogue: 0,0:15:57.65,0:16:00.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:15:57.65,0:16:00.94,T,,0,0,0,,Это рекорд, который не побит до сих пор.
Dialogue: 0,0:16:00.96,0:16:03.99,N,,0,0,0,,295
Dialogue: 0,0:16:00.96,0:16:03.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:00.96,0:16:03.99,T,,0,0,0,,Да, сегодня есть скважины и длиннее.
Dialogue: 0,0:16:04.00,0:16:09.98,N,,0,0,0,,296
Dialogue: 0,0:16:04.00,0:16:09.98,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:04.00,0:16:09.98,T,,0,0,0,,В Катаре, на Сахалине нефтяники бурят на двенадцать, даже на пятнадцать километров.
Dialogue: 0,0:16:10.00,0:16:14.52,N,,0,0,0,,297
Dialogue: 0,0:16:10.00,0:16:14.52,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:10.00,0:16:14.52,T,,0,0,0,,Но эти скважины идут почти горизонтально, под небольшим углом.
Dialogue: 0,0:16:14.54,0:16:17.76,N,,0,0,0,,298
Dialogue: 0,0:16:14.54,0:16:17.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:14.54,0:16:17.76,T,,0,0,0,,Настоящая глубина у них гораздо меньше.
Dialogue: 0,0:16:17.78,0:16:20.61,N,,0,0,0,,299
Dialogue: 0,0:16:17.78,0:16:20.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:17.78,0:16:20.61,T,,0,0,0,,А Кольская шла прямо вниз.
Dialogue: 0,0:16:20.63,0:16:25.65,N,,0,0,0,,300
Dialogue: 0,0:16:20.63,0:16:25.65,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:20.63,0:16:25.65,T,,0,0,0,,И всё равно это меньше половины процента пути до центра Земли.
Dialogue: 0,0:16:25.67,0:16:27.78,N,,0,0,0,,301
Dialogue: 0,0:16:25.67,0:16:27.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:25.67,0:16:27.78,T,,0,0,0,,Мы долетели до Луны.
Dialogue: 0,0:16:27.80,0:16:30.95,N,,0,0,0,,302
Dialogue: 0,0:16:27.80,0:16:30.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:27.80,0:16:30.95,T,,0,0,0,,Отправили зонды за пределы Солнечной системы.
Dialogue: 0,0:16:30.97,0:16:35.91,N,,0,0,0,,303
Dialogue: 0,0:16:30.97,0:16:35.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:30.97,0:16:35.91,T,,0,0,0,,А вглубь собственной планеты прошли всего на двенадцать километров.
Dialogue: 0,0:16:35.93,0:16:37.88,N,,0,0,0,,304
Dialogue: 0,0:16:35.93,0:16:37.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:35.93,0:16:37.88,T,,0,0,0,,И остановились.
Dialogue: 0,0:16:37.90,0:16:39.28,N,,0,0,0,,305
Dialogue: 0,0:16:37.90,0:16:39.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:37.90,0:16:39.28,T,,0,0,0,,Почему?
Dialogue: 0,0:16:39.30,0:16:41.63,N,,0,0,0,,306
Dialogue: 0,0:16:39.30,0:16:41.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:39.30,0:16:41.63,T,,0,0,0,,Итак, три версии.
Dialogue: 0,0:16:41.65,0:16:43.73,N,,0,0,0,,307
Dialogue: 0,0:16:41.65,0:16:43.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:41.65,0:16:43.73,T,,0,0,0,,А — Земля не пустила.
Dialogue: 0,0:16:43.75,0:16:50.10,N,,0,0,0,,308
Dialogue: 0,0:16:43.75,0:16:50.10,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:43.75,0:16:50.10,T,,0,0,0,,Жара и мягкий, как пластик, камень сделали дальнейшее бурение невозможным.
Dialogue: 0,0:16:50.12,0:16:51.39,N,,0,0,0,,309
Dialogue: 0,0:16:50.12,0:16:51.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:50.12,0:16:51.39,T,,0,0,0,,Б — кончились деньги.
Dialogue: 0,0:16:51.41,0:16:55.18,N,,0,0,0,,310
Dialogue: 0,0:16:51.41,0:16:55.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:51.41,0:16:55.18,T,,0,0,0,,Скважина умерла вместе с Советским Союзом.
Dialogue: 0,0:16:55.20,0:16:59.12,N,,0,0,0,,311
Dialogue: 0,0:16:55.20,0:16:59.12,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:55.20,0:16:59.12,T,,0,0,0,,В — там нашли что-то, о чём решили молчать.
Dialogue: 0,0:16:59.14,0:17:02.38,N,,0,0,0,,312
Dialogue: 0,0:16:59.14,0:17:02.38,W,,0,0,0,,рассказчик
Dialogue: 0,0:16:59.14,0:17:02.38,T,,0,0,0,,И крышку заварили не просто так.
Dialogue: 0,0:17:02.40,0:17:03.97,N,,0,0,0,,313
Dialogue: 0,0:17:02.40,0:17:03.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:17:02.40,0:17:03.97,T,,0,0,0,,А ты как думаешь?
Dialogue: 0,0:17:03.99,0:17:06.09,N,,0,0,0,,314
Dialogue: 0,0:17:03.99,0:17:06.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:17:03.99,0:17:06.09,T,,0,0,0,,Напиши букву в комментариях.
Dialogue: 0,0:17:06.11,0:17:09.30,N,,0,0,0,,315
Dialogue: 0,0:17:06.11,0:17:09.30,W,,0,0,0,,рассказчик
Dialogue: 0,0:17:06.11,0:17:09.30,T,,0,0,0,,И напиши, какую загадку разобрать следующей.
Dialogue: 0,0:17:09.32,0:17:11.97,N,,0,0,0,,316
Dialogue: 0,0:17:09.32,0:17:11.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:17:09.32,0:17:11.97,T,,0,0,0,,А если тебе понравилось — подпишись.
Dialogue: 0,0:17:11.99,0:17:36.28,N,,0,0,0,,317
Dialogue: 0,0:17:11.99,0:17:36.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:17:11.99,0:17:36.28,T,,0,0,0,,Впереди ещё много неразгаданного.
