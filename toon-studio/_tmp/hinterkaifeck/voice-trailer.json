{
 "dir": "public/hinterkaifeck/el",
 "lead": 0.0,
 "tail": 0.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "trailer-loop.mp3",
   "t0": 6.76,
   "t1": 9.85,
   "say": "На одиноком хуторе у самого леса.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 6.625,
   "t1": 9.335,
   "say": "Однажды утром хозяин выходит во двор.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 9.335,
   "t1": 11.995,
   "say": "И видит на свежем снегу следы.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.305,
   "t1": 13.665,
   "say": "Они идут из леса.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 13.825,
   "t1": 15.165,
   "say": "Прямо к его дому.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 15.385,
   "t1": 17.755,
   "say": "А обратно — не идёт ни один.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.025,
   "t1": 21.905,
   "say": "Той же ночью над головой, на чердаке, кто-то ходит.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.095,
   "t1": 24.985,
   "say": "Хозяин берёт фонарь и поднимается наверх.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 25.185,
   "t1": 26.425,
   "say": "Там никого.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 102.585,
   "t1": 104.165,
   "say": "Ему предлагают помощь.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 104.175,
   "t1": 105.735,
   "say": "Предлагают позвать полицию.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 106.055,
   "t1": 107.325,
   "say": "Он отказывается.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 32.025,
   "t1": 33.285,
   "say": "Шесть человек.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 33.505,
   "t1": 40.025,
   "say": "Вся семья, маленькие дети и служанка, которая пришла сюда всего за несколько часов до этого.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 49.345,
   "t1": 50.195,
   "say": "По одному.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 50.465,
   "t1": 51.595,
   "say": "Друг за другом.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 51.745,
   "t1": 53.945,
   "say": "И ни один не возвращается.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 42.545,
   "t1": 48.305,
   "say": "Самое жуткое то, что потом ещё несколько дней на хуторе кто-то жил.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 48.72,
   "t1": 50.03,
   "say": "Кормил скот.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.07,
   "t1": 50.815,
   "say": "Ел хлеб.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 51.095,
   "t1": 51.955,
   "say": "Топил печь.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 53.035,
   "t1": 57.675,
   "say": "Потом полиция найдёт на чердаке сено, разложенное так, чтобы глушить шаги.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 58.1,
   "t1": 59.8,
   "say": "Черепица в крыше сдвинута.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 60.06,
   "t1": 62.025,
   "say": "Через щель видно весь двор.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 62.225,
   "t1": 64.335,
   "say": "А в сене — две вмятины.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 64.495,
   "t1": 66.385,
   "say": "Как будто там кто-то лежал.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 66.545,
   "t1": 67.235,
   "say": "Долго.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 67.535,
   "t1": 68.935,
   "say": "Может быть, не одну ночь.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 81.315,
   "t1": 83.055,
   "say": "Прямо над их головами.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 79.345,
   "t1": 81.045,
   "say": "В доме нашли деньги.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 81.225,
   "t1": 82.345,
   "say": "Много денег.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 82.775,
   "t1": 85.155,
   "say": "Убийца несколько дней жил в доме.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 85.335,
   "t1": 87.225,
   "say": "У него было время найти всё.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 87.505,
   "t1": 89.105,
   "say": "Но он их не взял.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 82.745,
   "t1": 86.175,
   "say": "И когда разбирают крышу, на чердаке находят кирку.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 86.175,
   "t1": 87.825,
   "say": "Ту самую.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 87.985,
   "t1": 89.265,
   "say": "Со следами крови.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 123.38,
   "t1": 127.89,
   "say": "А в две тысячи седьмом году за дело берутся курсанты полицейской академии.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 133.065,
   "t1": 137.385,
   "say": "И говорят: да, у нас есть главный подозреваемый.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 137.425,
   "t1": 139.885,
   "say": "Но назвать его имя мы не будем.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 140.025,
   "t1": 143.655,
   "say": "Из уважения к его потомкам, которые живут до сих пор.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 0.4,
   "t1": 2.1,
   "say": "Так кто же пришёл из леса?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 2.35,
   "t1": 4.9,
   "say": "Ответ — в полном видео на канале.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "trailer-loop.mp3",
   "t0": 5.05,
   "t1": 6.76,
   "say": "Потому что всё началось…",
   "gap": 0.0,
   "who": "narrator"
  }
 ]
}