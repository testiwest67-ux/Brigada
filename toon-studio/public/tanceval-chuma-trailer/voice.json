     "t": 7.794
    },
    {
     "w": "серые.",
     "t": 8.134
    }
   ]
  },
  {
   "i": 4,
   "text": "Глаза пустые.",
   "start": 9.272,
   "end": 10.658,
   "who": "narrator",
   "words": [
    {
     "w": "Глаза",
     "t": 9.312
    },
    {
     "w": "пустые.",
     "t": 9.792
    }
   ]
  },
  {
   "i": 5,
   "text": "Ноги распухли.",
   "start": 11.108,
   "end": 12.354,
   "who": "narrator",
   "words": [
    {
     "w": "Ноги",
     "t": 11.128
    },
    {
     "w": "распухли.",
     "t": 11.528
    }
   ]
  },
  {
   "i": 6,
   "text": "Никто из них не хочет танцевать.",
   "start": 12.804,
   "end": 15.052,
   "who": "narrator",
   "words": [
    {
     "w": "Никто",
     "t": 12.884
    },
    {
     "w": "из",
     "t": 13.284
    },
    {
     "w": "них",
     "t": 13.484
    },
    {
     "w": "не",
     "t": 13.704
    },
    {
     "w": "хочет",
     "t": 13.904
    },
    {
     "w": "танцевать.",
     "t": 14.324
    }
   ]
  },
  {
   "i": 7,
   "text": "Но никто не может остановиться.",
   "start": 15.502,
   "end": 17.667,
   "who": "narrator",
   "words": [
    {
     "w": "Но",
     "t": 15.502
    },
