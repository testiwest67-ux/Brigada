Dialogue: 0,0:00:01.00,0:00:02.30,N,,0,0,0,,1
Dialogue: 0,0:00:01.00,0:00:02.30,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:01.00,0:00:02.30,T,,0,0,0,,Пятьсот лет.
Dialogue: 0,0:00:02.32,0:00:04.27,N,,0,0,0,,2
Dialogue: 0,0:00:02.32,0:00:04.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:02.32,0:00:04.27,T,,0,0,0,,Сотни экспедиций.
Dialogue: 0,0:00:04.29,0:00:05.91,N,,0,0,0,,3
Dialogue: 0,0:00:04.29,0:00:05.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:04.29,0:00:05.91,T,,0,0,0,,Тысячи погибших.
Dialogue: 0,0:00:05.93,0:00:09.16,N,,0,0,0,,4
Dialogue: 0,0:00:05.93,0:00:09.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:05.93,0:00:09.16,T,,0,0,0,,И ни одного найденного золотого города.
Dialogue: 0,0:00:09.18,0:00:11.70,N,,0,0,0,,5
Dialogue: 0,0:00:09.18,0:00:11.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:09.18,0:00:11.70,T,,0,0,0,,Ради Эльдорадо сжигали деревни.
Dialogue: 0,0:00:11.72,0:00:14.47,N,,0,0,0,,6
Dialogue: 0,0:00:11.72,0:00:14.47,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:11.72,0:00:14.47,T,,0,0,0,,Уходили в джунгли целыми армиями.
Dialogue: 0,0:00:14.49,0:00:16.56,N,,0,0,0,,7
Dialogue: 0,0:00:14.49,0:00:16.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:14.49,0:00:16.56,T,,0,0,0,,Пытались осушить озеро.
Dialogue: 0,0:00:16.58,0:00:19.71,N,,0,0,0,,8
Dialogue: 0,0:00:16.58,0:00:19.71,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:16.58,0:00:19.71,T,,0,0,0,,Одного знаменитого мореплавателя за него казнили.
Dialogue: 0,0:00:19.73,0:00:23.98,N,,0,0,0,,9
Dialogue: 0,0:00:19.73,0:00:23.98,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:19.73,0:00:23.98,T,,0,0,0,,Другой ушёл в джунгли с сыном — и исчез навсегда.
Dialogue: 0,0:00:24.00,0:00:30.11,N,,0,0,0,,10
Dialogue: 0,0:00:24.00,0:00:30.11,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:24.00,0:00:30.11,T,,0,0,0,,А в две тысячи двадцать четвёртом году учёные посветили лазером сквозь джунгли Амазонии.
Dialogue: 0,0:00:30.13,0:00:33.68,N,,0,0,0,,11
Dialogue: 0,0:00:30.13,0:00:33.68,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:30.13,0:00:33.68,T,,0,0,0,,И увидели то, чего там быть не могло.
Dialogue: 0,0:00:33.70,0:00:37.53,N,,0,0,0,,12
Dialogue: 0,0:00:33.70,0:00:37.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:33.70,0:00:37.53,T,,0,0,0,,Но сначала — главная находка двадцатого века.
Dialogue: 0,0:00:37.55,0:00:38.64,N,,0,0,0,,13
Dialogue: 0,0:00:37.55,0:00:38.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:37.55,0:00:38.64,T,,0,0,0,,Колумбия.
Dialogue: 0,0:00:38.66,0:00:41.32,N,,0,0,0,,14
Dialogue: 0,0:00:38.66,0:00:41.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:38.66,0:00:41.32,T,,0,0,0,,Тысяча девятьсот шестьдесят девятый год.
Dialogue: 0,0:00:41.34,0:00:45.45,N,,0,0,0,,15
Dialogue: 0,0:00:41.34,0:00:45.45,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:41.34,0:00:45.45,T,,0,0,0,,Крестьяне забираются в пещеру в горах, недалеко от Боготы.
Dialogue: 0,0:00:45.47,0:00:49.15,N,,0,0,0,,16
Dialogue: 0,0:00:45.47,0:00:49.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:45.47,0:00:49.15,T,,0,0,0,,В темноте, в глиняном горшке, что-то блестит.
Dialogue: 0,0:00:49.17,0:00:52.39,N,,0,0,0,,17
Dialogue: 0,0:00:49.17,0:00:52.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:49.17,0:00:52.39,T,,0,0,0,,Маленький плот из чистого золота.
Dialogue: 0,0:00:52.41,0:00:54.54,N,,0,0,0,,18
Dialogue: 0,0:00:52.41,0:00:54.54,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:52.41,0:00:54.54,T,,0,0,0,,На нём человек в короне.
Dialogue: 0,0:00:54.56,0:00:56.75,N,,0,0,0,,19
Dialogue: 0,0:00:54.56,0:00:56.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:54.56,0:00:56.75,T,,0,0,0,,Вокруг — его свита.
Dialogue: 0,0:00:56.77,0:01:00.05,N,,0,0,0,,20
Dialogue: 0,0:00:56.77,0:01:00.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:56.77,0:01:00.05,T,,0,0,0,,Учёные понимают: это не украшение.
Dialogue: 0,0:01:00.07,0:01:02.04,N,,0,0,0,,21
Dialogue: 0,0:01:00.07,0:01:02.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:00.07,0:01:02.04,T,,0,0,0,,Это доказательство.
Dialogue: 0,0:01:02.06,0:01:03.72,N,,0,0,0,,22
Dialogue: 0,0:01:02.06,0:01:03.72,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:02.06,0:01:03.72,T,,0,0,0,,Легенда не врала.
Dialogue: 0,0:01:03.74,0:01:05.63,N,,0,0,0,,23
Dialogue: 0,0:01:03.74,0:01:05.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:03.74,0:01:05.63,T,,0,0,0,,Что-то было.
Dialogue: 0,0:01:05.65,0:01:09.13,N,,0,0,0,,24
Dialogue: 0,0:01:05.65,0:01:09.13,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:05.65,0:01:09.13,T,,0,0,0,,Тогда почему никто так и не нашёл Эльдорадо?
Dialogue: 0,0:01:09.15,0:01:10.58,N,,0,0,0,,25
Dialogue: 0,0:01:09.15,0:01:10.58,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:09.15,0:01:10.58,T,,0,0,0,,Давай разберёмся.
Dialogue: 0,0:01:10.60,0:01:14.03,N,,0,0,0,,26
Dialogue: 0,0:01:10.60,0:01:14.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:10.60,0:01:14.03,T,,0,0,0,,А в конце — что увидел лазер под джунглями.
Dialogue: 0,0:01:14.05,0:01:18.29,N,,0,0,0,,27
Dialogue: 0,0:01:14.05,0:01:18.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:14.05,0:01:18.29,T,,0,0,0,,Это переворачивает всю историю.
Dialogue: 0,0:01:18.31,0:01:20.63,N,,0,0,0,,28
Dialogue: 0,0:01:18.31,0:01:20.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:18.31,0:01:20.63,T,,0,0,0,,Начнём с главного секрета.
Dialogue: 0,0:01:20.65,0:01:23.53,N,,0,0,0,,29
Dialogue: 0,0:01:20.65,0:01:23.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:20.65,0:01:23.53,T,,0,0,0,,Эльдорадо — это вообще не город.
Dialogue: 0,0:01:23.55,0:01:27.49,N,,0,0,0,,30
Dialogue: 0,0:01:23.55,0:01:27.49,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:23.55,0:01:27.49,T,,0,0,0,,По-испански «эль дорадо» значит «позолоченный».
Dialogue: 0,0:01:27.51,0:01:29.64,N,,0,0,0,,31
Dialogue: 0,0:01:27.51,0:01:29.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:27.51,0:01:29.64,T,,0,0,0,,Позолоченный человек.
Dialogue: 0,0:01:29.66,0:01:33.01,N,,0,0,0,,32
Dialogue: 0,0:01:29.66,0:01:33.01,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:29.66,0:01:33.01,T,,0,0,0,,Высоко в горах Колумбии жил народ муисков.
Dialogue: 0,0:01:33.03,0:01:34.67,N,,0,0,0,,33
Dialogue: 0,0:01:33.03,0:01:34.67,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:33.03,0:01:34.67,T,,0,0,0,,Они не строили пирамид.
Dialogue: 0,0:01:34.69,0:01:36.92,N,,0,0,0,,34
Dialogue: 0,0:01:34.69,0:01:36.92,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:34.69,0:01:36.92,T,,0,0,0,,Зато у них было золото.
Dialogue: 0,0:01:36.94,0:01:38.63,N,,0,0,0,,35
Dialogue: 0,0:01:36.94,0:01:38.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:36.94,0:01:38.63,T,,0,0,0,,Много золота.
Dialogue: 0,0:01:38.65,0:01:41.41,N,,0,0,0,,36
Dialogue: 0,0:01:38.65,0:01:41.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:38.65,0:01:41.41,T,,0,0,0,,Для муисков золото не было деньгами.
Dialogue: 0,0:01:41.42,0:01:43.41,N,,0,0,0,,37
Dialogue: 0,0:01:41.42,0:01:43.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:41.42,0:01:43.41,T,,0,0,0,,Это был металл солнца.
Dialogue: 0,0:01:43.43,0:01:44.94,N,,0,0,0,,38
Dialogue: 0,0:01:43.43,0:01:44.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:43.43,0:01:44.94,T,,0,0,0,,Подарок богам.
Dialogue: 0,0:01:44.96,0:01:48.07,N,,0,0,0,,39
Dialogue: 0,0:01:44.96,0:01:48.07,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:44.96,0:01:48.07,T,,0,0,0,,И раз в поколение у них был особый день.
Dialogue: 0,0:01:48.09,0:01:50.65,N,,0,0,0,,40
Dialogue: 0,0:01:48.09,0:01:50.65,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:48.09,0:01:50.65,T,,0,0,0,,Новый правитель восходил на трон.
Dialogue: 0,0:01:50.67,0:01:53.07,N,,0,0,0,,41
Dialogue: 0,0:01:50.67,0:01:53.07,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:50.67,0:01:53.07,T,,0,0,0,,Его тело мазали липкой смолой.
Dialogue: 0,0:01:53.09,0:01:55.64,N,,0,0,0,,42
Dialogue: 0,0:01:53.09,0:01:55.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:53.09,0:01:55.64,T,,0,0,0,,А потом осыпали золотой пылью.
Dialogue: 0,0:01:55.66,0:01:57.31,N,,0,0,0,,43
Dialogue: 0,0:01:55.66,0:01:57.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:55.66,0:01:57.31,T,,0,0,0,,С головы до ног.
Dialogue: 0,0:01:57.33,0:01:59.95,N,,0,0,0,,44
Dialogue: 0,0:01:57.33,0:01:59.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:57.33,0:01:59.95,T,,0,0,0,,Он сиял, как живое солнце.
Dialogue: 0,0:01:59.97,0:02:01.70,N,,0,0,0,,45
Dialogue: 0,0:01:59.97,0:02:01.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:59.97,0:02:01.70,T,,0,0,0,,Его сажали на плот.
Dialogue: 0,0:02:01.72,0:02:04.92,N,,0,0,0,,46
Dialogue: 0,0:02:01.72,0:02:04.92,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:01.72,0:02:04.92,T,,0,0,0,,Рядом клали горы золота и изумрудов.
Dialogue: 0,0:02:04.94,0:02:08.48,N,,0,0,0,,47
Dialogue: 0,0:02:04.94,0:02:08.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:04.94,0:02:08.48,T,,0,0,0,,Плот выплывал на середину круглого горного озера.
Dialogue: 0,0:02:08.50,0:02:10.27,N,,0,0,0,,48
Dialogue: 0,0:02:08.50,0:02:10.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:08.50,0:02:10.27,T,,0,0,0,,Озеро Гуатавита.
Dialogue: 0,0:02:10.29,0:02:12.48,N,,0,0,0,,49
Dialogue: 0,0:02:10.29,0:02:12.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:10.29,0:02:12.48,T,,0,0,0,,На берегу — тысячи людей.
Dialogue: 0,0:02:12.50,0:02:13.51,N,,0,0,0,,50
Dialogue: 0,0:02:12.50,0:02:13.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:12.50,0:02:13.51,T,,0,0,0,,Музыка.
Dialogue: 0,0:02:13.53,0:02:15.04,N,,0,0,0,,51
Dialogue: 0,0:02:13.53,0:02:15.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:13.53,0:02:15.04,T,,0,0,0,,Дым благовоний.
Dialogue: 0,0:02:15.06,0:02:17.17,N,,0,0,0,,52
Dialogue: 0,0:02:15.06,0:02:17.17,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:15.06,0:02:17.17,T,,0,0,0,,И вдруг — тишина.
Dialogue: 0,0:02:17.19,0:02:19.75,N,,0,0,0,,53
Dialogue: 0,0:02:17.19,0:02:19.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:17.19,0:02:19.75,T,,0,0,0,,Правитель бросал сокровища в воду.
Dialogue: 0,0:02:19.77,0:02:21.27,N,,0,0,0,,54
Dialogue: 0,0:02:19.77,0:02:21.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:19.77,0:02:21.27,T,,0,0,0,,Одно за другим.
Dialogue: 0,0:02:21.29,0:02:23.19,N,,0,0,0,,55
Dialogue: 0,0:02:21.29,0:02:23.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:21.29,0:02:23.19,T,,0,0,0,,А потом нырял сам.
Dialogue: 0,0:02:23.21,0:02:26.78,N,,0,0,0,,56
Dialogue: 0,0:02:23.21,0:02:26.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:23.21,0:02:26.78,T,,0,0,0,,И золото смывалось с его кожи в тёмную воду.
Dialogue: 0,0:02:26.80,0:02:28.89,N,,0,0,0,,57
Dialogue: 0,0:02:26.80,0:02:28.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:26.80,0:02:28.89,T,,0,0,0,,Вот он — Эль Дорадо.
Dialogue: 0,0:02:28.91,0:02:30.70,N,,0,0,0,,58
Dialogue: 0,0:02:28.91,0:02:30.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:28.91,0:02:30.70,T,,0,0,0,,Золотой человек.
Dialogue: 0,0:02:30.72,0:02:35.87,N,,0,0,0,,59
Dialogue: 0,0:02:30.72,0:02:35.87,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:30.72,0:02:35.87,T,,0,0,0,,Тот самый плот из пещеры — это и есть этот обряд, отлитый в золоте.
Dialogue: 0,0:02:35.89,0:02:41.16,N,,0,0,0,,60
Dialogue: 0,0:02:35.89,0:02:41.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:35.89,0:02:41.16,T,,0,0,0,,Но испанцы услышали эту историю иначе.
Dialogue: 0,0:02:41.19,0:02:43.63,N,,0,0,0,,61
Dialogue: 0,0:02:41.19,0:02:43.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:41.19,0:02:43.63,T,,0,0,0,,Тысяча пятьсот тридцать седьмой год.
Dialogue: 0,0:02:43.65,0:02:46.91,N,,0,0,0,,62
Dialogue: 0,0:02:43.65,0:02:46.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:43.65,0:02:46.91,T,,0,0,0,,В горы муисков приходит испанский отряд.
Dialogue: 0,0:02:46.93,0:02:50.20,N,,0,0,0,,63
Dialogue: 0,0:02:46.93,0:02:50.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:46.93,0:02:50.20,T,,0,0,0,,Командир — Гонсало Хименес де Кесада.
Dialogue: 0,0:02:50.22,0:02:52.88,N,,0,0,0,,64
Dialogue: 0,0:02:50.22,0:02:52.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:50.22,0:02:52.88,T,,0,0,0,,Испанцы уже ограбили ацтеков.
Dialogue: 0,0:02:52.90,0:02:54.98,N,,0,0,0,,65
Dialogue: 0,0:02:52.90,0:02:54.98,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:52.90,0:02:54.98,T,,0,0,0,,Уже ограбили инков.
Dialogue: 0,0:02:55.00,0:02:58.59,N,,0,0,0,,66
Dialogue: 0,0:02:55.00,0:02:58.59,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:55.00,0:02:58.59,T,,0,0,0,,Они знают: где индейцы — там золото.
Dialogue: 0,0:02:58.61,0:03:00.27,N,,0,0,0,,67
Dialogue: 0,0:02:58.61,0:03:00.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:58.61,0:03:00.27,T,,0,0,0,,Муиски проигрывают.
Dialogue: 0,0:03:00.29,0:03:05.78,N,,0,0,0,,68
Dialogue: 0,0:03:00.29,0:03:05.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:00.29,0:03:05.78,T,,0,0,0,,Испанцы забирают всё: золото, изумруды, храмовые украшения.
Dialogue: 0,0:03:05.80,0:03:07.34,N,,0,0,0,,69
Dialogue: 0,0:03:05.80,0:03:07.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:05.80,0:03:07.34,T,,0,0,0,,Но им мало.
Dialogue: 0,0:03:07.36,0:03:10.78,N,,0,0,0,,70
Dialogue: 0,0:03:07.36,0:03:10.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:07.36,0:03:10.78,T,,0,0,0,,Они слышат рассказы про озеро, полное сокровищ.
Dialogue: 0,0:03:10.80,0:03:12.91,N,,0,0,0,,71
Dialogue: 0,0:03:10.80,0:03:12.91,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:10.80,0:03:12.91,T,,0,0,0,,Про позолоченного правителя.
Dialogue: 0,0:03:12.93,0:03:15.89,N,,0,0,0,,72
Dialogue: 0,0:03:12.93,0:03:15.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:12.93,0:03:15.89,T,,0,0,0,,И в их головах история меняется.
Dialogue: 0,0:03:15.91,0:03:19.79,N,,0,0,0,,73
Dialogue: 0,0:03:15.91,0:03:19.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:15.91,0:03:19.79,T,,0,0,0,,Позолоченный человек превращается в золотое царство.
Dialogue: 0,0:03:19.81,0:03:22.51,N,,0,0,0,,74
Dialogue: 0,0:03:19.81,0:03:22.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:19.81,0:03:22.51,T,,0,0,0,,Золотое царство — в золотой город.
Dialogue: 0,0:03:22.53,0:03:24.15,N,,0,0,0,,75
Dialogue: 0,0:03:22.53,0:03:24.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:22.53,0:03:24.15,T,,0,0,0,,С крышами из золота.
Dialogue: 0,0:03:24.17,0:03:26.16,N,,0,0,0,,76
Dialogue: 0,0:03:24.17,0:03:26.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:24.17,0:03:26.16,T,,0,0,0,,С улицами из золота.
Dialogue: 0,0:03:26.18,0:03:29.30,N,,0,0,0,,77
Dialogue: 0,0:03:26.18,0:03:29.30,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:26.18,0:03:29.30,T,,0,0,0,,И главное — он всегда чуть дальше.
Dialogue: 0,0:03:29.32,0:03:30.78,N,,0,0,0,,78
Dialogue: 0,0:03:29.32,0:03:30.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:29.32,0:03:30.78,T,,0,0,0,,За следующей горой.
Dialogue: 0,0:03:30.80,0:03:32.33,N,,0,0,0,,79
Dialogue: 0,0:03:30.80,0:03:32.33,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:30.80,0:03:32.33,T,,0,0,0,,За следующей рекой.
Dialogue: 0,0:03:32.35,0:03:34.38,N,,0,0,0,,80
Dialogue: 0,0:03:32.35,0:03:34.38,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:32.35,0:03:34.38,T,,0,0,0,,В следующих джунглях.
Dialogue: 0,0:03:34.40,0:03:40.05,N,,0,0,0,,81
Dialogue: 0,0:03:34.40,0:03:40.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:34.40,0:03:40.05,T,,0,0,0,,Индейцы быстро поняли: чтобы испанцы ушли, достаточно махнуть рукой вдаль.
Dialogue: 0,0:03:40.07,0:03:41.09,N,,0,0,0,,82
Dialogue: 0,0:03:40.07,0:03:41.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:40.07,0:03:41.09,T,,0,0,0,,«Эльдорадо?
Dialogue: 0,0:03:41.11,0:03:41.74,N,,0,0,0,,83
Dialogue: 0,0:03:41.11,0:03:41.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:41.11,0:03:41.74,T,,0,0,0,,Там.
Dialogue: 0,0:03:41.76,0:03:42.86,N,,0,0,0,,84
Dialogue: 0,0:03:41.76,0:03:42.86,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:41.76,0:03:42.86,T,,0,0,0,,Дальше».
Dialogue: 0,0:03:42.88,0:03:45.08,N,,0,0,0,,85
Dialogue: 0,0:03:42.88,0:03:45.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:42.88,0:03:45.08,T,,0,0,0,,И испанцы шли дальше.
Dialogue: 0,0:03:45.10,0:03:50.22,N,,0,0,0,,86
Dialogue: 0,0:03:45.10,0:03:50.22,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:45.10,0:03:50.22,T,,0,0,0,,Скоро это будет стоить жизни тысячам людей.
Dialogue: 0,0:03:50.24,0:03:52.48,N,,0,0,0,,87
Dialogue: 0,0:03:50.24,0:03:52.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:50.24,0:03:52.48,T,,0,0,0,,Тысяча пятьсот сорок первый год.
Dialogue: 0,0:03:52.50,0:03:54.66,N,,0,0,0,,88
Dialogue: 0,0:03:52.50,0:03:54.66,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:52.50,0:03:54.66,T,,0,0,0,,Город Кито, в Андах.
Dialogue: 0,0:03:54.69,0:04:00.27,N,,0,0,0,,89
Dialogue: 0,0:03:54.69,0:04:00.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:03:54.69,0:04:00.27,T,,0,0,0,,Гонсало Писарро — брат завоевателя инков — собирает огромную экспедицию.
Dialogue: 0,0:04:00.29,0:04:02.48,N,,0,0,0,,90
Dialogue: 0,0:04:00.29,0:04:02.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:00.29,0:04:02.48,T,,0,0,0,,Двести двадцать испанцев.
Dialogue: 0,0:04:02.50,0:04:05.53,N,,0,0,0,,91
Dialogue: 0,0:04:02.50,0:04:05.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:02.50,0:04:05.53,T,,0,0,0,,Около четырёх тысяч индейцев-носильщиков.
Dialogue: 0,0:04:05.55,0:04:06.44,N,,0,0,0,,92
Dialogue: 0,0:04:05.55,0:04:06.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:05.55,0:04:06.44,T,,0,0,0,,Лошади.
Dialogue: 0,0:04:06.46,0:04:07.44,N,,0,0,0,,93
Dialogue: 0,0:04:06.46,0:04:07.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:06.46,0:04:07.44,T,,0,0,0,,Свиньи.
Dialogue: 0,0:04:07.46,0:04:10.48,N,,0,0,0,,94
Dialogue: 0,0:04:07.46,0:04:10.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:07.46,0:04:10.48,T,,0,0,0,,Собаки, натасканные на людей.
Dialogue: 0,0:04:10.50,0:04:13.15,N,,0,0,0,,95
Dialogue: 0,0:04:10.50,0:04:13.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:10.50,0:04:13.15,T,,0,0,0,,Цель — Эльдорадо и «страна корицы».
Dialogue: 0,0:04:13.17,0:04:15.99,N,,0,0,0,,96
Dialogue: 0,0:04:13.17,0:04:15.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:13.17,0:04:15.99,T,,0,0,0,,Тогда корица стоила как золото.
Dialogue: 0,0:04:16.01,0:04:18.34,N,,0,0,0,,97
Dialogue: 0,0:04:16.01,0:04:18.34,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:16.01,0:04:18.34,T,,0,0,0,,Они спускаются с гор в джунгли.
Dialogue: 0,0:04:18.36,0:04:20.95,N,,0,0,0,,98
Dialogue: 0,0:04:18.36,0:04:20.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:18.36,0:04:20.95,T,,0,0,0,,И джунгли начинают их убивать.
Dialogue: 0,0:04:20.97,0:04:23.37,N,,0,0,0,,99
Dialogue: 0,0:04:20.97,0:04:23.37,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:20.97,0:04:23.37,T,,0,0,0,,Дожди не прекращаются неделями.
Dialogue: 0,0:04:23.39,0:04:25.80,N,,0,0,0,,100
Dialogue: 0,0:04:23.39,0:04:25.80,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:23.39,0:04:25.80,T,,0,0,0,,Одежда гниёт прямо на теле.
Dialogue: 0,0:04:25.82,0:04:27.72,N,,0,0,0,,101
Dialogue: 0,0:04:25.82,0:04:27.72,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:25.82,0:04:27.72,T,,0,0,0,,Еда заканчивается.
Dialogue: 0,0:04:27.74,0:04:29.15,N,,0,0,0,,102
Dialogue: 0,0:04:27.74,0:04:29.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:27.74,0:04:29.15,T,,0,0,0,,Съедают свиней.
Dialogue: 0,0:04:29.17,0:04:30.42,N,,0,0,0,,103
Dialogue: 0,0:04:29.17,0:04:30.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:29.17,0:04:30.42,T,,0,0,0,,Потом лошадей.
Dialogue: 0,0:04:30.44,0:04:31.67,N,,0,0,0,,104
Dialogue: 0,0:04:30.44,0:04:31.67,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:30.44,0:04:31.67,T,,0,0,0,,Потом собак.
Dialogue: 0,0:04:31.69,0:04:33.81,N,,0,0,0,,105
Dialogue: 0,0:04:31.69,0:04:33.81,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:31.69,0:04:33.81,T,,0,0,0,,Потом ремни и подошвы.
Dialogue: 0,0:04:33.83,0:04:36.69,N,,0,0,0,,106
Dialogue: 0,0:04:33.83,0:04:36.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:33.83,0:04:36.69,T,,0,0,0,,Индейцы-носильщики умирают тысячами.
Dialogue: 0,0:04:36.71,0:04:38.40,N,,0,0,0,,107
Dialogue: 0,0:04:36.71,0:04:38.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:36.71,0:04:38.40,T,,0,0,0,,Корицы почти нет.
Dialogue: 0,0:04:38.42,0:04:40.17,N,,0,0,0,,108
Dialogue: 0,0:04:38.42,0:04:40.17,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:38.42,0:04:40.17,T,,0,0,0,,Золота нет.
Dialogue: 0,0:04:40.19,0:04:44.49,N,,0,0,0,,109
Dialogue: 0,0:04:40.19,0:04:44.49,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:40.19,0:04:44.49,T,,0,0,0,,Тогда Писарро отправляет вниз по реке маленький отряд за едой.
Dialogue: 0,0:04:44.51,0:04:47.31,N,,0,0,0,,110
Dialogue: 0,0:04:44.51,0:04:47.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:44.51,0:04:47.31,T,,0,0,0,,Командир — Франсиско де Орельяна.
Dialogue: 0,0:04:47.33,0:04:49.40,N,,0,0,0,,111
Dialogue: 0,0:04:47.33,0:04:49.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:47.33,0:04:49.40,T,,0,0,0,,Отряд не возвращается.
Dialogue: 0,0:04:49.42,0:04:51.78,N,,0,0,0,,112
Dialogue: 0,0:04:49.42,0:04:51.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:49.42,0:04:51.78,T,,0,0,0,,Писарро решает, что его предали.
Dialogue: 0,0:04:51.80,0:04:54.46,N,,0,0,0,,113
Dialogue: 0,0:04:51.80,0:04:54.46,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:51.80,0:04:54.46,T,,0,0,0,,Он с трудом выбирается назад в Кито.
Dialogue: 0,0:04:54.48,0:04:58.60,N,,0,0,0,,114
Dialogue: 0,0:04:54.48,0:04:58.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:54.48,0:04:58.60,T,,0,0,0,,Из четырёх тысяч индейцев не вернулся почти никто.
Dialogue: 0,0:04:58.62,0:05:00.24,N,,0,0,0,,115
Dialogue: 0,0:04:58.62,0:05:00.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:04:58.62,0:05:00.24,T,,0,0,0,,А Орельяна…
Dialogue: 0,0:05:00.25,0:05:01.87,N,,0,0,0,,116
Dialogue: 0,0:05:00.25,0:05:01.87,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:00.25,0:05:01.87,T,,0,0,0,,Орельяна плыл.
Dialogue: 0,0:05:01.89,0:05:02.98,N,,0,0,0,,117
Dialogue: 0,0:05:01.89,0:05:02.98,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:01.89,0:05:02.98,T,,0,0,0,,И плыл.
Dialogue: 0,0:05:03.00,0:05:04.16,N,,0,0,0,,118
Dialogue: 0,0:05:03.00,0:05:04.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:03.00,0:05:04.16,T,,0,0,0,,И плыл.
Dialogue: 0,0:05:04.18,0:05:09.53,N,,0,0,0,,119
Dialogue: 0,0:05:04.18,0:05:09.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:04.18,0:05:09.53,T,,0,0,0,,И сделал открытие, которое потрясёт весь мир.
Dialogue: 0,0:05:09.55,0:05:12.90,N,,0,0,0,,120
Dialogue: 0,0:05:09.55,0:05:12.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:09.55,0:05:12.90,T,,0,0,0,,Течение несёт отряд Орельяны всё дальше.
Dialogue: 0,0:05:12.92,0:05:15.55,N,,0,0,0,,121
Dialogue: 0,0:05:12.92,0:05:15.55,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:12.92,0:05:15.55,T,,0,0,0,,Повернуть назад уже невозможно.
Dialogue: 0,0:05:15.57,0:05:19.07,N,,0,0,0,,122
Dialogue: 0,0:05:15.57,0:05:19.07,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:15.57,0:05:19.07,T,,0,0,0,,Восемь месяцев они плывут по огромной реке.
Dialogue: 0,0:05:19.09,0:05:21.06,N,,0,0,0,,123
Dialogue: 0,0:05:19.09,0:05:21.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:19.09,0:05:21.06,T,,0,0,0,,Шириной как море.
Dialogue: 0,0:05:21.08,0:05:25.32,N,,0,0,0,,124
Dialogue: 0,0:05:21.08,0:05:25.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:21.08,0:05:25.32,T,,0,0,0,,И Орельяна видит то, во что потом никто не поверит.
Dialogue: 0,0:05:25.34,0:05:27.64,N,,0,0,0,,125
Dialogue: 0,0:05:25.34,0:05:27.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:25.34,0:05:27.64,T,,0,0,0,,Берега не пустые.
Dialogue: 0,0:05:27.66,0:05:28.92,N,,0,0,0,,126
Dialogue: 0,0:05:27.66,0:05:28.92,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:27.66,0:05:28.92,T,,0,0,0,,Там деревни.
Dialogue: 0,0:05:28.94,0:05:30.43,N,,0,0,0,,127
Dialogue: 0,0:05:28.94,0:05:30.43,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:28.94,0:05:30.43,T,,0,0,0,,Много деревень.
Dialogue: 0,0:05:30.45,0:05:31.44,N,,0,0,0,,128
Dialogue: 0,0:05:30.45,0:05:31.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:30.45,0:05:31.44,T,,0,0,0,,Дороги.
Dialogue: 0,0:05:31.46,0:05:32.44,N,,0,0,0,,129
Dialogue: 0,0:05:31.46,0:05:32.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:31.46,0:05:32.44,T,,0,0,0,,Поля.
Dialogue: 0,0:05:32.46,0:05:33.74,N,,0,0,0,,130
Dialogue: 0,0:05:32.46,0:05:33.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:32.46,0:05:33.74,T,,0,0,0,,Тысячи людей.
Dialogue: 0,0:05:33.76,0:05:36.45,N,,0,0,0,,131
Dialogue: 0,0:05:33.76,0:05:36.45,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:33.76,0:05:36.45,T,,0,0,0,,Целые царства вдоль реки.
Dialogue: 0,0:05:36.47,0:05:39.00,N,,0,0,0,,132
Dialogue: 0,0:05:36.47,0:05:39.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:36.47,0:05:39.00,T,,0,0,0,,Однажды на них нападают воины.
Dialogue: 0,0:05:39.01,0:05:42.57,N,,0,0,0,,133
Dialogue: 0,0:05:39.01,0:05:42.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:39.01,0:05:42.57,T,,0,0,0,,Испанцам кажется, что впереди сражаются женщины.
Dialogue: 0,0:05:42.59,0:05:45.29,N,,0,0,0,,134
Dialogue: 0,0:05:42.59,0:05:45.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:42.59,0:05:45.29,T,,0,0,0,,Как амазонки из греческих мифов.
Dialogue: 0,0:05:45.31,0:05:47.41,N,,0,0,0,,135
Dialogue: 0,0:05:45.31,0:05:47.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:45.31,0:05:47.41,T,,0,0,0,,Так река и получила имя.
Dialogue: 0,0:05:47.43,0:05:48.84,N,,0,0,0,,136
Dialogue: 0,0:05:47.43,0:05:48.84,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:47.43,0:05:48.84,T,,0,0,0,,Амазонка.
Dialogue: 0,0:05:48.86,0:05:53.12,N,,0,0,0,,137
Dialogue: 0,0:05:48.86,0:05:53.12,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:48.86,0:05:53.12,T,,0,0,0,,В тысяча пятьсот сорок втором году Орельяна выходит к океану.
Dialogue: 0,0:05:53.14,0:05:57.63,N,,0,0,0,,138
Dialogue: 0,0:05:53.14,0:05:57.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:53.14,0:05:57.63,T,,0,0,0,,Он первый европеец, проплывший Амазонку от гор до моря.
Dialogue: 0,0:05:57.65,0:06:00.28,N,,0,0,0,,139
Dialogue: 0,0:05:57.65,0:06:00.28,W,,0,0,0,,рассказчик
Dialogue: 0,0:05:57.65,0:06:00.28,T,,0,0,0,,Он рассказывает о многолюдных берегах.
Dialogue: 0,0:06:00.30,0:06:04.97,N,,0,0,0,,140
Dialogue: 0,0:06:00.30,0:06:04.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:00.30,0:06:04.97,T,,0,0,0,,Но когда через много лет туда приходят другие — никого нет.
Dialogue: 0,0:06:04.99,0:06:06.11,N,,0,0,0,,141
Dialogue: 0,0:06:04.99,0:06:06.11,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:04.99,0:06:06.11,T,,0,0,0,,Ни деревень.
Dialogue: 0,0:06:06.13,0:06:07.24,N,,0,0,0,,142
Dialogue: 0,0:06:06.13,0:06:07.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:06.13,0:06:07.24,T,,0,0,0,,Ни царств.
Dialogue: 0,0:06:07.26,0:06:08.58,N,,0,0,0,,143
Dialogue: 0,0:06:07.26,0:06:08.58,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:07.26,0:06:08.58,T,,0,0,0,,Ни дорог.
Dialogue: 0,0:06:08.60,0:06:10.24,N,,0,0,0,,144
Dialogue: 0,0:06:08.60,0:06:10.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:08.60,0:06:10.24,T,,0,0,0,,Только джунгли.
Dialogue: 0,0:06:10.26,0:06:13.10,N,,0,0,0,,145
Dialogue: 0,0:06:10.26,0:06:13.10,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:10.26,0:06:13.10,T,,0,0,0,,Орельяну назвали лжецом.
Dialogue: 0,0:06:13.12,0:06:14.57,N,,0,0,0,,146
Dialogue: 0,0:06:13.12,0:06:14.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:13.12,0:06:14.57,T,,0,0,0,,Запомни этот момент.
Dialogue: 0,0:06:14.59,0:06:17.54,N,,0,0,0,,147
Dialogue: 0,0:06:14.59,0:06:17.54,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:14.59,0:06:17.54,T,,0,0,0,,Мы к нему вернёмся.
Dialogue: 0,0:06:17.56,0:06:20.30,N,,0,0,0,,148
Dialogue: 0,0:06:17.56,0:06:20.30,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:17.56,0:06:20.30,T,,0,0,0,,Но золотой город не отпускает.
Dialogue: 0,0:06:20.32,0:06:22.71,N,,0,0,0,,149
Dialogue: 0,0:06:20.32,0:06:22.71,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:20.32,0:06:22.71,T,,0,0,0,,Тысяча пятьсот шестидесятый год.
Dialogue: 0,0:06:22.73,0:06:26.09,N,,0,0,0,,150
Dialogue: 0,0:06:22.73,0:06:26.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:22.73,0:06:26.09,T,,0,0,0,,Новая экспедиция уходит вниз по Амазонке.
Dialogue: 0,0:06:26.11,0:06:29.59,N,,0,0,0,,151
Dialogue: 0,0:06:26.11,0:06:29.59,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:26.11,0:06:29.59,T,,0,0,0,,В ней служит солдат по имени Лопе де Агирре.
Dialogue: 0,0:06:29.61,0:06:31.24,N,,0,0,0,,152
Dialogue: 0,0:06:29.61,0:06:31.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:29.61,0:06:31.24,T,,0,0,0,,Месяцы в джунглях.
Dialogue: 0,0:06:31.26,0:06:32.20,N,,0,0,0,,153
Dialogue: 0,0:06:31.26,0:06:32.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:31.26,0:06:32.20,T,,0,0,0,,Голод.
Dialogue: 0,0:06:32.22,0:06:33.10,N,,0,0,0,,154
Dialogue: 0,0:06:32.22,0:06:33.10,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:32.22,0:06:33.10,T,,0,0,0,,Жара.
Dialogue: 0,0:06:33.12,0:06:34.19,N,,0,0,0,,155
Dialogue: 0,0:06:33.12,0:06:34.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:33.12,0:06:34.19,T,,0,0,0,,Комары.
Dialogue: 0,0:06:34.21,0:06:36.31,N,,0,0,0,,156
Dialogue: 0,0:06:34.21,0:06:36.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:34.21,0:06:36.31,T,,0,0,0,,Ни крупинки золота.
Dialogue: 0,0:06:36.33,0:06:38.57,N,,0,0,0,,157
Dialogue: 0,0:06:36.33,0:06:38.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:36.33,0:06:38.57,T,,0,0,0,,И Агирре сходит с ума.
Dialogue: 0,0:06:38.59,0:06:40.99,N,,0,0,0,,158
Dialogue: 0,0:06:38.59,0:06:40.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:38.59,0:06:40.99,T,,0,0,0,,Он убивает командира экспедиции.
Dialogue: 0,0:06:41.01,0:06:43.36,N,,0,0,0,,159
Dialogue: 0,0:06:41.01,0:06:43.36,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:41.01,0:06:43.36,T,,0,0,0,,Потом — следующего командира.
Dialogue: 0,0:06:43.38,0:06:46.72,N,,0,0,0,,160
Dialogue: 0,0:06:43.38,0:06:46.72,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:43.38,0:06:46.72,T,,0,0,0,,Он объявляет войну самому королю Испании.
Dialogue: 0,0:06:46.74,0:06:49.55,N,,0,0,0,,161
Dialogue: 0,0:06:46.74,0:06:49.55,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:46.74,0:06:49.55,T,,0,0,0,,Он называет себя «Гнев Божий».
Dialogue: 0,0:06:49.57,0:06:52.56,N,,0,0,0,,162
Dialogue: 0,0:06:49.57,0:06:52.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:49.57,0:06:52.56,T,,0,0,0,,Его люди боятся его больше, чем джунглей.
Dialogue: 0,0:06:52.58,0:06:55.50,N,,0,0,0,,163
Dialogue: 0,0:06:52.58,0:06:55.50,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:52.58,0:06:55.50,T,,0,0,0,,Каждого, кто сомневается, — убивают.
Dialogue: 0,0:06:55.52,0:07:00.86,N,,0,0,0,,164
Dialogue: 0,0:06:55.52,0:07:00.86,W,,0,0,0,,рассказчик
Dialogue: 0,0:06:55.52,0:07:00.86,T,,0,0,0,,Когда солдаты короля наконец окружают Агирре, он делает самое страшное.
Dialogue: 0,0:07:00.88,0:07:03.56,N,,0,0,0,,165
Dialogue: 0,0:07:00.88,0:07:03.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:00.88,0:07:03.56,T,,0,0,0,,Он убивает собственную дочь.
Dialogue: 0,0:07:03.58,0:07:08.14,N,,0,0,0,,166
Dialogue: 0,0:07:03.58,0:07:08.14,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:03.58,0:07:08.14,T,,0,0,0,,Чтобы её, как он сказал, не называли дочерью предателя.
Dialogue: 0,0:07:08.16,0:07:11.10,N,,0,0,0,,167
Dialogue: 0,0:07:08.16,0:07:11.10,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:08.16,0:07:11.10,T,,0,0,0,,Вот что делала с людьми эта легенда.
Dialogue: 0,0:07:11.12,0:07:14.89,N,,0,0,0,,168
Dialogue: 0,0:07:11.12,0:07:14.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:11.12,0:07:14.89,T,,0,0,0,,Но были и те, кто решил не идти за Эльдорадо в джунгли.
Dialogue: 0,0:07:14.91,0:07:20.07,N,,0,0,0,,169
Dialogue: 0,0:07:14.91,0:07:20.07,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:14.91,0:07:20.07,T,,0,0,0,,Они решили забрать его золото прямо со дна.
Dialogue: 0,0:07:20.09,0:07:26.21,N,,0,0,0,,170
Dialogue: 0,0:07:20.09,0:07:26.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:20.09,0:07:26.21,T,,0,0,0,,Если правители бросали золото в озеро Гуатавита — значит, оно всё ещё там.
Dialogue: 0,0:07:26.23,0:07:33.02,N,,0,0,0,,171
Dialogue: 0,0:07:26.23,0:07:33.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:26.23,0:07:33.02,T,,0,0,0,,Около тысяча пятьсот восьмидесятого года богатый купец Антонио де Сепульведа берётся за дело.
Dialogue: 0,0:07:33.04,0:07:37.31,N,,0,0,0,,172
Dialogue: 0,0:07:33.04,0:07:37.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:33.04,0:07:37.31,T,,0,0,0,,Тысячи рабочих прорубают огромную выемку в краю озера.
Dialogue: 0,0:07:37.33,0:07:39.08,N,,0,0,0,,173
Dialogue: 0,0:07:37.33,0:07:39.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:37.33,0:07:39.08,T,,0,0,0,,Вода уходит.
Dialogue: 0,0:07:39.10,0:07:41.70,N,,0,0,0,,174
Dialogue: 0,0:07:39.10,0:07:41.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:39.10,0:07:41.70,T,,0,0,0,,Уровень падает на двадцать метров.
Dialogue: 0,0:07:41.72,0:07:43.94,N,,0,0,0,,175
Dialogue: 0,0:07:41.72,0:07:43.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:41.72,0:07:43.94,T,,0,0,0,,И на дне — золото.
Dialogue: 0,0:07:43.96,0:07:45.24,N,,0,0,0,,176
Dialogue: 0,0:07:43.96,0:07:45.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:43.96,0:07:45.24,T,,0,0,0,,Украшения.
Dialogue: 0,0:07:45.26,0:07:48.20,N,,0,0,0,,177
Dialogue: 0,0:07:45.26,0:07:48.20,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:45.26,0:07:48.20,T,,0,0,0,,Изумруд размером с куриное яйцо.
Dialogue: 0,0:07:48.22,0:07:51.18,N,,0,0,0,,178
Dialogue: 0,0:07:48.22,0:07:51.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:48.22,0:07:51.18,T,,0,0,0,,Но тут стенка выемки обрушивается.
Dialogue: 0,0:07:51.20,0:07:52.86,N,,0,0,0,,179
Dialogue: 0,0:07:51.20,0:07:52.86,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:51.20,0:07:52.86,T,,0,0,0,,Рабочих засыпает.
Dialogue: 0,0:07:52.88,0:07:55.03,N,,0,0,0,,180
Dialogue: 0,0:07:52.88,0:07:55.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:52.88,0:07:55.03,T,,0,0,0,,Озеро снова наполняется.
Dialogue: 0,0:07:55.05,0:07:57.53,N,,0,0,0,,181
Dialogue: 0,0:07:55.05,0:07:57.53,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:55.05,0:07:57.53,T,,0,0,0,,Сепульведа умирает бедным.
Dialogue: 0,0:07:57.55,0:08:00.79,N,,0,0,0,,182
Dialogue: 0,0:07:57.55,0:08:00.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:07:57.55,0:08:00.79,T,,0,0,0,,А выемка в краю озера видна до сих пор.
Dialogue: 0,0:08:00.81,0:08:03.18,N,,0,0,0,,183
Dialogue: 0,0:08:00.81,0:08:03.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:00.81,0:08:03.18,T,,0,0,0,,Её можно увидеть со спутника.
Dialogue: 0,0:08:03.20,0:08:05.01,N,,0,0,0,,184
Dialogue: 0,0:08:03.20,0:08:05.01,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:03.20,0:08:05.01,T,,0,0,0,,Проходит триста лет.
Dialogue: 0,0:08:05.03,0:08:07.58,N,,0,0,0,,185
Dialogue: 0,0:08:05.03,0:08:07.58,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:05.03,0:08:07.58,T,,0,0,0,,Англичане покупают права на озеро.
Dialogue: 0,0:08:07.60,0:08:12.79,N,,0,0,0,,186
Dialogue: 0,0:08:07.60,0:08:12.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:07.60,0:08:12.79,T,,0,0,0,,Они роют туннель и почти полностью осушают Гуатавиту.
Dialogue: 0,0:08:12.81,0:08:14.49,N,,0,0,0,,187
Dialogue: 0,0:08:12.81,0:08:14.49,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:12.81,0:08:14.49,T,,0,0,0,,На дне — толстый слой ила.
Dialogue: 0,0:08:14.51,0:08:16.67,N,,0,0,0,,188
Dialogue: 0,0:08:14.51,0:08:16.67,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:14.51,0:08:16.67,T,,0,0,0,,Ходить по нему невозможно.
Dialogue: 0,0:08:16.69,0:08:19.23,N,,0,0,0,,189
Dialogue: 0,0:08:16.69,0:08:19.23,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:16.69,0:08:19.23,T,,0,0,0,,Они ждут, пока солнце его подсушит.
Dialogue: 0,0:08:19.25,0:08:22.15,N,,0,0,0,,190
Dialogue: 0,0:08:19.25,0:08:22.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:19.25,0:08:22.15,T,,0,0,0,,А солнце превращает ил в камень.
Dialogue: 0,0:08:22.17,0:08:24.19,N,,0,0,0,,191
Dialogue: 0,0:08:22.17,0:08:24.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:22.17,0:08:24.19,T,,0,0,0,,Твёрдый, как бетон.
Dialogue: 0,0:08:24.21,0:08:28.00,N,,0,0,0,,192
Dialogue: 0,0:08:24.21,0:08:28.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:24.21,0:08:28.00,T,,0,0,0,,За всё время они достают около шестидесяти предметов.
Dialogue: 0,0:08:28.02,0:08:30.42,N,,0,0,0,,193
Dialogue: 0,0:08:28.02,0:08:30.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:28.02,0:08:30.42,T,,0,0,0,,И продают их с аукциона в Лондоне.
Dialogue: 0,0:08:30.44,0:08:33.04,N,,0,0,0,,194
Dialogue: 0,0:08:30.44,0:08:33.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:30.44,0:08:33.04,T,,0,0,0,,Денег не хватает даже на расходы.
Dialogue: 0,0:08:33.06,0:08:35.21,N,,0,0,0,,195
Dialogue: 0,0:08:33.06,0:08:35.21,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:33.06,0:08:35.21,T,,0,0,0,,Компания разоряется.
Dialogue: 0,0:08:35.23,0:08:40.33,N,,0,0,0,,196
Dialogue: 0,0:08:35.23,0:08:40.33,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:35.23,0:08:40.33,T,,0,0,0,,В тысяча девятьсот шестьдесят пятом году Колумбия запрещает трогать озеро.
Dialogue: 0,0:08:40.35,0:08:45.38,N,,0,0,0,,197
Dialogue: 0,0:08:40.35,0:08:45.38,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:40.35,0:08:45.38,T,,0,0,0,,Что ещё лежит на его дне — не знает никто.
Dialogue: 0,0:08:45.40,0:08:50.46,N,,0,0,0,,198
Dialogue: 0,0:08:45.40,0:08:50.46,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:45.40,0:08:50.46,T,,0,0,0,,А в Англии Эльдорадо искал один из самых знаменитых людей своего времени.
Dialogue: 0,0:08:50.48,0:08:52.56,N,,0,0,0,,199
Dialogue: 0,0:08:50.48,0:08:52.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:50.48,0:08:52.56,T,,0,0,0,,Сэр Уолтер Рэли.
Dialogue: 0,0:08:52.58,0:08:53.82,N,,0,0,0,,200
Dialogue: 0,0:08:52.58,0:08:53.82,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:52.58,0:08:53.82,T,,0,0,0,,Мореплаватель.
Dialogue: 0,0:08:53.84,0:08:54.66,N,,0,0,0,,201
Dialogue: 0,0:08:53.84,0:08:54.66,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:53.84,0:08:54.66,T,,0,0,0,,Поэт.
Dialogue: 0,0:08:54.68,0:08:56.60,N,,0,0,0,,202
Dialogue: 0,0:08:54.68,0:08:56.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:54.68,0:08:56.60,T,,0,0,0,,Любимец королевы.
Dialogue: 0,0:08:56.62,0:09:02.74,N,,0,0,0,,203
Dialogue: 0,0:08:56.62,0:09:02.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:08:56.62,0:09:02.74,T,,0,0,0,,В тысяча пятьсот девяносто пятом году он плывёт в Южную Америку, вверх по реке Ориноко.
Dialogue: 0,0:09:02.76,0:09:07.79,N,,0,0,0,,204
Dialogue: 0,0:09:02.76,0:09:07.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:02.76,0:09:07.79,T,,0,0,0,,Он ищет Маноа — золотой город на берегу огромного озера.
Dialogue: 0,0:09:07.81,0:09:09.69,N,,0,0,0,,205
Dialogue: 0,0:09:07.81,0:09:09.69,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:07.81,0:09:09.69,T,,0,0,0,,Он не находит ничего.
Dialogue: 0,0:09:09.71,0:09:13.51,N,,0,0,0,,206
Dialogue: 0,0:09:09.71,0:09:13.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:09.71,0:09:13.51,T,,0,0,0,,Но пишет книгу: Эльдорадо существует.
Dialogue: 0,0:09:13.53,0:09:15.43,N,,0,0,0,,207
Dialogue: 0,0:09:13.53,0:09:15.43,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:13.53,0:09:15.43,T,,0,0,0,,Я почти дошёл.
Dialogue: 0,0:09:15.45,0:09:16.87,N,,0,0,0,,208
Dialogue: 0,0:09:15.45,0:09:16.87,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:15.45,0:09:16.87,T,,0,0,0,,Проходят годы.
Dialogue: 0,0:09:16.89,0:09:18.78,N,,0,0,0,,209
Dialogue: 0,0:09:16.89,0:09:18.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:16.89,0:09:18.78,T,,0,0,0,,Рэли попадает в тюрьму.
Dialogue: 0,0:09:18.80,0:09:23.83,N,,0,0,0,,210
Dialogue: 0,0:09:18.80,0:09:23.83,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:18.80,0:09:23.83,T,,0,0,0,,Старый и больной, он уговаривает нового короля: отпусти меня.
Dialogue: 0,0:09:23.85,0:09:26.06,N,,0,0,0,,211
Dialogue: 0,0:09:23.85,0:09:26.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:23.85,0:09:26.06,T,,0,0,0,,Я привезу тебе золото.
Dialogue: 0,0:09:26.08,0:09:28.15,N,,0,0,0,,212
Dialogue: 0,0:09:26.08,0:09:28.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:26.08,0:09:28.15,T,,0,0,0,,Тысяча шестьсот семнадцатый год.
Dialogue: 0,0:09:28.17,0:09:29.92,N,,0,0,0,,213
Dialogue: 0,0:09:28.17,0:09:29.92,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:28.17,0:09:29.92,T,,0,0,0,,Вторая экспедиция.
Dialogue: 0,0:09:29.94,0:09:32.52,N,,0,0,0,,214
Dialogue: 0,0:09:29.94,0:09:32.52,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:29.94,0:09:32.52,T,,0,0,0,,Его люди нападают на испанский форт.
Dialogue: 0,0:09:32.54,0:09:35.05,N,,0,0,0,,215
Dialogue: 0,0:09:32.54,0:09:35.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:32.54,0:09:35.05,T,,0,0,0,,В бою погибает сын Рэли.
Dialogue: 0,0:09:35.07,0:09:36.88,N,,0,0,0,,216
Dialogue: 0,0:09:35.07,0:09:36.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:35.07,0:09:36.88,T,,0,0,0,,Золота нет.
Dialogue: 0,0:09:36.90,0:09:39.95,N,,0,0,0,,217
Dialogue: 0,0:09:36.90,0:09:39.95,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:36.90,0:09:39.95,T,,0,0,0,,Рэли возвращается домой с пустыми руками.
Dialogue: 0,0:09:39.97,0:09:44.41,N,,0,0,0,,218
Dialogue: 0,0:09:39.97,0:09:44.41,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:39.97,0:09:44.41,T,,0,0,0,,И в тысяча шестьсот восемнадцатом году ему отрубают голову.
Dialogue: 0,0:09:44.43,0:09:47.00,N,,0,0,0,,219
Dialogue: 0,0:09:44.43,0:09:47.00,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:44.43,0:09:47.00,T,,0,0,0,,Эльдорадо забрало и его.
Dialogue: 0,0:09:47.02,0:09:53.68,N,,0,0,0,,220
Dialogue: 0,0:09:47.02,0:09:53.68,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:47.02,0:09:53.68,T,,0,0,0,,Но спустя триста лет появится человек, который пойдёт ещё дальше.
Dialogue: 0,0:09:53.70,0:09:56.04,N,,0,0,0,,221
Dialogue: 0,0:09:53.70,0:09:56.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:53.70,0:09:56.04,T,,0,0,0,,Тысяча девятьсот двадцать пятый год.
Dialogue: 0,0:09:56.06,0:09:57.24,N,,0,0,0,,222
Dialogue: 0,0:09:56.06,0:09:57.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:56.06,0:09:57.24,T,,0,0,0,,Бразилия.
Dialogue: 0,0:09:57.26,0:09:59.99,N,,0,0,0,,223
Dialogue: 0,0:09:57.26,0:09:59.99,W,,0,0,0,,рассказчик
Dialogue: 0,0:09:57.26,0:09:59.99,T,,0,0,0,,Британский полковник Перси Фосетт.
Dialogue: 0,0:10:00.01,0:10:04.44,N,,0,0,0,,224
Dialogue: 0,0:10:00.01,0:10:04.44,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:00.01,0:10:04.44,T,,0,0,0,,Он десятки раз уходил в джунгли — и всегда возвращался.
Dialogue: 0,0:10:04.46,0:10:09.25,N,,0,0,0,,225
Dialogue: 0,0:10:04.46,0:10:09.25,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:04.46,0:10:09.25,T,,0,0,0,,Он уверен: в глубине Амазонии есть древний затерянный город.
Dialogue: 0,0:10:09.27,0:10:11.79,N,,0,0,0,,226
Dialogue: 0,0:10:09.27,0:10:11.79,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:09.27,0:10:11.79,T,,0,0,0,,Он называет его просто «Зет».
Dialogue: 0,0:10:11.81,0:10:14.29,N,,0,0,0,,227
Dialogue: 0,0:10:11.81,0:10:14.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:11.81,0:10:14.29,T,,0,0,0,,Он берёт с собой сына и его друга.
Dialogue: 0,0:10:14.31,0:10:15.83,N,,0,0,0,,228
Dialogue: 0,0:10:14.31,0:10:15.83,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:14.31,0:10:15.83,T,,0,0,0,,Никакой большой армии.
Dialogue: 0,0:10:15.85,0:10:17.01,N,,0,0,0,,229
Dialogue: 0,0:10:15.85,0:10:17.01,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:15.85,0:10:17.01,T,,0,0,0,,Только трое.
Dialogue: 0,0:10:17.03,0:10:20.97,N,,0,0,0,,230
Dialogue: 0,0:10:17.03,0:10:20.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:17.03,0:10:20.97,T,,0,0,0,,Последнее письмо жене: «Не беспокойся о неудаче».
Dialogue: 0,0:10:20.99,0:10:22.84,N,,0,0,0,,231
Dialogue: 0,0:10:20.99,0:10:22.84,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:20.99,0:10:22.84,T,,0,0,0,,Они уходят в джунгли.
Dialogue: 0,0:10:22.86,0:10:26.27,N,,0,0,0,,232
Dialogue: 0,0:10:22.86,0:10:26.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:22.86,0:10:26.27,T,,0,0,0,,И больше их никто никогда не видел.
Dialogue: 0,0:10:26.29,0:10:28.63,N,,0,0,0,,233
Dialogue: 0,0:10:26.29,0:10:28.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:26.29,0:10:28.63,T,,0,0,0,,Их искали десятки экспедиций.
Dialogue: 0,0:10:28.65,0:10:34.43,N,,0,0,0,,234
Dialogue: 0,0:10:28.65,0:10:34.43,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:28.65,0:10:34.43,T,,0,0,0,,По некоторым подсчётам, около ста человек погибли или пропали, пытаясь найти Фосетта.
Dialogue: 0,0:10:34.45,0:10:36.73,N,,0,0,0,,235
Dialogue: 0,0:10:34.45,0:10:36.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:34.45,0:10:36.73,T,,0,0,0,,Казалось, это конец истории.
Dialogue: 0,0:10:36.75,0:10:39.73,N,,0,0,0,,236
Dialogue: 0,0:10:36.75,0:10:39.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:36.75,0:10:39.73,T,,0,0,0,,Эльдорадо — просто сказка о жадности.
Dialogue: 0,0:10:39.75,0:10:44.31,N,,0,0,0,,237
Dialogue: 0,0:10:39.75,0:10:44.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:39.75,0:10:44.31,T,,0,0,0,,Но в двадцать первом веке у учёных появился новый инструмент.
Dialogue: 0,0:10:44.33,0:10:49.16,N,,0,0,0,,238
Dialogue: 0,0:10:44.33,0:10:49.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:44.33,0:10:49.16,T,,0,0,0,,И джунгли начали раскрывать свои секреты.
Dialogue: 0,0:10:49.18,0:10:50.33,N,,0,0,0,,239
Dialogue: 0,0:10:49.18,0:10:50.33,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:49.18,0:10:50.33,T,,0,0,0,,Лидар.
Dialogue: 0,0:10:50.35,0:10:53.02,N,,0,0,0,,240
Dialogue: 0,0:10:50.35,0:10:53.02,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:50.35,0:10:53.02,T,,0,0,0,,Самолёт стреляет в джунгли лазером.
Dialogue: 0,0:10:53.04,0:10:55.43,N,,0,0,0,,241
Dialogue: 0,0:10:53.04,0:10:55.43,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:53.04,0:10:55.43,T,,0,0,0,,Миллионы вспышек в секунду.
Dialogue: 0,0:10:55.45,0:10:58.89,N,,0,0,0,,242
Dialogue: 0,0:10:55.45,0:10:58.89,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:55.45,0:10:58.89,T,,0,0,0,,Часть лучей проходит сквозь листья до самой земли.
Dialogue: 0,0:10:58.91,0:11:03.12,N,,0,0,0,,243
Dialogue: 0,0:10:58.91,0:11:03.12,W,,0,0,0,,рассказчик
Dialogue: 0,0:10:58.91,0:11:03.12,T,,0,0,0,,И компьютер собирает картину: что лежит под деревьями.
Dialogue: 0,0:11:03.14,0:11:05.42,N,,0,0,0,,244
Dialogue: 0,0:11:03.14,0:11:05.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:03.14,0:11:05.42,T,,0,0,0,,Две тысячи двадцать четвёртый год.
Dialogue: 0,0:11:05.44,0:11:06.37,N,,0,0,0,,245
Dialogue: 0,0:11:05.44,0:11:06.37,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:05.44,0:11:06.37,T,,0,0,0,,Эквадор.
Dialogue: 0,0:11:06.39,0:11:08.43,N,,0,0,0,,246
Dialogue: 0,0:11:06.39,0:11:08.43,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:06.39,0:11:08.43,T,,0,0,0,,Долина реки Упано.
Dialogue: 0,0:11:08.45,0:11:10.36,N,,0,0,0,,247
Dialogue: 0,0:11:08.45,0:11:10.36,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:08.45,0:11:10.36,T,,0,0,0,,Учёные публикуют карту.
Dialogue: 0,0:11:10.38,0:11:12.56,N,,0,0,0,,248
Dialogue: 0,0:11:10.38,0:11:12.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:10.38,0:11:12.56,T,,0,0,0,,И не верят своим глазам.
Dialogue: 0,0:11:12.58,0:11:15.04,N,,0,0,0,,249
Dialogue: 0,0:11:12.58,0:11:15.04,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:12.58,0:11:15.04,T,,0,0,0,,Под джунглями — города.
Dialogue: 0,0:11:15.06,0:11:17.55,N,,0,0,0,,250
Dialogue: 0,0:11:15.06,0:11:17.55,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:15.06,0:11:17.55,T,,0,0,0,,Пять больших и десять поменьше.
Dialogue: 0,0:11:17.57,0:11:22.03,N,,0,0,0,,251
Dialogue: 0,0:11:17.57,0:11:22.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:17.57,0:11:22.03,T,,0,0,0,,Больше шести тысяч земляных платформ под дома и храмы.
Dialogue: 0,0:11:22.05,0:11:26.37,N,,0,0,0,,252
Dialogue: 0,0:11:22.05,0:11:26.37,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:22.05,0:11:26.37,T,,0,0,0,,Прямые широкие дороги, которые соединяют города между собой.
Dialogue: 0,0:11:26.39,0:11:27.17,N,,0,0,0,,253
Dialogue: 0,0:11:26.39,0:11:27.17,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:26.39,0:11:27.17,T,,0,0,0,,Поля.
Dialogue: 0,0:11:27.19,0:11:28.39,N,,0,0,0,,254
Dialogue: 0,0:11:27.19,0:11:28.39,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:27.19,0:11:28.39,T,,0,0,0,,Каналы.
Dialogue: 0,0:11:28.41,0:11:31.85,N,,0,0,0,,255
Dialogue: 0,0:11:28.41,0:11:31.85,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:28.41,0:11:31.85,T,,0,0,0,,Этим городам больше двух с половиной тысяч лет.
Dialogue: 0,0:11:31.87,0:11:35.19,N,,0,0,0,,256
Dialogue: 0,0:11:31.87,0:11:35.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:31.87,0:11:35.19,T,,0,0,0,,Их строили из земли и дерева, а не из камня.
Dialogue: 0,0:11:35.21,0:11:38.12,N,,0,0,0,,257
Dialogue: 0,0:11:35.21,0:11:38.12,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:35.21,0:11:38.12,T,,0,0,0,,Поэтому джунгли спрятали их так хорошо.
Dialogue: 0,0:11:38.14,0:11:42.29,N,,0,0,0,,258
Dialogue: 0,0:11:38.14,0:11:42.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:38.14,0:11:42.29,T,,0,0,0,,И это, говорят учёные, только верхушка айсберга.
Dialogue: 0,0:11:42.31,0:11:43.73,N,,0,0,0,,259
Dialogue: 0,0:11:42.31,0:11:43.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:42.31,0:11:43.73,T,,0,0,0,,Помнишь Орельяну?
Dialogue: 0,0:11:43.75,0:11:45.63,N,,0,0,0,,260
Dialogue: 0,0:11:43.75,0:11:45.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:43.75,0:11:45.63,T,,0,0,0,,Которого назвали лжецом?
Dialogue: 0,0:11:45.65,0:11:46.82,N,,0,0,0,,261
Dialogue: 0,0:11:45.65,0:11:46.82,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:45.65,0:11:46.82,T,,0,0,0,,Он не врал.
Dialogue: 0,0:11:46.84,0:11:48.88,N,,0,0,0,,262
Dialogue: 0,0:11:46.84,0:11:48.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:46.84,0:11:48.88,T,,0,0,0,,Многолюдные берега были.
Dialogue: 0,0:11:48.90,0:11:52.32,N,,0,0,0,,263
Dialogue: 0,0:11:48.90,0:11:52.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:48.90,0:11:52.32,T,,0,0,0,,Но вслед за испанцами в Америку пришли болезни.
Dialogue: 0,0:11:52.34,0:11:53.12,N,,0,0,0,,264
Dialogue: 0,0:11:52.34,0:11:53.12,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:52.34,0:11:53.12,T,,0,0,0,,Оспа.
Dialogue: 0,0:11:53.14,0:11:53.73,N,,0,0,0,,265
Dialogue: 0,0:11:53.14,0:11:53.73,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:53.14,0:11:53.73,T,,0,0,0,,Корь.
Dialogue: 0,0:11:53.75,0:11:54.75,N,,0,0,0,,266
Dialogue: 0,0:11:53.75,0:11:54.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:53.75,0:11:54.75,T,,0,0,0,,Грипп.
Dialogue: 0,0:11:54.77,0:11:57.22,N,,0,0,0,,267
Dialogue: 0,0:11:54.77,0:11:57.22,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:54.77,0:11:57.22,T,,0,0,0,,Они бежали по рекам быстрее людей.
Dialogue: 0,0:11:57.24,0:12:01.64,N,,0,0,0,,268
Dialogue: 0,0:11:57.24,0:12:01.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:11:57.24,0:12:01.64,T,,0,0,0,,И выкосили целые народы ещё до того, как их кто-то увидел.
Dialogue: 0,0:12:01.66,0:12:08.29,N,,0,0,0,,269
Dialogue: 0,0:12:01.66,0:12:08.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:01.66,0:12:08.29,T,,0,0,0,,Когда пришли следующие экспедиции — джунгли уже съели пустые деревни.
Dialogue: 0,0:12:08.31,0:12:10.37,N,,0,0,0,,270
Dialogue: 0,0:12:08.31,0:12:10.37,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:08.31,0:12:10.37,T,,0,0,0,,Так где же Эльдорадо?
Dialogue: 0,0:12:10.39,0:12:13.05,N,,0,0,0,,271
Dialogue: 0,0:12:10.39,0:12:13.05,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:10.39,0:12:13.05,T,,0,0,0,,Вот три главные версии.
Dialogue: 0,0:12:13.07,0:12:14.64,N,,0,0,0,,272
Dialogue: 0,0:12:13.07,0:12:14.64,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:13.07,0:12:14.64,T,,0,0,0,,Версия А.
Dialogue: 0,0:12:14.66,0:12:16.90,N,,0,0,0,,273
Dialogue: 0,0:12:14.66,0:12:16.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:14.66,0:12:16.90,T,,0,0,0,,Эльдорадо — это обряд.
Dialogue: 0,0:12:16.92,0:12:19.57,N,,0,0,0,,274
Dialogue: 0,0:12:16.92,0:12:19.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:16.92,0:12:19.57,T,,0,0,0,,Золотой человек на озере Гуатавита.
Dialogue: 0,0:12:19.59,0:12:21.58,N,,0,0,0,,275
Dialogue: 0,0:12:19.59,0:12:21.58,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:19.59,0:12:21.58,T,,0,0,0,,Города никогда не было.
Dialogue: 0,0:12:21.60,0:12:27.98,N,,0,0,0,,276
Dialogue: 0,0:12:21.60,0:12:27.98,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:21.60,0:12:27.98,T,,0,0,0,,А главное золото до сих пор лежит на дне озера, которое теперь запрещено трогать.
Dialogue: 0,0:12:28.00,0:12:29.56,N,,0,0,0,,277
Dialogue: 0,0:12:28.00,0:12:29.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:28.00,0:12:29.56,T,,0,0,0,,Версия Б.
Dialogue: 0,0:12:29.58,0:12:33.06,N,,0,0,0,,278
Dialogue: 0,0:12:29.58,0:12:33.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:29.58,0:12:33.06,T,,0,0,0,,Эльдорадо — это настоящие города Амазонии.
Dialogue: 0,0:12:33.08,0:12:35.97,N,,0,0,0,,279
Dialogue: 0,0:12:33.08,0:12:35.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:33.08,0:12:35.97,T,,0,0,0,,Не из золота, а из земли и дерева.
Dialogue: 0,0:12:35.99,0:12:37.60,N,,0,0,0,,280
Dialogue: 0,0:12:35.99,0:12:37.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:35.99,0:12:37.60,T,,0,0,0,,Их видел Орельяна.
Dialogue: 0,0:12:37.62,0:12:39.08,N,,0,0,0,,281
Dialogue: 0,0:12:37.62,0:12:39.08,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:37.62,0:12:39.08,T,,0,0,0,,Их убили болезни.
Dialogue: 0,0:12:39.10,0:12:42.68,N,,0,0,0,,282
Dialogue: 0,0:12:39.10,0:12:42.68,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:39.10,0:12:42.68,T,,0,0,0,,И сейчас лидар находит их один за другим.
Dialogue: 0,0:12:42.70,0:12:44.24,N,,0,0,0,,283
Dialogue: 0,0:12:42.70,0:12:44.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:42.70,0:12:44.24,T,,0,0,0,,Версия В.
Dialogue: 0,0:12:44.26,0:12:46.68,N,,0,0,0,,284
Dialogue: 0,0:12:44.26,0:12:46.68,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:44.26,0:12:46.68,T,,0,0,0,,Эльдорадо ещё не найдено.
Dialogue: 0,0:12:46.70,0:12:53.32,N,,0,0,0,,285
Dialogue: 0,0:12:46.70,0:12:53.32,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:46.70,0:12:53.32,T,,0,0,0,,Легенды говорят о Пайтити — последнем убежище инков, куда они унесли своё золото от испанцев.
Dialogue: 0,0:12:53.34,0:12:56.62,N,,0,0,0,,286
Dialogue: 0,0:12:53.34,0:12:56.62,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:53.34,0:12:56.62,T,,0,0,0,,Где-то на границе Перу, Боливии и Бразилии.
Dialogue: 0,0:12:56.64,0:13:00.75,N,,0,0,0,,287
Dialogue: 0,0:12:56.64,0:13:00.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:12:56.64,0:13:00.75,T,,0,0,0,,В джунглях, куда до сих пор не добрался ни один лазер.
Dialogue: 0,0:13:00.77,0:13:03.63,N,,0,0,0,,288
Dialogue: 0,0:13:00.77,0:13:03.63,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:00.77,0:13:03.63,T,,0,0,0,,Пятьсот лет люди искали золотой город.
Dialogue: 0,0:13:03.65,0:13:06.94,N,,0,0,0,,289
Dialogue: 0,0:13:03.65,0:13:06.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:03.65,0:13:06.94,T,,0,0,0,,Может быть, они просто искали не то.
Dialogue: 0,0:13:06.96,0:13:08.78,N,,0,0,0,,290
Dialogue: 0,0:13:06.96,0:13:08.78,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:06.96,0:13:08.78,T,,0,0,0,,А ты как думаешь?
Dialogue: 0,0:13:08.80,0:13:10.30,N,,0,0,0,,291
Dialogue: 0,0:13:08.80,0:13:10.30,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:08.80,0:13:10.30,T,,0,0,0,,А, Б или В?
Dialogue: 0,0:13:10.32,0:13:16.74,N,,0,0,0,,292
Dialogue: 0,0:13:10.32,0:13:16.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:13:10.32,0:13:16.74,T,,0,0,0,,Напиши букву в комментариях.
