   "who": "eva",
   "fx": "volume=2.147,highpass=f=260,lowpass=f=7000,aecho=0.6:0.35:18:0.18"
  },
  {
   "src": "D_DIANAa.mp3",
   "t0": 10.45,
   "t1": 12.68,
