{
 "dir": "public/mary-celeste/el",
 "lead": 3.0,
 "tail": 10.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0,
   "t1": 3.15,
   "say": "Четвёртое декабря тысяча восемьсот семьдесят второго.",
   "gap": 0.32,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 3.37,
   "t1": 4.75,
   "say": "Атлантический океан.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 5.05,
   "t1": 7.63,
   "say": "Между Азорскими островами и Португалией.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 8.11,
   "t1": 12.26,
   "say": "Моряки с брига «Деи Грация» замечают на горизонте парусник.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.66,
   "t1": 13.79,
   "say": "Он идёт странно.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.14,
   "t1": 14.83,
   "say": "Рыскает.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 15.18,
   "t1": 17.11,
   "say": "То в одну сторону, то в другую.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 17.48,
   "t1": 19.2,
   "say": "Как будто им никто не управляет.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 19.79,
   "t1": 20.92,
   "say": "Они подают сигнал.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 21.29,
   "t1": 21.94,
   "say": "Ответа нет.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.51,
   "t1": 25.32,
   "say": "Тогда они спускают лодку и поднимаются на борт.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 25.71,
   "t1": 27.28,
   "say": "На палубе — никого.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 27.73,
   "t1": 29.29,
   "say": "У руля — никого.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 29.73,
   "t1": 34.02,
   "say": "В каютах — одежда, обувь, личные вещи.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 34.18,
   "t1": 34.74,
   "say": "В трюме — груз.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.13,
   "t1": 36.33,
   "say": "Почти всё на месте.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 36.66,
   "t1": 37.86,
   "say": "Нет только людей.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 38.24,
   "t1": 39.97,
   "say": "И нет единственной шлюпки.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 40.49,
   "t1": 42.61,
   "say": "На этом корабле было десять человек.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 42.94,
   "t1": 46.82,
   "say": "Капитан, его жена, их двухлетняя дочь и семь моряков.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 47.33,
   "t1": 49.94,
   "say": "Их больше никто никогда не видел.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 50.42,
   "t1": 52.64,
   "say": "Корабль назывался «Мэри Селест».",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 53.2,
   "t1": 56.18,
   "say": "Полтора века люди спорят, что здесь случилось.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 56.56,
   "t1": 58.01,
   "say": "Давай разберёмся по порядку.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 58.34,
   "t1": 62.2,
   "say": "По судовому журналу, по показаниям моряков, по документам суда.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 62.53,
   "t1": 64.83,
   "say": "И отделим правду от легенд.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 65.2,
   "t1": 67.53,
   "say": "Их вокруг этого корабля очень много.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 67.95,
   "t1": 70.29,
   "say": "А в конце — три главные версии.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 70.51,
   "t1": 73.52,
   "say": "И ты решишь, какая из них ближе к правде.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0,
   "t1": 3.6,
   "say": "Эта история начинается за одиннадцать лет до того дня.",
   "gap": 0.59,
   "who": "narrator",
   "chapter": "1. «Амазон»"
  },
  {
   "src": "ch1.mp3",
   "t0": 4.09,
   "t1": 6.25,
   "say": "Тысяча восемьсот шестьдесят первый год.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 6.53,
   "t1": 8.42,
   "say": "Канада, Новая Шотландия.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 8.72,
   "t1": 11.06,
   "say": "Маленький остров Спенсерс-Айленд.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 11.52,
   "t1": 15.01,
   "say": "Здесь местные корабелы строят двухмачтовый парусник.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.29,
   "t1": 16.96,
   "say": "Его называют «Амазон».",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 17.31,
   "t1": 20.73,
   "say": "Обычное торговое судно, около тридцати метров в длину.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 21.25,
   "t1": 25.1,
   "say": "В первом же рейсе тяжело заболевает и умирает его капитан.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 25.57,
   "t1": 28.86,
   "say": "Позже моряки будут вспоминать это как дурной знак.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 29.51,
   "t1": 32.62,
   "say": "Несколько лет судно возит грузы и меняет хозяев.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 33.08,
   "t1": 37.14,
   "say": "В конце тысяча восемьсот шестьдесят восьмого его покупают американцы.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 37.42,
   "t1": 40.25,
   "say": "И дают новое имя — «Мэри Селест».",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 40.88,
   "t1": 44.63,
   "say": "Весной тысяча восемьсот семьдесят второго корабль перестраивают.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 44.89,
   "t1": 47.72,
   "say": "Он становится больше, получает вторую палубу.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 48.17,
   "t1": 51.72,
   "say": "Среди совладельцев — опытный капитан Бенджамин Бриггс.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.01,
   "t1": 54.05,
   "say": "Он вложил в судно свои сбережения.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 54.34,
   "t1": 56.68,
   "say": "И сам поведёт его в большой рейс.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 56.91,
   "t1": 57.98,
   "say": "Через Атлантику.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 58.16,
   "t1": 58.86,
   "say": "В Италию.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0.01,
   "t1": 2.04,
   "say": "Капитану Бриггсу тридцать семь лет.",
   "gap": 0.46,
   "who": "narrator",
   "chapter": "2. Десять"
  },
  {
   "src": "ch2.mp3",
   "t0": 2.4,
   "t1": 5.45,
   "say": "Он из семьи моряков и ходит в море с юности.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 5.87,
   "t1": 8.86,
   "say": "Его знают как спокойного и верующего человека.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 9.26,
   "t1": 10.98,
   "say": "По вечерам он читает Библию.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 11.52,
   "t1": 15.63,
   "say": "В этот рейс он берёт с собой жену Сару и двухлетнюю дочь Софью.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 16.01,
   "t1": 17.55,
   "say": "Их сыну Артуру семь.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 17.86,
   "t1": 20.81,
   "say": "Ему пора в школу, и он остаётся дома, у бабушки.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 21.4,
   "t1": 23.0,
   "say": "Команда — семь человек.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 23.36,
   "t1": 25.8,
   "say": "Старший помощник Альберт Ричардсон.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 26.15,
   "t1": 28.24,
   "say": "Второй помощник Эндрю Гиллинг.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 28.64,
   "t1": 30.18,
   "say": "Стюард Эдвард Хед.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 30.61,
   "t1": 33.47,
   "say": "И четыре матроса — немцы с Фризских островов.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 33.84,
   "t1": 37.44,
   "say": "Братья Лоренцен, Ариан Мартенс и Готлиб Гудшаал.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 38.0,
   "t1": 41.06,
   "say": "В трюме — тысяча семьсот одна бочка спирта.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.3,
   "t1": 42.88,
   "say": "Технического, не для питья.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 43.33,
   "t1": 44.66,
   "say": "Груз для Генуи.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 44.97,
   "t1": 48.52,
   "say": "Это больше семи тысяч километров по зимнему океану.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 48.77,
   "t1": 50.15,
   "say": "Почти месяц пути.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 50.83,
   "t1": 56.19,
   "say": "Пятого ноября тысяча восемьсот семьдесят второго «Мэри Селест» отходит от причала в Нью-Йорке.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 56.58,
   "t1": 59.94,
   "say": "Два дня стоит у острова Статен-Айленд и ждёт погоды.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 60.43,
   "t1": 62.81,
   "say": "Седьмого ноября она выходит в океан.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 63.38,
   "t1": 68.62,
   "say": "А через неделю из соседнего порта уходит другое судно — бриг «Деи Грация».",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 68.92,
   "t1": 70.74,
   "say": "Капитан — Дэвид Морхаус.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 71.08,
   "t1": 72.6,
   "say": "Курс у него почти тот же.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 72.75,
   "t1": 74.59,
   "say": "Через Атлантику, на Гибралтар.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 75.14,
   "t1": 78.11,
   "say": "Этим двум кораблям ещё предстоит встретиться.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0,
   "t1": 1.39,
   "say": "Рейс идёт обычно.",
   "gap": 0.46,
   "who": "narrator",
   "chapter": "3. Тишина"
  },
  {
   "src": "ch3.mp3",
   "t0": 1.75,
   "t1": 5.0,
   "say": "Ветер, волны, холодный ноябрьский океан.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 5.47,
   "t1": 6.83,
   "say": "На корабле ведут журнал.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 7.17,
   "t1": 10.78,
   "say": "Каждые несколько часов — курс, ветер, расстояние.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 11.35,
   "t1": 16.13,
   "say": "Двадцать пятого ноября, в восемь утра, в журнале появляется очередная запись.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 16.63,
   "t1": 19.72,
   "say": "«Мэри Селест» проходит мимо острова Санта-Мария.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 20.02,
   "t1": 22.59,
   "say": "Это Азорские острова, посреди Атлантики.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 22.92,
   "t1": 24.31,
   "say": "Земля видна с борта.",
   "gap": 0.86,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 25.07,
   "t1": 26.64,
   "say": "Это последняя запись.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 26.99,
   "t1": 28.44,
   "say": "После неё — пусто.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 28.9,
   "t1": 30.25,
   "say": "Ни слова о шторме.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 30.42,
   "t1": 31.75,
   "say": "Ни слова о беде.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 32.04,
   "t1": 35.44,
   "say": "Ни слова о том, что кто-то собирается покинуть корабль.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 36.01,
   "t1": 38.37,
   "say": "Что случилось дальше, не знает никто.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 38.83,
   "t1": 40.17,
   "say": "Мы знаем только одно.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 40.57,
   "t1": 43.7,
   "say": "Через девять дней корабль нашли посреди океана.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 44.07,
   "t1": 44.73,
   "say": "Без людей.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0,
   "t1": 1.18,
   "say": "Четвёртое декабря.",
   "gap": 0.4,
   "who": "narrator",
   "chapter": "4. Находка"
  },
  {
   "src": "ch4.mp3",
   "t0": 1.48,
   "t1": 2.6,
   "say": "Около часа дня.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 3.14,
   "t1": 5.49,
   "say": "С «Деи Грации» замечают парусник.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 5.89,
   "t1": 8.4,
   "say": "Капитан Морхаус смотрит в подзорную трубу.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 8.75,
   "t1": 11.55,
   "say": "Судно идёт под частью парусов и рыскает.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 11.95,
   "t1": 13.73,
   "say": "На палубе никого не видно.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 13.95,
   "t1": 15.95,
   "say": "На сигналы никто не отвечает.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 16.47,
   "t1": 23.35,
   "say": "Старший помощник Оливер Дево и ещё двое моряков садятся в лодку и поднимаются на борт.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 23.58,
   "t1": 25.6,
   "say": "На корме — имя: «Мэри Селест».",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 26.05,
   "t1": 27.11,
   "say": "Вот что они видят.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 27.57,
   "t1": 30.37,
   "say": "Паруса частью подняты, частью порваны.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 30.62,
   "t1": 32.0,
   "say": "Снасти повреждены.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 32.28,
   "t1": 33.69,
   "say": "Два люка открыты.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 33.98,
   "t1": 35.96,
   "say": "В трюме — около метра воды.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 36.33,
   "t1": 36.88,
   "say": "Много.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 37.19,
   "t1": 40.4,
   "say": "Но корабль держится на плаву и тонуть не собирается.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 40.74,
   "t1": 42.38,
   "say": "Один из насосов разобран.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 42.59,
   "t1": 47.45,
   "say": "На палубе лежит самодельный футшток — палка, которой меряют, сколько воды в трюме.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 47.8,
   "t1": 50.56,
   "say": "Компас сдвинут, стекло на нём разбито.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 50.84,
   "t1": 51.97,
   "say": "Шлюпки нет.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 52.25,
   "t1": 53.43,
   "say": "Нет судовых бумаг.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 53.62,
   "t1": 55.77,
   "say": "Нет навигационных приборов капитана.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 56.11,
   "t1": 58.01,
   "say": "А личные вещи — на месте.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 58.33,
   "t1": 58.99,
   "say": "Одежда.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 59.22,
   "t1": 59.6,
   "say": "Обувь.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 60.02,
   "t1": 62.37,
   "say": "У капитана под кроватью — сабля в ножнах.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 62.68,
   "t1": 64.72,
   "say": "Еды и воды на борту много.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 65.05,
   "t1": 66.37,
   "say": "Следов драки нет.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 66.65,
   "t1": 68.13,
   "say": "Следов пожара нет.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 68.57,
   "t1": 70.5,
   "say": "Похоже, люди ушли быстро.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 70.69,
   "t1": 74.62,
   "say": "Сели в маленькую шлюпку и оставили большой крепкий корабль.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 75.13,
   "t1": 75.67,
   "say": "Подумай.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 76.08,
   "t1": 81.3,
   "say": "Капитан берёт жену и двухлетнюю дочь и пересаживается с корабля в маленькую лодку.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 81.55,
   "t1": 82.88,
   "say": "Посреди Атлантики.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 83.08,
   "t1": 84.1,
   "say": "В конце ноября.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 84.48,
   "t1": 89.65,
   "say": "Что должно было случиться, чтобы опытный моряк решил, что в лодке безопаснее?",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 90.16,
   "t1": 93.92,
   "say": "Моряки «Деи Грации» решают: корабль можно спасти.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 94.33,
   "t1": 97.34,
   "say": "Дево и двое матросов остаются на «Мэри Селест».",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 97.72,
   "t1": 99.69,
   "say": "Два судна идут к Гибралтару.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 100.08,
   "t1": 103.8,
   "say": "За спасение брошенного корабля по закону положена награда.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0.01,
   "t1": 1.27,
   "say": "Тринадцатое декабря.",
   "gap": 0.59,
   "who": "narrator",
   "chapter": "5. Гибралтар"
  },
  {
   "src": "ch5.mp3",
   "t0": 1.76,
   "t1": 4.23,
   "say": "«Мэри Селест» входит в порт Гибралтара.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 4.52,
   "t1": 6.35,
   "say": "Начинается суд о спасении.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 6.77,
   "t1": 9.72,
   "say": "И тут дело принимает неожиданный оборот.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 10.17,
   "t1": 15.22,
   "say": "Генеральный прокурор Гибралтара Фредерик Солли-Флуд уверен: это преступление.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 15.46,
   "t1": 16.85,
   "say": "Он подозревает всех.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 17.24,
   "t1": 20.68,
   "say": "Может, экипаж напился спирта из груза и убил капитана?",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 21.0,
   "t1": 23.75,
   "say": "Может, это дело рук спасателей — ради награды?",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 24.29,
   "t1": 27.8,
   "say": "Флуд находит на борту отметины, похожие на удары топора.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 28.14,
   "t1": 31.02,
   "say": "А на сабле капитана — пятна, похожие на кровь.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 31.54,
   "t1": 36.36,
   "say": "Он подозревает даже владельца судна, Джеймса Уинчестера, который приехал в Гибралтар.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 36.58,
   "t1": 39.71,
   "say": "И требует с него залог — пятнадцать тысяч долларов.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 40.33,
   "t1": 43.51,
   "say": "Моряков «Деи Грации» допрашивают снова и снова.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 43.77,
   "t1": 46.39,
   "say": "Особенно Дево — он первым поднялся на борт.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 46.88,
   "t1": 50.15,
   "say": "Но проверка показывает: пятна на сабле — не кровь.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 50.61,
   "t1": 53.55,
   "say": "Пить технический спирт из груза тоже было нельзя.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 53.92,
   "t1": 56.0,
   "say": "Доказательств преступления нет.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 56.41,
   "t1": 58.15,
   "say": "Никого так и не обвинили.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 58.72,
   "t1": 63.08,
   "say": "Восьмого апреля тысяча восемьсот семьдесят третьего года суд выносит решение.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 63.39,
   "t1": 66.09,
   "say": "Спасатели получают тысячу семьсот фунтов.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 66.41,
   "t1": 69.23,
   "say": "Около пятой части стоимости корабля и груза.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 69.72,
   "t1": 72.2,
   "say": "Потом «Мэри Селест» доходит до Генуи.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 72.46,
   "t1": 73.51,
   "say": "Груз выгружают.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 73.89,
   "t1": 75.8,
   "say": "И находят ещё одну деталь.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 76.2,
   "t1": 79.68,
   "say": "Девять бочек из тысячи семисот одной — пустые.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 80.03,
   "t1": 81.56,
   "say": "Спирт из них протёк.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 82.1,
   "t1": 83.7,
   "say": "Запомни эти девять бочек.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 84.02,
   "t1": 86.18,
   "say": "Они ещё понадобятся нам в этой истории.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0.03,
   "t1": 1.47,
   "say": "Прошло двенадцать лет.",
   "gap": 0.5,
   "who": "narrator",
   "chapter": "6. Мифы"
  },
  {
   "src": "ch6.mp3",
   "t0": 1.87,
   "t1": 3.45,
   "say": "История почти забылась.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 3.93,
   "t1": 9.5,
   "say": "А в январе тысяча восемьсот восемьдесят четвёртого года в английском журнале выходит рассказ.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 9.94,
   "t1": 13.38,
   "say": "Автор — молодой врач по имени Артур Конан Дойл.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 13.88,
   "t1": 15.98,
   "say": "Шерлока Холмса он ещё не придумал.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 16.4,
   "t1": 18.87,
   "say": "В рассказе корабль зовут «Мари Селест».",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 19.24,
   "t1": 20.79,
   "say": "Капитана зовут иначе.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 21.12,
   "t1": 24.77,
   "say": "А на борту — убийца, который расправляется с экипажем.",
   "gap": 0.72,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 25.39,
   "t1": 26.51,
   "say": "Это была выдумка.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 26.72,
   "t1": 28.84,
   "say": "Но многие приняли её за правду.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 29.26,
   "t1": 32.99,
   "say": "Именно оттуда пошли легенды, которые повторяют до сих пор.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 33.55,
   "t1": 34.85,
   "say": "Тёплый чай на столе.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 35.05,
   "t1": 36.31,
   "say": "Недоеденный завтрак.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 36.69,
   "t1": 38.8,
   "say": "Всё будто бросили секунду назад.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 39.45,
   "t1": 43.79,
   "say": "Ничего этого нет в показаниях моряков, которые первыми поднялись на борт.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 44.18,
   "t1": 50.0,
   "say": "Даже имя «Мари Селест», которое до сих пор встречается в книгах и статьях, — тоже из рассказа.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 50.42,
   "t1": 53.31,
   "say": "Поэтому дальше — только то, что есть в документах.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0,
   "t1": 2.56,
   "say": "Версий за полтора века — десятки.",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "7. Версии"
  },
  {
   "src": "ch7.mp3",
   "t0": 2.97,
   "t1": 9.14,
   "say": "Сам Оливер Дево, первым поднявшийся на борт, думал так: корабль попал под водяной смерч.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 9.45,
   "t1": 12.57,
   "say": "Из-за перепада давления вода поднялась в трубах насосов.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 13.05,
   "t1": 19.64,
   "say": "Экипаж замерил её, решил, что трюм затоплен и судно сейчас пойдёт ко дну, и в панике покинул его.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 20.12,
   "t1": 22.52,
   "say": "Кто-то говорил о подводном землетрясении.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 22.75,
   "t1": 25.3,
   "say": "Кто-то — даже о гигантском кальмаре.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 25.61,
   "t1": 29.29,
   "say": "Об этом в тысяча девятьсот четвёртом году писал один британский журнал.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 29.85,
   "t1": 32.82,
   "say": "Давай разберём три самые известные версии.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 33.01,
   "t1": 35.25,
   "say": "И что говорит за и против каждой.",
   "gap": 0.89,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 36.04,
   "t1": 37.17,
   "say": "Версия первая.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 37.59,
   "t1": 38.59,
   "say": "Пары спирта.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 39.08,
   "t1": 40.71,
   "say": "Помнишь девять пустых бочек?",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 41.04,
   "t1": 43.55,
   "say": "Спирт из них мог испаряться прямо в трюм.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 43.95,
   "t1": 49.06,
   "say": "Ещё в тысяча девятьсот десятом году появилась идея: в трюме вспыхнули пары.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 49.3,
   "t1": 50.4,
   "say": "Раздался хлопок.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 50.63,
   "t1": 52.12,
   "say": "Из люков пошёл запах.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 52.43,
   "t1": 55.35,
   "say": "Капитан решил, что сейчас взорвётся весь груз.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 55.57,
   "t1": 58.42,
   "say": "И приказал всем сесть в шлюпку и отойти подальше.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 59.0,
   "t1": 64.48,
   "say": "В две тысячи шестом году лондонский химик Андреа Селла проверил это на модели трюма.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 64.86,
   "t1": 67.71,
   "say": "Он поджёг газ, и по трюму прошла вспышка.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 68.04,
   "t1": 73.04,
   "say": "Ударная волна, пламя, но без гари и без следов огня на дереве.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 73.46,
   "t1": 78.86,
   "say": "Это могло бы объяснить и открытые люки, и спешку, и то, что корабль остался цел.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 79.27,
   "t1": 82.91,
   "say": "Но против: это опыт на модели, а не доказательство.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 83.19,
   "t1": 86.37,
   "say": "И ни одного следа взрыва на «Мэри Селест» не нашли.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 87.17,
   "t1": 88.32,
   "say": "Версия вторая.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 88.65,
   "t1": 89.29,
   "say": "Ошибка.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 89.77,
   "t1": 92.8,
   "say": "В две тысячи седьмом году вышел документальный фильм.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 93.1,
   "t1": 95.57,
   "say": "Его авторы сложили вместе три детали.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 96.03,
   "t1": 98.15,
   "say": "Первая: насос разобран.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 98.28,
   "t1": 99.88,
   "say": "Значит, с ним были проблемы.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 100.38,
   "t1": 102.55,
   "say": "Вторая: на палубе футшток.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 102.77,
   "t1": 104.97,
   "say": "Значит, кто-то мерил воду в трюме.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 105.49,
   "t1": 108.54,
   "say": "Третья: хронометр капитана мог ошибаться.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 108.84,
   "t1": 113.82,
   "say": "Тогда Бриггс думал, что корабль почти на двести километров западнее, чем на самом деле.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 114.4,
   "t1": 114.89,
   "say": "Представь.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 115.24,
   "t1": 116.5,
   "say": "Насос не работает.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 116.74,
   "t1": 118.19,
   "say": "Вода в трюме прибывает.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 118.53,
   "t1": 122.48,
   "say": "Капитан не знает точно, сколько её, и боится, что корабль тонет.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 122.82,
   "t1": 124.91,
   "say": "А рядом — остров Санта-Мария.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 125.13,
   "t1": 125.72,
   "say": "Земля.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 126.13,
   "t1": 129.05,
   "say": "Он решает: лучше доплыть до берега на шлюпке.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 129.41,
   "t1": 130.92,
   "say": "Но корабль не тонет.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 131.24,
   "t1": 134.18,
   "say": "А маленькую лодку в океане больше никто не видит.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 134.76,
   "t1": 137.19,
   "say": "Против: это только реконструкция.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 137.37,
   "t1": 139.82,
   "say": "Ни шлюпку, ни людей так и не нашли.",
   "gap": 0.87,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 140.59,
   "t1": 141.77,
   "say": "Версия третья.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 142.05,
   "t1": 142.94,
   "say": "Преступление.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 143.21,
   "t1": 143.88,
   "say": "Мятеж.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 144.06,
   "t1": 144.66,
   "say": "Пираты.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 145.0,
   "t1": 148.18,
   "say": "Или сговор с моряками «Деи Грации» ради награды.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 148.58,
   "t1": 150.78,
   "say": "Именно в это верил прокурор Флуд.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 151.21,
   "t1": 153.21,
   "say": "Но на борту не было следов борьбы.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 153.46,
   "t1": 155.48,
   "say": "Личные вещи остались на месте.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 155.78,
   "t1": 161.61,
   "say": "А «Деи Грация», по расчётам историков, шла медленнее и просто не смогла бы догнать «Мэри Селест».",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 162.02,
   "t1": 164.35,
   "say": "Суд не нашёл ни одной улики.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.02,
   "t1": 1.89,
   "say": "А что стало с самим кораблём?",
   "gap": 0.43,
   "who": "narrator",
   "chapter": "8. Финал"
  },
  {
   "src": "ch8.mp3",
   "t0": 2.22,
   "t1": 5.8,
   "say": "Его ещё двенадцать лет продают и перепродают.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 6.1,
   "t1": 8.08,
   "say": "Моряки не хотят на нём служить.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 8.55,
   "t1": 13.29,
   "say": "В тысяча восемьсот семьдесят девятом году умирает ещё один его капитан.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 13.65,
   "t1": 20.63,
   "say": "Это уже третий капитан этого корабля, который ушёл из жизни раньше времени.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.05,
   "t1": 23.08,
   "say": "Так рождается слух: «Мэри Селест» проклята.",
   "gap": 0.76,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 23.74,
   "t1": 32.53,
   "say": "Третьего января тысяча восемьсот восемьдесят пятого года капитан Гилман Паркер нарочно сажает «Мэри Селест» на риф у берегов Гаити.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 32.81,
   "t1": 34.29,
   "say": "Чтобы получить страховку.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 34.68,
   "t1": 38.58,
   "say": "Груз, который он застраховал как ценный, на деле стоил гроши.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 38.98,
   "t1": 40.15,
   "say": "Обман раскрывают.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 40.43,
   "t1": 44.27,
   "say": "Паркера судят, но присяжные так и не могут прийти к решению.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 44.65,
   "t1": 46.61,
   "say": "Через три месяца он умирает.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 47.15,
   "t1": 51.76,
   "say": "Корабль-призрак заканчивает свою жизнь уликой в деле о мошенничестве.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 52.32,
   "t1": 60.23,
   "say": "В две тысячи первом году экспедиция писателя Клайва Касслера объявила: на этом рифе нашли обломки «Мэри Селест».",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 60.7,
   "t1": 63.81,
   "say": "Но учёные посчитали годичные кольца в дереве.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 64.2,
   "t1": 69.94,
   "say": "Деревья, из которых сделаны эти доски, ещё росли в тысяча восемьсот девяносто четвёртом.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 70.14,
   "t1": 72.67,
   "say": "Почти через десять лет после крушения.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 72.98,
   "t1": 75.15,
   "say": "Значит, это был другой корабль.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 75.73,
   "t1": 77.52,
   "say": "Так что же мы знаем точно?",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 77.99,
   "t1": 83.62,
   "say": "Десять человек сели в маленькую шлюпку и оставили крепкий корабль посреди океана.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 84.02,
   "t1": 85.94,
   "say": "Одежду и вещи они не взяли.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 86.29,
   "t1": 88.44,
   "say": "Капитан забрал бумаги и приборы.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 88.58,
   "t1": 90.47,
   "say": "Значит, собирался куда-то плыть.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 90.81,
   "t1": 92.98,
   "say": "И больше их никто не видел.",
   "gap": 0.73,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 93.61,
   "t1": 94.97,
   "say": "Чего мы не знаем?",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 95.35,
   "t1": 97.22,
   "say": "Что заставило их уйти.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 97.87,
   "t1": 101.66,
   "say": "А ты как думаешь, что случилось на «Мэри Селест»?",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 102.05,
   "t1": 104.01,
   "say": "А — пары спирта и страх взрыва.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 104.47,
   "t1": 108.86,
   "say": "Б — ошибка: насос, вода в трюме и остров рядом.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 109.35,
   "t1": 111.01,
   "say": "В — преступление.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 111.55,
   "t1": 113.06,
   "say": "Напиши букву в комментариях.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 113.18,
   "t1": 114.61,
   "say": "Мы прочитаем каждый.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
