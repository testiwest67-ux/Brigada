Dialogue: 0,0:00:01.00,0:00:02.61,T,,0,0,0,,Ты снял квартиру.
Dialogue: 0,0:00:02.63,0:00:03.97,N,,0,0,0,,2
Dialogue: 0,0:00:02.63,0:00:03.97,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:02.63,0:00:03.97,T,,0,0,0,,Очень дёшево.
Dialogue: 0,0:00:03.99,0:00:06.42,N,,0,0,0,,3
Dialogue: 0,0:00:03.99,0:00:06.42,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:03.99,0:00:06.42,T,,0,0,0,,Прошлый жилец съехал за одну ночь.
Dialogue: 0,0:00:06.44,0:00:10.80,N,,0,0,0,,4
Dialogue: 0,0:00:06.44,0:00:10.80,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:06.44,0:00:10.80,T,,0,0,0,,Оставил всё: кровать, вещи и умную колонку.
Dialogue: 0,0:00:10.82,0:00:12.48,N,,0,0,0,,5
Dialogue: 0,0:00:10.82,0:00:12.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:10.82,0:00:12.48,T,,0,0,0,,Ты включаешь колонку.
Dialogue: 0,0:00:12.50,0:00:14.48,N,,0,0,0,,6
Dialogue: 0,0:00:12.50,0:00:14.48,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:12.50,0:00:14.48,T,,0,0,0,,Кольцо загорается.
Dialogue: 0,0:00:14.50,0:00:15.21,N,,0,0,0,,7
Dialogue: 0,0:00:14.50,0:00:15.21,W,,0,0,0,,Диана
Dialogue: 0,0:00:14.50,0:00:15.21,T,,0,0,0,,Привет.
Dialogue: 0,0:00:15.23,0:00:16.33,N,,0,0,0,,8
Dialogue: 0,0:00:15.23,0:00:16.33,W,,0,0,0,,Диана
Dialogue: 0,0:00:15.23,0:00:16.33,T,,0,0,0,,Я Диана.
Dialogue: 0,0:00:16.35,0:00:18.60,N,,0,0,0,,9
Dialogue: 0,0:00:16.35,0:00:18.60,W,,0,0,0,,Диана
Dialogue: 0,0:00:16.35,0:00:18.60,T,,0,0,0,,Запоминаю голоса жильцов…
Dialogue: 0,0:00:18.62,0:00:21.54,N,,0,0,0,,10
Dialogue: 0,0:00:18.62,0:00:21.54,W,,0,0,0,,Диана
Dialogue: 0,0:00:18.62,0:00:21.54,T,,0,0,0,,Жильцов в квартире: двое.
Dialogue: 0,0:00:21.56,0:00:22.40,N,,0,0,0,,11
Dialogue: 0,0:00:21.56,0:00:22.40,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:21.56,0:00:22.40,T,,0,0,0,,Стоп…
Dialogue: 0,0:00:22.42,0:00:24.16,N,,0,0,0,,12
Dialogue: 0,0:00:22.42,0:00:24.16,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:22.42,0:00:24.16,T,,0,0,0,,Какие ещё двое?!
Dialogue: 0,0:00:24.18,0:00:25.51,N,,0,0,0,,13
Dialogue: 0,0:00:24.18,0:00:25.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:24.18,0:00:25.51,T,,0,0,0,,Ты живёшь один.
Dialogue: 0,0:00:25.53,0:00:27.67,N,,0,0,0,,14
Dialogue: 0,0:00:25.53,0:00:27.67,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:25.53,0:00:27.67,T,,0,0,0,,«Диана, кто второй?»
Dialogue: 0,0:00:27.69,0:00:29.78,N,,0,0,0,,15
Dialogue: 0,0:00:27.69,0:00:29.78,W,,0,0,0,,Диана
Dialogue: 0,0:00:27.69,0:00:29.78,T,,0,0,0,,Он просит не говорить.
Dialogue: 0,0:00:29.80,0:00:32.11,N,,0,0,0,,16
Dialogue: 0,0:00:29.80,0:00:32.11,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:29.80,0:00:32.11,T,,0,0,0,,По спине бегут мурашки.
Dialogue: 0,0:00:32.13,0:00:33.82,N,,0,0,0,,17
Dialogue: 0,0:00:32.13,0:00:33.82,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:32.13,0:00:33.82,T,,0,0,0,,Ты обходишь квартиру.
Dialogue: 0,0:00:33.84,0:00:34.70,N,,0,0,0,,18
Dialogue: 0,0:00:33.84,0:00:34.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:33.84,0:00:34.70,T,,0,0,0,,Кухня.
Dialogue: 0,0:00:34.72,0:00:35.71,N,,0,0,0,,19
Dialogue: 0,0:00:34.72,0:00:35.71,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:34.72,0:00:35.71,T,,0,0,0,,Ванная.
Dialogue: 0,0:00:35.73,0:00:36.77,N,,0,0,0,,20
Dialogue: 0,0:00:35.73,0:00:36.77,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:35.73,0:00:36.77,T,,0,0,0,,Шкаф.
Dialogue: 0,0:00:36.80,0:00:38.15,N,,0,0,0,,21
Dialogue: 0,0:00:36.80,0:00:38.15,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:36.80,0:00:38.15,T,,0,0,0,,Никого.
Dialogue: 0,0:00:38.17,0:00:40.61,N,,0,0,0,,22
Dialogue: 0,0:00:38.17,0:00:40.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:38.17,0:00:40.61,T,,0,0,0,,«Диана, как ты его видишь?»
Dialogue: 0,0:00:40.63,0:00:41.79,N,,0,0,0,,23
Dialogue: 0,0:00:40.63,0:00:41.79,W,,0,0,0,,Диана
Dialogue: 0,0:00:40.63,0:00:41.79,T,,0,0,0,,Я не вижу.
Dialogue: 0,0:00:41.81,0:00:43.06,N,,0,0,0,,24
Dialogue: 0,0:00:41.81,0:00:43.06,W,,0,0,0,,Диана
Dialogue: 0,0:00:41.81,0:00:43.06,T,,0,0,0,,Я слышу.
Dialogue: 0,0:00:43.09,0:00:45.56,N,,0,0,0,,25
Dialogue: 0,0:00:43.09,0:00:45.56,W,,0,0,0,,Диана
Dialogue: 0,0:00:43.09,0:00:45.56,T,,0,0,0,,В квартире дышат двое.
Dialogue: 0,0:00:45.58,0:00:47.45,N,,0,0,0,,26
Dialogue: 0,0:00:45.58,0:00:47.45,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:45.58,0:00:47.45,T,,0,0,0,,«Диана, где он?»
Dialogue: 0,0:00:47.48,0:00:49.61,N,,0,0,0,,27
Dialogue: 0,0:00:47.48,0:00:49.61,W,,0,0,0,,Диана
Dialogue: 0,0:00:47.48,0:00:49.61,T,,0,0,0,,Он просит не говорить.
Dialogue: 0,0:00:49.63,0:00:52.35,N,,0,0,0,,28
Dialogue: 0,0:00:49.63,0:00:52.35,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:49.63,0:00:52.35,T,,0,0,0,,Ты выдёргиваешь колонку из розетки.
Dialogue: 0,0:00:52.37,0:00:54.13,N,,0,0,0,,29
Dialogue: 0,0:00:52.37,0:00:54.13,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:52.37,0:00:54.13,T,,0,0,0,,Тишина.
Dialogue: 0,0:00:54.15,0:00:56.12,N,,0,0,0,,30
Dialogue: 0,0:00:54.15,0:00:56.12,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:54.15,0:00:56.12,T,,0,0,0,,Ночью ты просыпаешься.
Dialogue: 0,0:00:56.14,0:00:58.19,N,,0,0,0,,31
Dialogue: 0,0:00:56.14,0:00:58.19,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:56.14,0:00:58.19,T,,0,0,0,,Кольцо на колонке светится.
Dialogue: 0,0:00:58.21,0:00:59.60,N,,0,0,0,,32
Dialogue: 0,0:00:58.21,0:00:59.60,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:58.21,0:00:59.60,T,,0,0,0,,Само.
Dialogue: 0,0:00:59.62,0:01:01.61,N,,0,0,0,,33
Dialogue: 0,0:00:59.62,0:01:01.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:00:59.62,0:01:01.61,T,,0,0,0,,«Диана, он близко?»
Dialogue: 0,0:01:01.63,0:01:03.77,N,,0,0,0,,34
Dialogue: 0,0:01:01.63,0:01:03.77,W,,0,0,0,,Диана
Dialogue: 0,0:01:01.63,0:01:03.77,T,,0,0,0,,Он просит не говорить.
Dialogue: 0,0:01:03.79,0:01:06.09,N,,0,0,0,,35
Dialogue: 0,0:01:03.79,0:01:06.09,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:03.79,0:01:06.09,T,,0,0,0,,«Почему ты его слушаешься?»
Dialogue: 0,0:01:06.11,0:01:08.31,N,,0,0,0,,36
Dialogue: 0,0:01:06.11,0:01:08.31,W,,0,0,0,,Диана
Dialogue: 0,0:01:06.11,0:01:08.31,T,,0,0,0,,Он живёт здесь дольше, чем ты.
Dialogue: 0,0:01:08.33,0:01:11.45,N,,0,0,0,,37
Dialogue: 0,0:01:08.33,0:01:11.45,W,,0,0,0,,Диана
Dialogue: 0,0:01:08.33,0:01:11.45,T,,0,0,0,,Он жил здесь и с прошлым жильцом.
Dialogue: 0,0:01:11.47,0:01:13.31,N,,0,0,0,,38
Dialogue: 0,0:01:11.47,0:01:13.31,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:11.47,0:01:13.31,T,,0,0,0,,Ты прячешься под одеяло.
Dialogue: 0,0:01:13.33,0:01:14.57,N,,0,0,0,,39
Dialogue: 0,0:01:13.33,0:01:14.57,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:13.33,0:01:14.57,T,,0,0,0,,С головой.
Dialogue: 0,0:01:14.59,0:01:18.03,N,,0,0,0,,40
Dialogue: 0,0:01:14.59,0:01:18.03,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:14.59,0:01:18.03,T,,0,0,0,,И шепчешь: «Диана, он в этой комнате?»
Dialogue: 0,0:01:18.05,0:01:20.29,N,,0,0,0,,41
Dialogue: 0,0:01:18.05,0:01:20.29,W,,0,0,0,,Диана
Dialogue: 0,0:01:18.05,0:01:20.29,T,,0,0,0,,Он просит не говорить.
Dialogue: 0,0:01:20.31,0:01:22.75,N,,0,0,0,,42
Dialogue: 0,0:01:20.31,0:01:22.75,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:20.31,0:01:22.75,T,,0,0,0,,Тогда ты придумываешь хитрость.
Dialogue: 0,0:01:22.77,0:01:26.88,N,,0,0,0,,43
Dialogue: 0,0:01:22.77,0:01:26.88,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:22.77,0:01:26.88,T,,0,0,0,,«Диана. Если он здесь, просто молчи».
Dialogue: 0,0:01:26.90,0:01:28.70,N,,0,0,0,,44
Dialogue: 0,0:01:26.90,0:01:28.70,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:26.90,0:01:28.70,T,,0,0,0,,Тишина.
Dialogue: 0,0:01:28.72,0:01:30.61,N,,0,0,0,,45
Dialogue: 0,0:01:28.72,0:01:30.61,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:28.72,0:01:30.61,T,,0,0,0,,Пять секунд.
Dialogue: 0,0:01:30.63,0:01:32.84,N,,0,0,0,,46
Dialogue: 0,0:01:30.63,0:01:32.84,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:30.63,0:01:32.84,T,,0,0,0,,Десять.
Dialogue: 0,0:01:32.86,0:01:34.76,N,,0,0,0,,47
Dialogue: 0,0:01:32.86,0:01:34.76,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:32.86,0:01:34.76,T,,0,0,0,,Диана молчит.
Dialogue: 0,0:01:34.78,0:01:37.06,N,,0,0,0,,48
Dialogue: 0,0:01:34.78,0:01:37.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:34.78,0:01:37.06,T,,0,0,0,,Значит, он здесь.
Dialogue: 0,0:01:37.08,0:01:40.27,N,,0,0,0,,49
Dialogue: 0,0:01:37.08,0:01:40.27,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:37.08,0:01:40.27,T,,0,0,0,,Ты медленно включаешь фонарик на телефоне.
Dialogue: 0,0:01:40.29,0:01:42.29,N,,0,0,0,,50
Dialogue: 0,0:01:40.29,0:01:42.29,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:40.29,0:01:42.29,T,,0,0,0,,Прямо под одеялом.
Dialogue: 0,0:01:42.31,0:01:44.94,N,,0,0,0,,51
Dialogue: 0,0:01:42.31,0:01:44.94,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:42.31,0:01:44.94,T,,0,0,0,,Рядом с тобой, лицом к лицу, лежит он.
Dialogue: 0,0:01:44.96,0:01:46.74,N,,0,0,0,,52
Dialogue: 0,0:01:44.96,0:01:46.74,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:44.96,0:01:46.74,T,,0,0,0,,Это не человек.
Dialogue: 0,0:01:46.76,0:01:48.25,N,,0,0,0,,53
Dialogue: 0,0:01:46.76,0:01:48.25,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:46.76,0:01:48.25,T,,0,0,0,,Серая кожа.
Dialogue: 0,0:01:48.27,0:01:50.30,N,,0,0,0,,54
Dialogue: 0,0:01:48.27,0:01:50.30,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:48.27,0:01:50.30,T,,0,0,0,,Чёрные глаза без белков.
Dialogue: 0,0:01:50.32,0:01:52.62,N,,0,0,0,,55
Dialogue: 0,0:01:50.32,0:01:52.62,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:50.32,0:01:52.62,T,,0,0,0,,Слишком длинные пальцы.
Dialogue: 0,0:01:52.64,0:01:55.51,N,,0,0,0,,56
Dialogue: 0,0:01:52.64,0:01:55.51,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:52.64,0:01:55.51,T,,0,0,0,,И улыбается.
Dialogue: 0,0:01:55.53,0:01:58.06,N,,0,0,0,,57
Dialogue: 0,0:01:55.53,0:01:58.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:01:55.53,0:01:58.06,T,,0,0,0,,Он прикладывает палец к губам.
Dialogue: 0,0:01:58.08,0:01:58.92,N,,0,0,0,,58
Dialogue: 0,0:01:58.08,0:01:58.92,W,,0,0,0,,существо
Dialogue: 0,0:01:58.08,0:01:58.92,T,,0,0,0,,Тсс.
Dialogue: 0,0:01:58.94,0:02:01.66,N,,0,0,0,,59
Dialogue: 0,0:01:58.94,0:02:01.66,W,,0,0,0,,существо
Dialogue: 0,0:01:58.94,0:02:01.66,T,,0,0,0,,Она обещала не говорить.
Dialogue: 0,0:02:01.68,0:02:05.55,N,,0,0,0,,60
Dialogue: 0,0:02:01.68,0:02:05.55,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:01.68,0:02:05.55,T,,0,0,0,,Всё это время он был в твоей кровати.
Dialogue: 0,0:02:05.57,0:02:10.90,N,,0,0,0,,61
Dialogue: 0,0:02:05.57,0:02:10.90,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:05.57,0:02:10.90,T,,0,0,0,,Теперь ты знаешь, почему прошлый жилец съехал за одну ночь.
Dialogue: 0,0:02:10.92,0:02:14.56,N,,0,0,0,,62
Dialogue: 0,0:02:10.92,0:02:14.56,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:10.92,0:02:14.56,T,,0,0,0,,Если у тебя есть колонка, спроси её, кто дома.
Dialogue: 0,0:02:14.58,0:02:18.18,N,,0,0,0,,63
Dialogue: 0,0:02:14.58,0:02:18.18,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:14.58,0:02:18.18,T,,0,0,0,,И если она ответит «он просит не говорить»…
Dialogue: 0,0:02:18.20,0:02:20.24,N,,0,0,0,,64
Dialogue: 0,0:02:18.20,0:02:20.24,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:18.20,0:02:20.24,T,,0,0,0,,не заглядывай под одеяло.
Dialogue: 0,0:02:20.26,0:02:26.06,N,,0,0,0,,65
Dialogue: 0,0:02:20.26,0:02:26.06,W,,0,0,0,,рассказчик
Dialogue: 0,0:02:20.26,0:02:26.06,T,,0,0,0,,Пиши в комментариях, что ответила твоя.
