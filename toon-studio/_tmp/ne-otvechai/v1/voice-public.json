   "end": 2.552,
   "who": "tema",
   "words": [
    {
     "w": "Мам?",
     "t": 2.007
    }
   ]
  },
  {
   "i": 2,
   "text": "Три часа ночи. Мама на смене… до утра.",
   "start": 2.952,
   "end": 5.38,
   "who": "narrator",
   "words": [
    {
     "w": "Три",
     "t": 2.972
    },
    {
     "w": "часа",
     "t": 3.092
    },
    {
     "w": "ночи.",
     "t": 3.372
    },
    {
     "w": "Мама",
     "t": 4.232
    },
    {
     "w": "на",
     "t": 4.492
    },
    {
     "w": "смене…",
     "t": 4.632
    },
    {
     "w": "до",
     "t": 4.892
    },
    {
     "w": "утра.",
     "t": 5.032
    }
   ]
  },
  {
   "i": 3,
   "text": "А в дверь… стучат.",
   "start": 5.68,
   "end": 7.284,
   "who": "narrator",
   "words": [
    {
     "w": "А",
     "t": 5.7
    },
