   "say": "ты.",
   "gap": 0.71,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 27.49,
   "t1": 28.59,
   "say": "Три тридцать три.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 29.01,
   "t1": 30.51,
   "say": "Экран загорается сам.",
   "gap": 0.42,
   "who": "narrator"
  },
