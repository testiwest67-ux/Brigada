 "lines": [
  {
   "src": "N1a.mp3",
   "t0": 0.04,
   "t1": 2.27,
   "say": "Три часа тридцать две минуты ночи.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 2.73,
   "t1": 4.96,
   "say": "Телефон вибрирует у тебя под подушкой.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 5.31,
   "t1": 6.68,
   "say": "Голосовое сообщение.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 7.05,
   "t1": 8.47,
   "say": "От контакта «Я».",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 8.94,
   "t1": 9.87,
   "say": "Это твой номер.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 10.13,
   "t1": 12.0,
   "say": "Ты сам себе ничего не отправлял.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 12.34,
   "t1": 14.35,
   "say": "Отправлено в три тридцать три.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 14.77,
   "t1": 15.93,
   "say": "Ты смотришь на часы.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 16.3,
   "t1": 17.4,
   "say": "Три тридцать две.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 17.77,
   "t1": 19.09,
   "say": "Сообщение пришло…",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 19.32,
   "t1": 20.18,
   "say": "через минуту.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "N1a.mp3",
   "t0": 20.62,
   "t1": 21.44,
   "say": "Ты включаешь.",
   "gap": 0.9,
   "who": "narrator"
  },
  {
   "src": "HIMa.mp3",
   "t0": 0.11,
   "t1": 1.24,
   "say": "Не вставай с кровати.",
   "gap": 0.45,
   "who": "him",
   "fx": "highpass=f=320,lowpass=f=3400,volume=4.0"
  },
  {
   "src": "HIMa.mp3",
   "t0": 1.67,
   "t1": 2.7,
   "say": "Под ней кто-то есть.",
   "gap": 0.45,
   "who": "him",
   "fx": "highpass=f=320,lowpass=f=3400,volume=4.0"
  },
  {
   "src": "HIMa.mp3",
   "t0": 3.11,
   "t1": 3.88,
   "say": "Дождись утра.",
