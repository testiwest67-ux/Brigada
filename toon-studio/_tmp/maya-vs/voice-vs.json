   "t1": 1.762,
   "say": "Джунгли Гватемалы.",
   "gap": 0.45,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "L001.wav",
   "t0": 0,
   "t1": 2.543,
   "say": "Тысяча восемьсот тридцать девятый год.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L002.wav",
   "t0": 0,
   "t1": 4.047,
   "say": "Двое путешественников прорубают дорогу мачете сквозь лианы.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L003.wav",
   "t0": 0,
   "t1": 2.795,
   "say": "И вдруг из зелени выступает каменное лицо.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L004.wav",
   "t0": 0,
   "t1": 2.213,
   "say": "Высотой в два человеческих роста.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L005.wav",
   "t0": 0,
   "t1": 1.704,
   "say": "За ним — ещё одно.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L006.wav",
   "t0": 0,
   "t1": 1.969,
   "say": "Лестницы, уходящие в небо.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L007.wav",
   "t0": 0,
   "t1": 1.123,
   "say": "Площади.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L008.wav",
   "t0": 0,
   "t1": 1.057,
   "say": "Дворцы.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L009.wav",
   "t0": 0,
   "t1": 1.267,
   "say": "Целый город.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L010.wav",
   "t0": 0,
   "t1": 1.112,
   "say": "Пустой.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L011.wav",
   "t0": 0,
   "t1": 2.12,
   "say": "Деревья растут прямо из крыш храмов.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L012.wav",
   "t0": 0,
   "t1": 1.679,
   "say": "Корни разламывают ступени.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L013.wav",
   "t0": 0,
   "t1": 2.151,
   "say": "Здесь когда-то жили тысячи людей.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L014.wav",
   "t0": 0,
   "t1": 3.282,
   "say": "Здесь правили цари, считали звёзды, писали книги.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L015.wav",
   "t0": 0,
   "t1": 1.369,
   "say": "А потом все ушли.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L016.wav",
   "t0": 0,
   "t1": 1.443,
   "say": "Не один город.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L017.wav",
   "t0": 0,
   "t1": 1.087,
   "say": "Десятки.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L018.wav",
   "t0": 0,
   "t1": 1.169,
   "say": "Сотни.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L019.wav",
   "t0": 0,
   "t1": 6.637,
   "say": "Примерно за сто пятьдесят лет одна из самых развитых цивилизаций древнего мира покинула свои города.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L020.wav",
   "t0": 0,
   "t1": 1.732,
   "say": "И джунгли проглотили их.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L021.wav",
   "t0": 0,
   "t1": 1.875,
   "say": "Что случилось с майя?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L022.wav",
   "t0": 0,
   "t1": 1.291,
   "say": "Война?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L023.wav",
   "t0": 0,
   "t1": 1.326,
   "say": "Засуха?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L024.wav",
   "t0": 0,
   "t1": 1.391,
   "say": "Болезнь?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L025.wav",
   "t0": 0,
   "t1": 2.069,
   "say": "Или что-то, о чём мы ещё не знаем?",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L026.wav",
   "t0": 0,
   "t1": 1.499,
   "say": "Давай разберёмся.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L027.wav",
   "t0": 0,
   "t1": 5.389,
   "say": "По раскопкам, по надписям на камне и по тому, что рассказали учёным озёра и пещеры.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L028.wav",
   "t0": 0,
   "t1": 2.026,
   "say": "А в конце — три главные версии.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "L029.wav",
   "t0": 0,
   "t1": 2.55,
   "say": "И ты решишь, какая из них ближе к правде.",
