  },
  {
   "src": "N2a.mp3",
   "t0": 0.0,
   "t1": 1.5,
   "say": "Двери открываются.",
   "gap": 0.25
  },
  {
   "src": "N2a.mp3",
   "t0": 2.12,
   "t1": 4.54,
   "say": "Это твой этаж. Твоя дверь.",
   "gap": 0.25
  },
  {
   "src": "MOMb.mp3",
   "t0": 0.0,
   "t1": 3.2,
   "say": "Алиса, ты? Иди ужинать, всё остыло!",
