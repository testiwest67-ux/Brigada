{
 "dir": "public/eldorado/el",
 "lead": 1.0,
 "tail": 4.0,
 "tempo": 1.0,
 "lines": [
  {
   "src": "ch0.mp3",
   "t0": 0.04,
   "t1": 1.01,
   "say": "Пятьсот лет.",
   "gap": 0.36,
   "who": "narrator",
   "chapter": "0. Крючок"
  },
  {
   "src": "ch0.mp3",
   "t0": 1.27,
   "t1": 2.76,
   "say": "Сотни экспедиций.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 3.14,
   "t1": 4.27,
   "say": "Тысячи погибших.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 4.69,
   "t1": 7.3,
   "say": "И ни одного найденного золотого города.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 7.85,
   "t1": 10.04,
   "say": "Ради Эльдорадо сжигали деревни.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 10.29,
   "t1": 12.68,
   "say": "Уходили в джунгли целыми армиями.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 12.97,
   "t1": 14.49,
   "say": "Пытались осушить озеро.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 14.96,
   "t1": 17.72,
   "say": "Одного знаменитого мореплавателя за него казнили.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 18.02,
   "t1": 21.66,
   "say": "Другой ушёл в джунгли с сыном — и исчез навсегда.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 22.2,
   "t1": 27.87,
   "say": "А в две тысячи двадцать четвёртом году учёные посветили лазером сквозь джунгли Амазонии.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 28.23,
   "t1": 31.13,
   "say": "И увидели то, чего там быть не могло.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 31.71,
   "t1": 35.0,
   "say": "Но сначала — главная находка двадцатого века.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 35.46,
   "t1": 36.18,
   "say": "Колумбия.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 36.48,
   "t1": 38.64,
   "say": "Тысяча девятьсот шестьдесят девятый год.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 39.07,
   "t1": 42.61,
   "say": "Крестьяне забираются в пещеру в горах, недалеко от Боготы.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 43.1,
   "t1": 46.21,
   "say": "В темноте, в глиняном горшке, что-то блестит.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 46.71,
   "t1": 49.38,
   "say": "Маленький плот из чистого золота.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 49.86,
   "t1": 51.61,
   "say": "На нём человек в короне.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 51.91,
   "t1": 53.47,
   "say": "Вокруг — его свита.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 54.03,
   "t1": 56.84,
   "say": "Учёные понимают: это не украшение.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 57.23,
   "t1": 58.8,
   "say": "Это доказательство.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 59.13,
   "t1": 60.55,
   "say": "Легенда не врала.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 60.72,
   "t1": 61.95,
   "say": "Что-то было.",
   "gap": 0.68,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 62.53,
   "t1": 65.44,
   "say": "Тогда почему никто так и не нашёл Эльдорадо?",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 65.93,
   "t1": 66.91,
   "say": "Давай разберёмся.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 67.29,
   "t1": 70.36,
   "say": "А в конце — что увидел лазер под джунглями.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch0.mp3",
   "t0": 70.65,
   "t1": 72.91,
   "say": "Это переворачивает всю историю.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 0,
   "t1": 1.86,
   "say": "Начнём с главного секрета.",
   "gap": 0.49,
   "who": "narrator",
   "chapter": "1. Золотой человек"
  },
  {
   "src": "ch1.mp3",
   "t0": 2.25,
   "t1": 4.68,
   "say": "Эльдорадо — это вообще не город.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 5.06,
   "t1": 8.54,
   "say": "По-испански «эль дорадо» значит «позолоченный».",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 8.93,
   "t1": 10.47,
   "say": "Позолоченный человек.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 10.99,
   "t1": 13.84,
   "say": "Высоко в горах Колумбии жил народ муисков.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 14.27,
   "t1": 15.61,
   "say": "Они не строили пирамид.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 15.84,
   "t1": 17.73,
   "say": "Зато у них было золото.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 18.01,
   "t1": 19.23,
   "say": "Много золота.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 19.62,
   "t1": 22.03,
   "say": "Для муисков золото не было деньгами.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 22.3,
   "t1": 23.96,
   "say": "Это был металл солнца.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 24.21,
   "t1": 25.28,
   "say": "Подарок богам.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 25.65,
   "t1": 28.41,
   "say": "И раз в поколение у них был особый день.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 28.68,
   "t1": 30.82,
   "say": "Новый правитель восходил на трон.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 31.17,
   "t1": 33.32,
   "say": "Его тело мазали липкой смолой.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 33.5,
   "t1": 35.78,
   "say": "А потом осыпали золотой пылью.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 35.97,
   "t1": 37.27,
   "say": "С головы до ног.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 37.55,
   "t1": 39.76,
   "say": "Он сиял, как живое солнце.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 40.1,
   "t1": 41.4,
   "say": "Его сажали на плот.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 41.75,
   "t1": 44.42,
   "say": "Рядом клали горы золота и изумрудов.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 44.88,
   "t1": 47.99,
   "say": "Плот выплывал на середину круглого горного озера.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 48.34,
   "t1": 49.62,
   "say": "Озеро Гуатавита.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 50.04,
   "t1": 51.93,
   "say": "На берегу — тысячи людей.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.1,
   "t1": 52.86,
   "say": "Музыка.",
   "gap": 0.27,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 52.9,
   "t1": 54.03,
   "say": "Дым благовоний.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 54.34,
   "t1": 55.87,
   "say": "И вдруг — тишина.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 56.37,
   "t1": 58.67,
   "say": "Правитель бросал сокровища в воду.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 58.85,
   "t1": 60.01,
   "say": "Одно за другим.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 60.28,
   "t1": 61.78,
   "say": "А потом нырял сам.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 62.1,
   "t1": 65.12,
   "say": "И золото смывалось с его кожи в тёмную воду.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 65.6,
   "t1": 67.4,
   "say": "Вот он — Эль Дорадо.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 67.61,
   "t1": 68.95,
   "say": "Золотой человек.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 69.34,
   "t1": 73.88,
   "say": "Тот самый плот из пещеры — это и есть этот обряд, отлитый в золоте.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch1.mp3",
   "t0": 74.41,
   "t1": 77.71,
   "say": "Но испанцы услышали эту историю иначе.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 0.04,
   "t1": 2.01,
   "say": "Тысяча пятьсот тридцать седьмой год.",
   "gap": 0.51,
   "who": "narrator",
   "chapter": "2. Слух, который сводил с ума"
  },
  {
   "src": "ch2.mp3",
   "t0": 2.42,
   "t1": 5.13,
   "say": "В горы муисков приходит испанский отряд.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 5.6,
   "t1": 8.27,
   "say": "Командир — Гонсало Хименес де Кесада.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 8.8,
   "t1": 11.08,
   "say": "Испанцы уже ограбили ацтеков.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 11.39,
   "t1": 13.0,
   "say": "Уже ограбили инков.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 13.4,
   "t1": 16.4,
   "say": "Они знают: где индейцы — там золото.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 16.92,
   "t1": 18.25,
   "say": "Муиски проигрывают.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 18.51,
   "t1": 23.56,
   "say": "Испанцы забирают всё: золото, изумруды, храмовые украшения.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 23.93,
   "t1": 24.97,
   "say": "Но им мало.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 25.39,
   "t1": 28.48,
   "say": "Они слышат рассказы про озеро, полное сокровищ.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 28.74,
   "t1": 30.35,
   "say": "Про позолоченного правителя.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 30.77,
   "t1": 33.24,
   "say": "И в их головах история меняется.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 33.66,
   "t1": 37.16,
   "say": "Позолоченный человек превращается в золотое царство.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 37.47,
   "t1": 39.85,
   "say": "Золотое царство — в золотой город.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 40.09,
   "t1": 41.49,
   "say": "С крышами из золота.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 41.61,
   "t1": 43.17,
   "say": "С улицами из золота.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 43.53,
   "t1": 46.31,
   "say": "И главное — он всегда чуть дальше.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 46.57,
   "t1": 47.74,
   "say": "За следующей горой.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 47.96,
   "t1": 49.2,
   "say": "За следующей рекой.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 49.42,
   "t1": 50.7,
   "say": "В следующих джунглях.",
   "gap": 0.77,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 51.37,
   "t1": 56.56,
   "say": "Индейцы быстро поняли: чтобы испанцы ушли, достаточно махнуть рукой вдаль.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 56.95,
   "t1": 57.61,
   "say": "«Эльдорадо?",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 57.89,
   "t1": 58.29,
   "say": "Там.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 58.44,
   "t1": 58.97,
   "say": "Дальше».",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 59.47,
   "t1": 61.21,
   "say": "И испанцы шли дальше.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch2.mp3",
   "t0": 61.6,
   "t1": 64.74,
   "say": "Скоро это будет стоить жизни тысячам людей.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 0.05,
   "t1": 1.91,
   "say": "Тысяча пятьсот сорок первый год.",
   "gap": 0.41,
   "who": "narrator",
   "chapter": "3. Экспедиция смерти"
  },
  {
   "src": "ch3.mp3",
   "t0": 2.22,
   "t1": 3.88,
   "say": "Город Кито, в Андах.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 4.31,
   "t1": 9.55,
   "say": "Гонсало Писарро — брат завоевателя инков — собирает огромную экспедицию.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 9.83,
   "t1": 11.61,
   "say": "Двести двадцать испанцев.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 11.95,
   "t1": 14.57,
   "say": "Около четырёх тысяч индейцев-носильщиков.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 14.9,
   "t1": 15.57,
   "say": "Лошади.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 15.68,
   "t1": 16.43,
   "say": "Свиньи.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 16.56,
   "t1": 19.23,
   "say": "Собаки, натасканные на людей.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 19.51,
   "t1": 21.69,
   "say": "Цель — Эльдорадо и «страна корицы».",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 22.08,
   "t1": 24.36,
   "say": "Тогда корица стоила как золото.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 24.83,
   "t1": 26.72,
   "say": "Они спускаются с гор в джунгли.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 27.09,
   "t1": 29.26,
   "say": "И джунгли начинают их убивать.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 29.6,
   "t1": 31.71,
   "say": "Дожди не прекращаются неделями.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 31.93,
   "t1": 34.0,
   "say": "Одежда гниёт прямо на теле.",
   "gap": 0.36,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 34.26,
   "t1": 35.79,
   "say": "Еда заканчивается.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 36.09,
   "t1": 37.15,
   "say": "Съедают свиней.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 37.42,
   "t1": 38.29,
   "say": "Потом лошадей.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 38.6,
   "t1": 39.46,
   "say": "Потом собак.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 39.76,
   "t1": 41.41,
   "say": "Потом ремни и подошвы.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 41.81,
   "t1": 44.31,
   "say": "Индейцы-носильщики умирают тысячами.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 44.59,
   "t1": 45.88,
   "say": "Корицы почти нет.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 46.22,
   "t1": 47.36,
   "say": "Золота нет.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 47.89,
   "t1": 51.75,
   "say": "Тогда Писарро отправляет вниз по реке маленький отряд за едой.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 52.12,
   "t1": 54.39,
   "say": "Командир — Франсиско де Орельяна.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 54.85,
   "t1": 56.44,
   "say": "Отряд не возвращается.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 56.85,
   "t1": 58.8,
   "say": "Писарро решает, что его предали.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 59.13,
   "t1": 61.37,
   "say": "Он с трудом выбирается назад в Кито.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 61.72,
   "t1": 65.32,
   "say": "Из четырёх тысяч индейцев не вернулся почти никто.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 65.77,
   "t1": 66.88,
   "say": "А Орельяна…",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 67.31,
   "t1": 68.49,
   "say": "Орельяна плыл.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 68.85,
   "t1": 69.59,
   "say": "И плыл.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 69.86,
   "t1": 70.51,
   "say": "И плыл.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch3.mp3",
   "t0": 70.95,
   "t1": 74.33,
   "say": "И сделал открытие, которое потрясёт весь мир.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 0.03,
   "t1": 2.9,
   "say": "Течение несёт отряд Орельяны всё дальше.",
   "gap": 0.5,
   "who": "narrator",
   "chapter": "4. Река, которую никто не искал"
  },
  {
   "src": "ch4.mp3",
   "t0": 3.3,
   "t1": 5.3,
   "say": "Повернуть назад уже невозможно.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 5.86,
   "t1": 9.05,
   "say": "Восемь месяцев они плывут по огромной реке.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 9.29,
   "t1": 10.61,
   "say": "Шириной как море.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 11.18,
   "t1": 14.89,
   "say": "И Орельяна видит то, во что потом никто не поверит.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 15.35,
   "t1": 17.15,
   "say": "Берега не пустые.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 17.58,
   "t1": 18.44,
   "say": "Там деревни.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 18.76,
   "t1": 19.87,
   "say": "Много деревень.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 20.18,
   "t1": 20.92,
   "say": "Дороги.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 21.1,
   "t1": 21.62,
   "say": "Поля.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 22.01,
   "t1": 23.0,
   "say": "Тысячи людей.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 23.21,
   "t1": 25.15,
   "say": "Целые царства вдоль реки.",
   "gap": 0.78,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 25.83,
   "t1": 27.84,
   "say": "Однажды на них нападают воины.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 28.28,
   "t1": 31.56,
   "say": "Испанцам кажется, что впереди сражаются женщины.",
   "gap": 0.31,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 31.77,
   "t1": 33.75,
   "say": "Как амазонки из греческих мифов.",
   "gap": 0.74,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 34.39,
   "t1": 36.08,
   "say": "Так река и получила имя.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 36.41,
   "t1": 37.16,
   "say": "Амазонка.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 37.76,
   "t1": 41.53,
   "say": "В тысяча пятьсот сорок втором году Орельяна выходит к океану.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 41.94,
   "t1": 45.87,
   "say": "Он первый европеец, проплывший Амазонку от гор до моря.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 46.36,
   "t1": 48.56,
   "say": "Он рассказывает о многолюдных берегах.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 48.92,
   "t1": 52.99,
   "say": "Но когда через много лет туда приходят другие — никого нет.",
   "gap": 0.64,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 53.53,
   "t1": 54.4,
   "say": "Ни деревень.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 54.58,
   "t1": 55.32,
   "say": "Ни царств.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 55.61,
   "t1": 56.33,
   "say": "Ни дорог.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 56.86,
   "t1": 57.84,
   "say": "Только джунгли.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 58.43,
   "t1": 60.67,
   "say": "Орельяну назвали лжецом.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 61.19,
   "t1": 62.34,
   "say": "Запомни этот момент.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch4.mp3",
   "t0": 62.57,
   "t1": 63.54,
   "say": "Мы к нему вернёмся.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 0,
   "t1": 2.22,
   "say": "Но золотой город не отпускает.",
   "gap": 0.55,
   "who": "narrator",
   "chapter": "5. Гнев Божий"
  },
  {
   "src": "ch5.mp3",
   "t0": 2.67,
   "t1": 4.57,
   "say": "Тысяча пятьсот шестидесятый год.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 4.98,
   "t1": 7.93,
   "say": "Новая экспедиция уходит вниз по Амазонке.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 8.27,
   "t1": 11.21,
   "say": "В ней служит солдат по имени Лопе де Агирре.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 11.68,
   "t1": 13.05,
   "say": "Месяцы в джунглях.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 13.24,
   "t1": 13.95,
   "say": "Голод.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 14.03,
   "t1": 14.69,
   "say": "Жара.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 14.83,
   "t1": 15.52,
   "say": "Комары.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 15.83,
   "t1": 17.45,
   "say": "Ни крупинки золота.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 17.86,
   "t1": 19.64,
   "say": "И Агирре сходит с ума.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 20.03,
   "t1": 22.11,
   "say": "Он убивает командира экспедиции.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 22.35,
   "t1": 24.29,
   "say": "Потом — следующего командира.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 24.63,
   "t1": 27.57,
   "say": "Он объявляет войну самому королю Испании.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 27.89,
   "t1": 30.27,
   "say": "Он называет себя «Гнев Божий».",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 30.63,
   "t1": 33.21,
   "say": "Его люди боятся его больше, чем джунглей.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 33.55,
   "t1": 35.86,
   "say": "Каждого, кто сомневается, — убивают.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 36.39,
   "t1": 41.28,
   "say": "Когда солдаты короля наконец окружают Агирре, он делает самое страшное.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 41.65,
   "t1": 43.95,
   "say": "Он убивает собственную дочь.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 44.26,
   "t1": 48.26,
   "say": "Чтобы её, как он сказал, не называли дочерью предателя.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 48.75,
   "t1": 51.1,
   "say": "Вот что делала с людьми эта легенда.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 51.61,
   "t1": 54.99,
   "say": "Но были и те, кто решил не идти за Эльдорадо в джунгли.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch5.mp3",
   "t0": 55.31,
   "t1": 58.49,
   "say": "Они решили забрать его золото прямо со дна.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 0,
   "t1": 5.44,
   "say": "Если правители бросали золото в озеро Гуатавита — значит, оно всё ещё там.",
   "gap": 0.71,
   "who": "narrator",
   "chapter": "6. Осушить озеро"
  },
  {
   "src": "ch6.mp3",
   "t0": 6.05,
   "t1": 12.18,
   "say": "Около тысяча пятьсот восьмидесятого года богатый купец Антонио де Сепульведа берётся за дело.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 12.77,
   "t1": 16.59,
   "say": "Тысячи рабочих прорубают огромную выемку в краю озера.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 16.97,
   "t1": 18.13,
   "say": "Вода уходит.",
   "gap": 0.61,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 18.64,
   "t1": 20.69,
   "say": "Уровень падает на двадцать метров.",
   "gap": 0.58,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 21.17,
   "t1": 22.91,
   "say": "И на дне — золото.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 23.31,
   "t1": 24.19,
   "say": "Украшения.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 24.52,
   "t1": 26.82,
   "say": "Изумруд размером с куриное яйцо.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 27.38,
   "t1": 30.03,
   "say": "Но тут стенка выемки обрушивается.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 30.27,
   "t1": 31.43,
   "say": "Рабочих засыпает.",
   "gap": 0.53,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 31.86,
   "t1": 33.52,
   "say": "Озеро снова наполняется.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 33.93,
   "t1": 35.88,
   "say": "Сепульведа умирает бедным.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 36.34,
   "t1": 39.19,
   "say": "А выемка в краю озера видна до сих пор.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 39.5,
   "t1": 41.23,
   "say": "Её можно увидеть со спутника.",
   "gap": 0.67,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 41.8,
   "t1": 43.13,
   "say": "Проходит триста лет.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 43.54,
   "t1": 45.72,
   "say": "Англичане покупают права на озеро.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 46.02,
   "t1": 50.88,
   "say": "Они роют туннель и почти полностью осушают Гуатавиту.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 51.13,
   "t1": 52.51,
   "say": "На дне — толстый слой ила.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 52.74,
   "t1": 54.33,
   "say": "Ходить по нему невозможно.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 54.82,
   "t1": 56.85,
   "say": "Они ждут, пока солнце его подсушит.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 57.3,
   "t1": 59.8,
   "say": "А солнце превращает ил в камень.",
   "gap": 0.42,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 60.12,
   "t1": 61.56,
   "say": "Твёрдый, как бетон.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 62.06,
   "t1": 65.51,
   "say": "За всё время они достают около шестидесяти предметов.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 65.78,
   "t1": 67.71,
   "say": "И продают их с аукциона в Лондоне.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 68.1,
   "t1": 70.27,
   "say": "Денег не хватает даже на расходы.",
   "gap": 0.46,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 70.63,
   "t1": 72.16,
   "say": "Компания разоряется.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 72.71,
   "t1": 77.36,
   "say": "В тысяча девятьсот шестьдесят пятом году Колумбия запрещает трогать озеро.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch6.mp3",
   "t0": 77.74,
   "t1": 80.79,
   "say": "Что ещё лежит на его дне — не знает никто.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 0,
   "t1": 4.66,
   "say": "А в Англии Эльдорадо искал один из самых знаменитых людей своего времени.",
   "gap": 0.43,
   "who": "narrator",
   "chapter": "7. Голова за Эльдорадо"
  },
  {
   "src": "ch7.mp3",
   "t0": 4.99,
   "t1": 6.66,
   "say": "Сэр Уолтер Рэли.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 6.99,
   "t1": 8.01,
   "say": "Мореплаватель.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 8.13,
   "t1": 8.68,
   "say": "Поэт.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 8.88,
   "t1": 10.19,
   "say": "Любимец королевы.",
   "gap": 0.63,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 10.72,
   "t1": 16.43,
   "say": "В тысяча пятьсот девяносто пятом году он плывёт в Южную Америку, вверх по реке Ориноко.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 16.77,
   "t1": 21.2,
   "say": "Он ищет Маноа — золотой город на берегу огромного озера.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 21.72,
   "t1": 23.16,
   "say": "Он не находит ничего.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 23.53,
   "t1": 27.01,
   "say": "Но пишет книгу: Эльдорадо существует.",
   "gap": 0.34,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 27.25,
   "t1": 28.56,
   "say": "Я почти дошёл.",
   "gap": 0.62,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 29.08,
   "t1": 30.07,
   "say": "Проходят годы.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 30.42,
   "t1": 31.85,
   "say": "Рэли попадает в тюрьму.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 32.24,
   "t1": 36.85,
   "say": "Старый и больной, он уговаривает нового короля: отпусти меня.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 37.19,
   "t1": 38.74,
   "say": "Я привезу тебе золото.",
   "gap": 0.69,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 39.33,
   "t1": 41.08,
   "say": "Тысяча шестьсот семнадцатый год.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 41.33,
   "t1": 42.6,
   "say": "Вторая экспедиция.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 43.0,
   "t1": 45.1,
   "say": "Его люди нападают на испанский форт.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 45.52,
   "t1": 47.45,
   "say": "В бою погибает сын Рэли.",
   "gap": 0.6,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 47.95,
   "t1": 49.19,
   "say": "Золота нет.",
   "gap": 0.59,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 49.68,
   "t1": 52.24,
   "say": "Рэли возвращается домой с пустыми руками.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 52.66,
   "t1": 56.56,
   "say": "И в тысяча шестьсот восемнадцатом году ему отрубают голову.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 57.02,
   "t1": 58.96,
   "say": "Эльдорадо забрало и его.",
   "gap": 0.66,
   "who": "narrator"
  },
  {
   "src": "ch7.mp3",
   "t0": 59.52,
   "t1": 64.2,
   "say": "Но спустя триста лет появится человек, который пойдёт ещё дальше.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 0.05,
   "t1": 2.06,
   "say": "Тысяча девятьсот двадцать пятый год.",
   "gap": 0.36,
   "who": "narrator",
   "chapter": "8. Человек, который не вернулся"
  },
  {
   "src": "ch8.mp3",
   "t0": 2.32,
   "t1": 3.09,
   "say": "Бразилия.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 3.43,
   "t1": 5.68,
   "say": "Британский полковник Перси Фосетт.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 6.09,
   "t1": 10.02,
   "say": "Он десятки раз уходил в джунгли — и всегда возвращался.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 10.44,
   "t1": 14.84,
   "say": "Он уверен: в глубине Амазонии есть древний затерянный город.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 15.17,
   "t1": 17.2,
   "say": "Он называет его просто «Зет».",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 17.62,
   "t1": 19.76,
   "say": "Он берёт с собой сына и его друга.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 20.03,
   "t1": 21.31,
   "say": "Никакой большой армии.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 21.47,
   "t1": 22.14,
   "say": "Только трое.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 22.56,
   "t1": 25.87,
   "say": "Последнее письмо жене: «Не беспокойся о неудаче».",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 26.42,
   "t1": 27.81,
   "say": "Они уходят в джунгли.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 28.19,
   "t1": 31.13,
   "say": "И больше их никто никогда не видел.",
   "gap": 0.49,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 31.52,
   "t1": 33.54,
   "say": "Их искали десятки экспедиций.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 33.79,
   "t1": 39.09,
   "say": "По некоторым подсчётам, около ста человек погибли или пропали, пытаясь найти Фосетта.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 39.49,
   "t1": 41.35,
   "say": "Казалось, это конец истории.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 41.7,
   "t1": 44.19,
   "say": "Эльдорадо — просто сказка о жадности.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 44.61,
   "t1": 48.8,
   "say": "Но в двадцать первом веке у учёных появился новый инструмент.",
   "gap": 0.39,
   "who": "narrator"
  },
  {
   "src": "ch8.mp3",
   "t0": 49.09,
   "t1": 51.95,
   "say": "И джунгли начали раскрывать свои секреты.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 0,
   "t1": 0.62,
   "say": "Лидар.",
   "gap": 0.55,
   "who": "narrator",
   "chapter": "9. Что скрывали джунгли"
  },
  {
   "src": "ch9.mp3",
   "t0": 1.07,
   "t1": 3.44,
   "say": "Самолёт стреляет в джунгли лазером.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 3.67,
   "t1": 5.58,
   "say": "Миллионы вспышек в секунду.",
   "gap": 0.51,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 5.99,
   "t1": 9.03,
   "say": "Часть лучей проходит сквозь листья до самой земли.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 9.37,
   "t1": 12.85,
   "say": "И компьютер собирает картину: что лежит под деревьями.",
   "gap": 0.75,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 13.5,
   "t1": 15.49,
   "say": "Две тысячи двадцать четвёртый год.",
   "gap": 0.32,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 15.71,
   "t1": 16.36,
   "say": "Эквадор.",
   "gap": 0.3,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 16.56,
   "t1": 18.09,
   "say": "Долина реки Упано.",
   "gap": 0.54,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 18.53,
   "t1": 20.12,
   "say": "Учёные публикуют карту.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 20.37,
   "t1": 22.1,
   "say": "И не верят своим глазам.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 22.47,
   "t1": 24.45,
   "say": "Под джунглями — города.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 24.85,
   "t1": 26.97,
   "say": "Пять больших и десять поменьше.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 27.27,
   "t1": 31.3,
   "say": "Больше шести тысяч земляных платформ под дома и храмы.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 31.65,
   "t1": 35.55,
   "say": "Прямые широкие дороги, которые соединяют города между собой.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 35.9,
   "t1": 36.46,
   "say": "Поля.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 36.59,
   "t1": 37.25,
   "say": "Каналы.",
   "gap": 0.56,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 37.71,
   "t1": 40.75,
   "say": "Этим городам больше двух с половиной тысяч лет.",
   "gap": 0.43,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 41.08,
   "t1": 44.08,
   "say": "Их строили из земли и дерева, а не из камня.",
   "gap": 0.35,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 44.33,
   "t1": 46.75,
   "say": "Поэтому джунгли спрятали их так хорошо.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 47.17,
   "t1": 50.7,
   "say": "И это, говорят учёные, только верхушка айсберга.",
   "gap": 0.65,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 51.25,
   "t1": 52.44,
   "say": "Помнишь Орельяну?",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 52.56,
   "t1": 53.99,
   "say": "Которого назвали лжецом?",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 54.37,
   "t1": 55.16,
   "say": "Он не врал.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 55.46,
   "t1": 57.12,
   "say": "Многолюдные берега были.",
   "gap": 0.41,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 57.43,
   "t1": 60.39,
   "say": "Но вслед за испанцами в Америку пришли болезни.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 60.77,
   "t1": 61.31,
   "say": "Оспа.",
   "gap": 0.26,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 61.47,
   "t1": 61.84,
   "say": "Корь.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 61.98,
   "t1": 62.54,
   "say": "Грипп.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 62.91,
   "t1": 65.14,
   "say": "Они бежали по рекам быстрее людей.",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 65.25,
   "t1": 69.23,
   "say": "И выкосили целые народы ещё до того, как их кто-то увидел.",
   "gap": 0.44,
   "who": "narrator"
  },
  {
   "src": "ch9.mp3",
   "t0": 69.57,
   "t1": 74.23,
   "say": "Когда пришли следующие экспедиции — джунгли уже съели пустые деревни.",
   "gap": 2.0,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 0,
   "t1": 1.53,
   "say": "Так где же Эльдорадо?",
   "gap": 0.56,
   "who": "narrator",
   "chapter": "10. Три версии"
  },
  {
   "src": "ch10.mp3",
   "t0": 1.99,
   "t1": 3.97,
   "say": "Вот три главные версии.",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 4.57,
   "t1": 5.61,
   "say": "Версия А.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 6.06,
   "t1": 7.97,
   "say": "Эльдорадо — это обряд.",
   "gap": 0.37,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 8.24,
   "t1": 10.58,
   "say": "Золотой человек на озере Гуатавита.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 10.81,
   "t1": 12.43,
   "say": "Города никогда не было.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 12.73,
   "t1": 18.27,
   "say": "А главное золото до сих пор лежит на дне озера, которое теперь запрещено трогать.",
   "gap": 0.86,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 19.03,
   "t1": 20.04,
   "say": "Версия Б.",
   "gap": 0.57,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 20.51,
   "t1": 23.64,
   "say": "Эльдорадо — это настоящие города Амазонии.",
   "gap": 0.38,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 23.92,
   "t1": 26.43,
   "say": "Не из золота, а из земли и дерева.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 26.73,
   "t1": 28.09,
   "say": "Их видел Орельяна.",
   "gap": 0.28,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 28.27,
   "t1": 29.46,
   "say": "Их убили болезни.",
   "gap": 0.29,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 29.65,
   "t1": 32.43,
   "say": "И сейчас лидар находит их один за другим.",
   "gap": 0.83,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 33.16,
   "t1": 34.17,
   "say": "Версия В.",
   "gap": 0.55,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 34.62,
   "t1": 36.59,
   "say": "Эльдорадо ещё не найдено.",
   "gap": 0.47,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 36.96,
   "t1": 43.16,
   "say": "Легенды говорят о Пайтити — последнем убежище инков, куда они унесли своё золото от испанцев.",
   "gap": 0.45,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 43.51,
   "t1": 46.48,
   "say": "Где-то на границе Перу, Боливии и Бразилии.",
   "gap": 0.33,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 46.71,
   "t1": 50.33,
   "say": "В джунглях, куда до сих пор не добрался ни один лазер.",
   "gap": 0.52,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 50.75,
   "t1": 53.15,
   "say": "Пятьсот лет люди искали золотой город.",
   "gap": 0.48,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 53.53,
   "t1": 55.98,
   "say": "Может быть, они просто искали не то.",
   "gap": 0.87,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
   "t0": 56.75,
   "t1": 58.35,
   "say": "А ты как думаешь?",
   "gap": 0.25,
   "who": "narrator"
  },
  {
   "src": "ch10.mp3",
