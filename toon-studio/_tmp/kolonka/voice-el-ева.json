   "who": "narrator",
   "chapter": "N2"
  },
  {
   "src": "N2a.mp3",
   "t0": 1.11,
   "t1": 1.84,
   "say": "Глючит.",
   "gap": 0.4,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 2.24,
   "t1": 3.22,
   "say": "Ты живёшь один.",
   "gap": 0.5,
   "who": "narrator"
  },
  {
   "src": "N2a.mp3",
   "t0": 3.57,
   "t1": 4.93,
   "say": "«Ева, кто второй?»",
   "gap": 0.7,
   "who": "narrator"
  },
  {
   "src": "EVAa.mp3",
   "t0": 1.38,
   "t1": 2.67,
